						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;Unanchor Loaded&quot;)

LandMine = script.Parent
enabled = true

function onTouched(hit)
&#9;if not enabled then return end

enabled = false&#9;
wait(0.1)
  LandMine.Transparency = 0.2
  wait(0.1)
  LandMine.Transparency = 0.4
  wait(0.1)
  LandMine.Transparency = 0.6
  wait(0.1)
  LandMine.Transparency = 0.8
  wait(0.1)
  LandMine.Transparency = 1
  LandMine.CanCollide = false
  wait(2.5)
  LandMine.CanCollide = true
  LandMine.Transparency = 0
enabled = true
end

connection = LandMine.Touched:connect(onTouched)
</ProtectedString>
