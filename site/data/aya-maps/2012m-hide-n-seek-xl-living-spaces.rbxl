				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local ammo = 2

function onDown(mouse)
if mouse.Target ~= nil then
local trap = game.Lighting:findFirstChild(&quot;It &quot;):clone()
trap.Parent = game.Workspace
trap:MakeJoints()
trap:MoveTo(Vector3.new(mouse.Hit.p.x,(mouse.Hit.p.y + (mouse.Target.Size.y/2) + 3),mouse.Hit.p.z))
ammo = ammo - 1
script.Parent.Name = &quot;Fake It[&quot;..ammo..&quot;]&quot;
if ammo == 0 then
script.Parent:remove()
end
end
end

function onSes(mouse)
mouse.Button1Down:connect(function() onDown(mouse) end)
end

script.Parent.Selected:connect(onSes)</ProtectedString>
				</Properties>
			</Item>
		</Item>
