		<Item class="Script" referent="RBX808">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">H&amp;S</string>
				<ProtectedString name="Source">local maps = game.Lighting.Maps:GetChildren()--Finds maps from Lighting to be played 
local pickedMap = nil 

local plyrs = 2-- This is the least amount of players needed to start the game 
local it = nil -- nil means it removes it, it being the player that has to find everyone. 

local playIt = game.Workspace:findFirstChild(&quot;PlayerIt&quot;)
playIt.Value = nil

local start = game.Workspace:findFirstChild(&quot;GameStarted&quot;) 

local info = game.Workspace:findFirstChild(&quot;InfoReel&quot;) --This is the value that sends information to all the characters... 
--Feel free to edit any text fields stemming from this. 

local connection = nil --This has to deal with the it removal process 
local c1 = nil
local c2 = nil

local arrive = false

--This should clear up the &quot;It leaving&quot; issue. 
function playerLeave(person)
print(&quot;A Player has left...&quot;)
if it == nil or person == it then 
arrive = false
if c1 ~= nil then c1:disconnect() end
if c2 ~= nil then c2:disconnect() end
info.Value = &quot;&apos;It&apos; left the game!&quot; 
wait(2) 
info.Value = &quot;Re-Starting game!&quot; 
wait(2) 
local list = game.Players:children() 
for i = 1, #list do 
if list[i].Character ~= nil then 
list[i].Character:BreakJoints()--Kills everyone 
list[i].Alive.Value = false 
end 
end 
if pickedMap ~= nil then pickedMap:remove() end
CheckPlayers() 
end 
end 

function round(a,b) 
return math.floor((a/b)+0.5)*b 
end 

function findAlive()--Starts Function to find alive players. 
local alive = 0 
local playerLIST = game.Players:GetChildren() 
for i = 1, #playerLIST do 
if playerLIST[i].Alive.Value == true then 
alive = alive + 1--Counts that there is 1 player alive 
end 
end 
local total = 10/alive 
local p = round(total,1) 
print(&quot;Round Total: &quot;..p) 
local playerLIST = game.Players:GetChildren() 
for i = 1, #playerLIST do 
if playerLIST[i].Alive.Value == true then 
playerLIST[i].leaderstats.Points.Value = playerLIST[i].leaderstats.Points.Value + 10 
end 
end 
if alive == 0 then 
info.Value = it.Name.. &quot; tagged everyone. &quot;--This means the It Player tagged everyone. 
wait(4) 
info.Value = it.Name..&quot; gets a bonus of 5 points!&quot;--Everyone gets a 50 point bonus 
wait(5) 
if it ~= nil then 
it.leaderstats.Points.Value = it.leaderstats.Points.Value + 5--50 points is added to your leaderboard/stats at the top left corner 
wait(2) 
info.Value = &quot;&quot; 
end 
end 
local list = game.Players:children()--This line gets the list the list being the list of characters you are one of them 
for i = 1, #list do 
if list[i].Character ~= nil then 
list[i].Character:BreakJoints()--This kills everyone 
end 
end 
pickedMap:remove()--This removes the pick map code 
local minutes = 0--0 Minutes left 
local seconds = 30--30 seconds left 
for i = 1, (minutes+1) do--adds 1 minute 
for i = 1, (seconds+1) do 
if seconds &lt; 10 then 
info.Value = minutes..&quot;:0&quot;..seconds..&quot; till next round!&quot;--Shows seconds until next round 
else 
info.Value = minutes..&quot;:&quot;..seconds..&quot; till next round!&quot;--None till next round 
end 
seconds = seconds - 1 
wait(1)--waits 1 second 
end 
seconds = 59--59 seconds left 
minutes = minutes - 1--1 minute left 
end 
info.Value = &quot;&quot; 
CheckPlayers()--Checks the amount of players if say you had 2 players and 1 leaves then this kicks in and stops the script from going on. 
end--ends the script section 


function ItCountDown()--Starts the countdown code 
local walls = game.Workspace:GetChildren() 
for i = 1,#walls do if walls[i].className == &quot;Part&quot; then walls[i].Transparency = 0.4 end end 
local minutes = 3 -- how many minutes it has to find everyone 
local seconds = 45 -- how many seconds it has to find everyone 
for i = 1, (minutes+1) do 
for i = 1, (seconds+1) do 
if seconds &lt; 10 then 
info.Value = minutes..&quot;:0&quot;..seconds..&quot; left for &apos;It&apos; to find players!&quot; 
else 
info.Value = minutes..&quot;:&quot;..seconds..&quot; left for &apos;It&apos; to find players!&quot; 
end 
seconds = seconds - 1 
if arrive == false then return end
wait(1) 
end 
seconds = 59 
minutes = minutes - 1 
end 
info.Value = &quot;Round Over&quot; 
start.Value = false 
wait(3) 
info.Value = &quot;&quot; 
if connection ~= nil then connection:disconnect() print(&quot;disconnected function...&quot;) end 
findAlive()--Starts new section of code 
end 

function Teleport_It()--This starts the teleport IT which means say the IT charcter is in the waiting area after selected time the it teleports to Map area to find players 
if it ~= nil then 
if it.Character ~= nil then 
if it.Character.Humanoid.Health &gt; 0 then 
local s = game.Lighting.ItScript:clone() 
s.Parent = it.Character 
s.owner.Value = it.Name 
if game.Lighting:findFirstChild(&quot;Trap[3]&quot;) ~= nil then
game.Lighting:findFirstChild(&quot;Trap[3]&quot;):clone().Parent = it.Backpack 
game.Lighting:findFirstChild(&quot;Sprint&quot;):clone().Parent = it.Backpack
end
local location = pickedMap.Spawns.ItSpawn 
it.Character.Torso.CFrame = CFrame.new(Vector3.new(location.Position.x,location.Position.y + 3,location.Position.z)) 
wait(0.2) 
end 
end 
c2 = ItCountDown() 
else 
info.Value = &quot;&apos;It&apos; left the game!&quot; 
wait(2) 
info.Value = &quot;Re-Starting game!&quot; 
wait(2) 
local list = game.Players:children() 
for i = 1, #list do 
if list[i].Character ~= nil then 
list[i].Character:BreakJoints()--Kills everyone 
list[i].Alive.Value = false 
end 
end 
CheckPlayers() 
end 
end 


function HideCountDown() 
start.Value = true 
playIt.Value = it --There was some discrepency on exactly where &quot;It&quot; came into play, so I hope this works 
local minutes = 1 -- how many minutes hiders have to hide 
local seconds = 30-- how many seconds hiders have to hide 
for i = 1, (minutes+1) do 
for i = 1, (seconds+1) do 
if seconds &lt; 10 then 
info.Value = minutes..&quot;:0&quot;..seconds..&quot; left to hide.&quot; 
else 
info.Value = minutes..&quot;:&quot;..seconds..&quot; left to hide.&quot; 
end 
seconds = seconds - 1 
if arrive == false then return end
wait(1) 
end 
seconds = 59 
minutes = minutes - 1 
end 
info.Value = &quot;Ready or not here &quot; ..it.Name.. &quot; comes!&quot; 
wait(2) 
Teleport_It() 
end 

function Choose_It() 
local list = game.Players:GetChildren() 
local f = 1 
local random = math.random(30,45) 
for i = 1, random do 
it = list[f] 
info.Value = &quot;Choosing to be It: &quot;..it.Name--Starts to choose the character that is Selected to be the IT 
f = f + 1 
if f &gt; #list then 
f = 1 
end 
wait(0.2) 
end 
info.Value = it.Name..&quot; has been chosen to be It!&quot; 
wait(4) 
arrive = true
Start() 
end 

function Start() 
local po = game.Workspace:GetChildren() 
for i = 1,#po do 
if po[i].Name == &quot;Trap&quot; or po[i].Name == &quot;It &quot; then--This gives the tools to the IT character EX:Trap 
po[i]:remove() 
end 
end 
local players = game.Players:GetChildren() 
local spawns = pickedMap.Spawns:GetChildren()--This picks the spawns for the list characters to spawn 
local d = 1 
for x = 1, #players do 
if players[x] ~= it then 
if players[x].Character ~= nil then 
if players[x].Character.Humanoid.Health &gt; 0 then--Kills players 
players[x].Alive.Value = true 
players[x].Character.Head.Transparency = 1--This makes your head invisible for being the players and not It 
info.Value = &quot;Preparing &quot;..players[x].Name 
local location = spawns[d] 
players[x].Character.Torso.CFrame = CFrame.new(Vector3.new(location.Position.x,location.Position.y + 3,location.Position.z)) 
wait(0.2) 
end 
end 
end 
d = d + 1 
if d &gt; #spawns then 
d = 1 
end 
end 
local walls = game.Workspace:GetChildren() 
for i = 1,#walls do if walls[i].className == &quot;Part&quot; then walls[i].Transparency = 0 end end 
connection = game.Players.ChildRemoved:connect(playerLeave)
print(&quot;Connection made: proceeding with schedule...&quot;)
info.Value = &quot;All Hiders Ready!&quot;--Hint appears on the screen saying All Hiders Ready! 
wait(2) 
info.Value = &quot;Everyone Go Hide!!!&quot;--Hint being Hiders, Start Hiding!!! 
wait(3) 
c1 = HideCountDown()--Ends the function--HideCountDown 
end 

function Choose_Level()--Starts the Function to choose the level/stage 
local pM = maps[math.random(1, #maps)]--math.random means that it will randomly select the map to be chosen. 
pickedMap = pM:clone()--If map picked the it clones() the map 
pickedMap.Parent = game.Workspace 
info.Value = &quot;Map Chosen: &quot;..pickedMap.Name--Makes a message saying map chosen with the maps name in the front 
wait(6) 
local time = 5 
for i = 1, time do 
info.Value = &quot;Choosing &apos;It&apos; in &quot;..time--Chooses the IT/tagges character in a certain amount of time being CountDownTime 
time = time - 1 
wait(1) 
end 
Choose_It()--Starts the Function to choose it 
end 

function CheckPlayers()--And agian it checks if there are enough players to continue 
if connection ~= nil then
connection:disconnect()
end
if game.Players.NumPlayers &lt; plyrs then 
info.Value = &quot;Not enough players&quot;--Displays a Hint saying not enough players 
wait(1) 
CheckPlayers() 
else 
info.Value = &quot;Enough Players!&quot;--Displays a hint saying Enough Players! 
wait(1.3) --XD what? So random... 
info.Value = &quot;Choosing Map...&quot;--hint 
wait(1) 
info.Value = &quot;Choosing Map..&quot;--hint 
wait(1) 
info.Value = &quot;Choosing Map.&quot;--hint 
wait(1) 
Choose_Level()--Ends function to choose the level 
end 
end 

wait(1) 
CheckPlayers()--Ends all
