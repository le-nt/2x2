								<string name="Name">Script</string>
								<ProtectedString name="Source">function T(hit)
if (hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil) and (hit.Parent:FindFirstChild(&quot;Torso&quot;) ~= nil) then
if (script.Disabled == false) and (script.Parent.Parent.TeleporterA2.Script.Disabled == false) then
script.Disabled = true
script.Parent.Parent.TeleporterA2.Script.Disabled = true
hit.Parent.Torso.CFrame = script.Parent.Parent.TeleporterA2.CFrame + Vector3.new(0, 10, 0)
wait(1)
script.Disabled = false
script.Parent.Parent.TeleporterA2.Script.Disabled = false
else
print(&quot;disabled&quot;)
end
end
end

