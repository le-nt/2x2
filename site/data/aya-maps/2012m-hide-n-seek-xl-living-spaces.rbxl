			<Item class="Script" referent="RBX1013">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local torso = script.Parent

function onT(hit)
if hit.Parent.Name ~= &quot;It&quot; then
local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
       if h ~= nil then
       local plyr = game.Players:findFirstChild(hit.Parent.Name)
              if plyr ~= nil then
              plyr.Character.Torso.Anchored = true
              wait(10)
              plyr.Character.Torso.Anchored = false
              end
       end
end
end

torso.Touched:connect(onT)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
