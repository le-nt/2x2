				<ProtectedString name="Source">--Version 2 1.02 I fixed some problems caused by the updates.
adminlist = {&quot;TwoShue&quot; ,  &quot;souldragon&quot; , &quot;Elucid&quot;}--Add in the names of the people you want to be able to use the command script here.
