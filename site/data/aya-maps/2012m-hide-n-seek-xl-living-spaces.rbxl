						<Item class="LocalScript" referent="RBX967">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">LocalScript</string>
								<ProtectedString name="Source">wait(2)

local player = game.Players.LocalPlayer
local view = script.Parent.Parent:findFirstChild(&quot;ViewIt&quot;)
local sight = nil

if player ~= nil then
&#9;print(&quot;Searching local databases...&quot;)
&#9;local cam = game.Workspace:GetChildren()
&#9;for i = 1,#cam do
&#9;&#9;local play = game.Players.LocalPlayer
&#9;&#9;if play ~= nil then
&#9;&#9;&#9;if cam[i].className == &quot;Camera&quot; or cam[i].className == &quot;Cam&quot;..game.Players.LocalPlayer.Character.Name then
&#9;&#9;&#9;&#9;if cam[i].CameraSubject == play.Character:findFirstChild(&quot;Humanoid&quot;) then
&#9;&#9;&#9;&#9;&#9;print(&quot;GUI has found camera for: &quot;..player.Name)
&#9;&#9;&#9;&#9;&#9;sight = cam[i]
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

print(&quot;Camera service complete. Begin routine schedule...&quot;)
while player ~= nil do
&#9;local gamestart = game.Workspace:findFirstChild(&quot;GameStarted&quot;)
&#9;local playerit = game.Workspace:findFirstChild(&quot;PlayerIt&quot;)
&#9;if view.Value == true then
&#9;&#9;if gamestart.Value == true and playerit.Value ~= nil then
&#9;&#9;&#9;script.Parent.Parent:findFirstChild(&quot;ItPicture&quot;).Image = &quot;rbxasset://../../../shareddata/assets/&amp;y=100&amp;Format=Png&amp;username=&quot;..playerit.Value.Name
&#9;&#9;&#9;local human = playerit.Value
&#9;&#9;&#9;if human ~= nil then
&#9;&#9;&#9;&#9;local humanoid = human.Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;&#9;if humanoid ~= nil and sight ~= nil then
&#9;&#9;&#9;&#9;&#9;sight.CameraSubject = humanoid
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;script.Parent.Parent:findFirstChild(&quot;ItPicture&quot;).Image = &quot;rbxasset://../../../shareddata/assets/18803041&quot;
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.Parent:findFirstChild(&quot;ItPicture&quot;).Image = &quot;rbxasset://../../../shareddata/assets/&amp;y=100&amp;Format=Png&amp;username=&quot;..player.Name
&#9;&#9;if sight ~= nil then
&#9;&#9;&#9;sight.CameraSubject = player.Character:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;end
&#9;end
&#9;wait(0.5)
&#9;local itL = script.Parent.Parent:findFirstChild(&quot;ItLabel&quot;)
&#9;local it = game.Workspace:findFirstChild(&quot;PlayerIt&quot;).Value
&#9;if gamestart ~= nil and gamestart.Value == false then
&#9;&#9;script.Parent.Text = &quot;The game has not started yet.&quot;
&#9;&#9;itL.Text = &quot;&quot;
&#9;else
&#9;&#9;if player == it then
&#9;&#9;&#9;script.Parent.Text = &quot;You&apos;re it! Go get &apos;em! &gt;:D&quot;
&#9;&#9;&#9;itL.Text = &quot;&quot;
&#9;&#9;else
&#9;&#9;&#9;if it ~= nil and it.Character ~= nil and it.Character:findFirstChild(&quot;Head&quot;) ~= nil then
&#9;&#9;&#9;&#9;local dist = (player.Character.Head.Position-it.Character.Head.Position).magnitude
&#9;&#9;&#9;&#9;local distdown = (dist)-(dist%0.01)
&#9;&#9;&#9;&#9;local distup = (dist)-(dist%-0.01)
&#9;&#9;&#9;&#9;if (dist-distdown) &lt; (distup-dist) then
&#9;&#9;&#9;&#9;&#9;script.Parent.Text = &quot;&apos;It&apos; is &quot;..distdown..&quot; studs away.&quot;
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;script.Parent.Text = &quot;&apos;It&apos; is &quot;..distup..&quot; studs away.&quot;
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;itL.Text = it.Name..&quot; is &apos;It&apos;!&quot;
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;script.Parent.Text = &quot;&quot;
&#9;&#9;&#9;&#9;itL.Text = &quot;&apos;It&apos; has left the game...&quot;
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

</ProtectedString>
							</Properties>
						</Item>
