				<ProtectedString name="Source">function onDied(p, h)
p.Alive.Value = false
end

function onChanged(p, h)
h.Died:connect(function() onDied(p, h) end)
end

function onEnt(plyr)
local stats = Instance.new(&quot;IntValue&quot;)
stats.Parent = plyr
stats.Name = &quot;leaderstats&quot;
local points = Instance.new(&quot;IntValue&quot;)
points.Name = &quot;Points&quot;
points.Value = 0
points.Parent = stats
local alive = Instance.new(&quot;BoolValue&quot;)
alive.Name = &quot;Alive&quot;
alive.Value = false
alive.Parent = plyr
while true do
       if plyr.Character ~= nil then break end
       wait(2)
end
local human = plyr.Character.Humanoid
human.Died:connect(function() onDied(plyr, human) end)
plyr.Character.Changed:connect(function() onChanged(plyr, human) end)
end

game.Players.ChildAdded:connect(onEnt)

--This is just the leaderboard shows the points and that.
</ProtectedString>
