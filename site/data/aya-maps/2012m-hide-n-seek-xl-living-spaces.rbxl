		<Item class="Script" referent="RBX957">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Ash135&apos;s Stat Badge Awarder Script</string>
				<ProtectedString name="Source">--Molt Co--
--This Will Work For Any Stat!!!
local BadgeID =  22771160--Badge ID Here
local Cash = &quot;Points&quot;  --Change Money To The Stat
local HowMuch = 1000 --Change To How Much They Need To Have
game.Players.PlayerAdded:connect(function(p) 
repeat wait() until p:findFirstChild(&quot;leaderstats&quot;) ~= nil 
p.leaderstats[Cash].Changed:connect(function() 
if p.leaderstats[Cash].Value &lt;= HowMuch - 1 then return end 
game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId, BadgeID) 
end) 
end) 
--Molt Co--</ProtectedString>
			</Properties>
		</Item>
