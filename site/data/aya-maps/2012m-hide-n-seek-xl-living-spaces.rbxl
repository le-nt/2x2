						<bool name="Looped">false</bool>
						<string name="Name">Sound</string>
						<float name="Pitch">1</float>
						<bool name="PlayOnRemove">false</bool>
						<Content name="SoundId"><url>rbxasset://../../../shareddata/assets/16921198</url></Content>
						<float name="Volume">0.5</float>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX17261">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">TeddyScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true



s1 = Instance.new(&quot;Sound&quot;)
s1.SoundId = &quot;rbxasset://../../../shareddata/assets/16921115&quot;
s1.Parent = Tool.Handle

s2 = Instance.new(&quot;Sound&quot;)
s2.SoundId = &quot;rbxasset://../../../shareddata/assets/16921154&quot;
s2.Parent = Tool.Handle

s3 = Instance.new(&quot;Sound&quot;)
s3.SoundId = &quot;rbxasset://../../../shareddata/assets/16921173&quot;
s3.Parent = Tool.Handle

s4 = Instance.new(&quot;Sound&quot;)
s4.SoundId = &quot;rbxasset://../../../shareddata/assets/16921198&quot;
s4.Parent = Tool.Handle

local sayings = {s1,s2,s3,s4}


function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;
&#9;Tool.GripForward = Vector3.new(-0, -1, -0)
&#9;Tool.GripPos = Vector3.new(-2, -0.6, -0)
&#9;Tool.GripRight = Vector3.new(-1, 0, -0)
&#9;Tool.GripUp = Vector3.new(-0, 0, 1)

&#9;sayings[math.random(1,#sayings)]:Play()
&#9;wait(2)

&#9;Tool.GripForward = Vector3.new(-0, 1, 0)
&#9;Tool.GripPos = Vector3.new(0, -0.3, -0.2)
&#9;Tool.GripRight = Vector3.new(1, 0, 0)
&#9;Tool.GripUp = Vector3.new(0, -0, 1)

&#9;
&#9;enabled = true

end

function onEquipped()
&#9;for i=1,#sayings do
&#9;&#9;sayings[i].Volume = 1
&#9;end
end

function onUnequipped()
&#9;for i=1,#sayings do
&#9;&#9;sayings[i].Volume = 0
&#9;end
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX17262">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">View It</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="Script" referent="RBX17263">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onButton1Down(mouse)
local w = game.Workspace:getChildren()
for i = 1, #w do
if (w[i].className == &quot;Camera&quot;) or (w[i].className == &quot;Cam&quot; .. game.Players.LocalPlayer.Character.Name) then
if w[i].CameraSubject == game.Players.LocalPlayer.Character.Humanoid then
if game.Workspace:findFirstChild(&quot;It&quot;) ~= nil then
w[i].CameraSubject = game.Workspace:findFirstChild(&quot;It&quot;).Humanoid
end
w[i].Name = &quot;Cam&quot; .. game.Players.LocalPlayer.Character.Name
else w[i].CameraSubject = game.Players.LocalPlayer.Character.Humanoid
end
end
end
end


function onSelected(mouse) 
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end 

script.Parent.Selected:connect(onSelected)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="HopperBin" referent="RBX17264">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Spectator</string>
				<Content name="TextureId"><null></null></Content>
			</Properties>
			<Item class="LocalScript" referent="RBX17265">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">camera = game.Workspace.CurrentCamera
player = game.Players.LocalPlayer
bin = script.Parent
others = {}
num = 0

function moveit(human)
if human.className == &quot;Humanoid&quot; then
camera.CameraSubject = human
end
end

function onKeyDown(key)
key = key:lower()

if key == &quot;q&quot; or key == &quot;e&quot; then
if key == &quot;q&quot; then
num = num + 1
if num &gt; #others then
num = 1
end
if num == 0 then
num = #others
end
end

if key == &quot;e&quot; then
num = num - 1
if num &gt; #others then
num = 1
end
if num &lt;= 0 then
num = #others
end
end

humanoid = others[num].Character.Humanoid
moveit(humanoid)
end
end

function onSelected(mouse)
others = game.Players:getChildren()
mouse.KeyDown:connect(onKeyDown)
end

function onDeselected()
camera.CameraSubject = player.Character.Humanoid
others = {}
end

script.Parent.Selected:connect(onSelected)
script.Parent.Deselected:connect(onDeselected)</ProtectedString>
				</Properties>
			</Item>
