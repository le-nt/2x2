				<string name="Name">ItScript</string>
				<ProtectedString name="Source">local torso = script.Parent.Torso

function onT(hit)
local h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
       if h ~= nil then
       local plyr = game.Players:findFirstChild(hit.Parent.Name)
              if plyr ~= nil then
              local owner = game.Players:findFirstChild(script.owner.Value)
                         if owner ~= nil then
                         owner.leaderstats.Points.Value = owner.leaderstats.Points.Value + 4
                         end
              plyr.Character:BreakJoints()
              end
       end
end

torso.Touched:connect(onT)
</ProtectedString>
