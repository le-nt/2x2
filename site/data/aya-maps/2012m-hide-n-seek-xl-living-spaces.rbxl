					<string name="Name">TeddyScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true



s1 = Instance.new(&quot;Sound&quot;)
s1.SoundId = &quot;c4b67ed6de0eee7f13bf2c7b37a1d10c&quot;
s1.Parent = Tool.Handle

s2 = Instance.new(&quot;Sound&quot;)
s2.SoundId = &quot;rbxasset://../../../shareddata/assets/1387390&quot;
s2.Parent = Tool.Handle

s3 = Instance.new(&quot;Sound&quot;)
s3.SoundId = &quot;rbxasset://../../../shareddata/assets/2767085&quot;
s3.Parent = Tool.Handle

s4 = Instance.new(&quot;Sound&quot;)
s4.SoundId = &quot;rbxasset://../../../shareddata/assets/12803507&quot;
s4.Parent = Tool.Handle

s5 = Instance.new(&quot;Sound&quot;)
s5.SoundId = &quot;bbc8ccebbae87139f46c30acb71cce88&quot;
s5.Parent = Tool.Handle

s6 = Instance.new(&quot;Sound&quot;)
s6.SoundId = &quot;ae661659818dff307a9cca37d6196077&quot;
s6.Parent = Tool.Handle

s7 = Instance.new(&quot;Sound&quot;)
s7.SoundId = &quot;d767937563eb0c3c4d00f21ccd88855e&quot;
s7.Parent = Tool.Handle

s8 = Instance.new(&quot;Sound&quot;)
s8.SoundId = &quot;rbxasset://../../../shareddata/assets/15174422&quot;
s8.Parent = Tool.Handle

local sayings = {s1,s2,s3,s4,s5,s6,s7,s8}


function onActivated()
&#9;if not enabled  then
&#9;&#9;return
&#9;end

&#9;enabled = false
&#9;
&#9;Tool.GripForward = Vector3.new(1,0,0)
&#9;Tool.GripPos = Vector3.new(.5,-1.5,-1.56)
&#9;Tool.GripRight = Vector3.new(0,-.707,-.707)
&#9;Tool.GripUp = Vector3.new(0,-.707,.707)

&#9;sayings[math.random(1,#sayings)]:Play()
&#9;wait(2)

&#9;Tool.GripForward = Vector3.new(-1,0,0)
&#9;Tool.GripPos = Vector3.new(0,0,-.4)
&#9;Tool.GripRight = Vector3.new(0,1,0)
&#9;Tool.GripUp = Vector3.new(0,0,1)

&#9;
&#9;enabled = true

end

function onEquipped()
&#9;for i=1,#sayings do
&#9;&#9;sayings[i].Volume = 1
&#9;end
end

function onUnequipped()
&#9;for i=1,#sayings do
&#9;&#9;sayings[i].Volume = 0
&#9;end
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
</ProtectedString>
