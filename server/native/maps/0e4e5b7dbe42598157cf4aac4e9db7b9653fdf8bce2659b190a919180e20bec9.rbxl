						<string name="Source">local membership = script.Parent.Type.Value
local BCsayings = {
	&quot;lol ur a noob becaus u don&apos;t hav bc&quot;,
	&quot;bui bc u nbcr&quot;,
	&quot;bc places r awwsoume&quot;,
