						<string name="Source">-- this script removes its parent from the workspace after 24 seconds

while true do
wait(5)
if script.Parent.Name == &quot;Sniper&quot; then return end -- so the tool itelf isn&apos;t removed
script.Parent:Remove()
end </string>
