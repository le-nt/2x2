	&quot;Buy Builder&apos;s Club.&quot;,
	&quot;BC Only places are free from the likes of you.&quot;,
	&quot;You are an NBCer, so therefore you&apos;re a noob.&quot;,
	&quot;You are stupid.&quot;,
	&quot;Buy BC and I won&apos;t kill you.&quot;,
	&quot;Buy BC and maybe I&apos;ll friend you...&quot;,
	&quot;The number of limiteds I have exceeds your IQ.&quot;,
	&quot;I am much more skilled than you.&quot;,
	&quot;Stop running, I&apos;m doing you a favor.&quot;,
	&quot;Do everyone a favor and leave the server immediately.&quot;,
	&quot;We don&apos;t need noobs like you filling this server.&quot;,
	&quot;You&apos;re just going to die tired.&quot;,
	&quot;Oh you sad, strange little thing.&quot;,
	&quot;Telamon is my rolemodel.&quot;
}
local OBCsayings = {
	&quot;I Am The Uber Noob Killer&quot;,
	&quot;Buy OBC This Is A Threat&quot;,
	&quot;Having 100 Places Is A Very Cool Perk That Is Not Overkill&quot;,
	&quot;You Are A No Builders Cluber&quot;,
	&quot;You Are Stupid&quot;,
	&quot;Buy OBC Or Die&quot;,
	&quot;I Already Filled Up My Friend&apos;s List Noob&quot;,
	&quot;I Have Every Limited Known To Robloxian&quot;,
	&quot;I Have Much Swag&quot;,
	&quot;You Cannot Hide Coward&quot;,
	&quot;You Are Dumb For Not Having OBC&quot;,
