<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Workspace" referent="RBX0">
		<Properties>
			<Ref name="CurrentCamera">RBX1</Ref>
			<double name="DistributedGameTime">0</double>
			<CoordinateFrame name="ModelInPrimary">
				<X>0</X>
				<Y>0</Y>
				<Z>0</Z>
				<R00>1</R00>
				<R01>0</R01>
				<R02>0</R02>
				<R10>0</R10>
				<R11>1</R11>
				<R12>0</R12>
				<R20>0</R20>
				<R21>0</R21>
				<R22>1</R22>
			</CoordinateFrame>
			<string name="Name">Workspace</string>
			<Ref name="PrimaryPart">null</Ref>
			<bool name="archivable">true</bool>
		</Properties>
		<Item class="Script" referent="RBX2">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Game</string>
				<string name="Source">--made by jozuno
print(&quot;Survive the BCers Revamped: Version&quot;,script.Version.Value)
math.randomseed(tick()) --for randomness. only really matters if running on ORRH though because it handles RNG differently

--#-------- Variables --------#--
map_list = {}
survivors = {}
TBA = game.Lighting.Maps:GetChildren() -- gets the children of the Maps model to add to the above list
activegame = false
currentplayersalive = 0
lastmap = nil

--#-------- BTS Stuff --------#--

for i, v in pairs(TBA) do -- make a list of maps automatically so i don&apos;t need to edit a list every time
	if v:IsA(&quot;Model&quot;) then
		table.insert(map_list,v)
	end
end

function showmessage(msg) --edit or create a new message with the text given and put it in workspace
	if game.Workspace:FindFirstChild(&quot;GameMessage&quot;) then
		game.Workspace.GameMessage.Text = msg
	else
		local message = Instance.new(&quot;Message&quot;)
		message.Name = &quot;GameMessage&quot;
		message.Text = msg
		message.Parent = game.Workspace
	end
end

function hidemessages() --go through everything in the workspace and delete it if it&apos;s a message
	if game.Workspace:FindFirstChild(&quot;GameMessage&quot;) then
		game.Workspace.GameMessage:Remove()
	end
end

function showhint(msg) --edit or create a new hint with the text given and put it in workspace
	if game.Workspace:FindFirstChild(&quot;GameHint&quot;) then
		game.Workspace.GameHint.Text = msg
	else
		local message = Instance.new(&quot;Hint&quot;)
		message.Name = &quot;GameHint&quot;
		message.Text = msg
		message.Parent = game.Workspace
	end
end

function hidehints() --go through everything in the workspace and delete it if it&apos;s a hint
	if game.Workspace:FindFirstChild(&quot;GameHint&quot;) then
		game.Workspace.GameHint:Remove()
	end
end

function countdown(msg,time)	-- count down for the time given to the function, play announcer sounds if we&apos;re in a game
	for i=1,time do
		showhint(msg..time-i+1)
		wait(1)
	end
	hidehints()
end

function randompos()
	local x = math.random(-86,86)
	local z = math.random(-86,86)
	return Vector3.new(x,80,z)
end

function cleanup()
	BCModel:Remove()
	m:Remove()
	hidehints()
	game.Workspace.Base.BrickColor = game.Lighting.DefaultBaseColor.Value
end

function countdownsound(timeleft)
	if timeleft == 5 then
		game.Lighting.Sounds.Countdown.Announce_5:Play()
	end
	if timeleft == 4 then
		game.Lighting.Sounds.Countdown.Announce_4:Play()
	end
	if timeleft == 3 then
		game.Lighting.Sounds.Countdown.Announce_3:Play()
	end
	if timeleft == 2 then
		game.Lighting.Sounds.Countdown.Announce_2:Play()
	end
	if timeleft == 1 then
		game.Lighting.Sounds.Countdown.Announce_1:Play()
	end
end
--#-------- Round Functions --------#--

function loadmap()  --choose a random map from the list, announce it and then clone it
	showmessage(&quot;Choosing Map...&quot;)
	wait(2)
	local mapchosen = nil
	if #map_list &gt; 1 then
		repeat
			mapchosen = map_list[math.random(#map_list)]
		until mapchosen ~= lastmap
	else
		mapchosen = map_list[math.random(#map_list)]
	end
	m = mapchosen:clone()
	showmessage(&quot;Map Chosen: &quot; .. m.Name)
	m.Parent = game.Workspace
	m:makeJoints()
	game.Workspace.Base.BrickColor = m.BaseColor.Value
	lastmap = mapchosen
	wait(2)
	hidemessages()
end

function BCerroutine(timeleft)
	local roundpercent =  1 - (timeleft / script.RoundTime.Value)
	local randomnumber = math.random(1,100)
	clubber_type = nil
	if roundpercent &lt; 0.5 then
		if randomnumber &lt;= 50 then --50%
			clubber_type = 1
		end
		if randomnumber &gt; 50 and randomnumber &lt;= 88 then --38%
			clubber_type = 2
		end
		if randomnumber &gt; 88 then --12%
			clubber_type = 3
		end
	end
	if roundpercent &gt;= 0.5 and roundpercent &lt; .75 then
		if randomnumber &lt;= 50 then --50%
			clubber_type = 1
		end
		if randomnumber &gt; 50 and randomnumber &lt;= 75 then --25%
			clubber_type = 2
		end
		if randomnumber &gt; 75 then --25%
			clubber_type = 3
		end
	end
	if roundpercent &gt;= 0.75  then
		local randomnumber2 = math.random(1,3) -- equal chance
		if randomnumber2 == 1 then
			clubber_type = 1
		end
		if randomnumber2 == 2 then 
			clubber_type = 2
		end
		if randomnumber2 == 3 then
			clubber_type = 3
		end
	end
	spawnBCer(clubber_type)
end

function spawnBCer(type)
	local zombie = game.Lighting.Clubbers.Base:Clone()
	zombie.Parent = game.Workspace.ToRemove
	zombie:MakeJoints()
	local humanoid = Instance.new(&quot;Humanoid&quot;)
	humanoid.Name = &quot;Zombie&quot;
	humanoid.Parent = zombie
	local stuff = nil

	if type == 1 then
		zombie.Name = &quot;BC&quot;
		humanoid.MaxHealth = 50
		humanoid.Health = 50
		humanoid.WalkSpeed = 15
		stuff = game.Lighting.Clubbers.BC:GetChildren()
		for i,v in pairs(stuff) do
			local thingtoclone = v:clone()
			thingtoclone.Parent = zombie
		end
	end
	if type == 2 then
		zombie.Name = &quot;TBC&quot;
		humanoid.MaxHealth = 25
		humanoid.Health = 25
		humanoid.WalkSpeed = 18
		stuff = game.Lighting.Clubbers.TBC:GetChildren()
		for i,v in pairs(stuff) do
			local thingtoclone = v:clone()
			thingtoclone.Parent = zombie
		end
		zombie.Head.face.Texture = &quot;rbxasset://../../../shareddata/SBCR/7076053&quot;
		zombie.Handle.Mesh.TextureId = &quot;rbxasset://../../../shareddata/charcustom/hats/textures/hardhat_tbc.png&quot;
	end
	if type == 3 then
		zombie.Name = &quot;OBC&quot;
		humanoid.MaxHealth = 100
		humanoid.Health = 100
		humanoid.WalkSpeed = 12
		stuff = game.Lighting.Clubbers.OBC:GetChildren()
		for i,v in pairs(stuff) do
			local thingtoclone = v:clone()
			thingtoclone.Parent = zombie
		end
		zombie.Head.face.Texture = &quot;rbxasset://../../../shareddata/charcustom/faces/ItsGoTime.png&quot;
		zombie.Handle.Mesh.TextureId = &quot;rbxasset://../../../shareddata/charcustom/hats/textures/hardhat_obc.png&quot;
	end
	local scripts = game.Lighting.Clubbers.Scripts:GetChildren()
	for i,v in pairs(scripts) do
		local scripttoclone = v:clone()
		scripttoclone.Parent = zombie
	end

	local newPos = nil
	if m:FindFirstChild(&quot;BCSpawns&quot;) ~= nil then
		local BCSpawns = m.BCSpawns:GetChildren()
		local chosenSpawn = BCSpawns[math.random(1,#BCSpawns)]
		local size = chosenSpawn.Size
		newPos = chosenSpawn.Position + Vector3.new(math.random(size.x/-2,size.x/2),0,math.random(size.z/-2,size.z/2))
	else
		newPos =  randompos()
	end
	
	zombie.Torso.CFrame = CFrame.new(newPos)
	script.CurrentBCCount.Value = script.CurrentBCCount.Value + 1
end

function countsurvivors()
	if game.Players:GetChildren() ~= nil then
		for i, v in pairs(game.Players:GetChildren()) do
			if v ~= nil then
				if v.Survived.Value == true then
					table.insert(survivors,v) 
					v.Character:BreakJoints()
				end
			end
		end
	end
end

function rewardsurvivors()
	local multiplier = #activeplayers
	if multiplier &gt; 8 then
		multiplier = 8
	end
	points = math.ceil(script.PointToGive.Value/#survivors)*multiplier
	if game.Players:GetChildren() ~= nil then
		for i, v in pairs(game.Players:GetChildren()) do
			if v ~= nil then
				if v.Survived.Value == true then
					v.leaderstats.Points.Value = v.leaderstats.Points.Value + points
					v.leaderstats.Survivals.Value = v.leaderstats.Survivals.Value + 1
				end
			end
		end
	end
end

function nameplayers()
	local names = &quot;&quot;
	if #survivors == 1 then 
		return survivors[1].Name
	end
	for i=1, #survivors do
		if i == 1 then
			names = survivors[1].Name
		else
			if i == #survivors then
				names = names..&quot;, and &quot;..survivors[i].Name
			else
				names = names..&quot;, &quot;..survivors[i].Name
			end
		end
	end
	return names
end

function spawnplayer(player) --spawns a player in at an available spawn. cycles through each spawn until it loops, where it then adds +8 to the next player&apos;s position
	local spawns = m.Spawns:GetChildren()
	local currentspawn = spawns[spawnno]
	player.Character.Torso.CFrame = CFrame.new(Vector3.new(currentspawn.Position.x,currentspawn.Position.y + 8*loopcount,currentspawn.Position.z))
	if spawnno == #spawns then
		spawnno = 1
		loopcount = loopcount + 1
	else
		spawnno = spawnno + 1
	end
end

function giveItems(player) -- gives the player the items they bought
	local toolsmodel = game.Lighting.Tools
	local sword = toolsmodel.Sword:clone()
	sword.Parent = player.Backpack
	local pistol = toolsmodel.Pistol:clone()
	pistol.Parent = player.Backpack

	if player.itemslist.Rifle.Value == true then
		local rifle = toolsmodel.Rifle:clone()
		rifle.Parent = player.Backpack
	end

	if player.itemslist.Shotgun.Value == true then
		local shotgun = toolsmodel.Shotgun:clone()
		shotgun.Parent = player.Backpack
	end

	if player.itemslist.Sniper.Value == true then
		local sniper = toolsmodel.Sniper:clone()
		sniper.Parent = player.Backpack
	end
	
	if player.itemslist.Medkit.Value == true then
		local medkit = toolsmodel.MedKit:clone()
		medkit.Parent = player.Backpack
	end
end

--#-------- Round Processing --------#--

function startround()
	activegame = true
	activeplayers = game.Players:GetChildren()
	BCModel = Instance.new(&quot;Model&quot;)
	BCModel.Name = &quot;ToRemove&quot;
	BCModel.Parent = game.Workspace
	loadmap()
	spawnno = 1
	loopcount = 0
	if activeplayers ~= nil then
		for i, v in pairs(activeplayers) do
			if v ~= nil then -- for every active, existing player
				if v.Playing.Value == true then
					if v.Character.Humanoid.Health ~= 0 then
						currentplayersalive = currentplayersalive + 1
						v.Character.Humanoid.Died:connect(function ()
							v.Survived.Value = false
							currentplayersalive = currentplayersalive - 1
						end)
						--v.Character.Torso.CFrame = CFrame.new(randompos())
						spawnplayer(v)
						giveItems(v)
						v.Survived.Value = true
					else
						v.Survived.Value = false
					end
				end
			end
		end
	end
	if currentplayersalive &lt; 1 then
		activegame = false
		showmessage(&quot;No players to torment! Skipping round.&quot;)
		cleanup()
		wait(2)
		hidemessages()
		return
	end
	showmessage(&quot;Survive until the end!&quot;)
	wait(2)
	showmessage(&quot;Points will be distributed amongst all winners, and you get points for BCer kills.&quot;)
	wait(2)
	showmessage(&quot;Ready?&quot;)
	game.Lighting.Sounds.Announce_Ready:Play()
	wait(1.5)
	showmessage(&quot;GO!&quot;)
	game.Lighting.Sounds.Announce_Go:Play()
	wait(1)
	hidemessages()
end

function round()
	local timeleft = script.RoundTime.Value
	local maxBC = script.MaxBCersPerPlayer.Value * currentplayersalive -- difficulty scaler
	if maxBC &gt; 30 then
		maxBC = 30
	end
	while timeleft &gt; 0 do
		showhint(&quot;Time Until Round End: &quot;..timeleft)
		if #activeplayers &gt; 6 then
			if math.random(1,4) ~= 1 and script.CurrentBCCount.Value &lt; maxBC then --80% chance
				BCerroutine(timeleft)
			end
		else
			if math.random(1,3) ~= 1 and script.CurrentBCCount.Value &lt; maxBC then --66% chance
				BCerroutine(timeleft)
			end
		end
		wait(1)
		timeleft = timeleft - 1
		if currentplayersalive &lt; 1 then
			break
		end
	countdownsound(timeleft)
	end
end

function endround()
	activegame = false
	cleanup()
	if currentplayersalive &gt; 0 then
		showmessage(&quot;Time!&quot;)
		game.Lighting.Sounds.Announce_Time:Play()
	else
		showmessage(&quot;Game!&quot;)
		game.Lighting.Sounds.Announce_Game:Play()
	end
	wait(2)
	countsurvivors()
	if #survivors ~= 0 then
		showmessage(&quot;Survivors: &quot;.. nameplayers())
		rewardsurvivors()
		game.Lighting.Sounds.Announce_Success:Play()
		wait(2)
		showmessage(points.. &quot; points given to the survivor(s)!&quot;)
	else
		showmessage(&quot;No one survived!&quot;)
		game.Lighting.Sounds.Announce_Failure:Play()
	end
	wait(2)
	hidemessages()
end

while true do --main game loop
	survivors = {}
	script.CurrentBCCount.Value = 0
	currentplayersalive = 0
	countdown(&quot;Seconds Until Game Start: &quot;,script.IntTime.Value)
	startround()
	if activegame == true then
		round()
		endround()
	end
end
