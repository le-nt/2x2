							<string name="Name">lava</string>
							<string name="Source">function onTouched(part)
	--if part.Locked ~= true then
		part.BrickColor = BrickColor.new(26)
		wait(.3)
		part.Transparency = .2
		wait(.1)
		part.Transparency = .4
		wait(.1)
		part.Transparency = .6
		wait(.1)
		part.Transparency = .8
		wait(.1)
		part:Remove()
	--end
end

script.Parent.Touched:connect(onTouched)
</string>
