	&quot;You Will Die&quot;,
	&quot;You&apos;re Pretty Fast For A Puffball&quot;, -- Ahhh, who needs you, Splodge?
	&quot;I Idolize Moderators&quot;,
	&quot;Please Leave My Mom Checks My ROBLOX Account&quot;
}
local selectedsayings = nil
if membership == &quot;BC&quot; then
	selectedsayings = BCsayings
end
if membership == &quot;TBC&quot; then
	selectedsayings = TBCsayings
end
if membership == &quot;OBC&quot; then
	selectedsayings = OBCsayings
end
while true do
	script.Parent.Name = membership..&quot;er: &quot;..selectedsayings[math.random(1,#selectedsayings)]
	wait(math.random(2,4))
end
