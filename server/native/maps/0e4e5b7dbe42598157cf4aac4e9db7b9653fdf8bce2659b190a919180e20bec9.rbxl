							<Item class="Script" referent="RBX168">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">local debounce = false
local price = 360

function buy(hit)
	if debounce == false then
		debounce = true
		if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
			local player = game.Players:GetPlayerFromCharacter(hit.Parent)
			local notif = Instance.new(&quot;Hint&quot;)
			notif.Name = &quot;Notification&quot;
			if player.itemslist.Shotgun.Value == false then
				if player.leaderstats.Points.Value &gt;= price then
					player.itemslist.Shotgun.Value = true
					player.leaderstats.Points.Value = player.leaderstats.Points.Value - price
					notif.Text = &quot;Bought the Shotgun! It will be added to your backpack on the next round start.&quot;
					script.Parent.BrickColor = BrickColor.new(37)
				else
					notif.Text = &quot;Not enough points!&quot;
					script.Parent.BrickColor = BrickColor.new(21)
				end
				notif.Parent = player
			else
				notif.Text = &quot;You already own this!&quot;
				notif.Parent = player
				script.Parent.BrickColor = BrickColor.new(21)
			end
			wait(4)
			if player:FindFirstChild(&quot;Notification&quot;) then
				player.Notification:Remove()
			end
			debounce = false
			script.Parent.BrickColor = BrickColor.new(23)
		end
	end
end

script.Parent.Touched:connect(buy)
script.Parent.Parent.Name = script.Parent.Parent.Name..&quot; (&quot;..price..&quot; P)&quot;</string>
									<bool name="archivable">true</bool>
								</Properties>
