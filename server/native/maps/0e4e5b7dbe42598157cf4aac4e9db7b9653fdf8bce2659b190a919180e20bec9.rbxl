			<Item class="TextButton" referent="RBX1544">
				<Properties>
					<bool name="AutoButtonColor">true</bool>
					<int name="BackgroundColor">21</int>
					<int name="BorderColor">1003</int>
					<string name="Name">AFKToggle</string>
					<UDim2 name="Position">
						<XS>0</XS>
						<XO>0</XO>
						<YS>0</YS>
						<YO>390</YO>
					</UDim2>
					<UDim2 name="Size">
						<XS>0</XS>
						<XO>100</XO>
						<YS>0</YS>
						<YO>20</YO>
					</UDim2>
					<string name="Text">Toggle AFK Mode</string>
					<int name="TextColor">1003</int>
					<float name="Transparency">0</float>
					<bool name="Visible">true</bool>
					<bool name="archivable">true</bool>
