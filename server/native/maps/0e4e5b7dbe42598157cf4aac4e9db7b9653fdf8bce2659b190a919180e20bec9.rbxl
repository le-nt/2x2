				<Item class="Script" referent="RBX1545">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local debounce = false

function onButtonClicked()
	player = script.Parent.Parent.Parent.Parent
	if player ~= nil then 
		if debounce == false then
			debounce = true	
			local notif = Instance.new(&quot;Message&quot;)
			notif.Text = &quot;AFK MODE ON&quot;
			notif.Name = &quot;AFKMessage&quot;
			if player.Playing ~= nil then
				if player.Playing.Value == true then
					player.Playing.Value = false
					notif.Parent = player
					script.Parent.BackgroundColor = BrickColor.new(37)
				else
					player.Playing.Value = true
					player.AFKMessage:Remove()
					script.Parent.BackgroundColor = BrickColor.new(21)
				end
			end
			wait(.1)
			debounce = false
		end
	end
end


script.Parent.MouseButton1Click:connect(onButtonClicked)</string>
