						<string name="Source">Tool = script.Parent

function createmedkit(v)
	local medkit = Tool.Handle:clone()
	local healscript= Tool.Heal:clone()
	healscript.Parent = medkit
	Tool.Handle.Transparency = 1
	Tool.Handle.Decal:Remove()
	medkit.Position = Tool.Handle.Position + (v*4)
	medkit.Velocity = v * 5
	medkit.CanCollide = true
	medkit.Name = &quot;Medkit&quot;
	medkit.Parent = game.Workspace.ToRemove
end

Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then
		return
	end
	Tool.Enabled = false

	local character =  Tool.Parent
	local humanoid = character.Humanoid
	if humanoid == nil then
		return
	end

	local targetPos = humanoid.TargetPoint
	local lookAt = (targetPos - character.Head.Position).unit

	if game.Workspace:FindFirstChild(&quot;ToRemove&quot;) then
		createmedkit(lookAt)
	end
	Tool:Remove()
end


