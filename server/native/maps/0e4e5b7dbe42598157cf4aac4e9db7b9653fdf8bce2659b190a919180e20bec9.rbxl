							<Item class="Script" referent="RBX285">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">Script</string>
									<string name="Source">local debounce = false

function toggleAFK(hit)
	if debounce == false then
		debounce = true
		if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
			hit.Parent.Torso.CFrame = CFrame.new(game.Workspace.Lobby.ShopStuff.shoptpdest.Position)
		end
		wait(2)
		debounce = false
	end
end

script.Parent.Touched:connect(toggleAFK)</string>
