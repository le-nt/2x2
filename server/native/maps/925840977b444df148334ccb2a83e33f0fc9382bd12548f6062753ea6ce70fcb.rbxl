					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">BurgerScript</string>
					<ProtectedString name="Source">function ontouch(part)
	if part.Name == &quot;Buns&quot; then
		if script.Parent.Parent.Name == &quot;Bun with patty and cheese and lettuce&quot; then
			local model = script.Parent.Parent
			part.Parent = model
			model.Name = &quot;Cheeseburger&quot;
			local weld = Instance.new(&quot;Weld&quot;)
			weld.Part0 = model:FindFirstChild(&quot;Buns&quot;)
			weld.Part1 = part
			weld.C0 = model:FindFirstChild(&quot;Buns&quot;).CFrame:inverse()
			weld.C1 = part.CFrame:inverse()
			weld.Parent = model
			for i, v in pairs(model:GetChildren()) do
				if v:FindFirstChild(&quot;BurgerScript&quot;) then
					v.BurgerScript.Parent = nil
				end
			end
		end
	end

	if part.Name == &quot;Buns&quot; then
		if script.Parent == nil then return end
		if script.Parent.Parent == nil then return end
		if script.Parent.Parent.Name == &quot;Bun with patty and lettuce&quot; then
			local model = script.Parent.Parent
				part.Parent = model
				model.Name = &quot;Burger&quot;
				local weld = Instance.new(&quot;Weld&quot;)
				weld.Part0 = model:FindFirstChild(&quot;Buns&quot;)
				weld.Part1 = part
				weld.C0 = model:FindFirstChild(&quot;Buns&quot;).CFrame:inverse()
				weld.C1 = part.CFrame:inverse()
				weld.Parent = model
				for i, v in pairs(model:GetChildren()) do
					if v:FindFirstChild(&quot;BurgerScript&quot;) then
						print(&quot;found burgerscript&quot;)
						v.BurgerScript.Parent = nil
					end
				end
		end
	end
end

