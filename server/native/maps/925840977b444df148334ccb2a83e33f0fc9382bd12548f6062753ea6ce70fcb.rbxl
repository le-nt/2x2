				<Item class="Script" referent="RBX248">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function display(y)
y = tostring(y)
local g = script.Parent:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Decal&quot; then
if g[i].Name == y then
g[i].Face = &quot;Right&quot;
elseif g[i].Name ~= y then
g[i].Face = &quot;Left&quot;
end
end
end
end

while true do
for i = 1, 13, 1 do
    wait(5)
    display(i)
end
wait(1)
end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
