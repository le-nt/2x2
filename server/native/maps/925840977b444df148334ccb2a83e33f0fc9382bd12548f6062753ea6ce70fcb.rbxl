						<string name="Name">Script</string>
						<ProtectedString name="Source">Tool = script.Parent

function onActivated()
if not Tool.Enabled then
		return
	end

local tag = Instance.new(&quot;StringValue&quot;)
tag.Name = &quot;DisconnectOwner&quot;
tag.Value = Tool.Parent.Name
local model = game.Lighting.Models:FindFirstChild(script.Parent.Name):Clone()
tag.Parent = model
model.Parent = game.Workspace
model:MoveTo(script.Parent.Handle.Position)
--model.PrimaryPart.Position = script.Parent.Handle.Position
script.Parent.Parent = nil

end

script.Parent.Activated:connect(onActivated)</ProtectedString>
