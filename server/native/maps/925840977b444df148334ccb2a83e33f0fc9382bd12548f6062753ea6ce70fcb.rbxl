				<Item class="Script" referent="RBX1171">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function display(y)
y = tostring(y)
local g = script.Parent:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Decal&quot; then
if g[i].Name == y then
g[i].Face = &quot;Right&quot;
elseif g[i].Name ~= y then
g[i].Face = &quot;Left&quot;
end
end
end
end


while true do
wait(5)
display(1)
wait(5)
display(2)
wait(5)
display(3)

end
</ProtectedString>
