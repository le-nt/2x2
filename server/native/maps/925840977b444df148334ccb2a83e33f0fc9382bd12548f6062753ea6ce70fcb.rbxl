						<string name="Name">Script</string>
						<ProtectedString name="Source">script.Parent.Transparency = 1
while wait(1) do

if string.sub(game.Lighting.TimeOfDay, 1, 2) == &quot;17&quot; then
script.Parent.Transparency = 0.7
end

if string.sub(game.Lighting.TimeOfDay, 1, 2) == &quot;06&quot; then
script.Parent.Transparency = 1
end

end
</ProtectedString>
