		<Item class="Script" referent="RBX1291">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LagCleanup</string>
				<ProtectedString name="Source">while wait(120) do

for i, v in pairs(game.Workspace:GetChildren()) do
if v.className == &quot;Tool&quot; then v.Parent = nil end
if v.Name == &quot;Bun with patty&quot; then v.Parent = nil end
if v.Name == &quot;Bun with patty and cheese&quot; then v.Parent = nil end
if v.Name == &quot;Bun with patty and cheese and lettuce&quot; then v.Parent = nil end
if v.Name == &quot;Bun with patty and lettuce&quot; then v.Parent = nil end
if v.Name == &quot;Cheese Pizza&quot; then v.Parent = nil end
if v.Name == &quot;Pepperoni Pizza&quot; then v.Parent = nil end
if v.Name == &quot;Sausage Pizza&quot; then v.Parent = nil end
if v.Name == &quot;Burger&quot; then v.Parent = nil end
if v.Name == &quot;Cheeseburger&quot; then v.Parent = nil end
if v.Name == &quot;Cheese&quot; then v.Parent = nil end
if v.Name == &quot;Buns&quot; then v.Parent = nil end
if v.Name == &quot;Patties&quot; then v.Parent = nil end
if v.Name == &quot;Pepperoni&quot; then v.Parent = nil end
if v.Name == &quot;Lettuce&quot; then v.Parent = nil end
if v.Name == &quot;Sausage&quot; then v.Parent = nil end
if v.Name == &quot;Dough&quot; then v.Parent = nil end
if v.Name == &quot;Head&quot; then v.Parent = nil end
end

for i, v in pairs(game.Lighting.Stuff:GetChildren()) do
				local heisenburger = v:Clone()
				heisenburger.Parent = game.Workspace
			end

end
