						<string name="Name">Script</string>
						<ProtectedString name="Source">Tool = script.Parent
storeroof = script.Parent.Parent.storeroof
function onActivated()
if not Tool.Enabled then
		return
	end
roof = game.Workspace:FindFirstChild(game.Players:FindFirstChild(Tool.Parent.Name).OwnsHouse.Value):FindFirstChild(&quot;Roof&quot;)
if roof then
roof.Parent = nil
storeroof.Value = roof
else
if storeroof.Value ~= nil then
storeroof.Value.Parent = game.Workspace:FindFirstChild(game.Players:FindFirstChild(Tool.Parent.Name).OwnsHouse.Value)
end
end


end

