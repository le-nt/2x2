moneytype = game.Lighting.Money.Money2

local wants = {&quot;Hey, can I get a Cheeseburger?&quot;, &quot;I would like a Cheese Pizza, please.&quot;, &quot;Just a normal burger, please.&quot;, &quot;Can I get a Pepperoni Pizza?&quot;, &quot;Gimme that Sausage Pizza plox!!!&quot;}
for i, v in pairs(guy:GetChildren()) do if v.className ~= &quot;Humanoid&quot; then v.CanCollide = false; v.Transparency = 1 end end
