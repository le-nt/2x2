		<Item class="Script" referent="RBX1553">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BallScript</string>
				<ProtectedString name="Source">use = false
function ontouch(part)
if use == false then
	if part.Parent == nil then return end
	if not part.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
	local player = game.Players:FindFirstChild(part.Parent.Name)	
	use = true
	local tool = game.Lighting.Tools.Ball:Clone()
	tool.Parent = player.Backpack
	wait(1)
	use = false
end
end

for i, v in pairs(game.Workspace:GetChildren()) do
if v.Name == &quot;BallGiver&quot; then
v.Touched:connect(ontouch)
end
end
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
