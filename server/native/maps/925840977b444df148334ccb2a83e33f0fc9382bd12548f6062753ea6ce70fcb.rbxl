if not part:FindFirstChild(&quot;Hit&quot;) then
local score = game.Players:FindFirstChild(script.Parent.Player.Value).leaderstats.Score
score.Value = score.Value + 5
local hit = Instance.new(&quot;BoolValue&quot;)
