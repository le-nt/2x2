			shirt.Texture = &quot;&quot;
			guy.Head.Done:Play()
			for i, v in pairs(guy:GetChildren()) do if v.className ~= &quot;Humanoid&quot; then v.CanCollide = false; v.Transparency = 1 end end
		end
	end

	if wantvar == 4 then
		if part.Parent.Name == &quot;Pepperoni Pizza&quot; then
			part.Parent.Parent = nil
			local money = moneytype:Clone()
			money.Position = script.Parent.MoneySpawn.Position
			money.Parent = game.Workspace
			guy.Head.Decal.Face = &quot;Bottom&quot;
			shirt.Texture = &quot;&quot;
			guy.Head.Done:Play()
			for i, v in pairs(guy:GetChildren()) do if v.className ~= &quot;Humanoid&quot; then v.CanCollide = false; v.Transparency = 1 end end
		end
	end

	if wantvar == 5 then
		if part.Parent.Name == &quot;Sausage Pizza&quot; then
			part.Parent.Parent = nil
			local money = moneytype:Clone()
			money.Position = script.Parent.MoneySpawn.Position
			money.Parent = game.Workspace
			guy.Head.Decal.Face = &quot;Bottom&quot;
			shirt.Texture = &quot;&quot;
			guy.Head.Done:Play()
			for i, v in pairs(guy:GetChildren()) do if v.className ~= &quot;Humanoid&quot; then v.CanCollide = false; v.Transparency = 1 end end
		end
	end


end

guy.RightArm.Touched:connect(ontouch)
guy.Head.Touched:connect(ontouch)

while wait(18 + math.random(0,10)) do
moneytype = game.Lighting.Money.Money2
guy.Head.Decal.Face = &quot;Front&quot;
guy.Head.Spawn:Play()
for i, v in pairs(guy:GetChildren()) do if v.className ~= &quot;Humanoid&quot; then v.CanCollide = true; v.Transparency = 0; v.Reflectance = 0 end end
wantvar = math.random(1, #wants)
guy.Name = wants[wantvar]
local choseskin = skincolours[math.random(1,#skincolours)]
local chosetrousers = trouserscolours[math.random(1,#trouserscolours)]
local chosetorso = torsocolours[math.random(1,#torsocolours)]
local choseshirt = &quot;rbxasset://../../../shareddata/Bowlin/&quot; .. shirts[math.random(1,#torsocolours)] .. &quot;.png&quot;
shirt.Texture = choseshirt
guy.Head.BrickColor = BrickColor.new(choseskin); guy.LeftArm.BrickColor = BrickColor.new(choseskin); guy.RightArm.BrickColor = BrickColor.new(choseskin);
guy.LeftLeg.BrickColor = BrickColor.new(chosetrousers); guy.RightLeg.BrickColor = BrickColor.new(chosetrousers); guy.Torso.BrickColor = BrickColor.new(chosetorso);

if math.random(1,15) == 13 then
-- Golden Man
moneytype = game.Lighting.Money.Money
shirt.Texture = &quot;rbxasset://../../../shareddata/Bowlin/rbxtee.png&quot;
guy.Head.BrickColor = BrickColor.new(24); guy.LeftArm.BrickColor = BrickColor.new(24); guy.RightArm.BrickColor = BrickColor.new(24);
guy.LeftLeg.BrickColor = BrickColor.new(24); guy.RightLeg.BrickColor = BrickColor.new(24); guy.Torso.BrickColor = BrickColor.new(24);
for i, v in pairs(guy:GetChildren()) do if v.className ~= &quot;Humanoid&quot; then v.Reflectance = 0.5; v.Transparency = 0 end end
end

if math.random(1,10) == 9 then
shirt.Texture = &quot;rbxasset://../../../shareddata/Bowlin/rbxtee.png&quot;
guy.Head.BrickColor = BrickColor.new(29); guy.LeftArm.BrickColor = BrickColor.new(29); guy.RightArm.BrickColor = BrickColor.new(29);
guy.LeftLeg.BrickColor = BrickColor.new(38); guy.RightLeg.BrickColor = BrickColor.new(38); guy.Torso.BrickColor = BrickColor.new(38);
end

if math.random(1,10) == 10 then
shirt.Texture = &quot;noshirt&quot;
guy.Head.BrickColor = BrickColor.new(1); guy.LeftArm.BrickColor = BrickColor.new(1); guy.RightArm.BrickColor = BrickColor.new(1);
guy.LeftLeg.BrickColor = BrickColor.new(1); guy.RightLeg.BrickColor = BrickColor.new(1); guy.Torso.BrickColor = BrickColor.new(1);
for i, v in pairs(guy:GetChildren()) do if v.className ~= &quot;Humanoid&quot; then v.CanCollide = true; v.Transparency = 0.5 end end
end
end
