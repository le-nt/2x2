					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">de = false
function touch(hit)
	if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
	if hit.Name == &quot;Dough&quot; or &quot;Cheese&quot; or &quot;Pepperoni&quot; or &quot;Sausage&quot; or &quot;Buns&quot; or &quot;Lettuce&quot; or &quot;Patties&quot; and de == false then
		de = true
		hit:remove()
	end
wait(10)
de = false
end

script.Parent.Touched:connect(touch)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
