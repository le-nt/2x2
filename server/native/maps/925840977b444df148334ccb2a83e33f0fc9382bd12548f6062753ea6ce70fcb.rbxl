					<ProtectedString name="Source">script.Parent.Name = script.Parent.Parent.Name .. &quot; - &quot; .. tostring(script.Parent.Cost.Value) .. &quot; Score&quot;
use = false
function ontouch(part)
if use == false then
	if part.Parent == nil then return end
	if not part.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
	local player = game.Players:FindFirstChild(part.Parent.Name)	
	local score = player.leaderstats.Score
	use = true
	if score.Value &gt;= script.Parent.Cost.Value then
	score.Value = score.Value - script.Parent.Cost.Value
	local tool = game.Lighting.Tools.Furniture:Clone()
	tool.Name = script.Parent.Parent.Name
	tool.Parent = player.Backpack
	end
	wait(1)
	use = false
end
end


script.Parent.Head.Touched:connect(ontouch)</ProtectedString>
