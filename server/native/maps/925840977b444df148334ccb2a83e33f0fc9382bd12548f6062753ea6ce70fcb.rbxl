			<Item class="Script" referent="RBX2649">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onTouched(part) 
if part.Name == &quot;Cheese&quot; then part.Parent = nil end
if part.Name == &quot;Patties&quot; then part.Parent = nil end
if part.Name == &quot;Lettuce&quot; then part.Parent = nil end
if part.Name == &quot;Dough&quot; then part.Parent = nil end
if part.Name == &quot;Pepperoni&quot; then part.Parent = nil end
if part.Name == &quot;Sausage&quot; then part.Parent = nil end
if part.Parent == nil then return end
if not part.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
character = part.Parent
humanoid = character.Humanoid
if humanoid.MaxHealth == 0 then return end
if character:FindFirstChild(&quot;Grabber&quot;) then game.Players:FindFirstChild(character.Name).Backpack.Grabber.Active = false; character:FindFirstChild(&quot;Grabber&quot;).Parent = nil end
if game.Players:FindFirstChild(character.Name).Backpack:FindFirstChild(&quot;Grabber&quot;) then
	game.Players:FindFirstChild(character.Name).Backpack.Grabber.Parent = nil
end

if character:FindFirstChild(&quot;Copy&quot;) then game.Players:FindFirstChild(character.Name).Backpack.Copy.Active = false; character:FindFirstChild(&quot;Copy&quot;).Parent = nil end
if game.Players:FindFirstChild(character.Name).Backpack:FindFirstChild(&quot;Copy&quot;) then
	game.Players:FindFirstChild(character.Name).Backpack.Copy.Parent = nil
	local tooldeselect = game.Lighting.Tools.Change:Clone()
	tooldeselect.Handle.Position = character.PrimaryPart.Position
	tooldeselect.Parent = game.Workspace
	wait(0.2)
	tooldeselect.Parent = nil
end
end
script.Parent.Touched:connect(onTouched)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
