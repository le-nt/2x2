					<string name="Name">PizzaScript</string>
					<ProtectedString name="Source">function ontouch(part)
print(part.Name)

if part.Name == &quot;Pepperoni&quot; then

if script.Parent.Parent.Name == &quot;Pepperoni Pizza&quot; then

local model = script.Parent.Parent
part.Parent = model
model.Name = &quot;Pepperoni Pizza&quot;

end
end

if part.Name == &quot;Pepperoni&quot; then

if script.Parent.Parent.Name == &quot;Cheese Pizza&quot; then

local model = script.Parent.Parent
part.Parent = model
model.Name = &quot;Pepperoni Pizza&quot;

end
end

if part.Name == &quot;Sausage&quot; then

if script.Parent.Parent.Name == &quot;Cheese Pizza&quot; then

local model = script.Parent.Parent
part.Parent = model
model.Name = &quot;Sausage Pizza&quot;

end

end

if part.Name == &quot;Sausage&quot; then

if script.Parent.Parent.Name == &quot;Sausage Pizza&quot; then

local model = script.Parent.Parent
part.Parent = model
model.Name = &quot;Sausage Pizza&quot;

end

end

if script.Parent.Name == &quot;Head&quot; then

if script.Parent.Parent.Name == &quot;Workspace&quot; then

script.Parent.Parent = nil

end

end


end

script.Parent.Touched:connect(ontouch)</ProtectedString>
