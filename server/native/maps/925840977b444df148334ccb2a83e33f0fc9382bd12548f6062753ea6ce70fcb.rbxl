					<string name="Name">BurgerScript</string>
					<ProtectedString name="Source">function ontouch(part)
if part.Name == &quot;Bun&quot; then

if script.Parent.Parent.Name == &quot;Bun with patty&quot; then

local model = script.Parent.Parent
part.Parent = model
model.Name = &quot;Burger&quot;

end
end

if part.Name == &quot;Cheese&quot; then

if script.Parent.Parent.Name == &quot;Bun with patty&quot; then

local model = script.Parent.Parent
part.Parent = model
model.Name = &quot;Bun with patty and cheese&quot;
local weld = Instance.new(&quot;Weld&quot;)
weld.Part0 = model:FindFirstChild(&quot;Buns&quot;)
weld.Part1 = part
weld.C0 = model:FindFirstChild(&quot;Buns&quot;).CFrame:inverse()
weld.C1 = part.CFrame:inverse()
weld.Parent = model

end

end

if part.Name == &quot;Lettuce&quot; then

if script.Parent.Parent.Name == &quot;Bun with patty&quot; then

local model = script.Parent.Parent
part.Parent = model
model.Name = &quot;Bun with patty and lettuce&quot;
local weld = Instance.new(&quot;Weld&quot;)
weld.Part0 = model:FindFirstChild(&quot;Buns&quot;)
weld.Part1 = part
