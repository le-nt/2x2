						<string name="Name">Script</string>
						<ProtectedString name="Source">function ontouch(part)
	if part.Parent == nil then return end
	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) then
		local player = game.Players:FindFirstChild(part.Parent.Name)
		player.leaderstats.Score.Value = player.leaderstats.Score.Value + 100
		script.Parent.Parent = nil
	end
end

