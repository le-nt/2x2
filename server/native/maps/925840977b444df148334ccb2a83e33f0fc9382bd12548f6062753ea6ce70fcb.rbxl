	local player = game.Players:FindFirstChild(part.Parent.Name)	
	use = true
	local tool = game.Lighting.Tools.Ball:Clone()
	tool.Parent = player.Backpack
	wait(1)
	use = false
end
end

for i, v in game.Workspace do
if v.Name == &quot;BallGiver&quot; then
v.Touched:connect(ontouch)
end
end
