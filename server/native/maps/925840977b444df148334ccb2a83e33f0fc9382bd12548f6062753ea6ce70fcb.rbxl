			<Item class="Script" referent="RBX4023">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">HouseScript</string>
					<ProtectedString name="Source">character = nil
humanoid = nil
sign = script.Parent:FindFirstChild(&quot;For Sale&quot;)
forsale = Instance.new(&quot;Decal&quot;)

if (string.sub(script.Parent.Name, 7, 7) % 2 == 0) then
forsale.Face = 3
else
forsale.Face = 0
end

forsale.Texture = &quot;rbxasset://../../../shareddata/Bowlin/FSsign.png&quot;
forsale.Parent = sign.Head
-- Porch is the Part that the player stands on, the clickdetector uses the Porch to detect the player standing on it
-- Change the owner of Fake Furniture to your username to test
porch = script.Parent.Porch

function onTouched(part) 
if part.Parent == nil then return end
if not part.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
character = part.Parent
humanoid = character.Humanoid
player = game.Players:FindFirstChild(character.Name)
if character:FindFirstChild(&quot;Grabber&quot;) then game.Players:FindFirstChild(character.Name).Backpack.Grabber.Active = false; character:FindFirstChild(&quot;Grabber&quot;).Parent = nil end
if game.Players:FindFirstChild(character.Name).Backpack:FindFirstChild(&quot;Grabber&quot;) then
	game.Players:FindFirstChild(character.Name).Backpack.Grabber.Parent = nil
end

if character:FindFirstChild(&quot;Roof&quot;) then character:FindFirstChild(&quot;Roof&quot;).Parent = nil end
if game.Players:FindFirstChild(character.Name).Backpack:FindFirstChild(&quot;Roof&quot;) then
	game.Players:FindFirstChild(character.Name).Backpack.Roof.Parent = nil
	local tooldeselect = game.Lighting.Tools.Change:Clone()
	tooldeselect.Handle.Position = character.PrimaryPart.Position
	tooldeselect.Parent = game.Workspace
	wait(0.2)
	tooldeselect.Parent = nil
end

if game.Players:FindFirstChild(character.Name):FindFirstChild(&quot;OwnsHouse&quot;) then return end

--If porch doesnt have an owner, you become the owner if you touch it
if porch.Parent.Owner.Value == &quot;&quot; then
	local werner = Instance.new(&quot;StringValue&quot;)
	werner.Name = &quot;OwnsHouse&quot;
   werner.Value = script.Parent.Name
	werner.Parent = game.Players:FindFirstChild(character.Name)
	porch.Parent.Owner.Value = character.Name
	print(character.Name, &quot; now owns this house&quot;)
	if game.Players:FindFirstChild(character.Name):FindFirstChild(&quot;PlayerGui&quot;) then
	local h = Instance.new(&quot;Hint&quot;)
	h.Text = &quot;You now own this house!&quot;
	h.Parent = game.Players:FindFirstChild(character.Name).PlayerGui
	wait(3)
	h.Parent = nil
	end
	sign.Name = character.Name .. &quot;&apos;s House&quot;
	forsale.Texture = &quot;rbxasset://../../../shareddata/Bowlin/SoldSign.png&quot;
end

end

function floor(part)
if part.Parent == nil then return end
if not part.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
character = part.Parent
humanoid = character.Humanoid
if character.Name ~= porch.Parent.Owner.Value then return end
if not game.Players:FindFirstChild(character.Name).Backpack:FindFirstChild(&quot;Grabber&quot;) then
	local grabber = game.Lighting.Tools.Grabber:Clone()
	grabber.Parent = game.Players:FindFirstChild(character.Name).Backpack
	local rooftoggle = game.Lighting.Tools.Roof:Clone()
	rooftoggle.Parent = game.Players:FindFirstChild(character.Name).Backpack
end
end

script.Parent.Floor.Touched:connect(floor)

local doortoggle = false

-- Clicking the button next to the door will either lock it or unlock it, while locked, the player may move around all the furniture that they own
-- Thinking of adding just a lock or unlock your stuff feature in the future instead of having to lock your house every time you want to move things.

function ButtonClick()
-- if the part does not have a parent or is not a player
if character == nil then return end
-- if username matches
if character.Name == porch.Parent.Owner.Value then
--toggle the door

doortoggle = not doortoggle
if doortoggle == true then
script.Parent.Button.BrickColor = BrickColor.new(37)
script.Parent.Button2.BrickColor = BrickColor.new(37)
script.Parent.Door.Transparency = 1
script.Parent.Door.CanCollide = false
for i, v in ipairs(game.Workspace:GetChildren()) do
if v.className ~= &quot;Camera&quot; then 
if v:FindFirstChild(&quot;FurnitureOwner&quot;) then 
if v.FurnitureOwner.Value == character.Name then
 v.Locked = true
end
end
end

end
else
script.Parent.Button.BrickColor = BrickColor.new(21)
script.Parent.Button2.BrickColor = BrickColor.new(21)
script.Parent.Door.Transparency = 0
script.Parent.Door.CanCollide = true
for i, v in ipairs(game.Workspace:GetChildren()) do
if v.className ~= &quot;Camera&quot; then 
if v:FindFirstChild(&quot;FurnitureOwner&quot;) then 
if v.FurnitureOwner.Value == character.Name then
 v.Locked = false
end
end
end
end
end
end

end

function Leave(player)
if player.Name == porch.Parent.Owner.Value then
porch.Parent.Owner.Value = &quot;&quot;
sign.Name = &quot;For Sale&quot;
for i, v in pairs(game.Workspace:GetChildren()) do

if v:FindFirstChild(&quot;DisconnectOwner&quot;) then
if v.DisconnectOwner.Value == player.Name then v.Parent = nil end
end

end
end
end

script.Parent.Button.ClickDetector.MouseClick:connect(ButtonClick)
script.Parent.Button2.ClickDetector.MouseClick:connect(ButtonClick)
porch.Touched:connect(onTouched)
game.Players.PlayerRemoving:connect(Leave)</ProtectedString>
