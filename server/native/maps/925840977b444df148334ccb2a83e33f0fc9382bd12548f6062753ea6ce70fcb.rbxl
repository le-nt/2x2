			<Item class="Script" referent="RBX1748">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">empty = false
spawn = false
script.Parent.CanValue.Value = game.Lighting.Tools.LemLime:Clone()
function ontouch(part)
if empty == false then
	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) then
			local player = game.Players:FindFirstChild(part.Parent.Name)
			if spawn == true then return end
			if player.leaderstats.Score.Value &gt;= 30 then
				spawn = true
				local cola = script.Parent.CanValue.Value:Clone()
				cola.Parent = player.Backpack
				player.leaderstats.Score.Value = player.leaderstats.Score.Value - 30
				wait(5)
				spawn = false
			end
	end	
end
if empty == true then
		if part.Parent:FindFirstChild(&quot;Humanoid&quot;) then
			local player = game.Players:FindFirstChild(part.Parent.Name)
			if player.TeamColor == BrickColor.new(21) then
				if part.Parent:FindFirstChild(&quot;Soda Pack&quot;) then
					player.leaderstats.Score.Value = player.leaderstats.Score.Value + 10
					empty = false
					part.Parent:FindFirstChild(&quot;Soda Pack&quot;).Parent = nil
					script.Parent.Can1.BrickColor = BrickColor.new(1)
					script.Parent.Can2.BrickColor = BrickColor.new(1)
					script.Parent.Can3.BrickColor = BrickColor.new(1)
					script.Parent.Can4.BrickColor = BrickColor.new(1)
					script.Parent.Coke.Transparency = 0
					script.Parent.Rootbeer.Transparency = 0
					script.Parent.Sprite.Transparency = 0
					script.Parent.DrPepper.Transparency = 0
					script.Parent.Sounds.Refill:Play()
				end
			end
		end
end
end


for i, v in pairs(script.Parent:GetChildren()) do

if v.className ~= &quot;Script&quot; then
if v.className ~= &quot;Sound&quot; then
if v.className ~= &quot;ObjectValue&quot; then

v.Touched:connect(ontouch)

end
end
end

end

while wait(40) do
if empty ~= true then
empty = true
script.Parent.Can1.BrickColor = BrickColor.new(26)
script.Parent.Can2.BrickColor = BrickColor.new(26)
script.Parent.Can3.BrickColor = BrickColor.new(26)
script.Parent.Can4.BrickColor = BrickColor.new(26)
script.Parent.DrPepper.Transparency = 1
script.Parent.Coke.Transparency = 1
script.Parent.Rootbeer.Transparency = 1
script.Parent.Sprite.Transparency = 1
script.Parent.Sounds.Empty:Play()
end
end
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX1749">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">CanChooser</string>
					<ProtectedString name="Source">function can1()
script.Parent.CanClone.Mesh.Parent = nil
local mesh = script.Parent.Coke.Mesh:Clone()
mesh.Parent = script.Parent.CanClone
script.Parent.CanValue.Value = game.Lighting.Tools.LemLime
end

function can2()
script.Parent.CanClone.Mesh.Parent = nil
local mesh = script.Parent.DrPepper.Mesh:Clone()
mesh.Parent = script.Parent.CanClone
script.Parent.CanValue.Value = game.Lighting.Tools.CherrySoda
end

function can3()
script.Parent.CanClone.Mesh.Parent = nil
local mesh = script.Parent.Rootbeer.Mesh:Clone()
mesh.Parent = script.Parent.CanClone
script.Parent.CanValue.Value = game.Lighting.Tools.EnergyDrink
end

function can4()
script.Parent.CanClone.Mesh.Parent = nil
local mesh = script.Parent.Sprite.Mesh:Clone()
mesh.Parent = script.Parent.CanClone
script.Parent.CanValue.Value = game.Lighting.Tools.FruitPunch
end

script.Parent.Can1.ClickDetector.MouseClick:connect(can1)
script.Parent.Can2.ClickDetector.MouseClick:connect(can2)
script.Parent.Can3.ClickDetector.MouseClick:connect(can3)
script.Parent.Can4.ClickDetector.MouseClick:connect(can4)</ProtectedString>
