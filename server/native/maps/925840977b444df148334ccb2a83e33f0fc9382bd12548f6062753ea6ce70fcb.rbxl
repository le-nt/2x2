						<string name="Name">PizzaScript</string>
						<ProtectedString name="Source">function ontouch(part)
if part.Name == &quot;Cheese&quot; then
if script.Parent.Parent.Name ~= &quot;Cheese Pizza&quot; then

local model = Instance.new(&quot;Model&quot;)
model.Name = &quot;Cheese Pizza&quot;
model.Parent = game.Workspace
part.Parent = model
part.Name = &quot;Head&quot;
local hum = Instance.new(&quot;Humanoid&quot;)
hum.MaxHealth = 0
hum.Parent = model
script.Parent.Parent = model
local weld = Instance.new(&quot;Weld&quot;)
weld.Part0 = script.Parent
weld.Part1 = part
weld.C0 = script.Parent.CFrame:inverse()
weld.C1 = part.CFrame:inverse()
weld.Parent = model

end
end

end

