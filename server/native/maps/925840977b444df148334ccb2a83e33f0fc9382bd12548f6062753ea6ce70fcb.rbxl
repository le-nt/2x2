			<Item class="Script" referent="RBX2585">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function floor(part)
if part.Parent == nil then return end
if not part.Parent:FindFirstChild(&quot;Humanoid&quot;) then return end
character = part.Parent
humanoid = character.Humanoid
if humanoid.MaxHealth == 0 then return end
if game.Players:FindFirstChild(character.Name).TeamColor == BrickColor.new(23) then
if not game.Players:FindFirstChild(character.Name).Backpack:FindFirstChild(&quot;Grabber&quot;) then
	local grabber = game.Lighting.Tools.Grabber:Clone()
	grabber.Parent = game.Players:FindFirstChild(character.Name).Backpack
	local copy = game.Lighting.Tools.Copy:Clone()
	copy.Parent = game.Players:FindFirstChild(character.Name).Backpack
end
end
end

script.Parent.Touched:connect(floor)</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
