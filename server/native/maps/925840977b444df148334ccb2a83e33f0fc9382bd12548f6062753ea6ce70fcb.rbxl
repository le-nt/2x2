			<Item class="Script" referent="RBX4026">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ToiletScript</string>
					<ProtectedString name="Source">dirty = false
function ontouch(part)
if dirty then
		if part.Parent:FindFirstChild(&quot;Humanoid&quot;) then
			local player = game.Players:FindFirstChild(part.Parent.Name)
			if player.TeamColor == BrickColor.new(21) then
				if part.Parent:FindFirstChild(&quot;Sponge&quot;) then
					player.leaderstats.Score.Value = player.leaderstats.Score.Value + 10
					dirty = false
					script.Parent.Sounds.Clean:Play()
					for i, v in pairs(script.Parent:GetChildren()) do
						if v.className ~= &quot;Script&quot; then
						if v.Name ~= &quot;Dirty&quot; then
						if v.Name ~= &quot;Clean&quot; then
							v.BrickColor = BrickColor.new(1)
						end
						end
						end
					end
				end
			end
		end
end
end

for i, v in pairs(script.Parent:GetChildren()) do
if v.className ~= &quot;Script&quot; then
if v.Name ~= &quot;Dirty&quot; then
if v.Name ~= &quot;Clean&quot; then
v.Touched:connect(ontouch)
end
end
end
end

while wait(40 + math.random(0, 20)) do
dirty = true
script.Parent.Sounds.Dirty:Play()
for i, v in pairs(script.Parent:GetChildren()) do
if v.className ~= &quot;Script&quot; then
if v.Name ~= &quot;Dirty&quot; then
if v.Name ~= &quot;Clean&quot; then
v.BrickColor = BrickColor.new(26)
end
end
end
end

end
