				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Damage</string>
					<ProtectedString name="Source">function onTouched(part)
local h = part.Parent:FindFirstChild(&quot;Humanoid&quot;)
if (h ~= nil) then
if game.Players[h.Parent.Name].TeamColor == BrickColor.new(&quot;Really black&quot;) or game.Players[h.Parent.Name].TeamColor == BrickColor.new(&quot;Bright blue&quot;) then
h.Health = h.Health - 5
end
end
end
script.Parent.Touched:connect(onTouched)
