		<Item class="Script" referent="RBX362">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">BanScript(Disabled)</string>
				<ProtectedString name="Source">print(&quot;Ban Script Loaded&quot;)

speakers = 	{&quot;Playrobot&quot;, &quot;1dev2&quot;} -- Those who can say the command
 
banned = 	{ &quot;hendersonator&quot;,&quot;WhelenVortexR&quot;,&quot;Coldplay765&quot;,
					&quot;Coldplay766&quot;,&quot;WhelenVortexR4&quot;,&quot;OfficerWhelenVortexR&quot;,
					&quot;1505WhelenVortexR&quot;,&quot;altWhelenVortexR&quot;,&quot;s4f5srzdgv&quot;,
					&quot;WhelenWPS4000&quot;,&quot;ShawnWilkerson&quot;,&quot;sirenl0verShawn&quot;,&quot;bhruty&quot;,&quot;RoyMer&quot;,
					&quot;RoyMer8&quot;,&quot;jamknife&quot;,&quot;15WhelenVORTEXR05&quot;,&quot;CHRYSLERME412&quot;,&quot;conker456&quot;,&quot;spyro37&quot;,
					&quot;kblox2&quot;,&quot;neji0000&quot;,&quot;chrisinden&quot;,&quot;Geina&quot;,&quot;PoliceOfficer6472&quot;,&quot;TheSirenSpot&quot; }

namepart = {&quot;whelen&quot;, &quot;coldplay&quot;, &quot;chryslerme&quot;, &quot;Nicholas5645&quot;}	-- add parts of names to ban here

function checkSpeakers(name)
	for i,v in pairs(speakers) do
		if (string.upper(name) == string.upper(v)) then return true end
	end
   return false
end

function banPlayer(banner, victim)
	if (victim ~= banner) then
		victim:Remove()
		banned[victim.Name] = victim.Name
	end
end

function matchPlayer(str)
	local result = nil
	local players = game.Players:GetPlayers()
	for i,v in pairs(game.Players:GetPlayers()) do
		if (string.find(string.lower(v.Name), str) == 1) then
			if (result ~= nil) then return nil end
			result = v
		end
	end
	return result
end

function onChatted(msg, recipient, speaker)
	local source = string.lower(speaker.Name)
	msg = string.lower(msg)
	if (string.find(msg, &quot;ban&quot;) == 1) then 
		for word in msg:gmatch(&quot;%w+&quot;) do 
			local p = matchPlayer(word)
			if (p ~= nil) then
				banPlayer(speaker, p)
			end
		end
	end
end
function specific(newPlayer)
	for i,v in pairs(namepart) do
		if string.find(string.lower(newPlayer.Name), string.lower(v)) then
			print(&quot;checked&quot;)
			newPlayer:remove()
		end
	end
end
function onPlayerEntered(newPlayer)
	for i,v in pairs(banned) do
		if (v:lower() == newPlayer.Name:lower()) then
			newPlayer:Remove()
		end
	end

	specific(newPlayer)

	if checkSpeakers(newPlayer.Name) then
		newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
	end
end

game.Players.PlayerAdded:connect(onPlayerEntered)</ProtectedString>
