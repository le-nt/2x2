						<Item class="Script" referent="RBX13090">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Morph Script</string>
								<ProtectedString name="Source">local shopgui = script.Parent.Parent
local frame = script.Parent:findFirstChild(&quot;Inventory&quot;)
local player = script.Parent.Parent.Parent
local char = player.Character

function Dog()
	if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
		local script2 = script.DogAnimation:clone()
		local head = char.Head
		local mesh = head:findFirstChild(&quot;Mesh&quot;) 
		mesh:remove()
		local face = char.Head.face
		face:remove()
		local newface = Instance.new(&quot;Decal&quot;)
		newface.Parent = char.Head
		newface.Texture = &quot;http://www.roblox.com/asset/?id=6091331&quot;
		newface.Name = &quot;Decal&quot;
		local torso = char.Torso
		torso.Transparency = 1
		torso.CanCollide = false
		if char:findFirstChild(&quot;FakeTorso&quot;) ~= nil then
			char:findFirstChild(&quot;FakeTorso&quot;):remove()
		end
		local body = Instance.new(&quot;Part&quot;)
		body.BrickColor = BrickColor.new(38)
		body.Parent = char
		body.Position = torso.Position
		body.Name = &quot;FakeTorso&quot;
		body.formFactor = &quot;Plate&quot;
		body.Size = Vector3.new(2, 1, 4) 
		local w1 = Instance.new(&quot;Weld&quot;)----------------FAKE TORSO  POSITION
		w1.Parent = torso
		w1.Part0 = w1.Parent
		w1.Part1 = body
		w1.C1 = CFrame.new(0, 1, 0.3) 
		local w2 = Instance.new(&quot;Weld&quot;) -------------HEAD POSITION
		w2.Parent = torso
		w2.Part0 = w2.Parent
		w2.Part1 = char.Head
		w2.C1 = CFrame.new(0,0.2, 1.8)  
		local tail = Instance.new(&quot;Part&quot;) -------------------TAIL CREATED
		tail.BrickColor = BrickColor.new(38)
		tail.Parent = char
		tail.Position = torso.Position
		tail.Name = &quot;Tail&quot;
		tail.formFactor = &quot;Plate&quot;
		tail.Size = Vector3.new(0,2,0)
		local mesh2 = Instance.new(&quot;SpecialMesh&quot;) ----------TAIL MESH CREATED
		mesh2.Scale = Vector3.new(0.4, 1, 0.4) 
		mesh2.Parent = char.Tail
		local w3 = Instance.new(&quot;Weld&quot;)
		w3.Parent = torso
		w3.Part0 = w3.Parent
		w3.Part1 = tail
		w3.C1 = CFrame.new(0,-0.2,-1.5)
		local ear1 = Instance.new(&quot;Part&quot;) 
		ear1.BrickColor = BrickColor.new(38)
		ear1.Parent = char
		ear1.Position = torso.Position
		ear1.Name = &quot;LeftOutsideEar&quot;
		ear1.formFactor = &quot;Plate&quot;
		ear1.Size = Vector3.new(1, 0.4, 1)
		local mesh2 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh2.MeshType = &quot;Wedge&quot;
		mesh2.Scale = Vector3.new(0.4, 1, 1) 
		mesh2.Parent = ear1
		local w4 = Instance.new(&quot;Weld&quot;)
		w4.Parent = torso
		w4.Part0 = w4.Parent
		w4.Part1 = ear1
		w4.C1 = CFrame.fromEulerAnglesXYZ(-math.pi/2,math.pi/2,0) +Vector3.new(1.5,-0.6,1)
		local ear2 = Instance.new(&quot;Part&quot;) 
		ear2.BrickColor = BrickColor.new(38)
		ear2.Parent = char
		ear2.Position = torso.Position
		ear2.Name = &quot;LeftInsideEar&quot;
		ear2.formFactor = &quot;Plate&quot;
		ear2.Size = Vector3.new(1, 0.4, 1)
		local mesh2 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh2.MeshType = &quot;Wedge&quot;
		mesh2.Scale = Vector3.new(0.4, 1, 1) 
		mesh2.Parent = ear2
		local w5 = Instance.new(&quot;Weld&quot;)
		w5.Parent = torso
		w5.Part0 = w5.Parent
		w5.Part1 = ear2
		w5.C1 = CFrame.fromEulerAnglesXYZ(-math.pi/2,-math.pi/2,0) +Vector3.new(-1.5,0.2,1) 
		local ear3 = Instance.new(&quot;Part&quot;) 
		ear3.BrickColor = BrickColor.new(38)
		ear3.Parent = char
		ear3.Position = torso.Position
		ear3.Name = &quot;RightInsideEar&quot;
		ear3.formFactor = &quot;Plate&quot;
		ear3.Size = Vector3.new(1, 0.4, 1)
		local mesh5 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh5.MeshType = &quot;Wedge&quot;
		mesh5.Scale = Vector3.new(0.4, 1, 1) 
		mesh5.Parent = ear3
		local w8 = Instance.new(&quot;Weld&quot;)
		w8.Parent = torso
		w8.Part0 = w8.Parent
		w8.Part1 = ear3
		w8.C1 = CFrame.fromEulerAnglesXYZ(-math.pi/2,math.pi/2,0) +Vector3.new(1.5,0.2,1)
		local ear4 = Instance.new(&quot;Part&quot;) 
		ear4.BrickColor = BrickColor.new(38)
		ear4.Parent = char
		ear4.Position = torso.Position
		ear4.Name = &quot;RightOutsideEar&quot;
		ear4.formFactor = &quot;Plate&quot;
		ear4.Size = Vector3.new(1, 0.4, 1)
		local mesh6 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh6.MeshType = &quot;Wedge&quot;
		mesh6.Scale = Vector3.new(0.4, 1, 1) 
		mesh6.Parent = ear4
		local w5 = Instance.new(&quot;Weld&quot;)
		w5.Parent = torso
		w5.Part0 = w5.Parent
		w5.Part1 = ear4
		w5.C1 = CFrame.fromEulerAnglesXYZ(-math.pi/2,-math.pi/2,0) +Vector3.new(-1.5,-0.6,1) 
		local rightarm = char:findFirstChild(&quot;Right Arm&quot;)
		if rightarm ~= nil then
			local armmesh = Instance.new(&quot;SpecialMesh&quot;)
			armmesh.Scale = Vector3.new(0.7, 1.4, 0.7)
			armmesh.Parent = rightarm
		end
		local rightleg = char:findFirstChild(&quot;Right Leg&quot;)
		if rightleg~= nil then
			local legmesh = Instance.new(&quot;SpecialMesh&quot;)
			legmesh.Scale = Vector3.new(0.7, 1.4, 0.7)
			legmesh.Parent = rightleg
		end
		local leftarm = char:findFirstChild(&quot;Left Arm&quot;)
		if leftarm~= nil then
			local armmesh = Instance.new(&quot;SpecialMesh&quot;)
			armmesh.Scale = Vector3.new(0.7, 1.4, 0.7)
			armmesh.Parent = leftarm
		end
		local leftleg = char:findFirstChild(&quot;Left Leg&quot;)
		if leftleg ~= nil then
			local legmesh = Instance.new(&quot;SpecialMesh&quot;)
			legmesh.Scale = Vector3.new(0.7, 1.4, 0.7)
			legmesh.Parent = leftleg
		end
		local tophead = Instance.new(&quot;Part&quot;) -------------------EAR1 CREATED
		tophead.BrickColor = BrickColor.new(38)
		tophead.Parent = char
		tophead.Position = torso.Position
		tophead.Name = &quot;Tophead&quot;
		tophead.formFactor = &quot;Plate&quot;
		tophead.Size = Vector3.new(2, 0.4, 1)
		local mesh3 = Instance.new(&quot;SpecialMesh&quot;) ----------EAR1 MESH CREATED
		mesh3.MeshType = &quot;Torso&quot;
		mesh3.Scale = Vector3.new(1,1,1) 
		mesh3.Parent = tophead
		local w6 = Instance.new(&quot;Weld&quot;) -------------HEAD POSITION
		w6.Parent = torso
		w6.Part0 = w6.Parent
		w6.Part1 = tophead
		w6.C1 = CFrame.new(0,-0.5, 1.8)  
		local snout = Instance.new(&quot;Part&quot;) 
		snout.BrickColor = BrickColor.new(38)
		snout.Parent = char
		snout.Position = torso.Position
		snout.Name = &quot;Snout&quot;
		snout.formFactor = &quot;Plate&quot;
		snout.Size = Vector3.new(2, 0.7, 1)
		local mesh4 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh4.MeshType = &quot;Torso&quot;
		mesh4.Scale = Vector3.new(1,0.8,1) 
		mesh4.Parent = snout
		local w7 = Instance.new(&quot;Weld&quot;) 
		w7.Parent = torso
		w7.Part0 = w7.Parent
		w7.Part1 = snout
		w7.C1 = CFrame.new(0,0.2, 2.5)  
		local nose = Instance.new(&quot;Part&quot;) 
		nose.BrickColor = BrickColor.new(38)
		nose.Parent = char
		nose.Position = torso.Position
		nose.Name = &quot;Nose&quot;
		nose.formFactor = &quot;Plate&quot;
		nose.Size = Vector3.new(2, 0.4, 1)
		local mesh8 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh8.MeshType = &quot;Wedge&quot;
		mesh8.Scale = Vector3.new(0.4, 1, 1) 
		mesh8.Parent = nose
		local w9 = Instance.new(&quot;Weld&quot;) 
		w9.Parent = torso
		w9.Part0 = w9.Parent
		w9.Part1 = nose
		w9.C1 = CFrame.fromEulerAnglesXYZ(math.pi,0,-math.pi) +Vector3.new(0,-0.2, -2.5)  
		local marker = Instance.new(&quot;StringValue&quot;)
		marker.Parent = char
		marker.Name = &quot;IsaMorph&quot;
		script2.Parent = char
		local characterparts = char:getChildren() 
		for i=1,#characterparts do 
			if characterparts[i].className == &quot;Part&quot; then 
				characterparts[i].Locked = true 
				characterparts[i].BrickColor = BrickColor.new(38)
				characterparts[i].BackSurface = &quot;Smooth&quot;
				characterparts[i].BottomSurface = &quot;Smooth&quot;
				characterparts[i].FrontSurface = &quot;Smooth&quot;
				characterparts[i].LeftSurface = &quot;Smooth&quot;
				characterparts[i].RightSurface = &quot;Smooth&quot;
				characterparts[i].TopSurface = &quot;Smooth&quot;
			end 
			if characterparts[i].className == &quot;Hat&quot; then 
				characterparts[i]:remove()
			end 
			if characterparts[i].className == &quot;Pants&quot; then
				characterparts[i]:remove()
			end
			if characterparts[i].className == &quot;Shirt&quot; then
				characterparts[i]:remove()
			end
			if characterparts[i].className == &quot;CharacterMesh&quot; then
				characterparts[i]:remove()
			end
		end 
		char:findFirstChild(&quot;Body Colors&quot;).LeftArmColor = BrickColor.new(38)
		char:findFirstChild(&quot;Body Colors&quot;).LeftLegColor = BrickColor.new(38)
		char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = BrickColor.new(38)
		char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = BrickColor.new(38)
		char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = BrickColor.new(38)
		char:findFirstChild(&quot;Body Colors&quot;).HeadColor = BrickColor.new(38)
	end
end

function Sheep()
	local parts = char:GetChildren()
	for i = 1, #parts do
		if (parts[i].className == &quot;Part&quot;) then
				parts[i].BrickColor = BrickColor.new(38)
		end
	end
	if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
		local torso = char.Torso
		local script2 = script.SheepAnimation:clone()
		local head = char.Head
		local face = char.Head.face
		face:remove()
		local newface = Instance.new(&quot;Decal&quot;)
		newface.Parent = char.Head
		newface.Texture = &quot;http://www.roblox.com/asset/?id=9540082&quot;
		newface.Name = &quot;Decal&quot;
		newface.Face = &quot;Bottom&quot;
		local w0 = Instance.new(&quot;Weld&quot;)
		w0.Parent = torso
		w0.Part0 = w0.Parent
		w0.Part1 = head
		w0.C1 = CFrame.fromEulerAnglesXYZ(-math.pi/2,0,math.pi) +Vector3.new(0, 1.5, 0.3)
		local headmesh = char.Head.Mesh
		headmesh.MeshType = &quot;Head&quot;
		headmesh.Scale = Vector3.new(2,2,2)
		head.BrickColor = BrickColor.new(26)
		local torso = char.Torso
		torso.Transparency = 1
		torso.CanCollide = false
		if char:findFirstChild(&quot;FakeTorso&quot;) ~= nil then
			char:findFirstChild(&quot;FakeTorso&quot;):remove()
		end
		local body = Instance.new(&quot;Part&quot;)
		body.BrickColor = BrickColor.new(1)
		body.Parent = char
		body.Position = torso.Position
		body.Name = &quot;FakeTorso&quot;
		body.formFactor = &quot;Plate&quot;
		body.Size = Vector3.new(2, 1, 4) 
		local bodymesh = Instance.new(&quot;SpecialMesh&quot;)
		bodymesh.MeshId = &quot;http://www.roblox.com/asset/?id=1095708&quot;
		bodymesh.Scale = Vector3.new(3.2, 4.2, 5.2)
		bodymesh.Parent = body
