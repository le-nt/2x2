function Snowman()
	if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
		local head = char.Head
		local torso = char.Torso	
		head.Transparency = 0
		local w = Instance.new(&quot;Weld&quot;)
		w.Parent = torso
		w.Part0 = w.Parent
		w.Part1 = head
		w.C1 = CFrame.new(0, -3, 0)
		head.face:remove()
		local headmesh = Instance.new(&quot;SpecialMesh&quot;)
		headmesh.MeshType = &quot;FileMesh&quot;
		headmesh.MeshId = &quot;http://www.roblox.com/asset/?id=5818840&quot;
		headmesh.TextureId = &quot;http://www.roblox.com/asset/?id=5818846&quot;
		headmesh.Scale = Vector3.new(2.2,2,2)
		headmesh.Parent = head
		if char:findFirstChild(&quot;Left Leg&quot;) ~= nil then
			char:findFirstChild(&quot;Left Leg&quot;).Transparency = 1
			local legattachment = Instance.new(&quot;Part&quot;)
			legattachment.formFactor = &quot;Plate&quot;
			legattachment.BottomSurface = &quot;Smooth&quot;
			legattachment.TopSurface = &quot;Smooth&quot;
			legattachment.Size = Vector3.new(2, 1.6, 2)
			local bottomsnow = Instance.new(&quot;SpecialMesh&quot;)
			bottomsnow.MeshType = &quot;Sphere&quot;
			bottomsnow.Scale = Vector3.new(3,3,3)
			bottomsnow.Parent = legattachment
			legattachment.Parent = char:findFirstChild(&quot;Left Leg&quot;)
			local w1 = Instance.new(&quot;Weld&quot;)
			w1.Parent = char:findFirstChild(&quot;Left Leg&quot;)
			w1.Part0 = w1.Parent
			w1.Part1 = legattachment
			w1.C1 = CFrame.new(-0.5, 0, 0)
			legattachment.Parent = char:findFirstChild(&quot;Left Leg&quot;)
		end
		if char:findFirstChild(&quot;Right Leg&quot;) ~= nil then
			char:findFirstChild(&quot;Right Leg&quot;).Transparency = 1
		end
		local faketorso = Instance.new(&quot;Part&quot;)
		faketorso.formFactor = &quot;Plate&quot;
		faketorso.Size = Vector3.new(2, 1.6,2)
		faketorso.TopSurface = &quot;Smooth&quot;
		faketorso.BottomSurface = &quot;Smooth&quot;
		local middlesnow = Instance.new(&quot;SpecialMesh&quot;)
		middlesnow.MeshType = &quot;Sphere&quot;
		middlesnow.Scale = Vector3.new(2.5,2.5,2.5)
		middlesnow.Parent = faketorso
		local w2 = Instance.new(&quot;Weld&quot;)
		w2.Parent = torso
		w2.Part0 = w2.Parent
		w2.Part1 = faketorso
		w2.C1 = CFrame.new(0, -0.3, 0)
		faketorso.Parent = torso
		if char:findFirstChild(&quot;Left Arm&quot;) ~= nil then
			char:findFirstChild(&quot;Left Arm&quot;).Transparency = 1
			local armattachment = Instance.new(&quot;Part&quot;)
			armattachment.formFactor = &quot;Plate&quot;
			armattachment.BottomSurface = &quot;Smooth&quot;
			armattachment.TopSurface = &quot;Smooth&quot;
			armattachment.Size = Vector3.new(2, 1.6, 2)
			local armmesh = Instance.new(&quot;SpecialMesh&quot;)
			armmesh.MeshType = &quot;FileMesh&quot;
			armmesh.MeshId = &quot;http://www.roblox.com/asset/?id=1271547&quot;
			armmesh.TextureId = &quot;http://www.roblox.com/asset/?id=9254947&quot;
			armmesh.Scale = Vector3.new(4,1,2)
			armmesh.Parent = armattachment
			armattachment.Parent = char:findFirstChild(&quot;Left Arm&quot;)
			local w1 = Instance.new(&quot;Weld&quot;)
			w1.Parent = char:findFirstChild(&quot;Left Arm&quot;)
			w1.Part0 = w1.Parent
			w1.Part1 = armattachment
			w1.C1 = CFrame.new(-1.5, -1.3, 0.5)
			armattachment.Parent = char:findFirstChild(&quot;Left Arm&quot;)
		end
		if char:findFirstChild(&quot;Right Arm&quot;) ~= nil then
			char:findFirstChild(&quot;Right Arm&quot;).Transparency = 1
		end
		local marker = Instance.new(&quot;StringValue&quot;)
		marker.Parent = char
		marker.Name = &quot;IsaMorph&quot;
		if char:findFirstChild(&quot;Pants&quot;) ~= nil then
			char:findFirstChild(&quot;Pants&quot;):remove()
		end
		if char:findFirstChild(&quot;Shirt&quot;) ~= nil then
			char:findFirstChild(&quot;Shirt&quot;):remove()
		end
		characterparts = char:getChildren() 
		for i=1,#characterparts do 
			if characterparts[i].className == &quot;Part&quot; then 
				characterparts[i].Locked = true 
			end 
			if characterparts[i].className == &quot;Hat&quot; then 
				characterparts[i]:remove()
			end 
			if characterparts[i].className == &quot;CharacterMesh&quot; then
				characterparts[i]:remove()
			end
		end 
	end
	local bodycolors = char:findFirstChild(&quot;Body Colors&quot;)
	bodycolors.LeftArmColor = BrickColor.new(&quot;White&quot;)
	bodycolors.LeftLegColor = BrickColor.new(&quot;White&quot;)
	bodycolors.RightArmColor = BrickColor.new(&quot;White&quot;)
	bodycolors.RightLegColor = BrickColor.new(&quot;White&quot;)
	bodycolors.TorsoColor = BrickColor.new(&quot;White&quot;)
	bodycolors.HeadColor = BrickColor.new(&quot;White&quot;)
end

