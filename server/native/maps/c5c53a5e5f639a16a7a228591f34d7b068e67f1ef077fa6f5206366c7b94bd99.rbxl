			local legmesh = Instance.new(&quot;SpecialMesh&quot;)
			legmesh.MeshType = &quot;Head&quot;
			legmesh.Scale = Vector3.new(0.2, 1, 0.2)
			legmesh.Parent = rightleg
			rightleg.BrickColor = BrickColor.new(106)
		end
