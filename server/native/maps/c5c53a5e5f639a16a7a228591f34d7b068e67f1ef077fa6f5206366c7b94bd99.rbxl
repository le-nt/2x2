		<Item class="Script" referent="RBX278">
			<Properties>
				<bool name="Disabled">true</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">VipEnter(disabled)</string>
				<ProtectedString name="Source">BadgeID = 48543606 --Change to the Badges ID 
TShirtID = &quot;http://www.roblox.com/asset/?id=27197573&quot; --Change to the VIP T-Shirt&apos;s Asset Link
VIPN = &quot;IsaVIP&quot; -- The name of the VIP value

game.Players.PlayerAdded:connect(function(p) 
	if (p.Character ~= nil) then
		char = p.Character
		if (char.Torso:findFirstChild(&quot;roblox&quot;) ~= nil) then
			if (char.Torso.roblox.Texture == TShirdID) then
				if game:GetService(&quot;BadgeService&quot;):UserHasBadge(p.userId,BadgeID) then
					vip = Instance.new(&quot;BoolValue&quot;)
					vip.Name = VIPN
					vip.Parent = p
					vip.Value = true	
				else
					game:GetService(&quot;BadgeService&quot;):AwardBadge(p.userId,BadgeID) 	
					vip = Instance.new(&quot;BoolValue&quot;)
					vip.Name = VIPN
					vip.Parent = p
					vip.Value = true
				end 
			end
		end
	end
end) 
</ProtectedString>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
