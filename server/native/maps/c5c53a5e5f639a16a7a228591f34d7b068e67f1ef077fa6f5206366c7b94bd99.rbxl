										<string name="Name">Fly Script</string>
										<ProtectedString name="Source">local hold = false 
local u = 40 
local add = 5 
local mode = &quot;Off&quot; 
local char = script.Parent.Parent.Parent.Character

function onSelected(mouse) 
	hint = Instance.new(&quot;Hint&quot;) 
	hint.Parent = script.Parent.Parent.Parent 
	hint.Name = &quot;Modes&quot; 
	hint.Text = &quot;User: &quot;..script.Parent.Parent.Parent.Name..&quot;|Speed: &quot;..u..&quot;|AddValue: &quot;..add..&quot;|Hover: &quot;..mode 
	mouse.Button1Down:connect(function() onButton1Down(mouse) end) 
	mouse.Button1Up:connect(function() onButton1Up(mouse) end) 
	mouse.KeyDown:connect(onKeyDown) 
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
end 

script.Parent.Selected:connect(onSelected) 

function onDeselected(mouse) 
	wait() 
	script.Parent.Parent.Parent:findFirstChild(&quot;Modes&quot;):remove() 
end 

script.Parent.Deselected:connect(onDeselected) 

function onButton1Down(mouse) 
	hold = true 
	p = Instance.new(&quot;Part&quot;) 
	p.Parent = char
	p.Locked = true 
	p.TopSurface = 0 
	p.BottomSurface = 0 
	p.CanCollide = false 
	p.Transparency = 1 
	p.formFactor = 0 
	p.Size = Vector3.new(3,1,3) 

	w = Instance.new(&quot;Weld&quot;) 
	w.Parent = char.Torso 
	w.Name = &quot;Board&quot; 
	w.Part0 = w.Parent 
	w.Part1 = p 
	w.C0 = CFrame.new(0,1.5,0) * CFrame.fromEulerAnglesXYZ(math.pi / 2,0,0) 

	bg = Instance.new(&quot;BodyGyro&quot;) 
	bg.Parent = p 
	bg.maxTorque = Vector3.new(999999999999,99999999999999999,0) 

	bv = Instance.new(&quot;BodyVelocity&quot;) 
	bv.Parent = p 
	bv.maxForce = Vector3.new(4e+020, 4e+020, 4e+020) 

	bf = Instance.new(&quot;BodyForce&quot;) 
	bf.Parent = p 
	bf.force = Vector3.new(0, 196 * p:GetMass(), 0) 

	char.Torso.Neck.C0 = CFrame.new(0,0,0) * CFrame.fromEulerAnglesXYZ(math.pi,math.pi,0)

	belly = Instance.new(&quot;Part&quot;) 
	belly.Parent = char
	belly.Locked = true 
	belly.TopSurface = 0 
	belly.BottomSurface = 0 
	belly.CanCollide = true 
	belly.Transparency = 0 
	belly.formFactor = 0 
	belly.Size = Vector3.new(2,1,1)
	belly.Name = &quot;Belly&quot;
	belly.BrickColor = BrickColor.new(150)

	mesh = Instance.new(&quot;SpecialMesh&quot;)
	mesh.MeshType = &quot;Head&quot;
	mesh.Parent = belly
	mesh.Scale = Vector3.new(1, 1.7, 1.5)

	mesh2 = Instance.new(&quot;SpecialMesh&quot;)
	mesh2.MeshType = &quot;FileMesh&quot;
	mesh2.MeshId = &quot;http://www.roblox.com/asset/?id=23264294&quot;
	mesh2.TextureId = &quot;http://www.roblox.com/asset/?id=23264295&quot;
	mesh2.Parent = char.Head
	mesh2.Scale = Vector3.new(1, 1, 1)
	mesh2.Name = &quot;Bathead&quot;

	weld = Instance.new(&quot;Weld&quot;) 
	weld.Parent = char.Head 
	weld.Name = &quot;BellyWeld&quot; 
	weld.Part0 = w.Parent 
	weld.Part1 = belly 
	weld.C0 = CFrame.new(0,0,-0.8) * CFrame.fromEulerAnglesXYZ(math.pi/2,math.pi/2,0) 

	local t = game:GetService(&quot;InsertService&quot;):LoadAsset(19399858)
	print(&quot;model loaded&quot;)
	t.Parent = char
	local characterparts = char:GetChildren()
	for z = 1, #characterparts do
		if characterparts[z].className == &quot;Hat&quot; then
			characterparts[z].Handle.Transparency = 1
			characterparts[z].Name = &quot;OldHat&quot;
		end
	end
	local model = char.Model
	local modelparts = model:GetChildren()
	for b = 1, #modelparts do
		local tool = modelparts[b]
		tool.Parent = char
		tool.Name = &quot;Hat&quot;
		if tool.Handle ~= nil then
			tool.Handle.Locked = true
			tool.Handle.Mesh.TextureId = &quot;http://www.roblox.com/asset/?id=36442826&quot;
		end
		print(&quot;hat put into character&quot;)
	end

	for c = 1, #characterparts do
		if characterparts[c].Name == &quot;Model&quot; then
			characterparts[c]:remove()
		end
		if characterparts[c].className == &quot;Part&quot; then
			if characterparts[c].Name ~= &quot;Head&quot; and characterparts[c].Name ~= &quot;Belly&quot; then
				characterparts[c].Transparency = 1
			end
		end
	end

	while hold == true do 
		wait() 
		char.Humanoid.Sit = true 
		bv.velocity = mouse.Hit.lookVector * u 
		bg.cframe = CFrame.new(bg.Parent.Position, mouse.Hit.p) 
		a = char.Torso 
		a[&quot;Left Hip&quot;].DesiredAngle = 0 
		a[&quot;Right Hip&quot;].DesiredAngle = 0 
		a[&quot;Right Shoulder&quot;].DesiredAngle = 3.1 
		a[&quot;Left Shoulder&quot;].DesiredAngle = 3.1 
	end 
end 

function onKeyDown(key) 
	if (key:lower() == &quot;v&quot;) then 
