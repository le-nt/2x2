			fakeleftarm.Parent = torso
			fakeleftarm.BrickColor = BrickColor.new(&quot;ReddishBrown&quot;)
			local w5=Instance.new(&quot;Weld&quot;)
			w5.Parent = torso
			w5.Part0=w5.Parent
			w5.Part1=fakeleftarm
			w5.C1=CFrame.new(1,-1, 0.1) * CFrame.Angles(0, 0, -math.pi/2)
			local armmesh2 = Instance.new(&quot;SpecialMesh&quot;)
			armmesh2.MeshType = &quot;FileMesh&quot;
			armmesh2.MeshId = &quot;http://www.roblox.com/asset/?id=1081197&quot;
			armmesh2.TextureId = &quot;http://www.roblox.com/asset/?id=18267468&quot;
			armmesh2.Scale = Vector3.new(0.5, 1, 0.8)
