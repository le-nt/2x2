						<ProtectedString name="Source">local debounce = false
function onButtonClicked()
if debounce == false then
debounce = true
script.Parent.Parent.Parent.Parent.Character.Humanoid.Sit = true
local g = Instance.new(&quot;BodyGyro&quot;)
g.Parent = script.Parent.Parent.Parent.Parent.Character.Torso
wait(1)
g:Remove()
wait(2)
debounce = false
end
end
script.Parent.MouseButton1Click:connect(onButtonClicked)
