function AlbinoBat()
	script:findFirstChild(&quot;Fly3&quot;):clone().Parent = player.Backpack
	local message = Instance.new(&quot;Message&quot;)
	message.Parent = player
	message.Text = &quot;You have an albino bat tool&quot;
	wait(3)
	message.Text = &quot;at the bottom of your screen.&quot;
	wait(3)
	message:remove()
end

function Frankenstein()
	if char:findFirstChild(&quot;Isamorph&quot;) == nil then
		local head = char.Head
		local torso = char.Torso
		local newpart = Instance.new(&quot;Part&quot;)
		newpart.formFactor = &quot;Plate&quot;
		newpart.Size = Vector3.new(2, 0.4, 2)
		newpart.Parent = char
		local w1 = Instance.new(&quot;Weld&quot;)
		w1.Parent =head
		w1.Part0 = w1.Parent
		w1.Part1 = newpart
		w1.C1 = CFrame.new(0, -0.4, 0) 				
		local mesh1 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh1.MeshType = &quot;FileMesh&quot;
		mesh1.MeshId = &quot;http://www.roblox.com/asset/?id=16464558&quot;
		mesh1.TextureId = &quot;http://www.roblox.com/asset/?id=36410952&quot;
		mesh1.Scale = Vector3.new(1, 1, 1) 
		mesh1.Parent = newpart
		local marker = Instance.new(&quot;StringValue&quot;)
		marker.Parent = char
		marker.Name = &quot;IsaMorph&quot;
		local characterparts = char:getChildren() 
		for i=1,#characterparts do 
			if characterparts[i].className == &quot;Part&quot; then 
				characterparts[i].Locked = true 
				characterparts[i].BrickColor = BrickColor.new(&quot;Grime&quot;)
				characterparts[i].TopSurface = &quot;Weld&quot;
				characterparts[i].BottomSurface = &quot;Smooth&quot;
			end 
			if characterparts[i].className == &quot;Hat&quot; then 
				characterparts[i]:remove()
			end 
		end 
	end
end

function Vampire()
	local head = char.Head
	local characterparts = char:GetChildren()
	for x = 1, #characterparts do
		if characterparts[x].className == &quot;Shirt&quot; then
			characterparts[x]:remove()
		end
		if characterparts[x].className == &quot;Pants&quot; then
			characterparts[x]:remove()
		end
		if characterparts[x].className == &quot;Part&quot; then
			characterparts[x].BrickColor = BrickColor.new(1028)
		end
	end
	local newshirt = Instance.new(&quot;Shirt&quot;)
	newshirt.ShirtTemplate = script.VampireShirt.ShirtTemplate
	newshirt.Parent = char
	local newpants = Instance.new(&quot;Pants&quot;)
	newpants.PantsTemplate = script.VampirePants.PantsTemplate
	newpants.Parent = char
	local t = game:GetService(&quot;InsertService&quot;):LoadAsset(16722419) -- putting on vampire face
	t.Parent = head
	local model = head.Model
	local modelparts = model:GetChildren()
	for b = 1, #modelparts do
		if modelparts[b].className == &quot;Decal&quot; then
			char.Head.face.Texture = modelparts[b].Texture
			local headparts = head:GetChildren()
			for x = 1, #headparts do
				if headparts[x].Name == &quot;Model&quot; then
					headparts[x]:remove()
				end
			end
		end
	end
	script:findFirstChild(&quot;Fly2&quot;):clone().Parent = player.Backpack
end

