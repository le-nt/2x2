function Mangler()
	if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
		local length = 3
		local color = 1003
		local script2 = script.ManglerAnimation:clone()
		local script3 = script.ManglerSegmentScript:clone()
		local head = char.Head
		local mesh = head:findFirstChild(&quot;Mesh&quot;) 
		mesh.MeshType = &quot;FileMesh&quot;
		mesh.MeshId = &quot;http://www.roblox.com/asset/?id=24103726&quot;
		mesh.Scale = Vector3.new(1.3, 1, 0.85) 
		mesh.TextureId= &quot;http://www.roblox.com/asset/?id=24103714&quot;
		local face = head.face
		local torso = char.Torso
		torso.Transparency = 1
		torso.CanCollide = false
		local w1 = Instance.new(&quot;Weld&quot;) 
		w1.Parent = torso
		w1.Part0 = w1.Parent
		w1.Part1 = head
		w1.C1 = CFrame.new(0, 1.8, 0.8)
		local newXcoordinate = head.Position.x
		local newYcoordinate = head.Position.y
		local newZcoordinate = head.Position.z
		-----------------------------------
		--SEGMENTS
		------------------------------------
		local part1 = Instance.new(&quot;Part&quot;) 
		part1.Transparency = 0 
		part1.Locked = true 
		part1.Size = Vector3.new(2.5,2.5,length) --length of each part -- size of each part! 
		part1.Anchored = true 
		part1.CanCollide = false 
		part1.Parent = char 
		part1.Name = &quot;Part1&quot; 
		part1.CFrame = CFrame.new(Vector3.new(newXcoordinate + 1, newYcoordinate, newZcoordinate)) 
		local mesh1 = Instance.new(&quot;SpecialMesh&quot;) 
		mesh1.MeshType = &quot;Sphere&quot;
		mesh1.Scale = Vector3.new(1, 1, 1) 
		mesh1.Parent = part1
		local part2 = part1:Clone() 
		part2.Parent = char 
		part2.Name = &quot;Part2&quot; 
		part2.CFrame = CFrame.new(Vector3.new(newXcoordinate + 2, newYcoordinate, newZcoordinate)) 
		local part3 = part2:Clone() 
		part3.Parent = char
		part3.Name = &quot;Part3&quot; 
		part3.CFrame =CFrame.new(Vector3.new(newXcoordinate + 3, newYcoordinate, newZcoordinate)) 
		local part4 = part3:Clone() 
		part4.Parent = char
		part4.Name = &quot;Part4&quot; 
		part4.CFrame = CFrame.new(Vector3.new(newXcoordinate + 4, newYcoordinate, newZcoordinate)) 
		local part5 = part4:Clone() 
		part5.Parent = char 
		part5.Name = &quot;Part5&quot; 
		part5.CFrame = CFrame.new(Vector3.new(newXcoordinate + 5, newYcoordinate, newZcoordinate)) 
		local part6 = part5:Clone() 
		part6.Parent = char 
		part6.Name = &quot;Part6&quot; 
		part6.CFrame = CFrame.new(Vector3.new(newXcoordinate + 6, newYcoordinate, newZcoordinate)) 
		local part7 = part6:Clone() 
		part7.Parent = char 
		part7.Name = &quot;Part7&quot; 
		part7.CFrame = CFrame.new(Vector3.new(newXcoordinate + 7, newYcoordinate, newZcoordinate)) 
		local part8 = part7:Clone() 
		part8.Parent = char 
		part8.Name = &quot;Part8&quot; 
		part8.CFrame = CFrame.new(Vector3.new(newXcoordinate + 8, newYcoordinate, newZcoordinate)) 
		local part9 = part8:Clone() 
		part9.Parent = char 
		part9.Name = &quot;Part9&quot; 
		part9.CFrame = CFrame.new(Vector3.new(newXcoordinate + 9, newYcoordinate, newZcoordinate)) 
		local part10 = part9:Clone() 
		part10.Parent = char 
		part10.Name = &quot;Part10&quot; 
		part10.CFrame = CFrame.new(Vector3.new(newXcoordinate + 10, newYcoordinate, newZcoordinate)) 
		----------------------------------
		--ARMS AND LEGS
		----------------------------------
		local rightarm = char:findFirstChild(&quot;Right Arm&quot;)
		if rightarm ~= nil then
			local armmesh = Instance.new(&quot;SpecialMesh&quot;)
			armmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
			armmesh.Parent = rightarm
		end
		rightarm.Transparency = 1
		local rightleg = char:findFirstChild(&quot;Right Leg&quot;)
		if rightleg~= nil then
			local legmesh = Instance.new(&quot;SpecialMesh&quot;)
			legmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
			legmesh.Parent = rightleg
		end
		rightleg.Transparency = 1
		local leftarm = char:findFirstChild(&quot;Left Arm&quot;)
		if leftarm~= nil then
			local armmesh = Instance.new(&quot;SpecialMesh&quot;)
			armmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
			armmesh.Parent = leftarm
		end
		leftarm.Transparency = 1
		local leftleg = char:findFirstChild(&quot;Left Leg&quot;)
		if leftleg ~= nil then
			local legmesh = Instance.new(&quot;SpecialMesh&quot;)
			legmesh.Scale = Vector3.new(0.2, 0.12, 0.3)
			legmesh.Parent = leftleg
		end
		leftleg.Transparency = 1
		--------------------------
		---OTHER STUFF
		--------------------------
		local marker = Instance.new(&quot;StringValue&quot;)
		marker.Parent = char
		marker.Name = &quot;IsaMorph&quot;
		script2.Parent = char
		script3.Parent = char
		local characterparts = char:getChildren() 
		for i=1,#characterparts do 
			if characterparts[i].className == &quot;Pants&quot; then
				characterparts[i]:remove()
			end
			if characterparts[i].className == &quot;Shirt&quot; then
				characterparts[i]:remove()
			end
			if characterparts[i].className == &quot;CharacterMesh&quot; then
				characterparts[i]:remove()
			end
			if characterparts[i].className == &quot;Part&quot; then 
				characterparts[i].Locked = true 
				characterparts[i].BottomSurface = &quot;Smooth&quot;
				characterparts[i].TopSurface = &quot;Weld&quot;
				characterparts[i].BrickColor = BrickColor.new(color)
			end 
			if characterparts[i].className == &quot;Hat&quot; then 
				characterparts[i]:remove()
			end 
		end 
		local bodycolors = char:findFirstChild(&quot;Body Colors&quot;)
		bodycolors.LeftArmColor = BrickColor.new(color)
		bodycolors.LeftLegColor = BrickColor.new(color)
		bodycolors.RightArmColor = BrickColor.new(color)
		bodycolors.RightLegColor = BrickColor.new(color)
		bodycolors.TorsoColor = BrickColor.new(color)
		bodycolors.HeadColor = BrickColor.new(color)
	end
end
