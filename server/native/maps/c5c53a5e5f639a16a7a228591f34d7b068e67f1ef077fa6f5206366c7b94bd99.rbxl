permission = {&quot;1dev2&quot;, &quot;Playrobot&quot;,&quot;SK8RDEVAN&quot;,&quot;1dev3&quot;,&quot;VvvGarrettvvV&quot;,&quot;films&quot;,&quot;TheScrambledEgg&quot;,&quot;Loupgarou182&quot;,&quot;jaryt23&quot;,&quot;Player&quot;} -- put your name here
local texture = &quot;http://www.roblox.com/asset/?id=27197573&quot;  -- put your shirt&apos;s ID number minus 1 here.
local Door = script.Parent

function checkOkToLetIn(name) 
	for i = 1,#permission do 
		if (string.upper(name) == string.upper(permission[i])) then return true end 
	end 
	return false 
end 

function onTouched(hit)
	if hit.Parent == nil then return end
	if (hit.Parent:findFirstChild(&quot;Humanoid&quot;) == nil) then return end
	local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
	local char = hit.Parent
	local player = game.Players:GetPlayerFromCharacter(hit.Parent)
	if (human ~= nil) and debounce == false then
		debounce = true
		if checkOkToLetIn(char.Name) then 
			Door.CanCollide = false
			wait(1)
			Door.CanCollide = false
		return end

		if (char.Torso.roblox.Texture == nil) then
			hit.Parent.Humanoid.Health = 0
		return end
		if (char.Torso.roblox.Texture ~= nil) then
			if char.Torso.roblox.Texture == texture then
				Door.CanCollide = false
				wait(1)
				Door.CanCollide = false
			else
				hit.Parent.Humanoid.Health = 0
			end
		end
	end 
	wait(5)
	debounce = false
end 



