		mesh1.Scale = Vector3.new(1.5, 2, 1) 
		mesh1.Parent = body
		local w1 = Instance.new(&quot;Weld&quot;)----------------FAKE TORSO  POSITION
		w1.Parent = torso
		w1.Part0 = w1.Parent
		w1.Part1 = body
		w1.C1 = CFrame.new(0, 1.8, 0.3) ---- adjusted third number from 1 to 0.5
		local w2 = Instance.new(&quot;Weld&quot;) -------------HEAD POSITION
