	end 

	if (key:lower() == &quot;n&quot;) then 
		wait() 
		char.Torso.Anchored = true 
		mode = &quot;On&quot; 
		hint.Text = &quot;User: &quot;..script.Parent.Parent.Parent.Name..&quot;|Speed: &quot;..u..&quot;|AddValue: &quot;..add..&quot;|Hover: &quot;..mode 
	end 

	if (key:lower() == &quot;m&quot;) then 
		wait() 
		char.Torso.Anchored = false 
		mode = &quot;Off&quot; 
		hint.Text = &quot;User: &quot;..script.Parent.Parent.Parent.Name..&quot;|Speed: &quot;..u..&quot;|AddValue: &quot;..add..&quot;|Hover: &quot;..mode 
	end 
end 

function onButton1Up(mouse) 
	hold = false 
	char.Torso.Neck.C0 = CFrame.new(0,1,0) * CFrame.fromEulerAnglesXYZ(math.pi / 2,math.pi,0) 
	for i = 1, 2 do 
		char.Humanoid.Jump = true 
		char.Humanoid.Sit = false 
		wait() 
	end 
	char.Part:remove() 
	char.Head.Bathead:remove()
	local characterparts = char:GetChildren()
	for c = 1, #characterparts do
		if characterparts[c].Name == &quot;Hat&quot; then
			characterparts[c]:remove()
		end
		if characterparts[c].Name == &quot;OldHat&quot; then
			characterparts[c].Handle.Transparency = 0
		end
		if characterparts[c].className == &quot;Part&quot; then
			characterparts[c].Transparency = 0

			if characterparts[c].Name ==&quot;Belly&quot; then
				characterparts[c]:remove()
			end


		end
	end
end 
