		char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = BrickColor.new(106)
		char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = BrickColor.new(106)
		char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = BrickColor.new(106)
		char:findFirstChild(&quot;Body Colors&quot;).HeadColor = BrickColor.new(106)
	end
