			<Item class="Script" referent="RBX13195">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SandwichScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;

enabled = true




function onActivated()
	if not enabled  then
		return
	end

	enabled = false
	Tool.GripForward = Vector3.new(.995, -.0995, -0)
	Tool.GripPos = Vector3.new(.3, -.8, 1.55)
	Tool.GripRight = Vector3.new(0, 0, 1)
	Tool.GripUp = Vector3.new(0.0995, .995, 0)


	Tool.Handle.DrinkSound:Play()

	wait(.8)
	
	local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if (h ~= nil) then
		if (h.MaxHealth &gt; h.Health + 70) then
			h.Health = h.Health + 70
		else	
			h.Health = h.MaxHealth
		end
	end

	Tool.GripForward = Vector3.new(-.989, 0, .149)
	Tool.GripPos = Vector3.new(.55, -.1, -.1)
	Tool.GripRight = Vector3.new(-.149, 0, -.989)
	Tool.GripUp = Vector3.new(0,1,0)


	enabled = true
	wait(3)
	script.Parent:remove()

end

function onEquipped()
	Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
