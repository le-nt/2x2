function Close()
	script.Parent:remove()
end

function pickall()
	frame.Colors.Parts.Value = &quot;all&quot;
end
function pickallbuthead()
	frame.Colors.Parts.Value = &quot;allbuthead&quot;
end
function pickhead()
	frame.Colors.Parts.Value = &quot;head&quot;
end
function picktorso()
	frame.Colors.Parts.Value = &quot;torso&quot;
end
function pickleftleg()
	frame.Colors.Parts.Value = &quot;leftleg&quot;
end
function pickrightleg()
	frame.Colors.Parts.Value = &quot;rightleg&quot;
end
function pickrightarm()
	frame.Colors.Parts.Value = &quot;rightarm&quot;
end
function pickleftarm()
	frame.Colors.Parts.Value = &quot;leftarm&quot;
end

function PaintMe(part)
	local allstuff = char:GetChildren()
	if frame.Colors.Parts.Value == &quot;head&quot; then
		char:findFirstChild(&quot;Body Colors&quot;).HeadColor = part.BackgroundColor
	end
	if frame.Colors.Parts.Value == &quot;allbuthead&quot; then
		for as = 1, #allstuff do
			if allstuff[as].Name ~= &quot;Head&quot; and allstuff[as].className == &quot;Part&quot; then
				allstuff[as].BrickColor = part.BackgroundColor
			end
		end
		char:findFirstChild(&quot;Body Colors&quot;).LeftArmColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).LeftLegColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = part.BackgroundColor
	end
	if frame.Colors.Parts.Value == &quot;all&quot; then
		for as = 1, #allstuff do
			if allstuff[as].className == &quot;Part&quot; then
				allstuff[as].BrickColor = part.BackgroundColor
			end
		end
		char:findFirstChild(&quot;Body Colors&quot;).LeftArmColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).LeftLegColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).HeadColor = part.BackgroundColor
	end	
	if frame.Colors.Parts.Value == &quot;torso&quot; then
		char.Torso.BrickColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).TorsoColor = part.BackgroundColor
	end
	if frame.Colors.Parts.Value == &quot;leftleg&quot; then
		char:findFirstChild(&quot;Left Leg&quot;).BrickColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).LeftLegColor = part.BackgroundColor
	end
	if frame.Colors.Parts.Value == &quot;rightleg&quot; then
		char:findFirstChild(&quot;Body Colors&quot;).RightLegColor = part.BackgroundColor
	end
	if frame.Colors.Parts.Value == &quot;leftarm&quot; then
		char:findFirstChild(&quot;Left Arm&quot;).BrickColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).LeftArmColor = part.BackgroundColor
	end
	if frame.Colors.Parts.Value == &quot;rightarm&quot; then
		char:findFirstChild(&quot;Right Arm&quot;).BrickColor = part.BackgroundColor
		char:findFirstChild(&quot;Body Colors&quot;).RightArmColor = part.BackgroundColorZ
	end	
end

function MeshMe(part)
	if char:findFirstChild(&quot;IsaMorph&quot;) == nil then
		local allstuff = char:GetChildren()
		if frame.Colors.Parts.Value == &quot;head&quot; then return end
		if frame.Colors.Parts.Value == &quot;allbuthead&quot; then
			for as = 1, #allstuff do
				if allstuff[as].className == &quot;CharacterMesh&quot; then
					allstuff[as]:remove()
				end
			end
			local meshes = part:GetChildren()
			for m = 1, #meshes do
				local newmesh = Instance.new(&quot;CharacterMesh&quot;)
				newmesh.BaseTextureId = meshes[m].BaseTextureId
				newmesh.BodyPart = meshes[m].BodyPart
				newmesh.MeshId = meshes[m].MeshId
				newmesh.Name = meshes[m].Name
				newmesh.OverlayTextureId = meshes[m].OverlayTextureId
				newmesh.Parent = char
			end
		end
		if frame.Colors.Parts.Value == &quot;all&quot; then
			for as = 1, #allstuff do
				if allstuff[as].className == &quot;CharacterMesh&quot; then
					allstuff[as]:remove()
				end
			end
			local meshes = part:GetChildren()
			for m = 1, #meshes do
				local newmesh = Instance.new(&quot;CharacterMesh&quot;)
				newmesh.BaseTextureId = meshes[m].BaseTextureId
				newmesh.BodyPart = meshes[m].BodyPart
				newmesh.MeshId = meshes[m].MeshId
				newmesh.Name = meshes[m].Name
				newmesh.OverlayTextureId = meshes[m].OverlayTextureId
				newmesh.Parent = char
			end
		end	
		if frame.Colors.Parts.Value == &quot;torso&quot; then
				local newmesh = Instance.new(&quot;CharacterMesh&quot;)
				newmesh.BaseTextureId = part.Torso.BaseTextureId
				newmesh.BodyPart = part.Torso.BodyPart
				newmesh.MeshId = part.Torso.MeshId
				newmesh.Name = part.Torso.Name
				newmesh.OverlayTextureId = part.Torso.OverlayTextureId
				newmesh.Parent = char
		end
		if frame.Colors.Parts.Value == &quot;leftleg&quot; then
				local newmesh = Instance.new(&quot;CharacterMesh&quot;)
				newmesh.BaseTextureId = part.LeftLeg.BaseTextureId
				newmesh.BodyPart = part.LeftLeg.BodyPart
				newmesh.MeshId = part.LeftLeg.MeshId
				newmesh.Name = part.LeftLeg.Name
				newmesh.OverlayTextureId = part.LeftLeg.OverlayTextureId
				newmesh.Parent = char
		end
		if frame.Colors.Parts.Value == &quot;rightleg&quot; then
				local newmesh = Instance.new(&quot;CharacterMesh&quot;)
				newmesh.BaseTextureId = part.RightLeg.BaseTextureId
				newmesh.BodyPart = part.RightLeg.BodyPart
				newmesh.MeshId = part.RightLeg.MeshId
				newmesh.Name = part.RightLeg.Name
				newmesh.OverlayTextureId = part.RightLeg.OverlayTextureId
				newmesh.Parent = char
		end
		if frame.Colors.Parts.Value == &quot;leftarm&quot; then
				local newmesh = Instance.new(&quot;CharacterMesh&quot;)
				newmesh.BaseTextureId = part.LeftArm.BaseTextureId
				newmesh.BodyPart = part.LeftArm.BodyPart
				newmesh.MeshId = part.LeftArm.MeshId
				newmesh.Name = part.LeftArm.Name
				newmesh.OverlayTextureId = part.LeftArm.OverlayTextureId
				newmesh.Parent = char
		end
		if frame.Colors.Parts.Value == &quot;rightarm&quot; then
				local newmesh = Instance.new(&quot;CharacterMesh&quot;)
				newmesh.BaseTextureId = part.RightArm.BaseTextureId
				newmesh.BodyPart = part.RightArm.BodyPart
				newmesh.MeshId = part.RightArm.MeshId
				newmesh.Name = part.RightArm.Name
				newmesh.OverlayTextureId = part.RightArm.OverlayTextureId
				newmesh.Parent = char
		end
	end
end

function Lock()
	local characterparts = char:GetChildren()
	for c = 1,#characterparts do	
		if characterparts[c].className == &quot;Part&quot; then
			characterparts[c].Locked = true
		end
		if characterparts[c].className == &quot;Hat&quot; then
			characterparts[c].Handle.Locked = true
		end
	end
end

function Unlock()
	local characterparts = char:GetChildren()
	for c = 1,#characterparts do	
		if characterparts[c].className == &quot;Part&quot; then
			characterparts[c].Locked = false
		end
		if characterparts[c].className == &quot;Hat&quot; then
			characterparts[c].Handle.Locked = false
		end
	end
end

function SeeHalloween()
print(&quot;seeme&quot;)
	if (game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 36142135)) then -- Put Halloween badge # here
		frame.Halloween.Hiding.Visible = true
	else
		local message = Instance.new(&quot;Message&quot;)
		message.Text = &quot;You need the Halloween Badge to use this&quot;
		message.Parent = player
		wait (3)
		message:remove()
	end
end

function SeeWinter()
print(&quot;seeme&quot;)
	if (game:GetService(&quot;BadgeService&quot;):UserHasBadge(player.userId, 41299034)) then -- Put Winter Badge # here
		frame.Winter.Hiding.Visible = true
	else
		local message = Instance.new(&quot;Message&quot;)
		message.Text = &quot;You need the Winter Badge to use this&quot;
		message.Parent = player
		wait (3)
		message:remove()
	end
end

function TeleportNorthPole()
	char[&quot;Torso&quot;].CFrame=CFrame.new(Vector3.new(-1.5, 106.4, 1679))
end

function TeleportRobloxaville()
	char[&quot;Torso&quot;].CFrame=CFrame.new(Vector3.new(-4.3, 53, 314.5))
end

