			<Item class="Script" referent="RBX13133">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ToolScript</string>
					<ProtectedString name="Source">script.Parent = script.Parent.Parent.Parent

function Tools()

local ot = script.Parent.Backpack:GetChildren()

for i=1, # ot do
if ot[i].Name == &quot;Give $5&quot; or ot[i].Name == &quot;Fly&quot; or ot[i].Name == &quot;Parachute&quot; or ot[i].Name == &quot;Grocery Bag&quot; or ot[i].Name == &quot;Laptop&quot; or ot[i].Name == &quot;Book&quot; or ot[i].Name == &quot;Pencil&quot; or ot[i].Name == &quot;Pencil&amp;Paper&quot; or ot[i].Name == &quot;Umbrella&quot; or ot[i].Name == &quot;Coffee Cup&quot; then
else
ot[i]:Remove()
end
end

if script.Parent.TeamColor == BrickColor.new(&quot;Bright blue&quot;) then
local t = game.Lighting.Pistol:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Really black&quot;) then
local t = game.Lighting.Pistol:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;White&quot;) then
local t = game.Lighting.Otoscope:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Bright red&quot;) then
local t = game.Lighting[&quot;Fire Extinguisher&quot;]:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Light orange&quot;) then
local t = game.Lighting.Basketball:Clone()
t.Parent = script.Parent.Backpack
end

if script.Parent.TeamColor == BrickColor.new(&quot;Brown&quot;) then
for i=1, # ot do
ot[i]:Remove()
end
end

end

script.Parent.Changed:connect(Tools)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
