		<Item class="Script" referent="RBX833">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">MasterScript</string>
				<ProtectedString name="Source">local waitTime = 60

local imakethis = 5

function givememoney() 
local players = game.Players:GetChildren() 
for x=1, #players do 
players[x].Value.Value = players[x].Value.Value + imakethis 
--players[x].PlayerGui[&quot;Reset Gui&quot;].Money.Money.Value.Value = players[x].PlayerGui[&quot;Reset Gui&quot;].Money.Money.Value.Value + imakethis
end 
end 


object = script.Parent.Buyers
if (object ~= nil) and (object ~= game.Workspace) then 
model = object 

messageText = &quot;...[fixing broken buttons]...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()  
--while true do 

function fix()
--wait(180) 

message.Parent = game.Workspace
model:remove() 

wait(2)

model = backup:clone() 
model.Parent = game.Workspace 
model:makeJoints() 
message.Parent = nil 
end 
end

function ring()
game.Workspace.Bell1.Bell:Play()
game.Workspace.Bell2.Bell:Play()
wait(.02)
