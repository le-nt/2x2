			<Item class="Script" referent="RBX13250">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Teleporter</string>
					<ProtectedString name="Source">--

--Enter the name of the model you want to go to here. In Explorer, find the name of the brick, and drag or copy
-- An &quot;Enabled&quot; to it. It should work. (It will, if you don&apos;t type it wrong.)
------------------------------------
modelname=&quot;tele2&quot; 
------------------------------------
--          ^ Name that.

function onTouched(part)
	if part.Parent ~= nil then
	local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
		if h~=nil then
			local teleportfrom=script.Parent.Enabledd.Value
			if teleportfrom~=0 then
				if h==humanoid then
				return
				end
				local teleportto=script.Parent.Parent:findFirstChild(modelname)
				if teleportto~=nil then
					local torso = h.Parent.Torso
					local location = {teleportto.Position}
					local i = 1

					local x = location[i].x
					local y = location[i].y
					local z = location[i].z
				
					x = x + math.random(-1, 1)
					z = z + math.random(-1, 1)
					y = y + math.random(2, 3)

					local cf = torso.CFrame
					local lx = 0
					local ly = y
					local lz = 0
					
					local m = Instance.new(&quot;Message&quot;)
					m.Parent = game.Players[h.Parent.Name]
					m.Text = &quot;You have been sent to jail!&quot;
					
					script.Parent.Enabledd.Value=0
					teleportto.Enabledd.Value=0
					torso.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))
					wait(3)
					game.Players[h.Parent.Name].Message:Remove()
					script.Parent.Enabledd.Value=1
					teleportto.Enabledd.Value=1
				else
					print(&quot;Could not find teleporter!&quot;)
				end
			end
		end
	end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
