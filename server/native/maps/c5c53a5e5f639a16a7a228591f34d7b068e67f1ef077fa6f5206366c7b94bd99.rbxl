						<string name="Name">Script</string>
						<ProtectedString name="Source">script.Parent.Parent.Parent.Parent.Character.Humanoid.WalkSpeed = 14
local debounce = false
function onButtonClicked()
if debounce == false then
debounce = true
script.Parent.Parent.Parent.Parent.Character.Humanoid.WalkSpeed = 30
wait(5)
script.Parent.Parent.Parent.Parent.Character.Humanoid.WalkSpeed = 14
wait(2)
debounce = false
end
end
script.Parent.MouseButton1Click:connect(onButtonClicked)
</ProtectedString>
