function storm()
local dg = game.Workspace.DriveGround:GetChildren()
local m = math.random(1,2)
if m == 1 then 
print(&quot;Clear...&quot;)
for i=1, #dg do
if dg[i].className == &quot;Part&quot; then
dg[i].Friction = 1.2
end
end
game.Lighting.Ambient = Color3.new(0.75,0.75,0.75)
game.Workspace.StormSounds.Disabled = true
game.Workspace.StormSounds.Rain1:Stop()
game.Workspace.StormSounds.Rain2:Stop()
game.Workspace.StormSounds.Thunder:Stop()
end
if m == 2 then 
print(&quot;...Storm!&quot;)
for i=1, #dg do
if dg[i].className == &quot;Part&quot; then
dg[i].Friction = 0.7
end
end
game.Lighting.Ambient = Color3.new(0.3,0.3,0.3) --------BLAHAHA
game.Workspace.StormSounds.Disabled = false
end
end


function nostorm()
local dg = game.Workspace.DriveGround:GetChildren()
print(&quot;Clear...&quot;)
for i=1, #dg do
if dg[i].className == &quot;Part&quot; then
dg[i].Friction = 1.2
end
end
game.Lighting.Ambient = Color3.new(0.75,0.75,0.75)
game.Workspace.StormSounds.Disabled = true
game.Workspace.StormSounds.Rain1:Stop()
game.Workspace.StormSounds.Rain2:Stop()
game.Workspace.StormSounds.Thunder:Stop()
end

function cleanUp() 
local cs = game.Workspace:GetChildren() 
for i, v in pairs(cs) do 
if v.className == &quot;Tool&quot; or v.className == &quot;Hat&quot; then 
v:Remove() 
end 
end 
end

