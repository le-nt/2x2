		lankle.Name = &quot;LeftAnkle&quot;
		lankle.formFactor = &quot;Plate&quot;
		lankle.Size = Vector3.new(0.5,0.5,1) 
		local w3 = Instance.new(&quot;Weld&quot;)
		w3.Parent = leftleg
		w3.Part0 = w3.Parent
		w3.Part1 = lankle
		w3.C1 = CFrame.new(0, 0.2, 0.35) *CFrame.fromEulerAnglesXYZ(math.pi/2, 0, 0) 
		local lanklemesh = Instance.new(&quot;SpecialMesh&quot;)
		lanklemesh.Parent = lankle
		lanklemesh.MeshType = &quot;Head&quot;
		lanklemesh.Scale = Vector3.new(0.5, 2, 1)
		local rankle = Instance.new(&quot;Part&quot;)
		rankle.BrickColor = BrickColor.new(1)
		rankle.Parent = char
		rankle.Position = rightleg.Position
		rankle.Name = &quot;RightAnkle&quot;
		rankle.formFactor = &quot;Plate&quot;
		rankle.Size = Vector3.new(0.5,0.5,0.5) 
		local w4 = Instance.new(&quot;Weld&quot;)
		w4.Parent = rightleg
		w4.Part0 = w4.Parent
		w4.Part1 = rankle
		w4.C1 = CFrame.new(0, 0.2, 0.35) *CFrame.fromEulerAnglesXYZ(math.pi/2, 0, 0) 
		local ranklemesh = Instance.new(&quot;SpecialMesh&quot;)
		ranklemesh.Parent = rankle
		ranklemesh.MeshType = &quot;Head&quot;
		ranklemesh.Scale = Vector3.new(0.5, 2, 1)
		local lhand = Instance.new(&quot;Part&quot;)
		lhand.BrickColor = head.BrickColor
		lhand.Parent = char
		lhand.Position = leftarm.Position
		lhand.Name = &quot;Lefthand&quot;
		lhand.formFactor = &quot;Plate&quot;
		lhand.Size = Vector3.new(0.5,0.5,0.5) 
		local w5 = Instance.new(&quot;Weld&quot;)
		w5.Parent = leftarm
		w5.Part0 = w5.Parent
		w5.Part1 = lhand
		w5.C1 = CFrame.new(0, 0.5, 0) 
		local lhandmesh = Instance.new(&quot;SpecialMesh&quot;)
		lhandmesh.Parent = lhand
		lhandmesh.MeshType = &quot;Head&quot;
		lhandmesh.Scale = Vector3.new(0.5, 1, 0.5)
		local rhand = Instance.new(&quot;Part&quot;)
		rhand.BrickColor = head.BrickColor
		rhand.Parent = char
		rhand.Position = rightarm.Position
		rhand.Name = &quot;Righthand&quot;
		rhand.formFactor = &quot;Plate&quot;
		rhand.Size = Vector3.new(0.5,0.5,0.5) 
		local w6 = Instance.new(&quot;Weld&quot;)----------------FAKE TORSO  POSITION
		w6.Parent = rightarm
