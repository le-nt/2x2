			local armmesh = Instance.new(&quot;SpecialMesh&quot;)
			armmesh.MeshType = &quot;FileMesh&quot;
			armmesh.MeshId = &quot;http://www.roblox.com/asset/?id=1081197&quot;
			armmesh.TextureId = &quot;http://www.roblox.com/asset/?id=18267468&quot;
			armmesh.Scale = Vector3.new(0.5, 1, 0.8)
			armmesh.Parent = fakerightarm
		end
		local rightleg = char:findFirstChild(&quot;Right Leg&quot;)
