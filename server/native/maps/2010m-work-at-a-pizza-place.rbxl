function reset()
&#9;script.Parent.Parent.Parent.Character.Humanoid.Health = 0
end

function vote()
&#9;local p = script.Parent:GetChildren()
&#9;if #p &gt; 4 then return end
&#9;local yo = 19
&#9;local g = game.Players:GetChildren()
&#9;for i = 1,#g do
&#9;&#9;if g[i] ~= script.Parent.Parent.Parent then
&#9;&#9;&#9;local t = script.Parent.Vote:clone()
&#9;&#9;&#9;t.Text = g[i].Name
&#9;&#9;&#9;t.Name = &quot;Person&quot;
&#9;&#9;&#9;t.Position = UDim2.new(0,700,0,yo)
&#9;&#9;&#9;t.Parent = script.Parent
&#9;&#9;&#9;local y = script.Script:clone()
&#9;&#9;&#9;y.Disabled = false
&#9;&#9;&#9;y.Parent = t
&#9;&#9;&#9;yo = yo + 19
&#9;&#9;end
&#9;end
end









script.Parent.Home.MouseButton1Down:connect(home)
script.Parent.Vote.MouseButton1Down:connect(vote)
script.Parent.Reset.MouseButton1Down:connect(reset)</ProtectedString>
