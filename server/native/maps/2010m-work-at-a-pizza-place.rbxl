function check(s)
&#9;local g = s.Character:GetChildren()
&#9;for i = 1,#g do
&#9;&#9;if g[i].Name == &quot;ne&quot; then
&#9;&#9;&#9;g[i]:remove()
&#9;&#9;end
&#9;end
end


function onChatted(msg, recipient, speaker) 
&#9;a = speaker.Name
&#9;char = nil
&#9;check(speaker)
&#9;if speaker ~= nil and speaker.Character ~= nil then
&#9;&#9;if string.len(msg) &gt; 25 then
&#9;&#9;&#9;char = string.sub(msg,1,25) .. &quot;...&quot;
&#9;&#9;else
&#9;&#9;&#9;char = msg
&#9;&#9;end
&#9;&#9;speaker.Character.Name = char

&#9;&#9;local s = script.ne:clone()
&#9;&#9;s.Disabled = false
&#9;&#9;s.Parent = speaker.Character


&#9;&#9;local g = Instance.new(&quot;NumberValue&quot;)
&#9;&#9;g.Name = &quot;Time&quot;
&#9;&#9;g.Value = (string.len(char) / 3) + 1
&#9;&#9;g.Parent =s 

&#9;&#9;local ss = Instance.new(&quot;StringValue&quot;)
&#9;&#9;ss.Name = &quot;name&quot;
&#9;&#9;ss.Value = a
&#9;&#9;ss.Parent = s
&#9;&#9;a = nil
&#9;&#9;char = nil
&#9;end
end











function onPlayerEntered(newPlayer)
&#9;wait(0.5)
&#9;newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;


&#9;local c = Instance.new(&quot;IntValue&quot;)
&#9;c.Name = &quot;Money&quot;
&#9;c.Value = 30
&#9;c.Parent = stats

&#9;stats.Parent = newPlayer


&#9;local a = Instance.new(&quot;IntValue&quot;)
&#9;a.Name = &quot;Cashier&quot;
&#9;a.Value = 0
&#9;a.Parent = newPlayer

&#9;local aa = Instance.new(&quot;IntValue&quot;)
&#9;aa.Name = &quot;Cook&quot;
&#9;aa.Value = 0
&#9;aa.Parent = newPlayer

&#9;local aaa = Instance.new(&quot;IntValue&quot;)
&#9;aaa.Name = &quot;Boxer&quot;
&#9;aaa.Value = 0
&#9;aaa.Parent = newPlayer


&#9;local aaaa = Instance.new(&quot;IntValue&quot;)
&#9;aaaa.Name = &quot;Delivery&quot;
&#9;aaaa.Value = 0
&#9;aaaa.Parent = newPlayer

&#9;local aaaaa = Instance.new(&quot;IntValue&quot;)
&#9;aaaaa.Name = &quot;Supplier&quot;
&#9;aaaaa.Value = 0
&#9;aaaaa.Parent = newPlayer

&#9;local f = Instance.new(&quot;IntValue&quot;)
&#9;f.Name = &quot;Raise&quot;
&#9;f.Parent = newPlayer

local lol = Instance.new(&quot;IntValue&quot;)
lol.Name = &quot;Vote&quot;
lol.Parent = newPlayer


local llol = Instance.new(&quot;ObjectValue&quot;)
llol.Name = &quot;Voter&quot;
llol.Parent = newPlayer
end

game.Players.ChildAdded:connect(onPlayerEntered)


wait(5)
if game.Players:FindFirstChild(&quot;Dued1&quot;) ~= nil and game.Players:FindFirstChild(&quot;leaderstats&quot;) == nil then
onPlayerEntered(game.Players.Dued1)
end





function change()
game.Workspace.Tada:Play()
local g = game.Players:GetChildren()
for i = 1,#g do
if g[i].Character ~= nil and g[i]:FindFirstChild(&quot;leaderstats&quot;) ~= nil then
g[i].leaderstats.Money.Value = g[i].leaderstats.Money.Value + 10
end
end
if game.Workspace.EOD.Value ~= nil then
game.Workspace.EOD.Value.leaderstats.Money.Value = game.Workspace.EOD.Value.leaderstats.Money.Value + 10
end
end
script.Parent.Success.Changed:connect(change)


function leave(player)
local g = game.Workspace:GetChildren()
for i = 1,#g do
if g[i].Name == &quot;House&quot; and g[i].Owner.Value == player then
g[i].BKUP.Value.Parent = game.Workspace
g[i].BKUP.Value:MakeJoints()
g[i]:remove()
end
end
end
game.Players.ChildRemoved:connect(leave)








--[[while true do
&#9;wait(5)
&#9;local g = game.Players:GetChildren()
&#9;for i = 1,#g do
&#9;&#9;if 
&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):UserHasBadge(g[i].userId, 14677969) == true and
&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):UserHasBadge(g[i].userId, 14677914) == true and
&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):UserHasBadge(g[i].userId, 14678075) == true and
&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):UserHasBadge(g[i].userId, 14678118)  == true and
&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):UserHasBadge(g[i].userId, 14678224) == true then
&#9;&#9;&#9;if g[i].Backpack:FindFirstChild(&quot;Fly&quot;) == nil then
&#9;&#9;&#9;&#9;local t = game.Lighting.Storage.Fly:clone()
&#9;&#9;&#9;&#9;t.Parent = g[i].Backpack
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(g[i].userId, 15902941)
&#9;&#9;&#9;end&#9;
&#9;&#9;end
&#9;&#9;if g[i]:FindFirstChild(&quot;leaderstats&quot;) ~= nil then
&#9;&#9;&#9;if g[i].Cook.Value &gt;= 50 then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(g[i].userId, 14677969)
&#9;&#9;&#9;end
&#9;&#9;&#9;if g[i].Cashier.Value &gt;= 100 then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(g[i].userId, 14677914)
&#9;&#9;&#9;end
&#9;&#9;&#9;if g[i].Boxer.Value &gt;= 75 then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(g[i].userId, 14678075)
&#9;&#9;&#9;end
&#9;&#9;&#9;if g[i].Delivery.Value &gt;= 30 then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(g[i].userId, 14678118)
&#9;&#9;&#9;end
&#9;&#9;&#9;if g[i].Supplier.Value &gt;= 100 then
&#9;&#9;&#9;&#9;game:GetService(&quot;BadgeService&quot;):AwardBadge(g[i].userId, 14678224)
&#9;&#9;&#9;end
&#9;&#9;end
