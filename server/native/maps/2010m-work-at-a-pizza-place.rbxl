&#9;&#9;&#9;game.Lighting.Storage.Logo:clone().Parent = script.Parent
&#9;&#9;&#9;if hit:FindFirstChild(&quot;Owner&quot;) ~= nil and hit.Owner.Value ~= nil then
&#9;&#9;&#9;&#9;hit.Owner.Value.Boxer.Value = hit.Owner.Value.Boxer.Value + 1
&#9;&#9;&#9;end
