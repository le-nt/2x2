while true do
&#9;wait(60)
&#9;local g = game.Workspace:GetChildren()
&#9;for i = 1,#g do
&#9;&#9;if g[i]:FindFirstChild(&quot;Refill&quot;) ~= nil and g[i].Position.y &lt; 3 then
&#9;&#9;&#9;g[i]:remove()
&#9;&#9;end
&#9;end
&#9;local max = 0
&#9;local player = nil
&#9;local e = game.Players:GetChildren()
&#9;for i = 1,#e do
&#9;&#9;if e[i]:FindFirstChild(&quot;Vote&quot;) ~= nil and e[i].Vote.Value &gt; max then
&#9;&#9;&#9;max = e[i].Vote.Value
&#9;&#9;&#9;player = e[i]
&#9;&#9;end
&#9;end
&#9;if player ~= nil and player.TeamColor ~= BrickColor.new(28) then
&#9;&#9;player.TeamColor = BrickColor.new(28)
&#9;&#9;local t = game.Players:GetChildren()
&#9;&#9;for o = 1,#t do
&#9;&#9;&#9;if t[i].TeamColor == BrickColor.new(28) and t[i] ~= player then
&#9;&#9;&#9;&#9;t[i].TeamColor = BrickColor.new(21)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end



