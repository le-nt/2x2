						<ProtectedString name="Source">while true do
wait(10)
if script.Parent.Parent.Owner.Value ~= nil then
script.Parent.Name = script.Parent.Parent.House.Value .. &quot;(&quot; ..script.Parent.Parent.Owner.Value.Name .. &quot;&apos;s House)&quot;
else
script.Parent.Name = script.Parent.Parent.House.Value
end
end </ProtectedString>
