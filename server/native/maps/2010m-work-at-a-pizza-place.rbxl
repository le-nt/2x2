function onButton1Down(mouse)&#9;
&#9;if mouse.Target == nil then return end
&#9;&#9;
&#9;if mouse.Target.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and game.Players:GetPlayerFromCharacter(mouse.Target.Parent) ~= nil and option == false and s.TeamColor == BrickColor.new(28) then
&#9;&#9;option = true
&#9;&#9;targey = game.Players:GetPlayerFromCharacter(mouse.Target.Parent)
&#9;&#9;return
&#9;end
&#9;if option == true and targey ~= nil then
&#9;&#9;option = false
&#9;&#9;if options == 1 and raiseDe == false then
&#9;&#9;&#9;targey.leaderstats.Money.Value = targey.leaderstats.Money.Value + 30
&#9;&#9;&#9;targey.Raise.Value = targey.Raise.Value + 1
&#9;&#9;&#9;script.Parent.Parent.Parent.leaderstats.Money.Value = script.Parent.Parent.Parent.leaderstats.Money.Value - 5
&#9;&#9;&#9;raiseDe = true
&#9;&#9;&#9;wait(10)
&#9;&#9;&#9;raiseDe = false
&#9;&#9;&#9;return

&#9;&#9;elseif options == 2 and targey.Raise.Value ~= 0 then
&#9;&#9;&#9;targey.leaderstats.Money.Value = targey.leaderstats.Money.Value - 30
&#9;&#9;&#9;targey.Raise.Value = targey.Raise.Value - 1
&#9;&#9;&#9;s.leaderstats.Money.Value = s.leaderstats.Money.Value + 5
&#9;&#9;&#9;return

&#9;&#9;elseif options == 3 then
&#9;&#9;&#9;game.Workspace.EOD.Value = targey
&#9;&#9;&#9;return

&#9;&#9;elseif options == 4 and homeDe == false then
&#9;&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;&#9;if g[i].Name == &quot;House&quot; and g[i].Owner.Value == targey then
&#9;&#9;&#9;&#9;&#9;targey.Character:MoveTo(g[i].Spawn.Position)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;homeDe = true&#9;
&#9;&#9;&#9;wait(60)
&#9;&#9;&#9;homeDe = false
&#9;&#9;&#9;return
&#9;&#9;elseif options == 5 and spawnDe == false then
&#9;&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;&#9;if g[i].className == &quot;SpawnLocation&quot; then
&#9;&#9;&#9;&#9;&#9;if g[i].BrickColor == targey.TeamColor then
&#9;&#9;&#9;&#9;&#9;&#9;targey.Character:MoveTo(g[i].Position)
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;&#9;spawnDe = true
&#9;&#9;&#9;wait(30)
&#9;&#9;&#9;spawnDe = false
&#9;&#9;&#9;return
&#9;&#9;end
&#9;end



