function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = &quot;Your job is to put pizzas in boxes so the delivery boy can deliver the pizzas       Click to continue&quot;
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Hole
q.Text = &quot;When the cooks are finish making a pizza or drink they will fall throught here&quot;
mode = 3
elseif mode == 3 then
q.Text = &quot;Use your hand tool to move the pizza or mountain dew&quot;
mode = 4
elseif mode == 4 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.EmptyBox
q.Text = &quot;Drag and drop a pizza on top of one of these boxes to put the pizzas in the box&quot;
mode = 5
elseif mode == 5 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Sign
q.Text = &quot;When this logo is on the box, that means that there is a pizza inside&quot;
mode = 6
elseif mode == 6 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Belt
q.Text = &quot;Now move the box withthe logo in it to on to this belt&quot;
mode = 7
elseif mode == 7 then
q.Text = &quot;If you get a mountain dew, you can&apos;t box is so just put it on this belt&quot;
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Bin.Top
q.Text = &quot;If a pizza will not go in a box, move the pizza on top of this trash can to remove it&quot;
mode = 9
elseif mode == 9 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
on = false
end
end
end 

