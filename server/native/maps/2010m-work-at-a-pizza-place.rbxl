							<string name="Name">Script</string>
							<ProtectedString name="Source">function order(f)
&#9;if script.Parent.Parent.Parent.Owner.Value ~= nil and f.Handle.BrickColor == BrickColor.new(1) then
&#9;&#9;local g = script.Parent.Parent.Parent:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;Order&quot; then
&#9;&#9;&#9;&#9;g[i]:remove()
&#9;&#9;&#9;&#9;script.Parent.Parent.Parent.Owner.Value.leaderstats.Money.Value = script.Parent.Parent.Parent.Owner.Value.leaderstats.Money.Value - 30
&#9;&#9;&#9;&#9;local t = game.Lighting.Storage.PropPizza:clone()
&#9;&#9;&#9;&#9;t.Parent = script.Parent.Parent.Parent
&#9;&#9;&#9;&#9;t.Position = script.Parent.Parent.Parent.Spawn.Position
&#9;&#9;&#9;&#9;return
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
&#9;&#9;&#9;
&#9;&#9;&#9;
&#9;&#9;&#9;&#9;&#9;




function check(hit)
&#9;local g = hit.Parent:GetChildren()
&#9;for i = 1 ,#g do
&#9;&#9;if g[i].className == &quot;Tool&quot; then
&#9;&#9;&#9;return g[i]
&#9;&#9;end
&#9;end
&#9;return nil
end

function money(hit)
&#9;local g = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;if g ~= nil then
&#9;&#9;g.Delivery.Value = g.Delivery.Value + 1
&#9;end
end

function touch(hit)
&#9;local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil then
&#9;&#9;local f = check(hit)
&#9;&#9;if f ~= nil then
&#9;&#9;&#9;if f:FindFirstChild(&quot;House&quot;) ~= nil then
&#9;&#9;&#9;&#9;if f.House.Value == script.Parent.Parent.Parent.House.Value then
&#9;&#9;&#9;&#9;&#9;game.Workspace.Success.Value = game.Workspace.Success.Value + 1
&#9;&#9;&#9;&#9;&#9;local r = script.Parent.Parent:FindFirstChild(&quot;&quot;)
&#9;&#9;&#9;&#9;&#9;money(hit)
&#9;&#9;&#9;&#9;&#9;if r ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;order(f)
&#9;&#9;&#9;&#9;&#9;&#9;r.Name = &quot;Thank You!&quot;
&#9;&#9;&#9;&#9;&#9;&#9;local g = script.Script:clone()
&#9;&#9;&#9;&#9;&#9;&#9;g.Disabled = false
&#9;&#9;&#9;&#9;&#9;&#9;g.Parent = r
&#9;&#9;&#9;&#9;&#9;&#9;f:remove()
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end
script.Parent.Touched:connect(touch)


