						<string name="Name">Script</string>
						<ProtectedString name="Source">Tool = script.Parent
a = false

function onActivated(mouse)
&#9;if a == false then
&#9;&#9;a = true
&#9;&#9;script.Parent.Handle.De:remove()
&#9;local g = script.Parent:GetChildren()
&#9;for i = 1,#g do
&#9;&#9;if g[i].className == &quot;Decal&quot; then
&#9;&#9;&#9;g[i].Parent = script.Parent.Handle
&#9;&#9;end
&#9;end
&#9;return
&#9;end
&#9;if script.Parent.Handle:FindFirstChild(&quot;Decal&quot;) ~= nil then
&#9;&#9;script.Parent.Handle.Decal:remove()
&#9;elseif script.Parent.Handle:FindFirstChild(&quot;Decal&quot;) == nil then
&#9;&#9;script.Parent.Handle.CanCollide = false
&#9;end
end


script.Parent.Activated:connect(onActivated)</ProtectedString>
