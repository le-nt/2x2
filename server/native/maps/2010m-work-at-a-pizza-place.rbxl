				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">de = false

function click(hit)
if de == false then
de = true
local a = game.Lighting.Storage.Box.Sausager:clone()
a.Parent = game.Workspace
a.Position = game.Workspace.port1.Position
game.Debris:AddItem(a,300)
local b = game.Lighting.Storage.Box.Sausager:clone()
b.Parent = game.Workspace
b.Position = game.Workspace.port2.Position
game.Debris:AddItem(b,300)
end
wait(2)
de = false
end

script.Parent.ClickDetector.MouseClick:connect(click)
script.Parent.Touched:connect(click)</ProtectedString>
