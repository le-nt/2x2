					<ProtectedString name="Source">function remover(part)
if part.Name == &quot;Seat&quot; then
local g = game.Lighting.Tool.Car:clone()
g.Parent = game.Workspace
g:MakeJoints()
g:MoveTo(Vector3.new(70.5, 1 ,math.random(-156,-50.5)))
script.Parent:remove()
end
end
script.Parent.ChildRemoved:connect(remover)</ProtectedString>
