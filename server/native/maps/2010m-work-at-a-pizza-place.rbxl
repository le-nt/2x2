			</Item>
			<Item class="Script" referent="RBX3191">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">while true do
wait(0.3)
if script.Parent.Ringing.Value == true then
script.Parent.L.BrickColor = BrickColor.new(21)
script.Parent.R.BrickColor = BrickColor.new(21)
script.Parent.Handle.BrickColor = BrickColor.new(21)
wait(0.3)
script.Parent.L.BrickColor = BrickColor.new(26)
script.Parent.R.BrickColor = BrickColor.new(26)
script.Parent.Handle.BrickColor = BrickColor.new(26)

elseif script.Parent.Ringing.Value == false then
script.Parent.L.BrickColor = BrickColor.new(26)
script.Parent.R.BrickColor = BrickColor.new(26)
script.Parent.Handle.BrickColor = BrickColor.new(26)
end
wait(0.5)
if math.random(1,100) == 5 then
script.Parent.Ringing.Value = true
end
end


</ProtectedString>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX3192">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Ring</string>
					<ProtectedString name="Source">function change()
if script.Parent.Ringing.Value == true then
script.Parent.Handle.Telephone:Play()

elseif script.Parent.Ringing.Value == false then
script.Parent.Handle.Telephone:Stop()
end
end 
script.Parent.Ringing.Changed:connect(change)</ProtectedString>
				</Properties>
			</Item>
