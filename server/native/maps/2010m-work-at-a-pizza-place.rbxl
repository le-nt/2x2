				<Item class="Script" referent="RBX2596">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function touch(hit)
if hit.Position.y &lt; 2 then
local g = game.Lighting.Tool.Car:clone()
g.Parent = game.Workspace
g:MakeJoints()
g:MoveTo(Vector3.new(70.5, 1 ,math.random(-156,-50.5)))
script.Parent.Parent:remove()
end
end
script.Parent.Touched:connect(touch)


wait(math.random(500,600))

local g = game.Lighting.Tool.Car:clone()
g.Parent = game.Workspace
g:MakeJoints()
g:MoveTo(Vector3.new(70.5, 1 ,math.random(-156,-50.5)))

script.Parent.Parent:remove()
</ProtectedString>
					</Properties>
				</Item>
			</Item>
