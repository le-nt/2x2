					<string name="Name">Script</string>
					<ProtectedString name="Source">function check()
local g = game.Players:GetChildren()
for i = 1,#g do
if g[i].TeamColor == BrickColor.new(28) then
return false
end
end
return true
end



de = false
function click(hit)
&#9;if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil and de == false then
&#9;&#9;local g = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;&#9;if g ~= nil and g.TeamColor == BrickColor.new(28) then
&#9;&#9;&#9;script.Parent.CanCollide = false
&#9;&#9;&#9;de = true
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;de = false
&#9;&#9;&#9;script.Parent.CanCollide = true
&#9;&#9;elseif check() == true then
&#9;&#9;&#9;script.Parent.CanCollide = false
&#9;&#9;&#9;de = true
&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;de = false
&#9;&#9;&#9;script.Parent.CanCollide = true
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(click)</ProtectedString>
