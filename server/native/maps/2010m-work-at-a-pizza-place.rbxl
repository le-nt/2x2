if mouse.Target.Name == &quot;Sausage&quot; or mouse.Target.Name == &quot;Cheese&quot; or mouse.Target.Name == &quot;MountainDew&quot; or mouse.Target.Name == &quot;Pepperoni&quot; and mouse.Target.Parent.Name == &quot;Register&quot; then
