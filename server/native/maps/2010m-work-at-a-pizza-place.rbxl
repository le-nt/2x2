							<ProtectedString name="Source">item = &quot;Speakers&quot;
cost = math.random(10,100)
script.Parent.Parent.Name = &quot;Buy a &quot; .. item .. &quot; for &quot; .. &quot; $&quot; .. cost


function findhouse(h)
&#9;local e = game.Players:GetPlayerFromCharacter(h)
&#9;if e ~= nil then
&#9;&#9;local g = game.Workspace:GetChildren()
&#9;&#9;for i = 1,#g do
&#9;&#9;&#9;if g[i].Name == &quot;House&quot; and g[i].Owner.Value == e then
&#9;&#9;&#9;&#9;return g[i]
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return nil
end

de = false

function touch(hit)
&#9;local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
&#9;if h ~= nil and h.Health ~= 0 and de == false then
&#9;&#9;if findhouse(h.Parent) ~= nil then
&#9;&#9;&#9;local t = game.Players:GetPlayerFromCharacter(h.Parent)
&#9;&#9;&#9;if t ~= nil and t:FindFirstChild(&quot;leaderstats&quot;) ~= nil and t.leaderstats.Money.Value &gt;= cost then
&#9;&#9;&#9;&#9;t.leaderstats.Money.Value = t.leaderstats.Money.Value - cost
&#9;&#9;&#9;&#9;local a = t:FindFirstChild(item).Value
&#9;&#9;&#9;&#9;a.Parent = findhouse(h.Parent)
&#9;&#9;&#9;&#9;a:MakeJoints()
&#9;&#9;&#9;&#9;de = true
&#9;&#9;&#9;&#9;script.Parent.Parent.Name = &quot;Bought &quot; .. item
&#9;&#9;&#9;&#9;wait(2)
&#9;&#9;&#9;&#9;de = false
&#9;&#9;&#9;&#9;script.Parent.Parent.Name = &quot;Buy a &quot; .. item .. &quot; for &quot; .. &quot; $&quot; .. cost
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

script.Parent.Touched:connect(touch)

