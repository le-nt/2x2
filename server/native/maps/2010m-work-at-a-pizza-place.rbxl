						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function water()
if script.Parent.ON.Value == true then
script.Parent.BrickColor = BrickColor.new(26)
script.Parent.ON.Value = false
elseif script.Parent.ON.Value == false then

script.Parent.ON.Value = true
end
end
script.Parent.Screen.ClickDetector.MouseClick:connect(water)


while true do
wait(1)
if script.Parent.ON.Value == true then
script.Parent.Screen.BrickColor = BrickColor.new(math.random(1,250))
end
end


</ProtectedString>
					</Properties>
