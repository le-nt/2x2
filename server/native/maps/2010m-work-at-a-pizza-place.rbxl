&#9;&#9;local target = position.p
&#9;if on == false then break end
--cloud()
&#9;&#9;move(target, engine)
&#9;&#9;if planedebounce == true or controlling == false then break end
&#9;end
&#9;wait(.1)
&#9;debounce = false
&#9;end
end

