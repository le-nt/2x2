			<Item class="Script" referent="RBX54">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function check()
local p = 0
local f = game.Workspace:GetChildren()
for i = 1,#f do
if f[i].Name == &quot;EmptyBox&quot; then
p = p + 1
end
end 
return p
end

while true do
wait(2)
if check() &lt; 4 then
if game.Workspace.Items.Boxes.Value ~= 0 then
game.Workspace.Items.Boxes.Value = game.Workspace.Items.Boxes.Value - 1
local p = game.Lighting.Storage.EmptyBox:clone()
p.Parent = game.Workspace
p.Position = script.Parent.Position
p.Position = Vector3.new(p.Position.x ,p.Position.y + 2, p.Position.z)
end
end
end </ProtectedString>
				</Properties>
			</Item>
		</Item>
