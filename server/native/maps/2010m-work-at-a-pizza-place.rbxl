				<Item class="Script" referent="RBX2396">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function touch(hit)
if hit.Name == &quot;Dough&quot; then
hit.CFrame = script.Parent.Parent.Yo.CFrame
elseif hit.Name == &quot;Dew&quot; then
hit.CFrame = script.Parent.Parent.Yo.CFrame
end
end
script.Parent.Touched:connect(touch)</ProtectedString>
					</Properties>
