if e == &quot;Dew&quot; or e == &quot;EmptyBox&quot; or e == &quot;FullBox&quot; or e == &quot;Dough&quot; or e == &quot;Boxesr&quot; or e == &quot;Cheeser&quot; or e == &quot;Doughr&quot; or e == &quot;MountainDewr&quot; or e == &quot;Pepperonir&quot; or e == &quot;Sausager&quot; or e == &quot;TomatoSaucer&quot; then
print(2)
mouse.Target.Velocity = Vector3.new(mouse.Target.Velocity.x, mouse.Target.Velocity.y + 0.005, mouse.Target.Velocity.z)
end
end                                            

function onSelected(mouse)


        mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;

   mouse.Move:connect(function() onMove(mouse) end)

--[[h = Instance.new(&quot;Hint&quot;)
h.Text = &quot;Move your cursor over an object that will not move on the convayer belt to make it move&quot;
h.Parent = script.Parent.Parent.Parent]]

     


end


bin.Selected:connect(onSelected)


--[[function yo()
h.Parent = nil
end
bin.Deselected:connect(yo)]]
