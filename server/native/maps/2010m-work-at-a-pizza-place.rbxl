						<string name="Name">Script</string>
						<ProtectedString name="Source">while true do
wait(math.random(500,700))

if script.Parent.Parent.Seaty:FindFirstChild(&quot;SeatWeld&quot;) == nil then
local g = game.Lighting.Tool.Truck:clone()
g.Parent = game.Workspace
g:MakeJoints()
g:MoveTo(Vector3.new(math.random(-128,-31), 0.6, -669))
script.Parent.Parent.Script:remove()
wait()
script.Parent.Parent:remove()
end
end
</ProtectedString>
