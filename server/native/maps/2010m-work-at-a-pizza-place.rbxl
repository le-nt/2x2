if top == &quot;Sausage1&quot; and mouse.Target.Topping.Value ~= 1 and mouse.Target.Topping.Value ~= 2 and s.Sausage.Value ~= 0 then
mouse.Target.Owner.Value = script.Parent.Parent.Parent
game.Lighting.Storage.Sausage:clone().Parent = mouse.Target
mouse.Target.Topping.Value =  2 
s.Sausage.Value = s.Sausage.Value - 1
