							<string name="Name">Script</string>
							<ProtectedString name="Source">local isOn = true

function on()
&#9;isOn = true
&#9;script.Parent.Bulb.Transparency = .5

end

function off()
&#9;isOn = false
&#9;script.Parent.Bulb.Transparency = 1
end

function onClicked()
&#9;
&#9;if isOn == true then off() else on() end

end

script.Parent.Stand.ClickDetector.MouseClick:connect(onClicked)

on()</ProtectedString>
