				<Item class="Script" referent="RBX2434">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function check()
local t = script.Parent.Parent:GetChildren()
return t[math.random(2,#t)]
end


function touch(hit)
if hit.Name == &quot;FullBox&quot; then
hit.CFrame = script.Parent.Parent.Tile.CFrame
hit.Position = check().Position
hit.Anchored = true
elseif hit.Name == &quot;EmptyBox&quot; then
hit:remove()
game.Workspace.Items.Boxes.Value = game.Workspace.Items.Boxes.Value + 1
elseif hit.Name == &quot;Pizza&quot; then
hit.Position = game.Workspace.Pad.Pad.Position
elseif hit.Name == &quot;MountainDew&quot; then
hit.CFrame = script.Parent.Parent.Tiley.CFrame
hit.Locked = true
hit.Position = Vector3.new(hit.Position.x,hit.Position.y + 1, hit.Position.z)
wait()
hit.Position = script.Parent.Parent.Tiley.Position
hit.Anchored = true
end
end
script.Parent.Touched:connect(touch)</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
