				<Item class="Script" referent="RBX3929">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function touch(hit)
&#9;if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
&#9;&#9;local t = game.Players:GetPlayerFromCharacter(hit.Parent)
&#9;&#9;if script.Parent.Parent.Owner.Value == t then
&#9;&#9;&#9;local o = game.Lighting.Storage[&quot;Pizza!&quot;]:clone()
&#9;&#9;&#9;o.Parent = t.Backpack
&#9;&#9;&#9;script.Parent:remove()
&#9;&#9;end
&#9;end
end
script.Parent.Touched:connect(touch)</ProtectedString>
