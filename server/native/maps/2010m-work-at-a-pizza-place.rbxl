elseif s.Dough.Value &gt; 99 then
s.Dough.Value = 99

elseif s.Cheese.Value &gt; 99 then
s.Cheese.Value = 99

elseif s.Cheese.Value &gt; 99 then
s.Cheese.Value = 99

elseif s.Pepperoni.Value &gt; 99 then
s.Pepperoni.Value = 99

elseif s.MountainDew.Value &gt; 99 then
s.MountainDew.Value = 99

elseif s.TomatoSauce.Value &gt; 99 then
s.TomatoSauce.Value = 99

elseif s.Sausage.Value &gt; 99 then
s.Sausage.Value = 99

end
end




