			<Item class="Script" referent="RBX1772">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Main</string>
					<ProtectedString name="Source">a = script.Parent:clone()
a.Parent = game.Lighting.Storage
script.Parent.BKUP.Value = a

local g = script.Parent:GetChildren()
for i = 1,#g do
if g[i].className == &quot;Model&quot; and g[i]:FindFirstChild(&quot;Humanoid&quot;) == nil then
local e = g[i]:clone()
e.Parent = game.Lighting
local gg = Instance.new(&quot;ObjectValue&quot;)
gg.Value = e
gg.Name = g[i].Name
gg.Parent = script
g[i]:remove()
end
end </ProtectedString>
				</Properties>
			</Item>
