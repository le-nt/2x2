&#9;&#9;s.Voter.Value.Vote.Value = s.Voter.Value.Vote.Value  - 1
&#9;end

&#9;if game.Players:FindFirstChild(script.Parent.Text) ~= nil then
&#9;&#9;s.Voter.Value = game.Players:FindFirstChild(script.Parent.Text)
&#9;&#9;s.Voter.Value.Vote.Value = s.Voter.Value.Vote.Value  + 1
&#9;end

&#9;local g = script.Parent.Parent:GetChildren()
&#9;for i = 1,#g do
&#9;&#9;if g[i].className == &quot;TextButton&quot; and g[i].Name ~= &quot;Home&quot; and g[i].Name ~= &quot;Reset&quot; and g[i].Name ~= &quot;Vote&quot; then
&#9;&#9;&#9;g[i]:remove()
&#9;&#9;end
&#9;end
end
