cam=nil
mode = 1
q = nil
on = false

function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = &quot;Your job is to make pizzas      Click to continue&quot;
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Orders.a5
q.Text = &quot;This order board shows all the orders that need to be made&quot;
mode = 3
elseif mode == 3 then
q.Text = &quot;If there is a picture of a pepperoni pizza, that means you must make one&quot;
mode = 4
elseif mode == 4 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Dough
q.Text = &quot;Starting out you need to get some dough that looks like this&quot;
mode = 5
elseif mode == 5 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.TomatoSauce1
q.Text = &quot;Then select your cook tool, click on this tomato sauce, and click on your pizza dough&quot;
mode = 6
elseif mode == 6 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Cheese1
q.Text = &quot;You must do the same thing for the cheese as you do the tomato sauce&quot;
mode = 7
elseif mode == 7 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Pepperoni1
q.Text = &quot;Then add pepperoni to it&quot;
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Belty
q.Text = &quot;Then place the pizza on this belt to go in the oven &quot;
mode = 9
elseif mode == 9 then
q.Text = &quot;You are now done making the pizza &quot;
mode = 10
elseif mode == 10 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Belter
q.Text = &quot;If there is a mountain dew on the order board then just place one on the belt&quot;
mode = 11
elseif mode == 11 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.TomatoSauce
q.Text = &quot;This will tell you how much tomato sauce is in supply&quot;
mode = 12
elseif mode == 12 then
q.Text = &quot;If this reaches 0 then you will not be able to use tomato sauce&quot;
mode = 13
elseif mode == 13 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
on = false
end
end
end


