				<Item class="Script" referent="RBX3777">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">Tool = script.Parent

function onButton1Down(mouse)
local g = Instance.new(&quot;Hint&quot;)
if string.sub(5,5,script.Parent.House.Value) == &quot;a&quot; then
g.Text = &quot;Deliver this pizza to neighboorhood APPLE and house number &quot; .. string.sub(6,6,script.Parent.House.Value)
elseif string.sub(5,5,script.Parent.House.Value) == &quot;b&quot; then
g.Text = &quot;Deliver this pizza to neighboorhood BANANA and house number &quot; .. string.sub(6,6,script.Parent.House.Value)
elseif string.sub(5,5,script.Parent.House.Value) == &quot;c&quot; then
g.Text = &quot;Deliver this pizza to neighboorhood COCONUT and house number &quot; .. string.sub(6,6,script.Parent.House.Value)
end
g.Parent = game.Players:GetPlayerFromCharacter(script.Parent.Parent)
end

function onSelected(mouse)


     

        mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
    --    mouse.KeyDown:connect(onKeyDown)
   --mouse.Move:connect(function() onMove(mouse) end)

end

--[[function onKeyDown(key) 
if key == &quot;k&quot; then]]


Tool.Equipped:connect(onSelected)</ProtectedString>
