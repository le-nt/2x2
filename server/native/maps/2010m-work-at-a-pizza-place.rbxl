			<Item class="Script" referent="RBX10">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function touch(hit)
if hit.Name == &quot;Dough&quot; then
wait(1)
hit.BrickColor = BrickColor.new(106)
hit.Cooked.Value = true
end
end
script.Parent.Touched:connect(touch)</ProtectedString>
				</Properties>
			</Item>
