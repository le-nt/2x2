			<Item class="Script" referent="RBX90">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function remover(part)
if part.Name == &quot;Seat&quot; then
local g = game.Lighting.Tool.Truck:clone()
g.Parent = game.Workspace
g:MakeJoints()
g:MoveTo(Vector3.new(math.random(-128,-31), 0.6, -669))
script.Parent:remove()
end
end
script.Parent.ChildRemoved:connect(remover)

while true do
wait(math.random(15,30))
if script.Parent.a.Position.y &gt; script.Parent.b.Position.y then
remover(script.Parent.Seat)
end
end
</ProtectedString>
				</Properties>
			</Item>
