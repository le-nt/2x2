cam=nil
mode = 1
q = nil
on = false

function onButton1Down(mouse)
if on == true then
if mode == 1 then
q.Text = &quot;Your job is to deliver supplies to the pizza shop        Click to continue&quot;
mode = 2
elseif mode == 2 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Truck.VehicleSeat
q.Text = &quot;First you will need to get one of these trucks&quot;
mode = 3
elseif mode == 3 then
q.Text = &quot;Just get in the truck, select your truck tool, and hold down your mouse to go&quot;
mode = 4
elseif mode == 4 then
q.Text = &quot;Now you need supplies to fill the truck up with&quot;
mode = 5
elseif mode == 5 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Target
q.Text = &quot;Move your truck right on top of this target&quot;
mode = 6
elseif mode == 6 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Pepperonir
q.Text = &quot;Get out of your truck and start pressing these buttons&quot;
mode = 7
elseif mode == 7 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Boxyer
q.Text = &quot;Boxes like this will start to fall into your truck&quot;
mode = 8
elseif mode == 8 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Here
q.Text = &quot;Once you are done filling up, drive your truck over here&quot;
mode = 9
elseif mode == 9 then
game.Workspace.CurrentCamera.CameraSubject = game.Workspace.Bel
q.Text = &quot;Grab the boxes from your truck and put them on this convayer belt and thats all!&quot;
mode =10
elseif mode == 10 then
q:remove()
mode = 1
game.Workspace.CurrentCamera.CameraSubject=game.Players.LocalPlayer.Character
game.Workspace.CurrentCamera:Remove()
game.Workspace.CurrentCamera=cam
end
end
end



