					<Item class="Script" referent="RBX535">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function check(hit)
local g = game.Workspace:GetChildren()
for i = 1,#g do
local t = game.Players:GetPlayerFromCharacter(hit.Parent)
if g[i].Name ==&quot;House&quot; and g[i].Owner.Value ~= nil and g[i].Owner.Value == t then
return false
end
end
return true
end


function give(t)
local g = script.Parent.Parent.Parent.Main:GetChildren()
for i = 1,#g do
g[i].Parent = t
end
end


function touch(hit)
local h = hit.Parent:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil and script.Parent.Parent.Parent.Owner.Value == nil and check(hit) == true then
script.Parent.Parent.Parent.Owner.Value = game.Players:GetPlayerFromCharacter(hit.Parent)
script.Parent.Transparency = 1
give(game.Players:GetPlayerFromCharacter(hit.Parent))
end
end

script.Parent.Touched:connect(touch)

</ProtectedString>
