				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">item = &quot;EmptyBox&quot;
de = false
function check()
local f = game.Workspace:GetChildren()
for i = 1,#f do
if f[i].Name == item then
f[i]:remove()
game.Workspace.Items.Boxes.Value = game.Workspace.Items.Boxes.Value + 1
end
end
end


function click()
if de == false then
de = true
check() 
script.Parent.Head.BrickColor = BrickColor.new(21)
script.Parent.Torso.BrickColor = BrickColor.new(21)
check() 
wait(80)
script.Parent.Head.BrickColor = BrickColor.new(28)
script.Parent.Torso.BrickColor = BrickColor.new(28)
de = false
end
end

script.Parent.Torso.Click.MouseClick:connect(click)
script.Parent.Head.Click.MouseClick:connect(click)</ProtectedString>
				</Properties>
