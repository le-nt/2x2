		<Item class="Script" referent="RBX67">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">RegenerateScenery</string>
				<ProtectedString name="Source">model = game.Workspace.RegenScenery
messageText = &quot;Regenerating the Forsaken Scenery...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
	wait(600 * (1-math.random()*0.5))

	message.Parent = game.Workspace
	model:remove()

	wait(4)

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
</ProtectedString>
			</Properties>
		</Item>
