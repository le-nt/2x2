			<Item class="Script" referent="RBX1694">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Delete Player</string>
					<ProtectedString name="Source">print(&quot;Ban Players Loaded&quot;)


function onPlayerEntered(newPlayer)

	while true do
		if newPlayer.Character ~= nil then break end
		wait(0)
	end

	local force=script.Parent.BannedPlayers:children()
	for i=1, #force do
		if (force[i].Name:lower()==newPlayer.Name:lower()) then

			if (newPlayer == nil) then return end
			newPlayer.Parent = nil

			if (newPlayer.Character == nil) then return end
			newPlayer.Character.Parent = nil

		end
	end
end

