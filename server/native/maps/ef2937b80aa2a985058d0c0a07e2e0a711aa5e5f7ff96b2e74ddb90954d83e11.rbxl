				<Item class="Script" referent="RBX1761">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local board = script.Parent.Parent.Board:Clone()

while true do 

	wait(5)

	
	local n = script.Parent.Parent:FindFirstChild(&quot;Board&quot;) == nil
	if (n or (script.Parent.Position - script.Parent.Parent.Board.SkateboardPlatform.Position).magnitude &gt; 15) then
		if (n ~= true) then
			script.Parent.Parent.Board.Parent = game.Workspace
		end
		wait(3)
		local c = board:Clone()
		c.Parent = script.Parent.Parent
		c:makeJoints()
	end

end</ProtectedString>
