						<string name="Name">Script</string>
						<ProtectedString name="Source">local brick = script.Parent.Parent.Brick

function onClick()
	brick.Transparency = script.Parent.Transparency
	brick.Reflectance = script.Parent.Reflectance
	brick.BrickColor = script.Parent.BrickColor
	brick.Size = Vector3.new(1,1.2,1)
	brick.formFactor = &quot;Brick&quot;
	brick.Material = script.Parent.Material
end 

script.Parent.Click.MouseClick:connect(onClick)</ProtectedString>
