						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MiniMorph</string>
						<ProtectedString name="Source">--Made by Farvei
--For scripters:
--The function below called &apos;changeToMini&apos; changes the parameter char (which is a player character, i.e. the one stored in Workspace)
--into a miniature person at 1/8 scale.
--Implement it however you wish.

print(&quot;Farvei&apos;s Mini Morph Version 1.1.2 operative&quot;);

function changeToMini(char)
	local isMini = char:FindFirstChild(&quot;isMini&quot;);

	if isMini ~= nil then
		return;
	end

	print(&quot;Changing Character...&quot;);

	local head = char:FindFirstChild(&quot;Head&quot;);
	local torso = char:FindFirstChild(&quot;Torso&quot;);
	local rArm = char:FindFirstChild(&quot;Right Arm&quot;);
	local lArm = char:FindFirstChild(&quot;Left Arm&quot;);
	local rLeg = char:FindFirstChild(&quot;Right Leg&quot;);
	local lLeg = char:FindFirstChild(&quot;Left Leg&quot;);

	local allParts = {head, torso, rArm, lArm, rLeg, lLeg};

	if (head == nil or torso == nil or rArm == nil or rLeg == nil or lArm == nil or lLeg == nil) then
		return;
	end

	for i, v in pairs(allParts) do
		allParts[i].Size = Vector3.new(1, 1, 1);
	end

	local m = Instance.new(&quot;BlockMesh&quot;);
	m.Scale = Vector3.new(0.125, 0.25, 0.125);

	local m1 = m:Clone();
	m1.Scale = Vector3.new(0.25, 0.25, 0.125);
	m1.Parent = torso;
	local m2 = m:Clone();
	m2.Parent = rArm;
	local m3 = m:Clone();
	m3.Parent = lArm;
	local m4 = m:Clone();
	m4.Parent = rLeg;
	local m5 = m:Clone();
	m5.Parent = lLeg;

	head.Mesh.Scale = Vector3.new(0.2,0.2,0.2);

	local neck = Instance.new(&quot;Weld&quot;);
	neck.Name = &quot;Neck&quot;;
	neck.Parent = torso;
	neck.Part0 = torso;
	neck.Part1 = head;
	neck.C0 = CFrame.new(0, 0.25 / 2 + 0.125 / 2, 0);

	local rSho = Instance.new(&quot;Motor&quot;);
	rSho.Name = &quot;Right Shoulder&quot;;
	rSho.Parent = torso;
	rSho.Part0 = torso;
	rSho.Part1 = rArm;
	rSho.C0 = CFrame.new(0.25 / 2 + 0.125 / 2, 0.125 / 2, 0) * CFrame.fromEulerAnglesXYZ(0, 1.57, 0);
	rSho.C1 = CFrame.new(0, 0.125 / 2, 0) * CFrame.fromEulerAnglesXYZ(0, 1.57, 0);
	rSho.MaxVelocity = 0.15;

	local lSho = Instance.new(&quot;Motor&quot;);
	lSho.Name = &quot;Left Shoulder&quot;;
	lSho.Parent = torso;
	lSho.Part0 = torso;
	lSho.Part1 = lArm;
	lSho.C0 = CFrame.new(-0.25 / 2 + -0.125 / 2, 0.125 / 2, 0) * CFrame.fromEulerAnglesXYZ(0, -1.57, 0);
	lSho.C1 = CFrame.new(0, 0.125 / 2, 0) * CFrame.fromEulerAnglesXYZ(0, -1.57, 0);
	lSho.MaxVelocity = 0.15;

	local rHip = Instance.new(&quot;Motor&quot;);
	rHip.Name = &quot;Right Hip&quot;;
	rHip.Parent = torso;
	rHip.Part0 = torso;
	rHip.Part1 = rLeg;
	rHip.C0 = CFrame.new(0.125 / 2, -0.125, 0) * CFrame.fromEulerAnglesXYZ(0, 1.57, 0);
	rHip.C1 = CFrame.new(0, 0.125, 0) * CFrame.fromEulerAnglesXYZ(0, 1.57, 0);
	rHip.MaxVelocity = 0.15;

	local lHip = Instance.new(&quot;Motor&quot;);
	lHip.Name = &quot;Left Hip&quot;;
	lHip.Parent = torso;
	lHip.Part0 = torso;
	lHip.Part1 = lLeg;
	lHip.C0 = CFrame.new(-0.125 / 2, -0.125, 0) * CFrame.fromEulerAnglesXYZ(0, -1.57, 0);
	lHip.C1 = CFrame.new(0, 0.125, 0) * CFrame.fromEulerAnglesXYZ(0, -1.57, 0);
	lHip.MaxVelocity = 0.15;

	local isMini = Instance.new(&quot;IntValue&quot;);
	isMini.Name = &quot;isMini&quot;;
	isMini.Parent = char;

	local c = char:GetChildren();

	for i, v in pairs(c) do
		if (c[i].className == &quot;Hat&quot;) then
			c[i]:Remove();
		end
	end

	print(&quot;Changing done!&quot;);

	local animate = char:FindFirstChild(&quot;Animate&quot;);

	if (animate ~= nil) then
		local c = animate:Clone();
		animate:Remove();
		c.Parent = char;
	end
end

function onHit(hit)
	if hit.Parent == nil then
		return;
	end

	if hit.Parent:FindFirstChild(&quot;Humanoid&quot;) == nil then
		return;
	end

	changeToMini(hit.Parent);
end

script.Parent.Head.Touched:connect(onHit);

