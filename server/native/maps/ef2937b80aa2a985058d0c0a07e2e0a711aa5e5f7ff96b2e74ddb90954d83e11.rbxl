function onKeyDown(key) 
	if (key~=nil) then 
		local key = key:lower() 
		if (key==&quot;f&quot;) then 
			Tool.mode.Value=1
			Tool.pitchmode.Value = .8
			coroutine.resume(coroutine.create(Message),&quot;Spooky Echo&quot;)
		elseif (key==&quot;g&quot;) then
			Tool.mode.Value=5
			Tool.pitchmode.Value = .8
			coroutine.resume(coroutine.create(Message),&quot;Spookier Echo&quot;)
		elseif (key==&quot;h&quot;) then
			Tool.mode.Value=3
			Tool.pitchmode.Value = .8
			coroutine.resume(coroutine.create(Message),&quot;Lurking Danger&quot;)
		elseif (key==&quot;j&quot;) then
			Tool.mode.Value=4
			Tool.pitchmode.Value = 1
			coroutine.resume(coroutine.create(Message),&quot;Distorted Danger&quot;)
		elseif (key==&quot;k&quot;) then
			Tool.mode.Value=2
			Tool.pitchmode.Value = 1
			coroutine.resume(coroutine.create(Message),&quot;Ghost Cry&quot;)
		elseif (key==&quot;l&quot;) then
			Tool.mode.Value=6
			Tool.pitchmode.Value = 1
			coroutine.resume(coroutine.create(Message),&quot;Haunted House&quot;)
		end
	end
end

