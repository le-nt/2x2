		<Item class="HopperBin" referent="RBX14631">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Talk</string>
				<Content name="TextureId"><null></null></Content>
				<bool name="archivable">true</bool>
			</Properties>
			<Item class="Script" referent="RBX14632">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ExamineScript</string>
					<ProtectedString name="Source">msg=Instance.new(&quot;Hint&quot;)
t=0 --current time
tt=0 --time to take off msg
rate=0.05 --how long we wait before advancing the marquee one letter.
marqueePosition=-1 --used for &quot;marquee&quot;&apos;s with more than 100 characters. -1 means &quot;not in use&quot;
marquee=&quot;&quot;
num=100 --number of characters to display on the marquee hint.
responses={}
action={}
talking=false
newAction=nil --change to action[i] upon responses[i] for FTalk to resume
function updateMsg()
	--uses marqueePosition to index &quot;marquee&quot;.
	if marqueePosition==-1 then
		msg.Text=marquee
	else
		fl=num-marqueePosition
		totalMarquee=string.rep(&quot; &quot;, num) .. marquee .. string.rep(&quot; &quot;, num)
		msg.Text=string.sub(totalMarquee,marqueePosition,num+marqueePosition-1)
	end
end
reset=false
function waitForMarquee() --wait until marquee ends, or if no marquee then wait standard waiting time for msg length
	if marqueePosition==-1 then wait(string.len(marquee)*rate+rate*20) return end
	reset=false
	while reset==false do
		wait(.1)
	end
end
shouldWait=true
function FTalk(pos)
	if shouldWait then waitForMarquee() --let the msg operate; whatever it is
	end
	shouldWait=true
	if pos.className==&quot;StringValue&quot; then
		--1. It&apos;s a course of action (ie. &quot;y&quot; or &quot;n&quot;) with a msg.
		--2. It&apos;s #1 without a msg (is redirect, usually)
		--A. Look at the type + response
		--B. Look at it&apos;s children and wait for a response.
		marquee=pos.Value
		if marquee:len() &lt;= num then
			marqueePosition=-1
		else
			marqueePosition=0
		end
		updateMsg()
		if marquee:len()==0 then shouldWait=false wait() end --this means no wait time, but also means not an infinite loop if someone tries to create one.
		--Now, check to see what we&apos;re waiting for... in otherwords, GETCHILDREN
		local ch=pos:getChildren()
		local real={}
		local rand={}
		local i=1
		local dealt=false
		for i = 1, #ch do
			if string.len(ch[i].Name)==1 then table.insert(real, ch[i])
			elseif string.sub(ch[i].Name, 1, 6)==&quot;random&quot; then table.insert(rand,ch[i])
			else --ACT UPON IT because it MUST be an Orb thing!
				if ch[i].Name==&quot;redirect&quot; then FTalk(ch[i].Value) dealt=true
				elseif ch[i].className==&quot;Script&quot; then FTalk(ch[i]) dealt = true
				else--check for ORB condition
				end
			end
		end
		if not dealt then --check for what we&apos;re going to do...
			--1st, is rand+real?
			if #real &gt; 0 and #rand&gt;0 then
				if math.random(1,#real+#rand)&lt;=#rand then real={} end --clear that array; choose a random choice!
			end
			if #real&gt;0 then
				newAction=nil --clear from before
				responses={}
				action={}
				for i = 1, #real do
					table.insert(responses, real[i].Name)
					table.insert(action, real[i])				
				end
				expectingResponse=true
				while newAction==nil do
					wait(.5)
				end
				shouldWait=false --already waited for response!!
				FTalk(newAction)
			elseif #rand&gt;0 then
				FTalk(rand[math.random(1,#rand)])
			end --else no children and thus don&apos;t do anything! Finished conversation.
		end
	elseif pos.className==&quot;Script&quot; then --we need to run this script! 
		sc=pos:clone()
		if sc:findFirstChild(&quot;Who&quot;)~=nil then sc.Who.Value=game.Players.LocalPlayer end
		sc.Disabled=false
		sc.Parent=game.Workspace
	else --is a redirect
		FTalk(pos.Value)
	end
end
expectingResponse=false
function onKeyDown(key)
	if key== nil or expectingResponse==false then return end
	key=key:lower()
	for u = 1, #responses do
		if key==responses[u] then newAction=action[u] expectingResponse=false break end
	end
end
function onButton1Down(mouse)
	if talking then return end
	local player = game.Players.LocalPlayer
	if player == nil then return end
	obj=mouse.Target
	if obj==nil then 
		marquee=&quot;The goddess Crea is watching joo!&quot;
		marqueePosition=-1
		updateMsg()
		msg.Parent=script.Parent.Parent.Parent
		tt=t+6 --leave on for 5 to 6 seconds
		return
	else
		talk=obj:findFirstChild(&quot;Talk&quot;)
		if talk==nil then talk=obj.Parent:findFirstChild(&quot;Talk&quot;) end
		if talk==nil then talk=obj.Parent.Parent:findFirstChild(&quot;Talk&quot;) end
		desc=obj:findFirstChild(&quot;Description&quot;)
		if desc==nil then desc=obj.Parent:findFirstChild(&quot;Description&quot;) end
		if desc==nil then desc=obj.Parent.Parent:findFirstChild(&quot;Description&quot;) end
	end
	pos1=obj.Position
	head=script.Parent.Parent.Parent.Character:findFirstChild(&quot;Head&quot;)
	if head==nil then return end
	pos2=head.Position
	dist=(pos1-pos2).magnitude
	dist=dist-math.max(math.max(obj.Size.x, obj.Size.z), obj.Size.y)
	if talk~=nil and dist &lt;15 then
		w=talk:findFirstChild(&quot;who&quot;)
		msg.Parent=game.Players.LocalPlayer
		if w==nil or w.Value==&quot;&quot; then --free!
			talking=true
			tt=0
			if w~=nil then w.Value=game.Players.LocalPlayer.Name end
--[[			marquee=&quot;STARTING CHAT...&quot;
			updateMsg()
			wait(1) --]]
			shouldWait=false
			FTalk(talk)
			waitForMarquee()
			msg.Parent=nil
			tt=0
			if w~=nil then w.Value=&quot;&quot; end --end of chat!
			talking=false
		else
			marquee=&quot;Someone is Already Talking to that person&quot;
			marqueePosition=-1
			updateMsg()
			tt=t+6
		end
	elseif desc~=nil then
		marquee=desc.Value
		if marquee:len() &lt;= num then
			marqueePosition=-1
		else
			marqueePosition=0
		end
		if dist&gt;=50 then marquee=&quot;Too far away... you can&apos;t get a good look at it...&quot; end
		updateMsg()
		msg.Parent=script.Parent.Parent.Parent
		tt=t+6 --leave on for 5 to 6 seconds
	else --is this an elevator button?
		if obj.Parent.Parent.Name==&quot;Select Buttons&quot; and obj.Name==&quot;Head&quot; then --must be an elevator!
			q= obj.Parent.Parent
			if q:findFirstChild(&quot;DesiredFloor&quot;)~=nil and q:findFirstChild(&quot;FloorChange&quot;)~=nil then
				if q.FloorChange.Value==false then --we are allowed to change the floor!
					q.DesiredFloor.Value=obj.Parent.Name
					q.FloorChange.Value=true
				end
			end			
		end
	end
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
end

function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.KeyDown:connect(onKeyDown)
end

script.Parent.Selected:connect(onSelected)
while true do
	wait(rate)
	t=t+rate
	if t&gt;=tt and tt~=0 then
		tt=0
		msg.Parent=nil
		marqueePosition=-1
	end
	if marqueePosition~=-1 then marqueePosition=marqueePosition+1 if marqueePosition&gt;string.len(marquee)+99 then marqueePosition=0 reset=true end updateMsg() end
end
