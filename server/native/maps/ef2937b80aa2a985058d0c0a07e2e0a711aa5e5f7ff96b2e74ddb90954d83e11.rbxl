		<Item class="Tool" referent="RBX14351">
			<Properties>
				<bool name="Enabled">true</bool>
				<CoordinateFrame name="Grip">
					<X>0</X>
					<Y>0</Y>
					<Z>-0.899999976</Z>
					<R00>0</R00>
					<R01>0</R01>
