function onEquippedLocal(mouse)

	if mouse == nil then
		print(&quot;Mouse not found&quot;)
		return 
	end

	mouse.Icon = &quot;rbxasset://../../../shareddata/BitlsPlaces/EverythingObby/assets/1088199&quot;
