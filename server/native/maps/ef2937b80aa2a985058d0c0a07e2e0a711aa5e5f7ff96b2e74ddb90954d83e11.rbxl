								<R01>0</R01>
								<R02>1</R02>
								<R10>1</R10>
								<R11>0</R11>
								<R12>0</R12>
								<R20>0</R20>
								<R21>1</R21>
								<R22>0</R22>
							</CoordinateFrame>
							<string name="Name">WoodenSword</string>
