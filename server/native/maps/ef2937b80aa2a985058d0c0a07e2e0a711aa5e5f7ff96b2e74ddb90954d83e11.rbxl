				<Item class="Script" referent="RBX12881">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function touch(part)
	if part.Parent:findFirstChild(&quot;Humanoid&quot;) ~= nil then
		part.Parent:findFirstChild(&quot;Head&quot;).BrickColor = BrickColor.new(tostring(script.Parent.Parent:findFirstChild(&quot;Head&quot;).BrickColor))
		part.Parent:findFirstChild(&quot;Head&quot;).Transparency = script.Parent.Parent:findFirstChild(&quot;Head&quot;).Transparency
		part.Parent:findFirstChild(&quot;Torso&quot;).BrickColor = BrickColor.new(tostring(script.Parent.Parent:findFirstChild(&quot;Torso&quot;).BrickColor))
		part.Parent:findFirstChild(&quot;Torso&quot;).Transparency = script.Parent.Parent:findFirstChild(&quot;Torso&quot;).Transparency
		part.Parent:findFirstChild(&quot;Right Arm&quot;).BrickColor = BrickColor.new(tostring(script.Parent.Parent:findFirstChild(&quot;Right Arm&quot;).BrickColor))
		part.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency = script.Parent.Parent:findFirstChild(&quot;Right Arm&quot;).Transparency
		part.Parent:findFirstChild(&quot;Left Arm&quot;).BrickColor = BrickColor.new(tostring(script.Parent.Parent:findFirstChild(&quot;Left Arm&quot;).BrickColor))
		part.Parent:findFirstChild(&quot;Left Arm&quot;).Transparency = script.Parent.Parent:findFirstChild(&quot;Left Arm&quot;).Transparency
		part.Parent:findFirstChild(&quot;Right Leg&quot;).BrickColor = BrickColor.new(tostring(script.Parent.Parent:findFirstChild(&quot;Right Leg&quot;).BrickColor))
		part.Parent:findFirstChild(&quot;Right Leg&quot;).Transparency = script.Parent.Parent:findFirstChild(&quot;Right Leg&quot;).Transparency
		part.Parent:findFirstChild(&quot;Left Leg&quot;).BrickColor = BrickColor.new(tostring(script.Parent.Parent:findFirstChild(&quot;Left Leg&quot;).BrickColor))
		part.Parent:findFirstChild(&quot;Left Leg&quot;).Transparency = script.Parent.Parent:findFirstChild(&quot;Left Leg&quot;).Transparency
	end
end

script.Parent.Touched:connect(touch)
</ProtectedString>
