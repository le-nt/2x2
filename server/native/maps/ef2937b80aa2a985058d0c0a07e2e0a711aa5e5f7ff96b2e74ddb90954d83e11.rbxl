					<R00>-0.999890924</R00>
					<R01>-3.7638576e-005</R01>
					<R02>-0.0147698727</R02>
					<R10>3.7638576e-005</R10>
					<R11>0.999987006</R11>
					<R12>-0.00509635778</R12>
