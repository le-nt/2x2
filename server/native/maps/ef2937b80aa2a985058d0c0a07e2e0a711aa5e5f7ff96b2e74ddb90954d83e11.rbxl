					<Item class="Tool" referent="RBX7397">
						<Properties>
							<bool name="Enabled">true</bool>
							<CoordinateFrame name="Grip">
								<X>0</X>
								<Y>0</Y>
								<Z>-1.39999998</Z>
								<R00>0</R00>
								<R01>0</R01>
								<R02>1</R02>
								<R10>1</R10>
								<R11>0</R11>
