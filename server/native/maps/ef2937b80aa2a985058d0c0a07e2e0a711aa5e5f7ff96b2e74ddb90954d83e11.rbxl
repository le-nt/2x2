function sort(which)
	functions = {function1, function2, function3, function4, function5, function6, function7, function8, function9, function10, function11, function12, function13, function14}
	for i = 1,#functions do
		if which.Name == &quot;ListItem&quot; .. tostring(i) then
			functions[i]()
		end
	end
	if on then
		click()
	end
end

function click()
	if on then
		button.BackgroundColor = BrickColor.new(&quot;Bright blue&quot;)
	else button.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)
	end
	on = not on
	for i = 1,#list do
		item = button.Parent:findFirstChild(&quot;ListItem&quot; .. tostring(i))
		if (item~=nil) then
			item.Visible = on
			item.Text = list[i]
		end
	end
end

function release()
end

