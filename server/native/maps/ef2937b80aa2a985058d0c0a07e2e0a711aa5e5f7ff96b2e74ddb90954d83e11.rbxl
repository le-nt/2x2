				<Item class="Script" referent="RBX12183">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local lol = false

function onClick()
if lol == false then
	lol = true
	b = script.Parent.Parent.Brick:clone()
	b.Anchored = false
	b.Parent = game.Workspace
	b.Name = &quot;BrickClone&quot;
	b.Position = script.Parent.Parent.Dispensor.Position
	b.Locked = false
	wait(1)
	lol = false
end
end

script.Parent.Click.MouseClick:connect(onClick)
</ProtectedString>
