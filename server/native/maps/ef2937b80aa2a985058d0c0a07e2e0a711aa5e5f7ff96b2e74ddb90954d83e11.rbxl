				<Item class="Script" referent="RBX13343">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">brick = script.Parent
debounce = false

function onTouched(hit)
	h = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h ~= nil and debounce == false then
	debounce = true
	brick.Transparency = 1
		eggs = game.Workspace.eggroot
		G = eggs:getChildren()
		for i = 1, #G do
			if G[i].className == &quot;Part&quot; then
				G[i].CFrame = hit.Parent.Torso.CFrame
			end
		end
end
wait(2)
debounce = false
brick.Transparency = 0
end

brick.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
