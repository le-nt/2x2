								<R21>1</R21>
								<R22>0</R22>
							</CoordinateFrame>
							<string name="Name">WoodenClub</string>
							<Content name="TextureId"><url>rbxasset://../../../shareddata/BitlsPlaces/EverythingObby/assets/12215459</url></Content>
