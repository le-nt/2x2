						<Item class="Script" referent="RBX9335">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">local drink = script.Parent.Parent.Claymore
local spot = script.Parent.Parent.Holder2
local db = false

function onClick()
	if db == false then
		db = true
		local d = drink:clone()
		d.Handle.Position = spot.Position
		d.Parent = game.Workspace
		wait(5)
		db = false
	end
end

script.Parent.ClickDetector.MouseClick:connect(onClick)</ProtectedString>
