						<string name="Name">Script</string>
						<ProtectedString name="Source">function spawnZombie()
&#9;local zombie = game.Lighting.Zombie:clone()
&#9;zombie.Parent = game.Workspace
&#9;zombie:MoveTo(Vector3.new(script.Parent.Position.x, script.Parent.Position.y - 4, script.Parent.Position.z))
&#9;zombie:makeJoints()
end

while true do
&#9;local players = game.Players:children()

&#9;if (#players &gt; 0) then
&#9;&#9;wait(150 + math.random(0,5))
&#9;&#9;spawnZombie()
&#9;end
end</ProtectedString>
