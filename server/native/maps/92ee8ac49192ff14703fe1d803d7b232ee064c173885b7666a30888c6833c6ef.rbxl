						<ProtectedString name="Source">wait(1)
owner=script.Parent.Parent

function onTouched(part)
&#9;if owner.Humanoid.Health&gt;1 then
&#9;&#9;if part.Parent ~= nil then
&#9;&#9;&#9;local h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if h~=nil and part.Parent.Name ~=&quot;Zombie&quot; then
&#9;&#9;&#9;&#9;h.Health = h.Health - 15
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

