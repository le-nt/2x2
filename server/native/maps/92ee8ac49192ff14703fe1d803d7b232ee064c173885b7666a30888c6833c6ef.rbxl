					<ProtectedString name="Source">function findNearestTorso(pos)
&#9;local list = game.Workspace:children()
&#9;local torso = nil
&#9;local dist = 1000
&#9;local temp = nil
&#9;local human = nil
&#9;local temp2 = nil
&#9;for x = 1, #list do
&#9;&#9;temp2 = list[x]
&#9;&#9;if (temp2.className == &quot;Model&quot;) and (temp2 ~= script.Parent) and (temp2.Name ~= &quot;Zombie&quot;) then
&#9;&#9;&#9;temp = temp2:findFirstChild(&quot;Right Arm&quot;)
&#9;&#9;&#9;human = temp2:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;&#9;if (temp ~= nil) and (temp.Transparency == 0) and (human ~= nil) and (human.Health &gt; 0) then
&#9;&#9;&#9;&#9;if (temp.Position - pos).magnitude &lt; dist then
&#9;&#9;&#9;&#9;&#9;torso = temp
&#9;&#9;&#9;&#9;&#9;dist = (temp.Position - pos).magnitude
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;return torso
end

while true do
&#9;wait(3)
&#9;local target = findNearestTorso(script.Parent.Torso.Position)
&#9;if target ~= nil then
&#9;&#9;script.Parent.Humanoid:MoveTo(target.Position, target)

&#9;&#9;if math.random(1,3) == 3 then
&#9;&#9;&#9;script.Parent.Humanoid.Jump = true
&#9;&#9;end
&#9;else
&#9;&#9;script.Parent.Humanoid:MoveTo(Vector3.new(math.random(-100,100),0,math.random(-100,100)), game.Workspace.MainRoom.Floor)
&#9;end
end
</ProtectedString>
