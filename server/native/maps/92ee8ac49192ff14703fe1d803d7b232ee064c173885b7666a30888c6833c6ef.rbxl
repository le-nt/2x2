					<ProtectedString name="Source">Tool = script.Parent

medkits = 5

local field = nil

function Heal()

&#9;local vCharacter = Tool.Parent

&#9;local childs = vCharacter:GetChildren()

&#9;local colors = {}

&#9;local ff = Instance.new(&quot;ForceField&quot;)
&#9;ff.Parent = vCharacter

&#9;for i=1,#childs do
&#9;&#9;if (childs[i].className == &quot;Part&quot;) then
&#9;&#9;&#9;colors[i] = childs[i].BrickColor
&#9;&#9;&#9;childs[i].BrickColor = BrickColor.new(1)
&#9;&#9;end
&#9;end

&#9;wait(1)

&#9;local human = vCharacter:FindFirstChild(&quot;Humanoid&quot;)
&#9;if (human ~= nil) then
&#9;&#9;human.Health = human.MaxHealth
&#9;end

&#9;for i=1,#childs do
&#9;&#9;if (childs[i].className == &quot;Part&quot;) then
&#9;&#9;&#9;childs[i].BrickColor = colors[i]
&#9;&#9;end
&#9;end

&#9;ff.Parent = nil
end



Tool.Enabled = true
function onActivated()

&#9;if not Tool.Enabled then
&#9;&#9;return
&#9;end

&#9;Tool.Enabled = false

&#9;Heal()
&#9;
&#9;medkits = medkits - 1

&#9;if medkits &lt;= 0 then
&#9;&#9;Tool.Parent = nil
&#9;else
&#9;&#9;wait(.5)
&#9;&#9;Tool.Enabled = true
&#9;end
end


script.Parent.Activated:connect(onActivated)



