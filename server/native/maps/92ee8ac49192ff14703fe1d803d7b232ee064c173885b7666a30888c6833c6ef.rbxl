						<string name="Name">Script</string>
						<ProtectedString name="Source">function spawnKillbot()
&#9;local killbot = game.Lighting.Killbot:clone()
&#9;killbot.Parent = game.Workspace
&#9;killbot:MoveTo(Vector3.new(script.Parent.Position.x + math.random(-600,600), script.Parent.Position.y - 4, script.Parent.Position.z + math.random(-600,600)))
&#9;killbot:makeJoints()
end

while true do
&#9;local players = game.Players:children()

&#9;if (#players &gt; 0) then
&#9;&#9;wait(250 + math.random(0,5))
&#9;&#9;for n=0,5 do
&#9;&#9;&#9;spawnKillbot()
&#9;&#9;end

&#9;&#9;for _,instance in pairs(players) do
&#9;&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;message.Parent = instance
&#9;&#9;&#9;message.Text = &quot;The Killbots are back. To arms!&quot;
&#9;&#9;&#9;wait(5)
