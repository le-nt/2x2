		<Item class="Script" referent="RBX42">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Regenerate Cube</string>
				<ProtectedString name="Source">model = game.Workspace.RegenGroupCube
messageText = &quot;Regenerating PilotLuke&apos;s Battle Cube...&quot;

message = Instance.new(&quot;Message&quot;)
message.Text = messageText
backup = model:clone()

while true do
&#9;wait(script.Parent.RegenerationTime.Value*(1-math.random()*0.8))

&#9;message.Parent = game.Workspace
&#9;model:remove()

&#9;wait(script.Parent.RegenerationDelay.Value)

&#9;model = backup:clone()
&#9;model.Parent = game.Workspace
&#9;model:makeJoints()
&#9;message.Parent = nil
end
</ProtectedString>
			</Properties>
		</Item>
