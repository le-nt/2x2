			<Item class="Script" referent="RBX3890">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">KillbotScript</string>
					<ProtectedString name="Source">local sphere = script.Parent.Head

local myTarget = nil

local speed = math.random(64,70)

local maxHP = 50
local HP = maxHP
local trophism = 80

local rageMode = false
local justDamaged = false

script.Parent.Humanoid.MaxHealth = HP
script.Parent.Humanoid.Health = HP

script.Parent.Name = &quot;Killbot Delta | &quot;.. HP ..&quot;HP&quot;

--give us a color to diferenciate ourselves
sphere.BrickColor = BrickColor.random()

-- obtain goals based on Sphere part
sphere.BodyPosition.position = sphere.Position

-- this code hijacked from the new rocket launcher
local Rocket = Instance.new(&quot;Part&quot;)
Rocket.Locked = true
Rocket.BackSurface = 3
Rocket.BottomSurface = 3
Rocket.FrontSurface = 3
Rocket.LeftSurface = 3
Rocket.RightSurface = 3
Rocket.TopSurface = 3
Rocket.Size = Vector3.new(1,1,4)
Rocket.BrickColor = BrickColor.new(21)
script.Parent.RocketScript:clone().Parent = Rocket
script.Parent.Explosion:clone().Parent = Rocket
script.Parent.Swoosh:clone().Parent = Rocket

local gib = Instance.new(&quot;Part&quot;)
gib.Name = &quot;KillbotMetal&quot; 
gib.BackSurface = 0
gib.BottomSurface = 0
gib.FrontSurface = 0
gib.LeftSurface = 0
gib.RightSurface = 0
gib.TopSurface = 0
gib.Shape = 1 -- block
gib.formFactor = 2 -- plate
gib.Size = Vector3.new(1,.4,1)
gib.Reflectance = sphere.Reflectance
script.Parent.BrickCleanup:clone().Parent = gib

local gib2 = Instance.new(&quot;Part&quot;)
gib2.Name = &quot;KillbotGib&quot; 
gib2.BackSurface = 0
gib2.BottomSurface = 0
gib2.FrontSurface = 0
gib2.LeftSurface = 0
gib2.RightSurface = 0
gib2.TopSurface = 0
gib2.Size = Vector3.new(3,3,1)
gib2.BrickColor = sphere.BrickColor
gib2.Reflectance = sphere.Reflectance
script.Parent.BrickCleanup:clone().Parent = gib2

function fire(target)
&#9;local dir = target - sphere.Position
&#9;dir = computeDirection(dir)
&#9;local missile = Rocket:clone()

&#9;local spawnPos = sphere.Position

&#9;local pos = spawnPos + (dir * 8)
&#9;
&#9;--missile.Position = pos
&#9;missile.CFrame = CFrame.new(pos,  pos + dir)
&#9;missile.RocketScript.Disabled = false
&#9;missile.Parent = game.Workspace
end

function computeDirection(vec)
&#9;local lenSquared = vec.magnitude * vec.magnitude
&#9;local invSqrt = 1 / math.sqrt(lenSquared)
&#9;return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end

function scanForHumans()
&#9;-- KILL THE HUMANS!!!!!!!!!!

&#9;-- for now, pick a random one. In the future, pick the closest. Or use hit test to pick a visible one.
&#9;local humansFound = {}

&#9;local players = game.Players:children()

&#9;if (#players &lt; 1) then return end

&#9;local i = math.random(1, #players)

&#9;myTarget = players[i].Character
end

function moveKillbot()
&#9;
&#9;-- killbots move using a biased random walk toward the target
&#9;-- they also like to float at least 10 studs above the ground

&#9;local dx = math.random(-100,100)
&#9;local dy = math.random(-speed,speed)
&#9;local dz = math.random(-100,100)

&#9;if (sphere.Position.y &lt; 10 and dy &lt; 0) then dy = -dy end
&#9;if (sphere.Position.y &gt; trophism and dy &gt; 0) then dy = -dy end

&#9;if (myTarget ~= nil and myTarget.Humanoid ~= nil and myTarget.Humanoid.Health &gt; 0 and myTarget:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;local dir = computeDirection(myTarget.Torso.Position - sphere.Position)
&#9;&#9;dx = dx + (dir.x * trophism) -- change this number to alter player trophism
&#9;&#9;dy = dy + (dir.y * trophism) 
&#9;&#9;dz = dz + (dir.z * trophism)
&#9;end

&#9;local vec = computeDirection(Vector3.new(dx,dy,dz))

&#9;sphere.BodyPosition.position = sphere.Position + (vec * speed) -- change this number to alter speed
end

function onTouched(hit)
&#9;if hit.Parent then
&#9;&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if humanoid~=nil then
&#9;&#9;&#9;if hit.Parent:findFirstChild(&quot;IsKillbot&quot;) == nil then
&#9;&#9;&#9;&#9;humanoid.Health = humanoid.Health - 2000 -- Killbots kill you when you touch them! duh.
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;if hit.Name == &quot;Projectile&quot; then
&#9;&#9;&#9;&#9;-- sadly, there is no good way to give a killbot hit points, so one hit with any weapon kills them
&#9;&#9;&#9;&#9;--script.Parent.Parent = nil
&#9;&#9;&#9;&#9;if HP &gt; 0 then
&#9;&#9;&#9;&#9;&#9;onDamaged(hit)
&#9;&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;&#9;onKilled(hit)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

sphere.Touched:connect(onTouched)

function onDamaged(hit)
&#9;if hit.Name == &quot;Projectile&quot; then
&#9;&#9;HP = HP - 5
&#9;end

&#9;script.Parent.Humanoid.Health = HP
&#9;if rageMode then
&#9;&#9;script.Parent.Name = &quot;Killbot Delta | &quot;.. HP ..&quot;HP | RAGE MODE&quot;
&#9;else
&#9;&#9;script.Parent.Name = &quot;Killbot Delta | &quot;.. HP ..&quot;HP&quot;
&#9;end

&#9;for n=1,3 do
&#9;&#9;local dir = sphere.Position
&#9;&#9;local gibPart = gib:clone()
&#9;&#9;if math.random(1,3) == 3 then
&#9;&#9;&#9;gib.BrickColor = BrickColor.new(27)
&#9;&#9;&#9;gib.Reflectance = 0.4
&#9;&#9;else
&#9;&#9;&#9;gib.BrickColor = sphere.BrickColor
&#9;&#9;end
&#9;&#9;gibPart.BrickCleanup.Disabled = false
&#9;&#9;gibPart.Position = Vector3.new(dir.x+math.random(1,10),dir.y + 10,dir.z+math.random(1,10))
&#9;&#9;gibPart.CFrame = CFrame.new(dir,Vector3.new(dir.x+math.random(1,10),dir.y+math.random(1,10),dir.z+math.random(1,10)))
&#9;&#9;gibPart.Parent = game.Workspace
&#9;end

&#9;justDamaged = true
&#9;sparkles = Instance.new(&quot;Sparkles&quot;)
&#9;sparkles.Parent = sphere
end

function onKilled(hit)
&#9;for n=1,4 do
&#9;&#9;local dir = sphere.Position
&#9;&#9;local gibPart = gib2:clone()
&#9;&#9;gibPart.BrickCleanup.Disabled = false
&#9;&#9;gibPart.Position = Vector3.new(dir.x+math.random(1,10),dir.y + 10,dir.z+math.random(1,10))
&#9;&#9;gibPart.CFrame = CFrame.new(dir,Vector3.new(dir.x+math.random(1,10),dir.y+math.random(1,10),dir.z+math.random(1,10)))
&#9;&#9;gibPart.Parent = game.Workspace
&#9;end
&#9;explosion = Instance.new(&quot;Explosion&quot;)
&#9;explosion.Position = sphere.Position
&#9;explosion.Parent = game.Workspace
&#9;script.Parent:remove()
end

function regen()
&#9;if HP &lt; script.Parent.Humanoid.MaxHealth then
&#9;&#9;HP = HP + math.random(1,2)
&#9;else
&#9;&#9;HP = script.Parent.Humanoid.MaxHealth
&#9;end

&#9;script.Parent.Humanoid.Health = HP
&#9;if rageMode then
&#9;&#9;script.Parent.Name = &quot;Killbot Delta | &quot;.. HP ..&quot;HP | RAGE MODE&quot;
&#9;else
&#9;&#9;script.Parent.Name = &quot;Killbot Delta | &quot;.. HP ..&quot;HP&quot;
&#9;end
end

while true do  -- loop forever
&#9;scanForHumans()
&#9;for n=1,8 do
&#9;&#9;if (myTarget ~= nil and myTarget.Humanoid ~= nil and myTarget.Humanoid.Health &gt; 0 and myTarget:findFirstChild(&quot;Torso&quot;)) then
&#9;&#9;&#9;if justDamaged and not rageMode then
&#9;&#9;&#9;&#9;wait(3)
&#9;&#9;&#9;&#9;justDamaged = false
&#9;&#9;&#9;end
&#9;&#9;&#9;for _,instance in pairs(sphere:children()) do
&#9;&#9;&#9;&#9;   if instance:IsA(&quot;Sparkles&quot;) then
&#9;&#9;&#9;&#9;&#9;&#9;instance.Parent = nil
&#9;&#9;&#9;&#9;   end
&#9;&#9;&#9;end
&#9;&#9;&#9;fire(myTarget.Torso.Position)
&#9;&#9;&#9;wait(math.random(1,2))
&#9;&#9;&#9;moveKillbot()

&#9;&#9;&#9;if math.random(1,3) == 3 and HP &lt; maxHP then
&#9;&#9;&#9;&#9;rageMode = true
&#9;&#9;&#9;&#9;moveKillbot()
&#9;&#9;&#9;&#9;script.Parent.Name = &quot;Killbot Delta | &quot;.. HP ..&quot;HP  | RAGE MODE&quot;
&#9;&#9;&#9;&#9;ogcolor = sphere.BrickColor
&#9;&#9;&#9;&#9;sphere.BrickColor = BrickColor.Red()
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;for n=1,math.random(2,4) do
&#9;&#9;&#9;&#9;&#9;moveKillbot()
&#9;&#9;&#9;&#9;&#9;wait(0.7)
&#9;&#9;&#9;&#9;&#9;fire(myTarget.Torso.Position)
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;fire(myTarget.Torso.Position)
&#9;&#9;&#9;&#9;wait(1)
&#9;&#9;&#9;&#9;sphere.BrickColor = ogcolor
&#9;&#9;&#9;&#9;rageMode = false
&#9;&#9;&#9;&#9;script.Parent.Name = &quot;Killbot Delta | &quot;.. HP ..&quot;HP&quot;
&#9;&#9;&#9;end

&#9;&#9;&#9;regen()
&#9;&#9;end
&#9;end

&#9;wait(1) -- don&apos;t hog CPU
end
