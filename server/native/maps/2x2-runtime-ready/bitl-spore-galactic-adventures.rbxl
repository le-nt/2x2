								<string name="Name">ObjectScript</string>
								<ProtectedString name="Source">owner = script.Parent.OwnerName
factoryBackup = script.Parent.Parent.RigBackUp
factory = script.Parent
stuff = factory.Stuff


if factoryBackup.Value == nil then  --If the factory hasn't been stored yet (Game just started)


	--Storing stuff for later regen
	stuff.Fence.Value = factory.Fence:clone()



	--Removing stored stuff that can be upgraded/spawned

	factory.Fence:remove()


	--Storing the basic un-upgraded factory. All upgrades are removed above.
	factoryBackup.Value = script.Parent:clone()

end


wait(1)
while script.Parent ~= nil do
	if owner.Value ~= "" then
		local navn = owner.Value
		leaver = game.Players:FindFirstChild(navn)
		if leaver == nil then
			local loc = script.Parent.Parent
			owner.Value = ""
			MajorReset = factoryBackup.Value:clone()
			script.Parent:remove()
			MajorReset.Parent = loc
			MajorReset:MakeJoints()
		end
	
	else
	print ("no owner")
	end
	wait(2)
end

