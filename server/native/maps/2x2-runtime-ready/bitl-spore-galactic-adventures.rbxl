						<ProtectedString name="Source">local Egg = script.Parent

function Touch(hit)
if hit.Parent:findFirstChild("Humanoid")~=nil then
if game.Players:findFirstChild(hit.Parent.Name)~=nil then
ok:disconnect()
wait(.15)
Egg:remove()
player = game.Players:findFirstChild(hit.Parent.Name)
--player.Eggs.Value = player.Eggs.Value +1
	local root = game:GetService("InsertService"):LoadAsset(24840056)
	--game:GetService("InsertService"):Insert(root)
Gui = root.EggGUI
Gui.Parent = player.PlayerGui
Gui.Frame.Frame.ImageLabel.Image = "rbxasset://../../../shareddata/BitlsPlaces/SPORE/assets/&amp;wd=110&amp;ht=110&amp;aid=26716110"
Gui.Frame.Frame.EggName.Text = "Spore Egg Hunt"
Gui.Frame.Frame.EggCount.Text = "You got a egg!"
root:remove()
game.Debris:AddItem(Gui,6)
end
end
end


