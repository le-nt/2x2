										<string name="Name">Script</string>
										<ProtectedString name="Source">function onClicked()
            script.Parent.Parent.Door.Transparency = 1
            wait(0.1)
            script.Parent.Parent.Door.Transparency = 0.9
            wait(0.1)
            script.Parent.Parent.Door.Transparency = 0.8
            wait(0.1)
            script.Parent.Parent.Door.Transparency = 0.7
