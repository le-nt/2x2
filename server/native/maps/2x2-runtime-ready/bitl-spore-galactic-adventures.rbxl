						<string name="Name">READ ME FOR INSTRUCTIONS</string>
						<ProtectedString name="Source">--DONT PUT THIS IN ANYTHING IT'S JUST INSTRUCTIONS.
--First Place the "PUT THIS IN THE WEAPON" script in your Weapon or Tool.
--Then place your Weapon or Tool in the "PUT THE WEAPON IN THIS BRICK" brick.

--IMPORTANT (OPTINAL)
--Before doing anything you should put the Weapon or Tool in the giver where you want it.</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX7214">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Local Gui</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end

	enabled = false
	mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"

	wait(.2)
	mouse.Icon = "rbxasset://textures\\GunCursor.png"
	enabled = true

end

function onEquippedLocal(mouse)

	if mouse == nil then
		print("Mouse not found")
		return 
	end

	mouse.Icon = "rbxasset://textures\\GunCursor.png"
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end


Tool.Equipped:connect(onEquippedLocal)
</ProtectedString>
