							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">RainScript</string>
							<ProtectedString name="Source">eggs = game.Lighting:FindFirstChild("FakeEggs")

if eggs == nil then error("ZOMG NO EGGS!!! D:") end

DropCount = script:FindFirstChild("EggNum").Value
DropCurrent = 0

root = Instance.new("Model")
root.Name = "fakeeggroot"
root.Parent = game.Workspace

function PickEgg()
	e = eggs:GetChildren() --Get the eggs
	i = math.random(1, #e) --The highest number is the max number of eggs
	return e[i]:Clone() --Return the egg with the corrisponding number
end

function DropEgg(egg)
	egg.Parent = root
	egg.Position = Vector3.new(math.random(script.XMin.Value, script.XMax.Value), script.Y.Value, math.random(script.ZMin.Value, script.ZMax.Value))
end

player = script.Starter.Value
msg = Instance.new("Hint")
msg.Parent = player
msg.Text = "Spore Egg Hunt started, good luck."
wait(3)
msg:Remove()

while true do
	wait(math.random(1, 2.5))
	DropEgg(PickEgg())
	DropCurrent = DropCurrent + 1
	if DropCurrent &gt;= DropCount then
		break
	end
end

wait(60)
root:Remove()
script:Remove()</ProtectedString>
