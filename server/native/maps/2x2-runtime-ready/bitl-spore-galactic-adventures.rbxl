							<string name="Name">FakeRain</string>
							<ProtectedString name="Source">--It's a fake egg drop... LOLWUT

function StartDrop(hit)
	player = game.Players:FindFirstChild(hit.Parent.Name)
	if player ~= nil then
		script.Parent.RainScript:FindFirstChild("Starter").Value = player
		script.Parent.RainScript:FindFirstChild("EggNum").Value = script.Parent.Settings:FindFirstChild("# of Eggs").Value
		blarg = script.Parent.RainScript --Getting board with the "script.Parent.RainScript" thing. lol
		blarg2 = script.Parent.Settings
		blarg.XMin.Value = blarg2:FindFirstChild("X Min").Value
		blarg.XMax.Value = blarg2:FindFirstChild("X Max").Value
		blarg.Y.Value = blarg2.Y.Value
		blarg.ZMin.Value = blarg2:FindFirstChild("Z Min").Value
		blarg.ZMax.Value = blarg2:FindFirstChild("Z Max").Value
		script.Parent.RainScript.Parent = script.Parent.Parent
		blarg.Disabled = false
		script.Parent:Remove()
	end
end

script.Parent.Touched:connect(StartDrop)</ProtectedString>
