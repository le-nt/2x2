		<Item class="Script" referent="RBX7264">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">--[[
---------- TIME REVERSAL SCRIPT ----------
This script was created by Patacorow!

--- WHAT THIS DOES ---
This script takes a part and records it.
After a while (which is set by you) the part gets anchored and it's CFrame is brought one step backwards.
The process repeats itself untill the part is in it's starting position again.

--- SETUP ---
This is the time to wait between backward and foward.
Deafult is 100. Change this to whatever you want]]--
TimeToWait = 100
-- WARNING: HIGH NUMBERS MIGHT CAUSE LAG
-- Also, too low numbers will not work. You should at least put in 100
--[[
And this is the syntax printing enabler. Write 1 here if you want the output to print the current
CFrameValue number and it's reversal, and write 0 if you don't: (Deafult is 0)
I'd suggest you write 0, this can cause a crash.
]]--
syntax = 0
--[[

--- FINAL WORDS ---
This took me a while to design, think of and make.
Please, I REALLY beg you to do NOT steal this and claim it as your own! You CAN republish it
but you must include something in the description saying this WAS made by Patacorow.
Also there is this line: "This script was created by Patacorow!". Please don't change it!

Enjoy!

- You can also place this inside your character's torso. If you do this, your character will be reversed each while! :D
--------------------------------------------------
]]--

local check = {"Part","SpawnLocation","FlagStand","Seat"}
num = 1
function write(target)
	for i = 1, #check do
		if target.className == check[i] then
			cfr = Instance.new("CFrameValue")
			cfr.Parent = target
			cfr.Name = num
			cfr.Value = target.CFrame
			num = num + 1
			velc = Instance.new("Vector3Value")
			velc.Name = "Velocity" .. num
			velc.Value = target.Velocity
			velc.Parent = target
		end
	end
end

num = 1
ball = script.Parent
work = 0
ha = 0
isch = 0

while true do
	if num &lt; TimeToWait then
		if work == 0 then
			write(ball)
			num = num + 1
			ball.Anchored = false
			if syntax == 1 then print("Current CFrame: " .. num) end
		end
	end
	if num == TimeToWait + 1 then
		work = 1
	end
	if work == 1 then
		crntnum = ball:findFirstChild(num - 2)
		if crntnum == nil then
			work = 0
			num = 1
		end
		if crntnum ~= nil then
			if syntax == 1 then print("Reversing...") end
			if crntnum.className == "CFrameValue" then
				ball.Velocity = ball["Velocity" .. num - 1].Value
				ball["Velocity" .. num - 1]:Remove()
				ball.CFrame = crntnum.Value
				crntnum:Remove()
				num = num - 2
				if syntax == 1 then print("Reversal: " .. num) end
				local hum = ball.Parent:GetChildren()
				for i = 1, #hum do
					if hum[i].className == "Humanoid" then
						isch = 1
					end
				end
				-- Check if inside character
				if isch == 0 then
					ball.Anchored = true
				end
			end
		end
	end
	wait(.01)
end
