			<Item class="Script" referent="RBX5158">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Master</string>
					<ProtectedString name="Source">local DefaultItem = &quot;Christmas Crowbar&quot;
local Sounds = {
&#9;[&quot;Default&quot;] = &quot;rbxasset://../../../shareddata/ZorkXmas/WoodSmash.mp3&quot;,
&#9;[&quot;Bass&quot;] = &quot;rbxasset://sounds\\bass.wav&quot;,
&#9;[&quot;Glass&quot;] = &quot;rbxasset://sounds\\glassbreak.wav&quot;,
&#9;[&quot;Victory&quot;] = &quot;rbxasset://sounds\\victory.wav&quot;,
&#9;[&quot;Ouch&quot;] = &quot;rbxasset://sounds\\Kid saying Ouch.wav&quot;,

&#9;[&quot;DefaultVOL&quot;] = 0.20,
&#9;[&quot;BassVOL&quot;] = 0.20,
&#9;[&quot;GlassVOL&quot;] = 0.50,
&#9;[&quot;VictoryVOL&quot;] = 0.30,
&#9;[&quot;OuchVOL&quot;] = 0.8
}

local EventDictionary = {} -- in fear of potential memory leak, may be removed if proven otherwise 

function List(handle)
&#9;local ITEM = handle:FindFirstChild(&quot;Special Item&quot;)
&#9;local SOUND, SOUNDVOL = handle:FindFirstChild(&quot;Special Sound&quot;), Sounds[&quot;DefaultVOL&quot;]
&#9;local GIFT = handle:FindFirstChild(&quot;Gift Giver&quot;)
&#9;ITEM = ITEM and ITEM.Value or DefaultItem
&#9;SOUNDVOL = SOUND and Sounds[SOUND.Value .. &quot;VOL&quot;] or SOUNDVOL
&#9;SOUND = SOUND and Sounds[SOUND.Value] or Sounds[&quot;Default&quot;] 
&#9;GIFT = workspace:FindFirstChild(&quot;Gifts&quot;) and GIFT or nil

&#9;return ITEM, SOUND, SOUNDVOL, GIFT
end 

function ExecuteSound(handle, id, vol)
&#9;local Sound = Instance.new(&quot;Sound&quot;)
&#9;Sound.SoundId = id
&#9;Sound.Volume = vol
&#9;Sound.Parent = handle
&#9;Sound:Play() -- If capitalization fails me again, you will find me under the Golden Gate Bridge.
end 

function Looper(handle)
&#9;if handle.className ~= &quot;Part&quot; then return end
&#9;local Item, Sound, Volume, Gift = List(handle)
&#9;local personalkey = tostring(handle.Position)
&#9;
&#9;EventDictionary[personalkey] = handle.Touched:connect(function(Obj) 
&#9;&#9;if Obj.Parent.Name == Item then 
&#9;&#9;&#9;EventDictionary[personalkey]:disconnect()

&#9;&#9;&#9;ExecuteSound(handle, Sound, Volume)
&#9;&#9;&#9;if Gift then 
&#9;&#9;&#9;&#9;local Player = game.Players:GetPlayerFromCharacter(Obj.Parent.Parent)
&#9;&#9;&#9;&#9;if Player then
&#9;&#9;&#9;&#9;&#9;Player.leaderstats.Score.Value = Player.leaderstats.Score.Value +1 -- bleh
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 

&#9;&#9;&#9;if Item ~= DefaultItem then -- remove key from startergui
&#9;&#9;&#9;&#9;local failsafe_item = game.StarterPack:FindFirstChild(Item)
&#9;&#9;&#9;&#9;if failsafe_item then failsafe_item:Remove() end
&#9;&#9;&#9;&#9;Obj.Parent:Remove() -- remove key, but not crowbar
&#9;&#9;&#9;end 

&#9;&#9;&#9;wait() -- debug (if removing this breaks sound, that means this wait gives enough time for script to play sound before removal)
&#9;&#9;&#9;handle:Remove() -- may be replaced with simply hiding if future developments are made
&#9;&#9;end 
&#9;end)
end 

for _, v in pairs(script.Parent:GetChildren()) do
&#9;Looper(v)
&#9;--wait()
&#9;--print(&quot;Applied&quot;, script.Name, &quot;To&quot;, v.Name)
end </ProtectedString>
				</Properties>
			</Item>
