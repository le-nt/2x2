				<ProtectedString name="Source">if script.Parent.Parent:FindFirstChild(&quot;leaderstats&quot;) then return end
local stats = Instance.new(&quot;IntValue&quot;)
stats.Name = &quot;leaderstats&quot;

local score = Instance.new(&quot;IntValue&quot;)
score.Name = &quot;Gifts&quot;
score.Value = 0

score.Parent = stats
stats.Parent = script.Parent.Parent</ProtectedString>
			</Properties>
