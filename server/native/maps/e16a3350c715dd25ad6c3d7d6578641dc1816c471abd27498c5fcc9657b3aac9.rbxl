&#9;--[[_G.Display(Player, {
&#9;&#9;0,
&#9;&#9;&quot;Use the Sleigh tool for more instructions!&quot;,
&#9;&#9;4
&#9;})]]
&#9;local hint = Instance.new(&quot;Hint&quot;, Player)
&#9;hint.Text = &quot;Use the Sleigh tool for more instructions!&quot;
&#9;wait(4)
&#9;hint:Remove()

&#9;script:Remove()
end)
