						<string name="Name">Script</string>
						<ProtectedString name="Source">local Players = {}

local debounce = false
script.Parent.Touched:connect(function(obj)
&#9;local Player = game.Players:GetPlayerFromCharacter(obj.Parent)
&#9;if not Player or debounce then return end
&#9;debounce = true
&#9;
&#9;_G.Display(Player, {
&#9;&#9;0,
&#9;&#9;&quot;It&apos;s locked!&quot;,
&#9;&#9;3,
&#9;&#9;&quot;You hear a voice on the other side...&quot;,
&#9;&#9;3,
&#9;&#9;&quot;\&quot;The key is inside the kilroy!\&quot;&quot;,
&#9;&#9;3
&#9;})
end)
</ProtectedString>
