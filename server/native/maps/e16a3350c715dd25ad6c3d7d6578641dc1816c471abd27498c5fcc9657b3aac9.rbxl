									<ProtectedString name="Source">script.Parent.ChildAdded:connect(function(obj)
&#9;if obj.Name ~= &quot;SeatWeld&quot; then return end
&#9;local Player = game.Players:GetPlayerFromCharacter(obj.Part1.Parent)
&#9;--print(obj.Part1, obj.Part1.Parent)
