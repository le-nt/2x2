		<Item class="Script" referent="RBX7449">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)

-- There is no such thing as saving, but I&apos;m using this to allow players to maintain their scores even if they left the server at first.
local Dictionary = {}

Players.PlayerAdded:connect(function(Player)
&#9;if not Dictionary[Player.Name] then
&#9;&#9;Dictionary[Player.Name] = {
&#9;&#9;&#9;[&quot;Score&quot;] = 0,
&#9;&#9;&#9;[&quot;Snowman&quot;] = 0
&#9;&#9;}
&#9;end
&#9;
&#9;local leaderstats = Instance.new(&quot;Model&quot;)
&#9;local Score = Instance.new(&quot;IntValue&quot;, leaderstats)
&#9;local Snowman = Instance.new(&quot;IntValue&quot;)

&#9;leaderstats.Name = &quot;leaderstats&quot;
&#9;Score.Name = &quot;Score&quot;
&#9;Score.Value = Dictionary[Player.Name][&quot;Score&quot;]

&#9;Snowman.Name = &quot;Snowman&quot;
&#9;Snowman.Value = Dictionary[Player.Name][&quot;Snowman&quot;]

&#9;leaderstats.Parent = Player
&#9;Snowman.Parent = Player
end)


Players.PlayerRemoving:connect(function(Player)
&#9;&#9;Dictionary[Player.Name] = {
&#9;&#9;&#9;[&quot;Score&quot;] = Player.leaderstats.Score.Value,
&#9;&#9;&#9;[&quot;Snowman&quot;] = Player.Snowman.Value
&#9;&#9;}
end)</ProtectedString>
			</Properties>
		</Item>
