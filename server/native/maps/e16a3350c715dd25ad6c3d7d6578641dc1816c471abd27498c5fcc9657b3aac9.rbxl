				<Item class="Script" referent="RBX7504">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)

local score_amount = 1
for _,v in pairs(script.Parent:GetChildren()) do
&#9;if v.className ~= &quot;Part&quot; then return end
&#9;v.Touched:connect(function(obj)
&#9;&#9;if obj.Parent.Name ~= &quot;Sponge&quot; then return end
&#9;&#9;v:Remove()
&#9;&#9;script.Parent.Clean.Value = script.Parent.Clean.Value +1
&#9;&#9;obj.Parent.Handle.Clean:Play()

&#9;&#9;if script.Parent.Clean.Value &gt;= 8 then 
&#9;&#9;&#9;obj.Parent.Handle.Victory:Play()
&#9;&#9;&#9;script.Parent.Parent.Engineer.Name = &quot; Engineer &quot;

&#9;&#9;&#9;local player = Players:GetPlayerFromCharacter(obj.Parent.Parent)
&#9;&#9;&#9;if player then player.leaderstats.Score.Value = player.leaderstats.Score.Value + score_amount end -- bleh

&#9;&#9;&#9;obj.Parent:Remove()
&#9;&#9;&#9;script.Parent:Remove()
&#9;&#9;end
&#9;end)
end </ProtectedString>
					</Properties>
				</Item>
			</Item>
