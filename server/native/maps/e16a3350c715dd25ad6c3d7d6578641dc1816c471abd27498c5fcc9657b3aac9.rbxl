					<ProtectedString name="Source">for _, v in pairs(script.Parent:GetChildren()) do
&#9;if v.className == &quot;Part&quot; then
&#9;&#9;delay(math.random(1,3), function()
&#9;&#9;&#9;while wait(1) do
&#9;&#9;&#9;&#9;local clone = v:Clone()
&#9;&#9;&#9;&#9;clone.Anchored = false
&#9;&#9;&#9;&#9;clone.CanCollide = false
&#9;&#9;&#9;&#9;clone.Transparency = 0.3
&#9;&#9;&#9;&#9;clone.Parent = game.Workspace
&#9;&#9;&#9;end
&#9;&#9;end)
&#9;end 
end </ProtectedString>
