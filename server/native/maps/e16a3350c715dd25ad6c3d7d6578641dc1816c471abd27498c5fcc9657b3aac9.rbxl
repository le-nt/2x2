				<Item class="Script" referent="RBX2506">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MessageBox</string>
						<ProtectedString name="Source">local Limit = 1
local Players = {}

script.Parent.Touched:connect(function(obj)
&#9;local Player = game.Players:GetPlayerFromCharacter(obj.Parent)
&#9;if not Player then return end

&#9;local posPlayer = Players[Player.Name]
&#9;if not posPlayer then 
&#9;&#9;Players[Player.Name] = {[&quot;debounce&quot;] = false, [&quot;amount&quot;] = 0} 
&#9;&#9;posPlayer = Players[Player.Name]
&#9;end

&#9;-- This is a really dumb way of allowing people to see the same tutorial.
&#9;-- May be removed if enough time. But at leas this was a learning experience.
&#9;if posPlayer.debounce == true then return end
&#9;if posPlayer.amount &gt;= Limit then return end
&#9;posPlayer.debounce = true
&#9;
&#9;_G.Display(Player, {
&#9;&#9;0,
&#9;&#9;&quot;You live in your small cabin near Mundelow.&quot;,
&#9;&#9;3,
&#9;&#9;&quot;You&apos;ve been awoken by a loud crash... Someone&apos;s on the floor!&quot;,
&#9;&#9;3,
&#9;&#9;&quot;Use your Examine tool to see who it is!&quot;,
&#9;&#9;3
&#9;})

&#9;posPlayer.amount = posPlayer.amount +1
&#9;posPlayer.debounce = false
end)
</ProtectedString>
					</Properties>
				</Item>
			</Item>
