			<Item class="Script" referent="RBX11">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">wait(4.1337) -- to make sure _G.Captures() exist

local Goal = 10
while wait(1) do
&#9;local Captures = _G.Captures()
&#9;if Captures &gt;= Goal then
&#9;&#9;break
&#9;end 
end 

script.Parent.Barrier:Remove()

local message = Instance.new(&quot;Message&quot;, workspace)
message.Text = Goal .. &quot; Gifts have been delivered! The North Pole Barrier has collapsed!&quot;
for _, v in pairs(script.Parent.Sounds:GetChildren()) do -- nice sounds
&#9;v:Play()
end 

script.Parent.Wall.CanCollide = false 
script.Parent.Wall.Anchored = false 

wait(3)
message:Remove()
script.Parent:Remove()
</ProtectedString>
