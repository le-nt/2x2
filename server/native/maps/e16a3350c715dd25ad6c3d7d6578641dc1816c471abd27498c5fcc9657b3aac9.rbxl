			<Item class="Script" referent="RBX5005">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Master</string>
					<ProtectedString name="Source">local function waitForChild(parent, childName)
    while true do
        local child = parent:FindFirstChild(childName)
        if child then
            return child
        end
        parent.ChildAdded:wait()
    end
end

local Trees = script.Parent.Trees
local Windows = script.Parent.Windows
local TreeScript = waitForChild(script, &quot;Presents&quot;)

-- to make sure the children exist
waitForChild(Trees, &quot;GiftBox1&quot;)
waitForChild(Windows, &quot;Windows1&quot;)

print(&quot;Start!&quot;) -- debug

-- freaky way of connecting windows
for i = 1, #Trees:GetChildren() do
&#9;local Tree = Trees:GetChildren()[i]
&#9;local TreeNumber = tonumber( string.match(Tree.Name, &quot;%d+&quot;) )
&#9;if TreeNumber ~= nil then 
&#9;&#9;for _, Window in pairs(Windows:GetChildren()) do
&#9;&#9;&#9;local WindowNumber = tonumber( string.match(Window.Name, &quot;%d+&quot;) )
&#9;&#9;&#9;if WindowNumber ~= nil then
&#9;&#9;&#9;&#9;if TreeNumber == WindowNumber then
&#9;&#9;&#9;&#9;&#9;local Object = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;&#9;&#9;Object.Name = &quot;Windows&quot;
&#9;&#9;&#9;&#9;&#9;Object.Value = Window
&#9;&#9;&#9;&#9;&#9;Object.Parent = Tree
&#9;&#9;&#9;&#9;&#9;break 
&#9;&#9;&#9;&#9;end 
&#9;&#9;&#9;end 
&#9;&#9;end 
&#9;end 
end 

for _, t in pairs(Trees:GetChildren()) do
&#9;local NewScript = TreeScript:Clone()
&#9;NewScript.Disabled = false
&#9;NewScript.Parent = t
end 

print(&quot;End!&quot;)</ProtectedString>
				</Properties>
				<Item class="Script" referent="RBX5006">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Presents</string>
						<ProtectedString name="Source">-- These Sound Instances could of been done better, but only God knows.

local GiftSound = Instance.new(&quot;Sound&quot;)
GiftSound.SoundId = &quot;rbxasset://sounds\\victory.wav&quot;
GiftSound.Parent = script.Parent
GiftSound.Volume = .3

local OffSound = Instance.new(&quot;Sound&quot;)
OffSound.SoundId = &quot;rbxasset://sounds\\switch.wav&quot;
OffSound.Parent = script.Parent
OffSound.Volume = .7

local OnSound = Instance.new(&quot;Sound&quot;)
OnSound.Name = &quot;OnSound&quot;
OnSound.SoundId = &quot;rbxasset://sounds\\SWITCH3.wav&quot;
OnSound.Parent = script.Parent
OnSound.Volume = 1

script.Parent.Touched:connect(function(Obj)
&#9;if Obj.Parent.Name ~= &quot;Gift&quot; or Obj.Parent.className ~= &quot;Tool&quot; then return end
&#9;if script.Parent.Windows.Value:GetChildren()[1].BrickColor == BrickColor.new(26) then print(&quot;Already captured!&quot;) return end -- TODO: make script which enables houses again by just turning on brickcolor
&#9;
&#9;delay(0, function()
&#9;&#9;_G.Fire(script.Parent, Obj.Parent) -- gift to be removed in another script
&#9;end)

&#9;GiftSound:Play()
&#9;workspace.Gifts.Value = workspace.Gifts.Value +1 -- THIS SHOULD EXIST!!!

&#9;for _, window in pairs(script.Parent.Windows.Value:GetChildren()) do
&#9;&#9;if window.className == &quot;Part&quot; then
&#9;&#9;&#9;window.BrickColor = BrickColor.new(26)
&#9;&#9;end 
&#9;end 

&#9;delay(0.15, function()
&#9;&#9;OffSound:Play()
&#9;end)
end) </ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Script" referent="RBX5007">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Windows Loop</string>
					<ProtectedString name="Source">local Trees = script.Parent.Trees
local Min, Max = 30, 60

local Tick = 0
local Limit = 3 -- Only 3 houses can be turned on every loop!

function Shuffle() -- Fisher-Yates shuffle
&#9;local array = {}
&#9;for i = 1, #Trees:GetChildren() do table.insert(array, i) end
&#9;for i = #array, 2, -1 do
&#9;&#9;local j = math.random(i)
&#9;&#9;array[i], array[j] = array[j], array[i]
&#9;end
&#9;return array
end 

function Check(Tree)
&#9;local Windows = Tree:FindFirstChild(&quot;Windows&quot;)
&#9;if not Windows then return end
&#9;if Windows.Value == nil then return end

&#9;Windows = Windows.Value
&#9;local Block = Windows:GetChildren()[1]
&#9;if Block.BrickColor == BrickColor.new(24) then return end 
&#9;for _, v in pairs(Windows:GetChildren()) do 
&#9;&#9;v.BrickColor = BrickColor.new(24)
&#9;end 

&#9;if Tree:FindFirstChild(&quot;OnSound&quot;) then 
&#9;&#9;Tree.OnSound:Play() 
&#9;end

&#9;print(&quot;Turned on&quot;, Windows.Name)
&#9;return true 
end 

while true do
&#9;Tick = 0
&#9;wait(math.random(Min,Max))
&#9;for _, i in pairs(Shuffle()) do
&#9;&#9;if Check(Trees:GetChildren()[i]) == true then
&#9;&#9;&#9;Tick = Tick +1
&#9;&#9;&#9;if Tick &gt;= Limit then break end 
&#9;&#9;&#9;wait(math.random(1, 3)) -- little variation
&#9;&#9;end 
&#9;end 
end </ProtectedString>
				</Properties>
			</Item>
