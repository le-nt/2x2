		<Item class="Script" referent="RBX17">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Message Master</string>
				<ProtectedString name="Source">local Lighting = game:GetService(&quot;Lighting&quot;)
if not Lighting:FindFirstChild(&quot;Version&quot;) then return end

local Message = nil
local Year = Lighting.Version.Value
Year = tonumber( string.match(Year, &quot;%d+&quot;) )
if not Year then return end

if Year &gt;= 2011 then -- Message instance stops showing up post 2010
&#9;repeat wait() until script:FindFirstChild(&quot;GUI Replacement&quot;) 
&#9;script[&quot;GUI Replacement&quot;].Disabled = false 
&#9;repeat wait() until script:FindFirstChild(&quot;Message Replacement&quot;)
&#9;script[&quot;GUI Replacement&quot;]:Remove()
&#9;Message = script[&quot;Message Replacement&quot;]
end 

Message = Message or Instance.new(&quot;Message&quot;)
Message.Name = &quot;MESSAGE_INSTANCE&quot;

-- actions is array. starts with time, then text, repeat both
-- example: {0, &quot;hey&quot;, 0.2, &quot;i just met you&quot;, 1, &quot;and this is crazy&quot;}
function _G.Display(player, actions)
&#9;if not player or not actions then return end

&#9;local new = Message:Clone()
&#9;local location = Year &lt; 2011 and player or player:FindFirstChild(&quot;PlayerGui&quot;)

&#9;if not location then return end
&#9;local other = location:FindFirstChild(Message.Name) 
&#9;if other then other:Remove() end

&#9;new.Parent = location

&#9;for i = 1, #actions do
&#9;&#9;local current = actions[i]
&#9;&#9;if i % 2 == 0 then 
&#9;&#9;&#9;if Year &lt; 2011 then new.Text = current
&#9;&#9;&#9;else
&#9;&#9;&#9;&#9;new.TextLabel.Text = current
&#9;&#9;&#9;&#9;new.TextLabel.TextLabel.Text = current
&#9;&#9;&#9;end
&#9;&#9;else wait(current) end
&#9;end 

&#9;new:Remove()
end </ProtectedString>
			</Properties>
			<Item class="Script" referent="RBX18">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">GUI Replacement</string>
					<ProtectedString name="Source">-- MAKESHIFT MESSAGE GUI --

local ScreenGui = Instance.new(&quot;ScreenGui&quot;)
local Outline = Instance.new(&quot;TextLabel&quot;)
local Inline = Instance.new(&quot;TextLabel&quot;)
Outline.BackgroundColor3 = Color3.new(-119, -119, -119) -- for some ungodly reason this works. should be 119, 119, 119
Outline.BackgroundTransparency = 0.40
Outline.Font = &quot;ArialBold&quot;
Outline.FontSize = &quot;Size18&quot;
Outline.Position = UDim2.new(0.023, 0, 0.017, 0)
Outline.Size = UDim2.new(0.25, 0, 0.255, 0)
Outline.TextColor3 = Color3.new(0, 0, 0)
Outline.TextWrap = true
Outline.BorderSizePixel = 0

Inline.BackgroundTransparency = 1
Inline.Font = &quot;ArialBold&quot;
Inline.FontSize = &quot;Size18&quot;
Inline.Position = UDim2.new(-0.01, 0, -0.001, 0)
Inline.Size = UDim2.new(1.01, 0, 1.01, 0)
Inline.TextColor3 = Color3.new(1, 1, 1) -- should be 255, 255, 255
Inline.TextWrap = true
Inline.ZIndex = 2

Inline.Parent = Outline
Outline.Parent = ScreenGui
ScreenGui.Name = &quot;Message Replacement&quot;
ScreenGui.Parent = script.Parent

print(&quot;CREATED&quot;)
</ProtectedString>
				</Properties>
			</Item>
		</Item>
