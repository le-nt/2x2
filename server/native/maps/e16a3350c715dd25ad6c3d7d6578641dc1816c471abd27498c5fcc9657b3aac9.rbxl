			<Item class="Script" referent="RBX7527">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Main</string>
					<ProtectedString name="Source">-- Examine Tool Script by Lachrymogenic, a tool that acts like an Interact button you&apos;d see in RPG Games.
-- Heres an example of how to format your Messages variable:

-- Messages = 
-- {
-- [&quot;Baseplate&quot;] = {&quot;Its the floor.&quot;}, 
-- [&quot;Test&quot;] = {&quot;This is a test message&quot;, &quot;Another TEST&quot;}
-- }

-- Below are user definable variables that are required for this tool to work:
-- modelmode, If true, will only look for model names not part names
-- Messages, Name of model/part and the text(s) you want to show when clicked.
-- interval, Time to wait between text

local Player = script.Parent.Parent.Parent -- this should be in backpack when first spawn, so this is player
modelmode = true 

Messages = 
{
[&quot;Tut TV&quot;] = {&quot;Your trusty TV&quot;,&quot;It&apos;s flashing some important information!&quot;},
[&quot;Sleigh1&quot;] = {&quot;It&apos;s Santa&apos;s sleigh!&quot;},
[&quot;Santa&quot;] = {&quot;It&apos;s Santa!&quot;, &quot;I think he&apos;s saying something...&quot;, &quot;\&quot;Please deliver 10 presents... for my elves...\&quot;&quot;, &quot;He dies.&quot;, &quot;You better listen to Santa, &quot; .. Player.Name .. &quot;!&quot;},
[&quot;Fridge&quot;] = {&quot;Looks like Mr C raided the fridge!&quot;},
[&quot;Snowman1&quot;] = {&quot;Howdy, I&apos;m Frosty the 1st!&quot;,&quot;Find the other 2 for a reward!&quot;},
[&quot;Snowman2&quot;] = {&quot;Howdy, I&apos;m Frosty the 2nd!&quot;,&quot;Find the other 2 for a reward!&quot;, &quot;I think one is inside Crunk City...&quot;},
[&quot;Snowman3&quot;] = {&quot;Howdy, I&apos;m Frosty the 3rd!&quot;,&quot;Oh, but you must&apos;ve known that already...&quot;,&quot;Make sure to find the others for a reward!&quot;},
[&quot;Carl&quot;] = {&quot;Hey, don&apos;t tell anyone I said this but&quot;,&quot;There&apos;s something shady going on in there&quot;,&quot;Take this key and invesitage&quot;},
[&quot;StudioAre&quot;] = {&quot;Ah, StudioAre, home sweet home...&quot;},
[&quot;Train&quot;] = {&quot;A freight train blocks the road.&quot;},
[&quot;TownSign&quot;] = {&quot;The sign reads:&quot;,&quot;Welcome to Mundelow&quot;,&quot;Population: Yes&quot;},
[&quot;Tapes&quot;] = {&quot;An old fashioned 8-track 3 stack&quot;,&quot;I love myself some Pink Floyd.&quot;},
[&quot;Hifi&quot;] = {&quot;A very expensive HiFi setup.&quot;},
[&quot;Antenna&quot;] = {&quot;This bad boy gets you upwards of 3 channels!&quot;},
[&quot;Elf1&quot;] = {&quot;Sorry \&quot;Big Guy\&quot;, I&apos;m off duty.&quot;},
[&quot;Elf2&quot;] = {&quot;Catch me later, I&apos;ll buy you some nog!&quot;},
[&quot;Elf3&quot;] = {&quot;No can do big man, I&apos;m busy.&quot;},
[&quot;Elf4&quot;] = {&quot;Hey man, these toys don&apos;t make themselves!&quot;},
[&quot;Elf5&quot;] = {&quot;please santa im a tired boy&quot;},
[&quot;Elf6&quot;] = {&quot;Welcome back!&quot;, &quot;Oh, you&apos;re wondering how I know you?&quot;, &quot;Santa lets us in on the sleep-watching, too.&quot;},
[&quot;Engineer&quot;] = {&quot;Hey you, you look helpful!&quot;,&quot;I need someone to clean the crap off my train.&quot;,&quot;All that graffiti isn&apos;t much of a looker...&quot;,&quot;Take this sponge, I&apos;ll give you a reward if you do good!&quot;},
[&quot; Engineer &quot;] = {&quot;Thanks a ton kid!&quot;,&quot;Take your reward - You&apos;ve earned it!&quot;},

[&quot;Steve Hitbox&quot;] = {&quot;No! Leave me alone!&quot;, &quot;Please spare me...&quot;},
[&quot;Grumblo&quot;] = {&quot;Hey! It&apos;s the cat!&quot;, &quot;Time to return them for my reward...&quot;},
[&quot;Grumblo&apos;s Door&quot;] = {&quot;Please find my Grumblo!&quot;, &quot;I&apos;ll give you something in return!&quot;}
}

interval = 3 


-- END OF VARIABLES, EVERYTHING ELSE BELOW IS LIKE, COMPLICATED CODE AND STUFF.
-- Haha, complicated. Funny!
tool = script.Parent
Mouse = nil

function onEquipped(mouse)
&#9;Mouse = mouse 
&#9;Mouse.Move:connect(onMouseMove)
end

function modelorpart()
&#9;if Mouse == nil then return end
&#9;if Mouse.Target == nil then return end
&#9;if Mouse.Target.Name == &quot;Steve Hitbox&quot; then return Mouse.Target.Name end -- exception
&#9;if Mouse.Target.Name == &quot;Grumblo&apos;s Door&quot; then return Mouse.Target.Name end -- exception
&#9;if Mouse.Target.Parent.Name == &quot;Grumblo&quot; then return Mouse.Target.Parent.Name end -- exception
&#9;if modelmode == false then
&#9;&#9;if Mouse.Target == nil then return nil end
&#9;&#9;return Mouse.Target.Name
&#9;else
&#9;&#9;if Mouse.Target.Parent == nil then return nil end
&#9;&#9;if Mouse.Target.Parent.className == &quot;Model&quot; then
&#9;&#9;&#9;return Mouse.Target.Parent.Name
&#9;&#9;end
&#9;end
end

function onActivated()
&#9;if tool.Enabled == false then return end
&#9;if Mouse ~= nil then
&#9;&#9;local MOP = modelorpart()
&#9;&#9;if Messages[MOP] ~= nil then

&#9;&#9;&#9;-- this is bad code but you are not my dad!!!! harharhar
&#9;&#9;&#9;local stringarray = Messages[MOP]
&#9;&#9;&#9;if string.match(MOP, &quot;Snowman&quot;) == &quot;Snowman&quot; then
&#9;&#9;&#9;&#9;if not Mouse.Target.Parent:FindFirstChild(&quot;Frame&quot;) then
&#9;&#9;&#9;&#9;&#9;Player.Snowman.Value = Player.Snowman.Value +1
&#9;&#9;&#9;&#9;end

&#9;&#9;&#9;&#9;if Player.Snowman.Value == 3 then
&#9;&#9;&#9;&#9;&#9;Player.Snowman.Value = 1337
&#9;&#9;&#9;&#9;&#9;Player.leaderstats.Score.Value = Player.leaderstats.Score.Value +1
&#9;&#9;&#9;&#9;&#9;Instance.new(&quot;Frame&quot;, Mouse.Target.Parent)

&#9;&#9;&#9;&#9;&#9;local sound = Instance.new(&quot;Sound&quot;)
&#9;&#9;&#9;&#9;&#9;sound.SoundId = &quot;rbxasset://sounds\\victory.wav&quot;
&#9;&#9;&#9;&#9;&#9;sound.Parent = Mouse.Target
&#9;&#9;&#9;&#9;&#9;sound:Play()

&#9;&#9;&#9;&#9;&#9;stringarray = {&quot;You found all of us!&quot;, &quot;Here&apos;s a reward, as we promised.&quot;}
&#9;&#9;&#9;&#9;&#9;delay(2, function() 
&#9;&#9;&#9;&#9;&#9;&#9;sound:Remove()
&#9;&#9;&#9;&#9;&#9;end)
&#9;&#9;&#9;&#9;elseif Player.Snowman.Value == 1337 then
&#9;&#9;&#9;&#9;&#9;stringarray = {&quot;Are we made of flesh? Or are we made of snow?&quot;, &quot;We scream, as we do not know.&quot;}
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end 

&#9;&#9;&#9;local custom_array = {}
&#9;&#9;&#9;table.insert(custom_array, 0)
&#9;&#9;&#9;for i = 1, #stringarray do
&#9;&#9;&#9;&#9;table.insert(custom_array, stringarray[i])
&#9;&#9;&#9;&#9;table.insert(custom_array, interval)
&#9;&#9;&#9;end

&#9;&#9;&#9;tool.Enabled = false
&#9;&#9;&#9;_G.Display(game.Players:GetPlayerFromCharacter(tool.Parent), custom_array)
&#9;&#9;&#9;tool.Enabled = true

&#9;&#9;&#9;--[[
&#9;&#9;&#9;for i, v in pairs(Messages[MOP]) do
&#9;&#9;&#9;&#9;local message = Instance.new(&quot;Message&quot;)
&#9;&#9;&#9;&#9;message.Text = v
&#9;&#9;&#9;&#9;message.Parent = game.Players:FindFirstChild(tool.Parent.Name)
&#9;&#9;&#9;&#9;tool.Enabled = false
&#9;&#9;&#9;&#9;wait(interval)
&#9;&#9;&#9;&#9;message.Parent = nil
&#9;&#9;&#9;&#9;tool.Enabled = true
&#9;&#9;&#9;end]]
&#9;&#9;end
&#9;end
end

function onMouseMove()
&#9;if Mouse ~= nil then
&#9;&#9;if Messages[modelorpart()] ~= nil then
&#9;&#9;&#9;Mouse.Icon = &quot;rbxasset://textures/DragCursor.png&quot;
&#9;&#9;else
&#9;&#9;&#9;Mouse.Icon = &quot;rbxasset://textures/ArrowCursor.png&quot;
&#9;&#9;end
&#9;end
end

tool.Equipped:connect(onEquipped)
tool.Activated:connect(onActivated)</ProtectedString>
				</Properties>
			</Item>
