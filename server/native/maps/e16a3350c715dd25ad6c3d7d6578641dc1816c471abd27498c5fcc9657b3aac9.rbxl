		<Item class="Script" referent="RBX4993">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Gift Master</string>
				<ProtectedString name="Source">print(&quot;script&quot;)

local Players = game:GetService(&quot;Players&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)

local GiftDefacto = Lighting.Gift
local GiftTextures = Lighting[&quot;Gift Textures&quot;]
local TextureChildren = GiftTextures:GetChildren()

local CharacterAddedReplacement = false 

-- player has a texture id rather than gift instance to save on space
-- player gets different texture each time they get a new gift
local Dictionary = {}
--local Captures = {}

local TotalCaptures = 0

-- Player Event Section --

if Lighting:FindFirstChild(&quot;Version&quot;) then
&#9;local Year = Lighting.Version.Value
&#9;Year = tonumber( string.match(Year, &quot;%d+&quot;) )
&#9;if Year then
&#9;&#9;if Year &lt; 2009 then -- CharacterAdded does not exist before 2009E
&#9;&#9;&#9;CharacterAddedReplacement = true
&#9;&#9;end 
&#9;end 
end 

function RandomTexture(Previous)
&#9;local Random = math.random(1, #TextureChildren)
&#9;local Texture = TextureChildren[Random]
&#9;return Texture == Previous and RandomTexture(Previous) or Texture -- As long as there&apos;s more than one gift texture, this should not end in a crash!
end 

-- make sure to remove &quot;.png&quot; and perhaps &quot;gifts/&quot; if textures do not load after novetus auto-localization
function ConstructGift(Player, Texture)
&#9;local Gift = GiftDefacto:Clone()
&#9;Gift.TextureId = &quot;rbxasset://../../../shareddata/ZorkXmas/icons/&quot; .. Texture.Name .. &quot;.png&quot; 
&#9;Gift.Handle.Mesh.TextureId = Texture.Value
&#9;Gift.Parent = Player.Backpack
end 

function PlayerAdded(Player)
&#9;if Dictionary[Player.Name] == nil then -- Y&apos;know what? I&apos;ll keep them in. Just in case they accidentally quit.
&#9;&#9;Dictionary[Player.Name] = RandomTexture()
&#9;end 

&#9;--[[if Captures[Player.Name] == nil then
&#9;&#9;Captures[Player.Name] = 0
&#9;end]]

&#9;if not CharacterAddedReplacement then -- if characteradded exists
&#9;&#9;Player.CharacterAdded:connect(function()
&#9;&#9;&#9;ConstructGift(Player, Dictionary[Player.Name])
&#9;&#9;end)

&#9;&#9;delay(0.1337, function() -- might allow gift duplication if player is fast enough to equip/drop gift
&#9;&#9;&#9;if not Player.Backpack:FindFirstChild(&quot;Gift&quot;) then
&#9;&#9;&#9;&#9;ConstructGift(Player, Dictionary[Player.Name])
&#9;&#9;&#9;end 
&#9;&#9;end)
&#9;end 
end

Players.PlayerAdded:connect(PlayerAdded)

-- Global Event Section --

repeat wait() until workspace:FindFirstChild(&quot;Components&quot;)
local Components = workspace[&quot;Components&quot;]

function _G.Fire(Culprit, Gift)
&#9;local Player = Players:GetPlayerFromCharacter(Gift.Parent) 
&#9;if Player == nil then print(&quot;No Player&quot;) return end
&#9;if Culprit.Parent.Parent ~= Components then print(&quot;Denied Operation&quot;) return end 
&#9;
&#9;-- bad but bleh :)
&#9;Player.leaderstats.Score.Value = Player.leaderstats.Score.Value +1 
&#9;TotalCaptures = TotalCaptures +1
&#9;Dictionary[Player.Name] = RandomTexture(Dictionary[Player.Name])
&#9;ConstructGift(Player, Dictionary[Player.Name])
&#9;Gift:Remove()

&#9;_G.Display(Player, {
&#9;&#9;0,
&#9;&#9;&quot;Congrats! Here&apos;s another gift...&quot;,
&#9;&#9;2
&#9;})
end 

-- subsitute for CharacterAdded in 2008
function _G.Acquire(Player)
&#9;if not CharacterAddedReplacement then return end 
&#9;if Player.className ~= &quot;Player&quot; then print(&quot;Not Player!&quot;) return end
&#9;if Dictionary[Player.Name] == nil then print(&quot;Not encoded yet.&quot;) return end
&#9;ConstructGift(Player, Dictionary[Player.Name])
&#9;return true
end 

-- reads captures for north pole
function _G.Captures()
&#9;return TotalCaptures
end 

-- SOLO-PROOF APPLICATION --
repeat wait() until #Players:GetPlayers() &gt; 0
PlayerAdded(Players:GetPlayers()[1])
print(&quot;First Player Joined&quot;)</ProtectedString>
