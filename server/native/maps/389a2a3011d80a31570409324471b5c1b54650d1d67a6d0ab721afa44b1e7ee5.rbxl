					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Tutorial Display</string>
					<ProtectedString name="Source">local duration = 4

local name, times = &quot;grab_tutorial&quot;, 3
local countdown = game.Players.LocalPlayer:FindFirstChild(name) or Instance.new(&quot;IntValue&quot;, game.Players.LocalPlayer)
countdown.Name = name
if countdown.Value &gt;= times then return end

event = script.Parent.Selected:connect(function()
	event:disconnect()
	countdown.Value = countdown.Value + 1

	local GUI = script:GetChildren()[1]
	GUI.Parent = game.Players.LocalPlayer.PlayerGui

	wait(duration)
	GUI:Remove()
	script:Remove()
end)</ProtectedString>
