						<ProtectedString name="Source">print(&quot;PumpkinBomb hopper script loaded&quot;)

local bin = script.Parent
local bombScript = script.Parent.Bomb

local function plant()
	local bomb = bin.PumpkinBomb:clone()

	local spawnPos = game.Players.LocalPlayer.Character.PrimaryPart.Position

	bomb.PrimaryPart = bomb.Pumpkin --I noticed that this gets reset to nil when you receive it from the shop. Could this be caused by :Clone()?
	bomb.PrimaryPart.Position = Vector3.new(spawnPos.x, spawnPos.y+3, spawnPos.z)

	bomb.Parent = game.Workspace
	local new_script = bombScript:clone()
	new_script.Disabled = false
	new_script.Parent = bomb

end



local enabled = true
local function onButton1Down(mouse)
	if not enabled then
		return
	end
	if not game.Workspace:FindFirstChild(&quot;CurrentMap&quot;) or not game.Workspace.CurrentMap:FindFirstChild(&quot;Ghosts&quot;) then
		return
	end

	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\ArrowFarCursor.png&quot;

	plant()

	wait(5)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	enabled = true

end

local function onSelected(mouse)
	print(&quot;bomb selected&quot;)
	mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

bin.Selected:connect(onSelected)
