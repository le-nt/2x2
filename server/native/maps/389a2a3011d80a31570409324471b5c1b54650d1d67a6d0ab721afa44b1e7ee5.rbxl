				<ProtectedString name="Source">for _,v in pairs(workspace.CurrentCamera:GetChildren()) do
	v:Remove()
end 

-- This script is just in case the arrows don&apos;t decay.
-- Yes, this is lazy. But you are not my dad!</ProtectedString>
