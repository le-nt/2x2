			<Item class="Script" referent="RBX5">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">AreaChecker</string>
					<ProtectedString name="Source">--[[
function areaCheck(t, z) -- stolen from fencing
	if t:IsA(&quot;BasePart&quot;) and z:IsA(&quot;BasePart&quot;) then 
		local tp=t.Position -- torso position
		local ap=z.Position -- zone position
		local as=z.Size -- zone size
		local ax=(as.x+1)/2 -- SIZE X + 1 / 2
		local ay=(as.z+1)/2 -- SIZE Z + 1 / 2
		local ax1=ap.x-ax -- POSITION X - (SIZE X + 1 / 2)
		local ax2=ap.x+ax -- POSITION X + (SIZE X + 1 / 2)
		local ay1=ap.z-ay -- POSITION Z - (SIZE Z + 1 / 2)
		local ay2=ap.z+ay -- POSITION Z + (SIZE Z + 1 / 2)
		if tp.x&gt;ax1 and tp.x&lt;ax2 and tp.z&gt;ay1 and tp.z&lt;ay2 then 
			-- this if statement is basically asking; &quot;Is the player in between this area?
			-- this is done by subtracting and adding the position and size, for X and Z. Y isn&apos;t needed. 
			-- This is then, in the if statement, compares if the torso position is above the negative, but below the positive.
			-- If all is true, then return true. 
			return true
		end
	end
	return false
end
--]]

--[[
_G.GhostsInArea = function(Area, Ghosts) -- inefficient? 
	local GhostsInside = {}
	for _, Ghost in pairs(Ghosts) do
		if areaCheck(Ghost, Area) then 
			table.insert(GhostsInside, Ghost)
		end
	end
	return GhostsInside
end 
--]]

--A simple table for showing how many Ghosts each player moved into the truck.
--We can&apos;t just know the top player! We need to know every player&apos;s contributions to reward them individually!
-- HOW IT WORKS: in grab tool, give objectvalue to ghost that is grabbed. if let go before area, get rid. if in area when dropped, give. if grabbed but still in Ghost, stay same player.
-- POTENTIAL ISSUES: players might figure out and just drag ghosts in and out to get the most points
--[[
_G.GhostContributions = function() --AreaGhosts is from GetGhostsInArea. returns table of {GhostsTable, playerInstance}
	local Players = {}
	local AreaGhosts = _G.GhostsInArea(_G.GetMap().TruckPoint, _G.GetMap().Ghosts:GetChildren())
	for _, Ghost in pairs(AreaGhosts) do
		print(&quot;A Ghost&quot;) -- A Ghost?!
		if Ghost:FindFirstChild(&quot;Player&quot;) and (Ghost.Player.Value ~= nil) then 
			if (Players[Ghost.Player.Value.Name] == nil) then
				Players[Ghost.Player.Value.Name] = {1, Ghost.Player.Value}
			else
				Players[Ghost.Player.Value.Name][1] = Players[Ghost.Player.Value.Name][1] + 1
			end
		end
	end

	return Players
end
--]]

local GhostsMoved = 0

_G.GhostContributions = {} --Placeholder for now.
-- What we need to do for this is add an event or something that tracks when a ghost passes through the &quot;HolePoint&quot;, an invisible part placed in the hole to detect parts falling through it.
-- no instead im just puting the placeholder script inside the finish part :)
-- yes this might be a bad idea but this is just for this halloween thing
-- god this looks ugly but if we keep cleaning scripts we&apos;ll never get this finished...

-- true, true. it do be facts tho.

_G.GhostsMoved = function(scr, scr2)
	if scr and scr.Parent.Name == &quot;Finish&quot; then -- and game.Lighting.Maps:FindFirstChild(scr.Parent.Parent.Name) then
		GhostsMoved = GhostsMoved + 1
	elseif scr2 and scr2 == script.Parent then GhostsMoved = 0
	else return GhostsMoved end
end

-- potential idea to give more points to person who captured the most ghosts
_G.GhostMVP = function() --Returns the MVP player instance
	table.sort(_G.GhostContributions(), function(a, b)
		return a[1] &gt; b[1]
	end)
end 

--print(&quot;AreaChecker Loaded&quot;)</ProtectedString>
