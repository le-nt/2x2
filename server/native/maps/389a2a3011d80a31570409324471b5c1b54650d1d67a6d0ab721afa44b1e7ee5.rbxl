							<ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)

local fire = script.Parent
local damage = 400

function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid and not Players:GetPlayerFromCharacter(hit.Parent) then
		humanoid.Health = humanoid.Health - damage
		wait(2)
		connection:disconnect()
	else
		damage = damage - 1
		if damage &lt; 390 then
			connection:disconnect()
		end
	end
end

connection = fire.Touched:connect(onTouched)

local RunService = game:GetService(&quot;RunService&quot;)
local t, s = RunService.Stepped:wait() -- ????????
local d = t + 2.0 - s
local madeGray = false
while t &lt; d do
	t = RunService.Stepped:wait()
	if madeGray == false and d - t &lt; 0.7 then
		madeGray = true
		fire.BrickColor = BrickColor.new(0.4, 0.4, 0.4)
	end
end

fire.Parent = nil</ProtectedString>
