				<ProtectedString name="Source">-- Forgot how much work it is to replace to factor out the truck from these scripts...
-- lol. i would put a ghost emoji here, but old roblox doesn&apos;t support emojis.
-- is that a good thing? what if i wanna express :moyai: in game, what then?

-- constant variables

local SOLO_ENABLED = false
Script = game.Lighting:FindFirstChild(&quot;ScriptLoaded&quot;)
if Script then
	if Script.Value == &quot;Solo&quot; then
		SOLO_ENABLED = true
	end
end

local MIN_PLAYERS = 2 -- Minimum # of players needed for rounds can start, to be decided

local MAX_ROUND_TIME = 180 -- check MapHandler&apos;s Algorithm function for more info

local INTERMISSION_TIME = 15 -- Seconds of Intermission time
local PREPARATION_TIME = 5 -- Seconds of Preperation time (after Intermission, before Round)

local MIN_GHOSTS = 10 -- Minimum # of ghosts needed for map to be viable, to be decided
--local UP_COUNT = 4.8 -- # of studs Truck will be spawned above TruckPoint (from Root origin)
--local TRUCK_SHAKE_AMOUNT = 10 -- # of studs Truck will be launched up for the shake test
--local TRUCK_SHAKE_DURATION = 4 -- Seconds of shaking before script continues

local CURRENCY_NAME = &quot;Tickets&quot; -- name for main leaderboard $
local BONUS_AMOUNT = 10 --Bonus tickets amount payed to each player if the team gets &gt;= 90% of ghosts in

-- other variables

local Players = game:GetService(&quot;Players&quot;)
local PlayerGameList = {} -- dictionary of players who are playing. includes their instance

local Hint = workspace:FindFirstChild(&quot;Hint&quot;) or Instance.new(&quot;Hint&quot;, workspace)

-- Find on: MapHandler
--local Last_Map 

local RoundInProgress = script.RoundInProgress
_G.GetRoundPlayingStatus = function() -- prevent exploits but allows access to state
	return RoundInProgress.Value
end

-- im too lazy to re-do/add to the MapHandler so i&apos;ll just put it here, be aware of caps sens.
local LOBBY_SONG = &quot;Calm&quot;
local SongList = {
	[&quot;Campsite&quot;] = &quot;Minas&quot;,
	[&quot;Ghost Town&quot;] = &quot;Moog City&quot;,
	[&quot;SharkRock Island&quot;] = &quot;Rocket Jump Waltz&quot;,
	[&quot;Dark Hills&quot;] = &quot;Sojourn&quot;,
	[&quot;Nowhere To Run&quot;] = &quot;Still Alive&quot;
}
_G.SongPlaying = function(scr, request)
	if (scr == script and type(request) == &quot;string&quot;) then 
		local SPV = _G.SongPlaying()
		if SPV and SPV:FindFirstChild(request) then
			SPV.Value = request
		end
	else return script:FindFirstChild(&quot;SongPlaying&quot;) end  
end

local DebugMode = false
_G.GetDebugMode = function()
	return DebugMode
end

_G.leaderboard_communicator = true -- ugly way to give debugmode status to leaderstats, to be discussed in future

-- functions

local function Speak(message, timer)
	Hint.Text = message
	if (timer) then wait(timer) end 
end 

-- Not sure if this is needed. Might just be my paranoia in terms of h4x and accidents. Could be cleared up for space, if you really want that.
local function Handler(message)
	Speak(message, 9)
	delay(0, function()
		_G.DestroyMap()
		script.Disabled = true
		wait(1)
		script.Disabled = false 
	end)
end 

local function DoPlayers(list, func) -- saves space 
	for _, player in pairs(list) do
		if player.Character and player:FindFirstChild(&quot;leaderstats&quot;) then
			func(player)
		end
	end
end

local function RoundCheck(Components, percent) -- if not return true, stop round
	if (percent == 100) then return end -- if all ghosts are captured, stop round

	for i, c in pairs(Components) do
		if (type(c) == &quot;userdata&quot;) and (c.Parent == nil) then
			number_for_info = i
			return i
		end
	end 

	local ListAmount = 0 -- because doing #PlayerGameList does not work for dictionaries
	for _, _ in pairs(PlayerGameList) do ListAmount = ListAmount + 1 end

	if (#Players:GetPlayers() &lt;= 0) or (ListAmount &lt;= 0) then 
		return &quot;Not enough players to continue round!&quot;
	end 

	return true
end 

local function RewardPlayers(collected, total)
	for _, player in pairs(PlayerGameList) do --playerData in pairs(_G.BoxContributions()) do
		local currency = player.leaderstats[CURRENCY_NAME] --playerData[2].leaderstats[CURRENCY_NAME]

		--[[if not payAmount then
			--Pay based on ghosts moved instead of an arbitrary value which are for bonuses and such
			payAmount = playerData[1]
		end]]

		-- rough calculation
		currency.Value = currency.Value + ( (collected/total) * 100 )--payAmount --TODO test how broken points earning is and adjust values accordingly
	end
end

--[[
local function Ranking(Remaining, Total, OriginalTotal) -- to be refined
	if (Remaining == 0) then 
		return &quot;You lost all your ghosts! Make sure to pack them better next time!&quot;
	elseif (Remaining == Total) then
		if (OriginalTotal == Total) then
			return &quot;You got ALL the ghosts! Amazing job!&quot;
		else
			return &quot;You kept all your ghosts! Good job! Make sure to get more ghosts next time!&quot;
		end 
	elseif (Remaining == (Total -1)) then
		return &quot;Ouch! You were one ghost short from keeping all your ghosts! Better luck next time!&quot;
	else
		return string.format(
			&quot;You lost %d ghosts in the drop test, but the other %d ghosts were packed well enough!&quot;,
			(Total - Remaining),
			(Total - (Total - Remaining))
		)
	end
end
--]]

--PlayerGameList Section

local function ListRemoval(player)
	if (PlayerGameList[player.Name]) then
		PlayerGameList[player.Name] = nil
		print(player.Name.. &quot; removed from list&quot;)
		
	else print(player.Name.. &quot; is not on list&quot;) end
end

local function PlayerAdded(player)
	player.CharacterAdded:connect(function(character)
		print(player.Name.. &quot; added&quot;)

		-- For some reason when playing, if the health (just) reaches 0, then the player is not removed.
		-- Hopefully we dont have to run into this problem. 
		-- If so, uncomment the line below, and comment out the event definitions.
		--repeat wait() until Humanoid.Health &lt;= 0 
		character.Humanoid.Died:connect(function()
			print(player.Name.. &quot; died&quot;)
			ListRemoval(player)
		end)
	end)
end

if (DebugMode) then 
	repeat wait() until #Players:GetPlayers() &gt; 0
	PlayerAdded(Players:GetPlayers()[1])
end

Players.PlayerAdded:connect(PlayerAdded)
Players.PlayerRemoving:connect(ListRemoval)

-- main loop

local STORAGE_MP = MIN_PLAYERS
while true do
	-- shifted to top so server can turn back to intermission if it goes from 1 --&gt; 2 --&gt; 1
	local seflag = true 
	if script:FindFirstChild(&quot;Start Early&quot;) then 
		if #Players:GetPlayers() &lt;= 1 then
			MIN_PLAYERS = 1
			seflag = false 
		else script[&quot;Start Early&quot;]:Remove() end 
	elseif SOLO_ENABLED then
		if #Players:GetPlayers() &lt;= 1 then
			MIN_PLAYERS = 1
			seflag = false 
		end
	end 

	MIN_PLAYERS = (seflag) and STORAGE_MP or MIN_PLAYERS
	if #Players:GetPlayers() &lt; MIN_PLAYERS then
		Speak(
			string.format(
				&quot;There needs to be %d player%s ingame to start a round.&quot;, 
				MIN_PLAYERS, 
				((MIN_PLAYERS == 1) and &quot;&quot; or &quot;s&quot;) -- correct grammar. 1 player[], 2 player[s]
			)
		)
		repeat wait(1) until (#Players:GetPlayers() &gt;= MIN_PLAYERS) or script:FindFirstChild(&quot;Start Early&quot;) or SOLO_ENABLED
	end 

	for i = INTERMISSION_TIME, 1, -1 do 
		Speak(string.format(&quot;Intermission - the next round will begin in %d seconds.&quot;, i), 1)
	end	

	DoPlayers(Players:GetPlayers(), function(player)
		PlayerGameList[player.Name] = player
		print(player.Name.. &quot; added&quot;)
	end)
	
	--print(script, PlayerGameList, MIN_GHOSTS, MAX_ROUND_TIME)
	local MapArray = _G.LoadMap(script, PlayerGameList, MIN_GHOSTS, MAX_ROUND_TIME)--, UP_COUNT)
	if (type(MapArray) ~= &quot;table&quot;) then Handler(MapArray) break end

	local Ghosts, HolePoint, SpawnPoint = MapArray[1], MapArray[2], MapArray[3]
	local round_time = MapArray[#MapArray] -- round_time is always last in list

	Speak(&quot;The game will start soon!&quot;, PREPARATION_TIME) -- maybe transport players in near this point +animation transition
	Speak(&quot;Ready...&quot;, 1)
	Speak(&quot;Set...&quot;, 1)
	Speak(&quot;MOVE!&quot;, 1) --TODO change this

	_G.SongPlaying(script, SongList[MapArray[4].Name] or LOBBY_SONG) --[4] is map
	DoPlayers(PlayerGameList, function(player)
		if script:FindFirstChild(&quot;Arrow&quot;) then script[&quot;Arrow&quot;]:Clone().Parent = player.PlayerGui end
		player.Character.Humanoid.WalkSpeed = 32 -- faster
		player.Character:MoveTo(SpawnPoint.Position + Vector3.new(math.random(-5, 5), 5, math.random(-5, 5))) -- maybe different spawn points?
	end)

	MapArray[4].Name = &quot;CurrentMap&quot; -- carried from MapHandler so the grab tool can work; to be removed when midi music application is reformed
	local AllGhosts = #Ghosts:GetChildren() - 1 -- dont include script
	RoundInProgress.Value = true
	local percent, last = 0
	for i = round_time, 0, -0.1 do
		percent = _G.GhostsMoved() / AllGhosts * 100 --(#_G.BoxesInArea(TruckPoint, Ghosts:GetChildren()) / #Ghosts:GetChildren()) * 100
		if (math.floor(i) ~= last) then if (RoundCheck(MapArray, percent) ~= true) then break end end -- every ~second, check
		Speak(
			string.format(
				&quot;%s seconds left! %d%% of ghosts have been captured!&quot;,
				((i &gt; 5) and math.ceil(i) or string.format(&quot;%.1f&quot;, i)),
				percent
			),
			0.1
		)
	end 

	-- ugly :(
	RoundInProgress.Value = false
	local Check = RoundCheck(MapArray)
	if (Check == true) then 
		local FinalGhosts = _G.GhostsMoved() --_G.BoxesInArea(TruckPoint, Ghosts:GetChildren())

		if (FinalGhosts ~= 0) then 
			--Speak(&quot;Time&apos;s up! Get ready for the drop test!&quot;, 3)
			Speak(
				string.format(
					&quot;You got %d out of %d ghosts into the moving area in %d seconds.&quot;, 
					FinalGhosts, 
					AllGhosts, 
					round_time
				),
				3
			)

			--[[
			-- if player in area, teleport to spawn. then, regardless, make them SNAILS!
			DoPlayers(PlayerGameList, function(player)
				local bodyParts = _G.BoxesInArea(TruckPoint, player.Character:GetChildren())
				if (bodyParts[1]) and (bodyParts[1].Parent == player.Character) then 
					player.Character:MoveTo(SpawnPoint.Position)
				end
				player.Character.Humanoid.WalkSpeed = 0
			end)

			local Root = Truck.Cage.Root
			_G.FocusCamera = Root
			Speak(&quot;But did you pack it in well enough? Lets see...&quot;, 2)
			local handle = _G.ShakeTest(&quot;ShakeShack&quot;, Truck, Root, FinalGhosts, TRUCK_SHAKE_AMOUNT) -- maybe put in semi-closed door to prevent unfair physics? Maybe that&apos;s what makes it fun.
			if (handle ~= nil) then Handler(handle) end -- test returns error message if exists

			wait(TRUCK_SHAKE_DURATION) -- Maybe around this point, or a bit later, animation transitions could start?
			if (Truck.Parent ~= nil) then -- just in case it spazzes and kills itself. maybe put this with mentions of cage and root if truck somehow gets killed?
				TruckPoint.Position = Root.Position -- truckpoint is invisible and non-cancollide in final product

				local RemainingBoxes = _G.BoxesInArea(TruckPoint, FinalGhosts)
				Speak(Ranking(#RemainingBoxes, #FinalGhosts, #Ghosts:GetChildren()), 3)
	
				local bonusEarned = (#RemainingBoxes / #Ghosts:GetChildren()) &gt;= 0.9
				local bonusReward = 0
				local bonusString = &quot;&quot;
				if bonusEarned then
					bonusString = string.format(&quot; as well as a bonus of %d tickets&quot;, BONUS_AMOUNT)
					Speak(&quot;You got more than 90% of all the ghosts into the truck! Tickets bonus earned!&quot;, 3)
					RewardPlayers(BONUS_AMOUNT)
				end
				RewardPlayers() -- TODO Total isn&apos;t mentioned anywhere in loop?
				Speak(string.format(&quot;Players will now be paid for their individual efforts%s!&quot;, bonusString), 3)
			else -- TODO make less-ugly if possible
				--RewardPlayers(Total)
				Speak(&quot;The truck... uh, it did that. Please report this bug to the owners! Restarting...&quot;, 3)
			end
			--]]

			Speak(&quot;Players will now be paid for their overall efforts!&quot;, 3)
			RewardPlayers(FinalGhosts, AllGhosts)
		else
			Speak(&quot;No ghosts were captured...&quot;, 3)
		end
	else
		if (tonumber(Check)) then 
			Speak(string.format(&quot;Component #%d was deleted. Please report this bug to the owners!&quot;, number_for_info), 3)
			number_for_info = nil
		else
			Speak(Check, 3)
		end 
	end

	DoPlayers(PlayerGameList, function(player)
		player.Character.Humanoid.Health = 0 
		PlayerGameList[player.Name] = nil -- just in case
	end)

	_G.SongPlaying(script, LOBBY_SONG)
	_G.FocusCamera = nil
	_G.DestroyMap()
	_G.GhostsMoved(nil, script) -- resets ghostmoved value
	Speak(&quot;Thanks for playing!&quot;, 3)
end</ProtectedString>
				<bool name="archivable">true</bool>
