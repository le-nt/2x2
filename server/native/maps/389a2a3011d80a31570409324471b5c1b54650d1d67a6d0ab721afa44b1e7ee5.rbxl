				<Item class="LocalScript" referent="RBX862">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LocalScript</string>
						<ProtectedString name="Source">repeat wait() until script.Parent:FindFirstChild(&quot;Exit Spec&quot;) and script.Parent:FindFirstChild(&quot;Next&quot;) and script.Parent:FindFirstChild(&quot;Spectate&quot;)
local bExitSpec = script.Parent[&quot;Exit Spec&quot;]
local bNext = script.Parent.Next
local bSpectate = script.Parent.Spectate

local Player = game.Players.LocalPlayer

local current_id, current_list = 1
local spectating = false 

local function playerList()
	local x = {}
	for _, v in pairs(game.Players:GetPlayers()) do
		table.insert(x, v)
	end
	return x
end 

local function nextFunc()
	local plr, chr
	for i = current_id+1, #current_list do
		--plr = current_list[i]
		if current_list[i] ~= nil then
			chr = workspace:FindFirstChild(current_list[i].Name)
			if chr:FindFirstChild(&quot;Humanoid&quot;) and chr:FindFirstChild(&quot;Head&quot;) and chr.Humanoid.Health &gt; 0 then
				current_id = i
				plr = current_list[i]
				break
			end
		end
	end
	if (current_id &gt;= #current_list) then current_id = 0 end 
	if not plr and not chr then
		current_list = playerList()
		nextFunc()
	end 
	
	--print(plr, chr, current_id)
	workspace.CurrentCamera.CameraSubject = chr.Humanoid
end 

bSpectate.MouseButton1Click:connect(function()
	if not spectating then
		spectating = true 
		bSpectate.Visible, bSpectate.Active = false, false
		for _, v in pairs({bNext, bExitSpec}) do v.Visible, v.Active = true, true end
		current_list = playerList()
	end 
end)

bNext.MouseButton1Click:connect(nextFunc)

bExitSpec.MouseButton1Click:connect(function()
	if spectating then
		spectating = false 
		workspace.CurrentCamera.CameraSubject = Player.Character.Humanoid
		bSpectate.Visible, bSpectate.Active = true, true
		for _, v in pairs({bNext, bExitSpec}) do v.Visible, v.Active = false, false end
	end 
end)</ProtectedString>
						<bool name="archivable">true</bool>
