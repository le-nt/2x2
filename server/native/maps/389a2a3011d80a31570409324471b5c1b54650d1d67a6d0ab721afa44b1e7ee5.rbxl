			<Item class="LocalScript" referent="RBX818">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Skin Application</string>
					<ProtectedString name="Source">--[[
	How this works:
	- A model called &quot;Skins&quot; is put inside Lighting
	- It includes all avaliable Skins ingame, with each skin model including its&apos; effects as instances.
	- If its a property change, it is a []value, with the name being the property and the value being the intended change.
	- If its another effect, it is simply put inside the skin model.

	- Another script dictates the players ability to buy skins. 
	- The shop would put a BoolValue inside a player&apos;s &quot;Skins&quot; folder, which becomes true or false depending on if has the skin equipped or not.
	- The script you&apos;re in right now simply checks which value is true, and then applies the skin name to the skin instance.
	- The main script then applies the changes.

	- If a skin called &quot;Remove&quot; is put inside the player, and it is true, then the Skin value inside this tool is deleted.
	- It will remain deleted until the next time the player wants to use a skin, which then it is re-created.
	- The shop script must delete this Remove skin if it wants to give or equip a skin.
	
	Could this be better? Could the entire tool be better?
	Yes. But it&apos;s better to finish this now then give up and use the old one.
]]

---===--- ---===--- VARIABLES ---===--- ---===---

-- Player Definitions
local Players = game:GetService(&quot;Players&quot;)
local Player = Players.LocalPlayer

repeat wait() until Player.Character:FindFirstChild(&quot;Humanoid&quot;)
local Humanoid = Player.Character.Humanoid

-- Skins in Lighting check
local SkinStorage = game.Lighting:FindFirstChild(&quot;Skins&quot;)
if (not SkinStorage) then print(&quot;There is no skin model inside Lighting&quot;) return end
if (#SkinStorage:GetChildren() == 0) then print(&quot;There is no skins in the Lighting skin folder&quot;) return end

-- If the player has a skin inside this skins folder, then that means that they own the skin
-- If the skin, which is a boolvalue, is true; that means it is currently equipped by the player.
print(&quot;Waiting for&quot;, Player.Name, &quot;Skins...&quot;)
repeat wait() until Player:FindFirstChild(&quot;Skins&quot;)
local Skins = Player.Skins

-- Events: Array to store Changed events. Is to be cleaned when the player dies.
-- This will NOT work if the player is LoadCharacter()&apos;d. IT WILL CAUSE A MEMORY LEAK IF BYPASSED!
local Events = {}

---===--- ---===--- FUNCTIONS ---===--- ---===---

-- When events are defined within events, or what-not, they don&apos;t &quot;go away&quot; when the object does. 
-- This is due to how :Remove() works; it just .Parent&apos;s the object to nil. It doesn&apos;t disconnect any events related to it.
-- Without this key function, these events will start to build up and slow down the game -- eventually even crashing it.
local function Break()
	for _, event in pairs(Events) do
		if (event) then event:disconnect() end
	end
end 

local function Application(Object)
	if SkinStorage:FindFirstChild(Object.Name) and Object:IsA(&quot;BoolValue&quot;) and Object.Value == true then
		local SkinString = script.Parent:FindFirstChild(&quot;Skin&quot;) or Instance.new(&quot;StringValue&quot;)
		if (Object.Name == &quot;Remove&quot;) then SkinString:Remove() Events[Object.Name]:disconnect() return end -- deletes skin value if wanted

		SkinString.Name, SkinString.Value = &quot;Skin&quot;, Object.Name
		SkinString.Parent = script.Parent
	end
end 

local function EventApplication(Object)
	if (Events[Object.Name]) then Events[Object.Name]:disconnect() end
	Events[Object.Name] = Object.Changed:connect(function()
		Application(Object)
	end)
	print(&quot;event applied&quot;)
end 

---===--- ---===--- MAIN ---===--- ---===---

-- If no skins, wait until skins.
if (#Skins:GetChildren() == 0) then 
	repeat wait() until #Skins:GetChildren() &gt; 0
end 

-- Event applications for skins!
for _, Skin in pairs(Skins:GetChildren()) do Application(Skin) EventApplication(Skin) end
Events[&quot;Skins_ChildAdded&quot;] = Skins.ChildAdded:connect(EventApplication)

-- Prevents data leak. 
Humanoid.Died:connect(Break)

print(Player.Name, script.Parent.Name, script.Name, &quot;Completed Action&quot;)
</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX819">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Main Script</string>
					<ProtectedString name="Source">---===--- ---===--- SETTING VARIABLES ---===--- ---===---

-- Charges: Velocity amounts for each charge stage
-- Duration: # of seconds a stage lasts (except last)
-- Splice: # of times a value check is done per stage
local Charges = {10, 25, 40, 60}
local Duration = 0.5
local Splice = 4

-- StudDistance: Distant automatically put between box and player after throwing box
local StudDistance = 5

---===--- ---===--- OTHER VARIABLES ---===--- ---===---
--repeat wait() until workspace:FindFirstChild(&quot;CurrentMap&quot;) and workspace.CurrentMap:FindFirstChild(&quot;Ghosts&quot;) 

-- Icons for Detect()
local Icons = {
	[&quot;Regular&quot;] = &quot;rbxasset://textures\\ArrowCursor.png&quot;,
	[&quot;Drag&quot;] = &quot;rbxasset://textures\\DragCursor.png&quot;
}

-- Mouse: Mouse instance taken from Selected event
-- ButtonPress: Mouse.Button1Down Event variable to be discarded in Deselected event to prevent leak
-- ButtonRelease: Button_Down but Mouse.Button1Up
-- MouseSelect: Button_Down but Mouse.Move
local Mouse, ButtonPress, ButtonRelease, MouseSelect

-- CurrentBox: Box carried by player 
local CurrentBox

-- START: MaxVelocity # that the arms start with for ShoulderAnimation()
-- MAX: MaxVelocity # that the arms are constantly looped through until the box is dropped
-- DESIRED: DesiredAngle # that are constantly looped through until the box is dropped
local START, MAX, DESIRED = 1337, 0.50, 3.14

-- Storage: Array to store the original versions of the affected properties caused by SkinApplication()
local Storage = {}

-- debounce: Boolean for Selected(), prevents mass-click box grabs
local debounce = false

-- Charging: Variable for the script acknowledging if the player is charging for a throw or not
local Charging = false

-- Player Definitions
local Players = game:GetService(&quot;Players&quot;)
local Player = Players.LocalPlayer
repeat wait() until Player:FindFirstChild(&quot;PlayerGui&quot;)
local PlayerGui = Player.PlayerGui

repeat wait() until Player.Character
local Character = Player.Character

repeat wait() until Player.Character:FindFirstChild(&quot;Humanoid&quot;)
local Humanoid = Player.Character.Humanoid

repeat wait() until Player.Character:FindFirstChild(&quot;Head&quot;)
local Head = Player.Character.Head

--Other data
repeat wait() until workspace:FindFirstChild(&quot;Round Script&quot;) and workspace[&quot;Round Script&quot;]:FindFirstChild(&quot;RoundInProgress&quot;)
local RoundInProgress = workspace[&quot;Round Script&quot;].RoundInProgress

---===--- ---===--- FUNCTIONS ---===--- ---===---

-- Returns Y offset for putting box ontop of head
local function offset_formula(x, y)
	print(&quot;Offset formula&quot;)
	return -( (x.Size.Y/2) + (y.Size.Y/2) )
end 

-- Returns first section of Velocity for Throw()
local function throw_formula(stage)
	print(&quot;Throw formula&quot;)
	local lookVector = Head.CFrame.lookVector
	local RightVector = lookVector:Cross(Vector3.new(0, 1, 0))
	local UpVector = RightVector:Cross(lookVector)
	return (lookVector + UpVector)
end

-- Checks for if target is a box viable for picking up
local function Viable(Target)
	return (Target)
	and (Head) 
	and Target:IsA(&quot;BasePart&quot;) 
	and not (Target.Anchored)
	and (Target.Locked) -- WHY DO YOU KEEP FORGETTING THIS
	and not (Target:FindFirstChild(&quot;Box Weld&quot;)) 
	and RoundInProgress.Value
	and (
		Target.Parent.Name == &quot;Ghosts&quot; -- good enough. head --&gt; ghosts
		and Target.Parent.Parent.Name == &quot;CurrentMap&quot; -- good enough. head --&gt; ghosts --&gt; map
	) or Target.Name == &quot;PumpkinBomb&quot; --this &quot;or&quot; operator will only compare to the previous thing, really not clean but it&apos;s hard to format parentheses like this ok!!!
end 

-- Checks if torso has shoulders, for ShoulderAnimation()
local function ShouldersViable()
	local Torso = Character:FindFirstChild(&quot;Torso&quot;)
	if (Torso) then 
		local RightShoulder, LeftShoulder = Torso:FindFirstChild(&quot;Right Shoulder&quot;), Torso:FindFirstChild(&quot;Left Shoulder&quot;)
		if (RightShoulder and LeftShoulder) then
			return RightShoulder, LeftShoulder
		end
	end 
end 

-- Animates the players arms. BUG: STARTS TO SPAZ OUT STARTING 2011-2012
local function ShoulderAnimation() 
	local RightShoulder, LeftShoulder = ShouldersViable()
	if (RightShoulder and LeftShoulder) then

		-- snap to position
		RightShoulder.MaxVelocity = START
		LeftShoulder.MaxVelocity = START
		RightShoulder.DesiredAngle = DESIRED
		LeftShoulder.DesiredAngle = -DESIRED	

		-- keep position until condition, then let go
		while (CurrentBox) and ShouldersViable() do
			RightShoulder.MaxVelocity = MAX
			LeftShoulder.MaxVelocity = MAX
			RightShoulder.DesiredAngle = DESIRED
			LeftShoulder.DesiredAngle = -DESIRED
			wait()
		end

	end
end 

-- Drops the box, and turns the variable into nil
local function Drop()
	if (CurrentBox) then
		for _, obj in pairs(CurrentBox:GetChildren()) do 
			if not obj:IsA(&quot;Decal&quot;) and not obj:IsA(&quot;Script&quot;) and not obj:IsA(&quot;Sound&quot;) then -- prevents decals being removed in event of boxes with decals (like ghosts), can be removed if skins include decals
				obj:Remove() -- remove weld &amp; any effects
			end 
		end 
		for name, val in pairs(Storage) do CurrentBox[name] = val end -- skin reset
		Storage = {} -- storage reset
		
		CurrentBox.CanCollide = true 
		CurrentBox = nil
	end
end 

-- Throws the box
local function Throw(Stage)
	if not (Head and CurrentBox) then print(&quot;nope&quot;) Drop() return end
	local Velocity, Power = throw_formula(Stage), Charges[Stage] 

	CurrentBox.Position = Head.Position + Head.CFrame.lookVector * StudDistance
	CurrentBox.Velocity = Head.Velocity + (Velocity * Power)

	Drop()
end 

-- Charges a shot for throwing the box
local function Charge()
	-- Create needed components (sound and numbervalue for gui)
	local Bass = Instance.new(&quot;Sound&quot;)
	Bass.SoundId = &quot;rbxasset://sounds/bass.wav&quot;
	Bass.Parent = Character:FindFirstChild(&quot;Head&quot;) or script.Parent.Parent.Parent.PlayerGui -- ugly but works rather than defining one-use variable

	local ChargeInt = Instance.new(&quot;NumberValue&quot;)
	ChargeInt.Name = &quot;Charge Value&quot;
	ChargeInt.Parent = script.Parent

	-- Charge up loop for throwing
	local Stage = (1/Splice) * (Splice-1) 
	Charging = true 

	while (Charging) do
		Stage = (Stage &lt; #Charges) and (Stage + (1/Splice)) or 1
		if (ChargeInt) then ChargeInt.Value = Stage end -- just in case of destruction, to prevent error

		Bass.Pitch = math.floor(Stage)
		Bass:Play()

		wait(Duration/Splice)
	end

	-- Throws and remove components
	Throw(math.floor(Stage))
	Bass:Remove()
	ChargeInt:Remove()
	
	-- Possibly prevents potential data leak
	ChargeInt = nil
	Stage = nil 
end 

-- for Charge()
local function LetGoCharge()
	if (Charging == true) then
		Charging = false
	end
end 

-- Changes the box to a skin
-- See Skin Application for more Information
local function SkinApplication()
	local Skins = game.Lighting:FindFirstChild(&quot;Skins&quot;)
	local SkinString = script.Parent:FindFirstChild(&quot;Skin&quot;)
	if (Skins and SkinString) and SkinString:IsA(&quot;StringValue&quot;) then
		local Specific = Skins:FindFirstChild(SkinString.Value)
		if (Specific) then
			for _, val in pairs(Specific:GetChildren()) do
				if (not CurrentBox) then break end
				if (string.match(val.className, &quot;Value&quot;) == &quot;Value&quot;) then
					Storage[val.Name] = CurrentBox[val.Name]
					CurrentBox[val.Name] = val.Value
				else -- effects like fire or sparkles
					val:Clone().Parent = CurrentBox
				end
			end
		end
	end 
end 

-- Pick up box for moving
local function PickUp(Box)
	CurrentBox = Box
	CurrentBox.CanCollide = false 

	delay(0, function()
		SkinApplication()
		ShoulderAnimation()
	end)

	local Weld = Instance.new(&quot;Weld&quot;)
	Weld.Name = &quot;Box Weld&quot;
	Weld.Parent = CurrentBox

	-- Positions box above head
	-- If box too big (&gt;4x4x4), it clips the player into origin; making them fall to their deaths. TODO: Figure out why...
	Weld.Part0, Weld.Part1 = Head, CurrentBox
	Weld.C0 = CurrentBox.CFrame 
	Weld.C1 = Head.CFrame * CFrame.new(0, offset_formula(CurrentBox, Head), 0) 

	Mouse.Icon = Icons.Regular
end 

-- Checks if player is holding box or not, does functions accordingly
local function Decision()
	local Target = Mouse.Target
	if (CurrentBox) then Charge()
	elseif Viable(Target) then PickUp(Target) end
end 

-- Changes Icon depending on what mouse is hovering over
local function Detect()
	if Viable(Mouse.Target) and (not CurrentBox) then Mouse.Icon = Icons.Drag
	else Mouse.Icon = Icons.Regular end
end

local function Selected(_mouse)
	if (not debounce) and (_mouse) then
		debounce = true
		Mouse = _mouse

		ButtonPress = Mouse.Button1Down:connect(Decision)
		ButtonRelease = Mouse.Button1Up:connect(LetGoCharge)
		MouseSelect = Mouse.Move:connect(Detect)

		debounce = false 
	end
end 

local function Deselected()
	Drop(CurrentBox)
	for _, Event in pairs({ButtonPress, ButtonRelease, MouseSelect}) do
		if (Event) then
			Event:disconnect()
		end
	end

	Charging = false -- disables charge if exists
	if (Mouse) then 
		Mouse.Icon = Icons.Regular
		Mouse = nil
	end 
end 

---===--- ---===--- MAIN ---===--- ---===---

script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
Humanoid.Died:connect(function() Deselected() script:Remove() end) -- shuts off selected() without needing to define event variables

print(Player.Name, script.Parent.Name, script.Name, &quot;Completed Action&quot;)</ProtectedString>
