				<ProtectedString name="Source">-- this would be a localscript but it gives me illegal action errors

repeat wait() until workspace:FindFirstChild(&quot;Round Script&quot;)
local LB = Instance.new(&quot;Message&quot;)
LB.Name, LB.Parent = &quot;Local_Bricks&quot;, script.Parent.Parent.Character

local SPV = workspace[&quot;Round Script&quot;]:FindFirstChild(&quot;SongPlaying&quot;) --_G.SongPlaying()
-- &quot;hurdur you can use _G on localscripts in studio but not in server&quot;
-- WHY DO YOU ALLOW IT THEN ROBLOX YO UFUCIC FCOCKASHACASOCAJDSDJANDAZM

if (SPV) then --if (LB and SPV) then 
	local SongClone
	local function addVolume(song)
		local x = song:FindFirstChild(&quot;VolumeV&quot;) or Instance.new(&quot;NumberValue&quot;)
		x.Name, x.Value = &quot;VolumeV&quot;, ((x.Value == 0) and 1 or x.Value)
		if script.Parent.Parent:FindFirstChild(&quot;GlobalVolume&quot;) then
			x.Value = script.Parent.Parent.GlobalVolume.Value
		end
		return x
	end

	local function application()
		if script.Parent.Parent:FindFirstChild(&quot;GlobalVolume&quot;) and script.Parent.Parent.GlobalVolume.Value == 0 then return end
		local Song = SPV:FindFirstChild(SPV.Value)
		if Song and Song:IsA(&quot;LocalScript&quot;) and not LB:FindFirstChild(SPV.Value) then
			for _, c in pairs(LB:GetChildren()) do c:Remove() end 
			SongClone = Song:Clone()
			SongClone.Parent = LB
			addVolume(Song).Parent = SongClone
		end 
	end 

	application()
	SPV.Changed:connect(application)

	local function command(message)
		if (string.match(message, &quot;:volume &quot;) == &quot;:volume &quot;) then
			local volume = tonumber(string.sub(message, 9))
			if (volume) then return volume end 
		end 
	end

	local old_volume
	script.Parent.Parent.Chatted:connect(function(message)
		local volume = command(message)
		if volume and SongClone and SongClone:FindFirstChild(&quot;VolumeV&quot;) then
			volume = (volume &gt; 1) and 1 or ((volume &lt; 0) and 0 or volume)

			local x = script.Parent.Parent:FindFirstChild(&quot;GlobalVolume&quot;) or Instance.new(&quot;NumberValue&quot;)
			x.Name, x.Value = &quot;GlobalVolume&quot;, volume
			x.Parent = script.Parent.Parent

			SongClone.Disabled = (volume == 0) and true or false
			if old_volume and old_volume == 0 and volume &gt; 0 then 
				application() 
			else
				SongClone.VolumeV.Value = volume
			end 

			old_volume = volume
		end
	end)
end </ProtectedString>
