++&quot;, 343, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;A+&quot;, 343, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;B-&quot;, 343, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;A+&quot;, 343.5, 1, &quot;Align:;sound:Ping;&quot;},{&quot;A++&quot;, 343.5, 1, &quot;Align:;sound:Ping;&quot;},{&quot;B--&quot;, 343.5, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;D--&quot;, 344, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;A-&quot;, 344.5, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;D-&quot;, 345, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;A-&quot;, 345.5, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;B--&quot;, 346, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;G+&quot;, 346.5, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;G&quot;, 346.5, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;F--#&quot;, 346.5, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;F#&quot;, 347, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;F+#&quot;, 347, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;B-&quot;, 347, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;F+#&quot;, 347.5, 1.5, &quot;Align:;sound:Ping;&quot;},{&quot;F#&quot;, 347.5, 1.5, &quot;Align:;sound:Ping;&quot;},{&quot;B--&quot;, 347.5, 0.5, &quot;Align:;sound:Ping;&quot;},{&quot;D--&quot;, 348, 1, &quot;Align:;sound:Ping;&quot;},}
