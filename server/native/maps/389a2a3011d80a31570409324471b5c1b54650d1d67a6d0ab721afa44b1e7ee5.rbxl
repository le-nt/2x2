						<ProtectedString name="Source">-- this originally was a localscript but it seems like localscripts don&apos;t like using global events 
local count = 0.30
local loops = 7
local colors = {
	Color3.new(-255, -255, 0),
	Color3.new(-102, 0, -255)
}

local sound = Instance.new(&quot;Sound&quot;)
sound.Pitch, sound.SoundId = 1.34, &quot;rbxasset://sounds/victory.wav&quot;
sound.Parent = script

local debounce = false
script.Parent.Parent.Parent.Parent.Chatted:connect(function(message)
	if not debounce and string.match(string.lower(message), &quot;loud&quot;) then
		debounce = true
		script.Parent.Visible = true
		sound:Play()
		for i = 0, (#colors * 7)-1 do
			script.Parent.BorderColor3 = colors[(i%(#colors))+1]
			wait(count)
		end 
		script.Parent.Visible = false
		debounce = false
	end
end)

