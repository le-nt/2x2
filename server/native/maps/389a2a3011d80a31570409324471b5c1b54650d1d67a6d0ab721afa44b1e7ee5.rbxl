					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Arrow</string>
					<ProtectedString name="Source">-- in playergui instance
-- value in player instance
local check = script.Parent.Parent:FindFirstChild(&quot;arrow_label_count&quot;) or Instance.new(&quot;IntValue&quot;)
check.Name, check.Parent = &quot;arrow_label_count&quot;, script.Parent.Parent
if check.Value &gt; 4 then script:Remove() end 

--repeat wait() until game.Lighting:FindFirstChild(&quot;Arrow Script&quot;)
repeat wait() until workspace:FindFirstChild(&quot;CurrentMap&quot;)
check.Value = check.Value + 1

if workspace.CurrentMap:FindFirstChild(&quot;Finish&quot;) then
	--game.Lighting[&quot;Arrow Script&quot;]:Clone().Parent = workspace.Camera
	
	local model = game.Lighting:FindFirstChild(&quot;Arrow&quot;)
	if not model then return end

	model = model:Clone()
	model.Parent = workspace.CurrentCamera

	local part = model:GetChildren()[1]
	if not part then return end

	function GetDescendants(object)
		local descendants = {}
		local function Scan(parent)
			for _,v in pairs(parent:GetChildren()) do
				table.insert(descendants, v)
				Scan(v)
			end
		end

		Scan(object)
		return descendants
	end

	local function SetModelCFrame(primpart, model, desiredcf)
		local origprimpartcf = primpart.CFrame
		for i, part in pairs(GetDescendants(model)) do
			if part:IsA(&quot;Part&quot;) then 
				local offset = origprimpartcf:inverse() * part.CFrame
				part.CFrame = desiredcf * offset
			end 
		end

		primpart.CFrame = desiredcf
	end 

	SetModelCFrame(part, model, workspace.CurrentMap.Finish.CFrame * CFrame.new(0, 40, 0) * CFrame.Angles(0, 0, -1.55))

	local countdown = 60
	local t = time()

	local switch = 0

	delay(0, function()
		while time() &lt; (t+countdown) do
			SetModelCFrame(part, model, part.CFrame * CFrame.Angles(.05, 0, 0))
			wait(0.05)
			--SetModelCFrame(part, script.Arrow, part.CFrame * CFrame.new(0, shift(), 0))
		end 
		--switch = switch + 1
	end)

	local offset = 2
	local orin = &quot;Y&quot;
	local oris = tonumber(part.CFrame[orin])
	local set = 0.2
	local function shift()
		if part.CFrame[orin] &gt;= (oris + offset) or part.CFrame[orin] &lt;= (oris - offset) then
			set = -set
		end
		return set
	end 

	--delay(0, function()
	while time() &lt; (t+countdown) do
		SetModelCFrame(part, model, part.CFrame + Vector3.new(0, shift(), 0))
		wait(.05)
	end
	--switch = switch + 1
	--end)

	--repeat wait() until switch &gt;= 2
	model:Remove()
	script:Remove()
end </ProtectedString>
