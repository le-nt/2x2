repeat wait() until _G.GetMap() and _G.GetRoundPlayingStatus() == true 
if _G.GetMap() ~= script.Parent.Parent then return end 

local Whitelist = {&quot;Pellet&quot;, &quot;FireShot&quot;}

local events = {}
for i,v in pairs(script.Parent:GetChildren()) do
	if v:IsA(&quot;Part&quot;) then
		delay(0, function() 
			local model = Instance.new(&quot;Model&quot;)
			model.Name = &quot;Ghost&quot;
			model.Parent = script.Parent
			v.Parent = model

			local torso = script.Torso:Clone()
			torso.Anchored = false 
			torso.Parent = model

			local Sound = script.Sound:Clone()
			Sound.Parent = v

			local weld = Instance.new(&quot;Weld&quot;)
			weld.Parent = v
			weld.Part0 = v
			weld.Part1 = torso  
	
			local original_pos = v.Position
			local BodyPos = script.BodyPosition:Clone()

			local firstHit

			BodyPos.position = original_pos
			BodyPos.Parent = v

			torso.Anchored = false
			v.Anchored = false 
			v.Locked = true -- &gt;:)

			local random_name, bool = tostring(i), true
			events[random_name] = v.Touched:connect(function(obj)
				for _, viable_objname in pairs(Whitelist) do
					if obj.Name == viable_objname then
						firstHit = obj.Name
						events[random_name]:disconnect() -- attempt to index global &apos;event&apos; (a nil value)
						bool = false
						break
					end
				end
			end)

			local t, random = time(), x[math.random(1, #x)]
			while (bool == true and _G.GetRoundPlayingStatus() ~= false) do
				wait()
				if time() &gt;= (t + random) then 
					t, random = time(), x[math.random(1, #x)]
					BodyPos.position = Vector3.new(
						original_pos.X + math.random(-10,10),
						original_pos.Y + math.random(-2, 2),
						original_pos.Z + math.random(-10, 10)
					)
				end 
			end

			if _G.GetRoundPlayingStatus() == false then 
				events[random_name]:disconnect()
				bool = false 
			else
				local humanoid = Instance.new(&quot;Humanoid&quot;)
				
				local currentHealth = 20
				if firstHit == &quot;FireShot&quot; then
					currentHealth = 0 --Pumpkin Bomb is an instakill
				end

				humanoid.Health, humanoid.MaxHealth = currentHealth, 25 -- already hurt due to first hit
				humanoid.Parent = model

				while (humanoid.Health &gt; 0 and _G.GetRoundPlayingStatus() ~= false) do
					wait()
					if time() &gt;= (t + random) then 
						t, random = time(), x[math.random(1, #x)]
						BodyPos.position = Vector3.new(
							original_pos.X + math.random(-10,10),
							original_pos.Y + math.random(-2, 2),
							original_pos.Z + math.random(-10, 10)
						)
					end 
				end

				--Sound.PlayOnRemove = true --Sound:Play()
				Sound:Play()
			end

			v.Parent = script.Parent
			model:Remove()
			BodyPos:Remove()
		end)
	end 
end </ProtectedString>
