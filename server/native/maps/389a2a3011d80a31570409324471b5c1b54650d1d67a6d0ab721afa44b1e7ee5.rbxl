				<ProtectedString name="Source">repeat wait() until _G.leaderboard_communicator == true
print(&apos;leaderboard&apos;)

local Players = game:GetService(&quot;Players&quot;)
local debugStart = 1337

local function LeaderboardSetup(player, dbS)
	if player:FindFirstChild(&quot;leaderstats&quot;) then return end

	local leaderstats = Instance.new(&quot;Model&quot;)
	leaderstats.Name = &quot;leaderstats&quot;
	leaderstats.Parent = player

	local money = Instance.new(&quot;IntValue&quot;)
	money.Name = &quot;Tickets&quot; -- Tickets is a nice name.
	money.Value = (dbS) and dbS or 0
	money.Parent = leaderstats
end

Players.PlayerAdded:connect(LeaderboardSetup)

-- allows play with play solo
--local DebugMode = _G.GetDebugMode()
--if (DebugMode == true) then 
	repeat wait() until #Players:GetPlayers() &gt; 0
	LeaderboardSetup(Players:GetPlayers()[1], debugStart)
--end </ProtectedString>
