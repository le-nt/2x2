					<string name="Name">MapHandler</string>
					<ProtectedString name="Source">local Lighting = game:GetService(&quot;Lighting&quot;)

repeat wait() until workspace:FindFirstChild(&quot;Round Script&quot;)
local allowed_script = workspace[&quot;Round Script&quot;]

repeat wait() until Lighting:FindFirstChild(&quot;Maps&quot;) --and Lighting:FindFirstChild(&quot;Truck&quot;)
local Maps = Lighting.Maps

repeat wait() until script:FindFirstChild(&quot;Pit Instances&quot;) and script:FindFirstChild(&quot;Ghost Script&quot;)
local Ghost_Script = script[&quot;Ghost Script&quot;]
local Pit_Instances = script[&quot;Pit Instances&quot;]

local Last_Map -- string

--local Truck = Lighting.Truck

--repeat wait() until #Maps:GetChildren() &gt; 0 and Truck:FindFirstChild(&quot;Cage&quot;) -- unsure
--repeat wait() until Truck.Cage:FindFirstChild(&quot;Root&quot;) -- unsure

local CurrentMap -- shared over both functions
local CurrentBoxes
_G.CurrentBoxes = function() -- get &quot;boxes&quot; model, used for tool and pit scripts
	return CurrentBoxes
end

local function GetDescendants(object) -- Redundant function repost, but it&apos;s better than adding another script and wait()&apos;s
	local descendants = {}
	local function Scan(parent)
		for _,v in pairs(parent:GetChildren()) do
			table.insert(descendants, v)
			Scan(v)
		end
	end
	Scan(object)
	return descendants
end

local function SetModelCFrame(primpart, model, desiredcf) -- See: LINE 12
	local origprimpartcf = primpart.CFrame
	for i, part in pairs(GetDescendants(model)) do
		if part:IsA(&quot;BasePart&quot;) then
			local offset = origprimpartcf:inverse() * part.CFrame
			part.CFrame = desiredcf * offset
		end 
	end
	primpart.CFrame = desiredcf
end 

--[[ 
TODO: Vigorous testing 

algorithm components:
- magnitude between farthest ghost and holepoint
- stud/sec from 16 walkspeed
- player count

result should help guide ghost count and round duration
ghosts are to be deleted accordingly in function
round duration should have upper limit based on testing, there are map size limits after all
perhaps allow map makers to choose time, to be discussed
]]
local max_player_calc = 10
local function Algorithm(Players, MAX_ROUND_TIME, Ghosts, HolePoint) 
	local round_time = MAX_ROUND_TIME
	-- for halloween game: 1 plr = max_round, &lt;10 plr = max_round/1.(plr) 10+ plr = max_round/2
	local player_count = 0
	for _, _ in pairs(Players) do player_count = player_count + 1 end
	round_time = player_count &lt;= 1 and round_time or (player_count &lt; 10 and (round_time/(1+(player_count*.1))) or (round_time/2)) 
	return math.ceil(round_time) -- placeholder
end  

-- Truck faces the same front direction as the TruckPoint!
-- TruckPoint should be around same size as the Truck Cage.
--[[
local function LoadTruck(TruckPoint, MapTruck, UP_COUNT) -- redundant function, but it looks nicer.
	SetModelCFrame( 
		MapTruck.Cage.Root, 
		MapTruck, 
		TruckPoint.CFrame + Vector3.new(0, UP_COUNT, 0)
	)
end
--]]

local ViableArray = {&quot;Ghosts&quot;, --[[&quot;TruckPoint&quot;,--]] &quot;Finish&quot;, &quot;SpawnPoint&quot;}
local function Viable(Map, MINIMUM_GHOSTS)
	local bool = true -- innocent until proven guilty
	for _, a in pairs(ViableArray) do
		if not Map:FindFirstChild(a) then 
			bool = false
			break
		end
	end 

	if (bool) then 
		if #Map.Ghosts:GetChildren() &lt; MINIMUM_GHOSTS then 
			bool = false 
		end 
	end 

	if Map.Name == Last_Map then bool = false end 
	
	return bool
end 

-- saves the ghosts if thrown out of map, teleports to spawnpoint
local function FailSafe(Finish, SpawnPoint, Group)
	if not Finish and SpawnPoint and Group then return end
	local Part = Instance.new(&quot;Part&quot;)
	Part.Name, Part.Anchored, Part.CanCollide, Part.Transparency = &quot;FAILSAFE&quot;, true, false, 1
	Part.Size = Vector3.new(377, 1, 377)
	
	Part.CFrame = Finish.CFrame * CFrame.new(0, -21, 0) -- whats 9+10
	Part.Parent = SpawnPoint.Parent -- map
	delay(0, function()
		if _G.GetRoundPlayingStatus() == false then 
			repeat wait() until _G.GetRoundPlayingStatus() == true 
		end

		print(&quot;FAILSAFE part created&quot;)
		local event 
		event = Part.Touched:connect(function(Object)
			if Object:IsA(&quot;Part&quot;) and Object.Parent == Group then 
				Object.CFrame = SpawnPoint.CFrame * CFrame.new(math.random(2, 5), 3, math.random(2, 5))
				Object.Velocity = Vector3.new(0, 0, 0)
			end
		end)

		repeat wait() until _G.GetRoundPlayingStatus() == false
		print(&quot;FAILSAFE part retired&quot;)
		event:disconnect()
	end)
end 

-- IDEA: Add a &quot;LastMap&quot; variable to prevent same map happening twice in a row; only do if &gt;3-5 maps
-- returns array: {ghosts, holepoint, spawnpoint, map, new_round_time}
_G.LoadMap = function(key, PlayerList, MIN_GHOSTS, MAX_ROUND_TIME)--, UP_COUNT)
	if not (key and PlayerList and MIN_GHOSTS and MAX_ROUND_TIME --[[ and UP_COUNT --]]) then 
		--better error logging now
		print(&quot;ERROR: Map loading variables are not inputted correctly for _G.LoadMap() in MapHandler!&quot;)
		print(&quot;Key, PlayerList, MIN_GHOSTS, MAX_ROUND_TIME will be printed:&quot;)
		print(key, PlayerList, MIN_GHOSTS, MAX_ROUND_TIME)
		return &quot;Variables are not inputted correctly!&quot; 
	end
	if (key ~= allowed_script) then return &quot;Illegal Operation!&quot; end -- measure to prevent ease of execution

	local flag, RandomMap = false 
	for i = 1, #Maps:GetChildren() do
		RandomMap = Maps:GetChildren()[math.random(1, #Maps:GetChildren())]
		if Viable(RandomMap, MIN_GHOSTS) then 
			flag = true 
			break
		end 
	end 

	if flag then -- if the map chosen doesn&apos;t not have Ghosts or HolePoint, redo function
		--CurrentMap, MapTruck = RandomMap:Clone(), Truck:Clone()
		Last_Map = RandomMap.Name
		CurrentMap = RandomMap:Clone()
		local new_round_time = Algorithm(PlayerList, MAX_ROUND_TIME, CurrentMap.Ghosts, CurrentMap.Finish)
		--LoadTruck(CurrentMap.TruckPoint, MapTruck, UP_COUNT)

		--CurrentMap.Parent, MapTruck.Parent = workspace, CurrentMap -- map in workspace, truck in map
		--CurrentMap.Name = &quot;CurrentMap&quot; --This is to make it easier for other scripts to get the current map!
		-- ^^ to be uncommented when midi music is reformed
		CurrentMap.Parent = workspace
		CurrentMap:MakeJoints()--; MapTruck:MakeJoints();

		Ghost_Script:Clone().Parent = CurrentMap.Ghosts
		for _, v in pairs(Pit_Instances:GetChildren()) do v:Clone().Parent = CurrentMap.Finish end
		CurrentBoxes = CurrentMap.Ghosts
		FailSafe(CurrentMap.Finish, CurrentMap.SpawnPoint, CurrentMap.Ghosts)

		return {CurrentMap.Ghosts, --[[MapTruck, CurrentMap.TruckPoint,--]] CurrentMap.Finish, CurrentMap.SpawnPoint, CurrentMap, new_round_time}
	else
		print(&quot;ERROR: Map &quot; .. tostring(RandomMap) .. &quot; in Lighting.Maps is invalid for _G.LoadMap() in MapHandler!&quot;)
		--TODO we could add a message here and in the base game for modders who want to add custom maps, what they might be missing and how to add them to their map
		if (RandomMap) and (#Maps:GetChildren() &gt; 1) then -- if no maps left, RandomMap is left nil
			RandomMap:remove() -- remove from map-pool, hope this doesn&apos;t cause a leak!
			RandomMap = nil -- just in case, research if needed
			return _G.LoadMap(MIN_GHOSTS)--, UP_COUNT) --what?
		else
			return &quot;No maps contain the important instances. Please contact the owner!&quot;
		end
	end 
end 

_G.DestroyMap = function()
	if CurrentMap then -- idk
		CurrentMap:remove() -- hope this doesn&apos;t cause a leak!
	end 
	CurrentMap = nil -- remove doesn&apos;t turn variable into nil
	CurrentBoxes = nil
end

--Get the current map&apos;s model in Workspace
--Making CurrentMap _G is probably the naive way of doing it as it would let hackers change it - we should probably go back and change the other _G variables for this too
_G.GetMap = function()
	return CurrentMap
end

