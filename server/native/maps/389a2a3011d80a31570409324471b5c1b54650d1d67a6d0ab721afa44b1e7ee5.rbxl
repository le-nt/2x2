						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">-- should work in global script because old roblox is just like that

repeat wait() until workspace:FindFirstChild(&quot;Round Script&quot;) 
local RS = workspace[&quot;Round Script&quot;]

script.Parent.MouseButton1Click:connect(function()
	if not RS:FindFirstChild(&quot;Start Early&quot;) then
		local x = Instance.new(&quot;Model&quot;)
		x.Name = &quot;Start Early&quot;
		x.Parent = RS
	end 
end)

while true do
	repeat wait() until not workspace:FindFirstChild(&quot;CurrentMap&quot;)
	repeat wait() until not RS:FindFirstChild(&quot;Start Early&quot;)
	--print(1)
	repeat wait() until #game.Players:GetPlayers() &lt;= 1
	--print(1)
	script.Parent.Visible, script.Parent.Active = true, true 
	--print(2)
	repeat wait() until RS:FindFirstChild(&quot;Start Early&quot;)
	script.Parent.Visible, script.Parent.Active = false, false
end </ProtectedString>
