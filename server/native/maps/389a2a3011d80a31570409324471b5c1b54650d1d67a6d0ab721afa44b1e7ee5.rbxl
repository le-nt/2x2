				<Item class="Script" referent="RBX4653">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Bomb</string>
						<ProtectedString name="Source">local updateInterval = .6

local currentColor = 1
local colors = {105, 106} 

local ticksound = Instance.new(&quot;Sound&quot;)
ticksound.SoundId = &quot;rbxasset://sounds\\clickfast.wav&quot;
ticksound.Parent = script.Parent

local function update()
	updateInterval = updateInterval * .9

	script.Parent.PrimaryPart.BrickColor = BrickColor.new(colors[currentColor])
	currentColor = currentColor + 1
	if (currentColor &gt; 2) then currentColor = 1 end
end

local splashcolors = {21, 106, 105, 24, 226, 1, 226, 24, 105, 106} 

local function closestGhosts(position)
	local currentMap = workspace:FindFirstChild(&quot;CurrentMap&quot;)
	if not currentMap or not currentMap:FindFirstChild(&quot;Ghosts&quot;) then
		return
	end

	local closest = {}

	for _, ghost in pairs(currentMap.Ghosts:GetChildren()) do
		if ghost:IsA(&quot;Model&quot;) and ghost:FindFirstChild(&quot;Head&quot;) then
			table.insert(closest, {Ghost = ghost.Head, Distance = (position - ghost.Head.Position).Magnitude})
		end
	end

	table.sort(closest, function(a, b)
		return a.Distance &lt; b.Distance
	end)

	return closest
end

local function fire(pos)
	local missile = Instance.new(&quot;Part&quot;)

	missile.Name = &quot;FireShot&quot;

	local ghosts = closestGhosts(pos)
	local v = Vector3.new((math.random() - 0.5) * 100, (math.random() - 0.5) * 100, (math.random() - 0.5) * 100) --Default
	
	
	--80% chance to target a nearby ghost
	if math.random(1, 10) &lt; 8 then
		local targetedGhost = ghosts[math.random(1, 3)].Ghost --Closest 3 ghosts
		local targetCF = CFrame.new(pos, targetedGhost.Position)
		v = targetCF.lookVector * 100
	end
	

	missile.CFrame = CFrame.new(pos --[[+ (v / 10)]], v)
	missile.Size = Vector3.new(1,1,1)
	missile.Velocity = v * 3
	missile.Shape = 2

	local randomColor = splashcolors[math.random(1, #splashcolors)]
	missile.BrickColor = BrickColor.new(randomColor)

	local new_script = script.Parent.FireShot:clone()
	
	new_script.Parent = missile
	new_script.Disabled = false
	
	missile.Parent = game.Workspace
	print(&quot;Fire shot added&quot;)

end

local function blowUp()
	local sound = Instance.new(&quot;Sound&quot;)
	sound.SoundId = &quot;rbxasset://sounds\\Rocket shot.wav&quot;
	sound.Parent = script.Parent
	sound.Volume = 1
	sound:play()

	--[[
	--Kill nearby ghosts in the explosion
	local ghosts = closestGhosts(script.Parent.PrimaryPart.Position)
	for _, v in pairs(ghosts) do
		if v.Distance &lt; 25 then
			--This is kinda hacky, recreating the kill behavior instead of trying to find a way to signal the ghost script to do it
			v.Ghost.Sound:Play()
			v.Ghost.Sound:Remove()
			v.Ghost.Parent:Remove()
			v.Ghost.Parent = workspace[&quot;Round Script&quot;].MapHandler
			if v.Ghost:FindFirstChild(&quot;BodyPosition&quot;) then
				v.Ghost.BodyPosition:Remove()
			end
		else
			break --All ghosts past this point will be even further away!
		end
	end
	--]]
	
	for i = 1, 15 do
		fire(script.Parent.PrimaryPart.Position)
	end

	script.Parent.PrimaryPart.Transparency = 1
end

while updateInterval &gt; .1 do
	wait(updateInterval)
	update()
	ticksound:play()
end

blowUp()
wait(2)
script.Parent:Remove()
