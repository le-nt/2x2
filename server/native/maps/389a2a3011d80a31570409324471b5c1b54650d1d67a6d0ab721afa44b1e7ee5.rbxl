					<string name="Name">Gui Application</string>
					<ProtectedString name="Source">wait(4) -- Thou shall not touch the sacred function, unless it would like to meet the wrath of a lion. Beeeitch.
-- (this fixes the gui not showing on first use)

---===--- ---===--- SETTING VARIABLES ---===--- ---===---

-- Settings: Color3 values which help guide an asset&apos;s color changes
-- Assets: The icons responsible for showing each charge stage.
local Settings = {&quot;Black&quot;, &quot;Dark&quot;, &quot;Highlight&quot;}
local Assets = {&quot;1&quot;, &quot;2&quot;, &quot;3&quot;, &quot;4&quot;}

-- Looking_For: Name of Number
-- Expiration: Turn GUI invisible after this many seconds if the player hasn&apos;t already started another charge.
local Looking_For = &quot;Charge Value&quot;
local Expiration = 1

---===--- ---===--- OTHER VARIABLES ---===--- ---===---

-- chargevalue: numbervalue instance used for checking stage
-- event: .Changed event defined to allow :disconnect() on removed event
local chargevalue, event

-- Player definitions
local Players = game:GetService(&quot;Players&quot;)
local Player = Players.LocalPlayer
local PlayerGui = Player.PlayerGui

-- Gui Definitions &amp; Checks
local Main_Gui = script:FindFirstChild(&quot;Throw Gui&quot;)
if (not Main_Gui) then print(&quot;no throw gui&quot;) return end 

local Frame = Main_Gui:FindFirstChild(&quot;Frame&quot;)
if (not Frame) then print(&quot;no frame&quot;) return end

-- Setting Variable transition for script use
local _Settings, _Assets = {}, {}
for _, array in pairs({Settings, Assets}) do
	local decider = tonumber(array[1]) and _Assets or _Settings
	for i = 1, #array, 1 do
		local obj = Frame:FindFirstChild(array[i])
		if (not obj) then print(&quot;no &quot;, array[i]) return end

		obj = obj:IsA(&quot;Color3Value&quot;) and obj.Value or obj
		table.insert(decider, obj)
	end
end 

Settings, Assets = _Settings, _Assets
for _, a in pairs(Assets) do
	if not a:FindFirstChild(&quot;Color&quot;) then print(&quot;no color in &quot;, a.Name) return end 
end 

-- Properties: Values to be changed during Animation()
-- on, off: Arrays which decide the outcome of the Asset&apos;s properties. &quot;on&quot; is given a different [1] during Animation()
local Properties = {&quot;BackgroundColor3&quot;, &quot;BackgroundTransparency&quot;, &quot;TextColor3&quot;}
local on, off = {0, Settings[3]}, {Settings[1], 0.2, Settings[2]}

---===--- ---===--- FUNCTIONS ---===--- ---===---

-- Check if its the stage numbervalue script is looking for
local function Viable(object)
	return object and object.Name == Looking_For and object:IsA(&quot;NumberValue&quot;)
end 

-- &apos;animates&apos; (changes properties) of each asset
-- stage: # given from charge value
local function Animation(stage)
	for _, a in pairs(Assets) do
		local array
		if a.Name == tostring(stage) then array = {Assets[stage].Color.Value, unpack(on)} 
		else array = off end

		for i = 1, #Properties, 1 do
			a[Properties[i]] = array[i]
		end
	end
end

---===--- ---===--- MAIN ---===--- ---===---

-- Insertion to PlayerGui
Main_Gui.Parent = PlayerGui

script.Parent.ChildAdded:connect(function(obj)
	if Viable(obj) and not (chargevalue and event) then 
		Frame.Visible = true
		Animation(-1) -- resets gui 

		chargevalue = obj
		event = chargevalue.Changed:connect(function()
			Animation(math.floor(chargevalue.Value))
		end)
	end
end)

script.Parent.ChildRemoved:connect(function(obj)
	if (event) then event:disconnect() end
	if (obj == chargevalue) then chargevalue = nil end

	delay(Expiration, function()
		if not Viable(script.Parent:FindFirstChild(Looking_For)) then
			Frame.Visible = false 
			Animation(-1)
		end
	end)
end)

print(Player.Name, script.Parent.Name, script.Name, &quot;Completed Action&quot;)</ProtectedString>
