				<string name="Name">ShopScript</string>
				<ProtectedString name="Source">--Script first does setup by updating 
--Step on a shop part (Head part in a model in the shop model) to buy it.

--TODO: Hover over the buy item / billboard GUI to make a GUI pop up on your screen that shows a description of what the item does.

local Players = game:GetService(&quot;Players&quot;)
local Lighting = game:GetService(&quot;Lighting&quot;)

repeat wait() until Lighting:FindFirstChild(&quot;Tools&quot;)
local tools = Lighting.Tools

repeat wait() until workspace:FindFirstChild(&quot;Shop&quot;) -- if this breaks, too bad!
local shop = workspace.Shop

local cashName = &quot;Tickets&quot;

local delayamt = 3
local function tellPlayer(message, player)
	local msg = Instance.new(&quot;Message&quot;, player.PlayerGui) 
	msg.Text = message
	delay(delayamt, function()
		msg:Remove()
		msg = nil -- prevents memory leak, hopefully
	end)
end

local function HintPlayer(message, player)
	local msg = player.PlayerGui:FindFirstChild(&quot;Message&quot;) or Instance.new(&quot;Message&quot;, player.PlayerGui) 
	msg.Text = message
end
 
local function DescriptionSet(itemname, description)
	if shop:FindFirstChild(&quot;Description&quot;) and shop.Description:GetChildren()[1] and itemname and description then
		shop.Description:GetChildren()[1].Name = itemname .. &quot;: &quot;.. description.Value
	end
end

local function Buy(item, player)
	if not player:FindFirstChild(&quot;leaderstats&quot;) then
		return
	end
	if not item:FindFirstChild(&quot;Head&quot;) or not item:FindFirstChild(&quot;Price&quot;) or not item:FindFirstChild(&quot;Type&quot;) then
		return
	end
	if item:FindFirstChild(&quot;Debounce&quot;) and item.Debounce.Value then
		return
	end

	local price = item.Price
	local money = player.leaderstats[cashName]
	if money.Value &lt; price.Value then
		return
	end

	local debounce = item:FindFirstChild(&quot;Debounce&quot;)
	if not debounce then
		debounce = Instance.new(&quot;BoolValue&quot;)
		debounce.Name = &quot;Debounce&quot;
		debounce.Parent = item
	end
	debounce.Value = true

	local originalColor = item.Head.BrickColor
	local originalReflectance = item.Head.Reflectance
	local originalMaterial = item.Head.Material
	--Could remove the effects but I&apos;m too lazy right now...
	item.Head.BrickColor = BrickColor.Black()
	item.Head.Reflectance = 0
	item.Head.Material = Enum.Material.Plastic

	--[[
	if item.Type.Value == &quot;SelectionColor&quot; then
		local colorValue = player:FindFirstChild(&quot;SelectedColor&quot;)
		if not colorValue then
			colorValue = Instance.new(&quot;BrickColorValue&quot;)
			colorValue.Name = &quot;SelectedColor&quot;
			colorValue.Parent = player
		end
		colorValue.Value = originalColor
	
		local SelectionBox = player.Character:FindFirstChild(&quot;SelectionBox&quot;)
		if SelectionBox then
			SelectionBox.Color = originalColor
		end

		local SelectionPartLasso = player.Character:FindFirstChild(&quot;SelectionPartLasso&quot;)
		if SelectionPartLasso then
			SelectionPartLasso.Color = originalColor
		end

		tellPlayer(
			string.format(&quot;Your tool&apos;s color has now turned to %s!&quot;, tostring(originalColor)), 
			player
		)
	elseif item.Type.Value == &quot;SelectedPartEffect&quot; then
		--TODO: Lets you add an effect to the part you&apos;re dragging, e.g. sparkles, smoke, and fire
	elseif item.Type.Value == &quot;SelectionType&quot; then
		--TODO: Lets you change your part selection to be a sphere around the part instead of a cube (or reset it)
	elseif item.Type.Value == &quot;PartSkin&quot; then
		--TODO: Lets you change the appearance of the part you&apos;re grabbing, e.g. change it to metal material and make it gray colored, or black colored and add a fire effect, etc.
		local partSkin = player:FindFirstChild(&quot;PartSkin&quot;)
		if not partSkin then
			partSkin = Instance.new(&quot;Model&quot;)
			partSkin.Name = &quot;PartSkin&quot;
			partSkin.Parent = player
		end

		local colorValue = partSkin:FindFirstChild(&quot;SelectedColor&quot;)
		if not colorValue then
			colorValue = Instance.new(&quot;BrickColorValue&quot;)
			colorValue.Name = &quot;SelectedColor&quot;
			colorValue.Parent = partSkin
		end
		colorValue.Value = originalColor

		local materialValue = partSkin:FindFirstChild(&quot;SelectedMaterial&quot;)
		if not materialValue then
			materialValue = Instance.new(&quot;StringValue&quot;)
			materialValue.Name = &quot;SelectedMaterial&quot;
			materialValue.Parent = partSkin
		end
		materialValue.Value = tostring(originalMaterial):sub(15) --Kind of a hack to remove the &quot;Enum.Material&quot; part off the tostring and only keep the material name
																					--Otherwise, setting the material using a string will not work.

		local effects = partSkin:FindFirstChild(&quot;SelectedEffects&quot;)
		if effects then
			effects:Remove() --Clear all children
		end
		if not effects then
			effects = Instance.new(&quot;Model&quot;)
			effects.Name = &quot;SelectedEffects&quot;
			effects.Parent = partSkin
		end
		for _, effect in pairs(item.Head:GetChildren()) do
			--Would we need to ensure that only actual effect types (fire, smoke, sparkles) are included? Would we place anything else inside the head that we don&apos;t want transferred?
			--I doubt it, but it&apos;s a possibility. Whatever...
			local clone = effect:Clone()
			clone.Parent = effects
		end


		local newSkinName = item.Name:match(&quot;^(.+)%s&quot;) --Get only the first word of the name
		if newSkinName == &quot;Reset&quot; then
			tellPlayer(
				&quot;Your box skin has been reset!&quot;,
				player
			)
		else
			tellPlayer(
				string.format(&quot;Your box skin has now turned to %s!&quot;, newSkinName), 
				player
			)
		end
		--]]

	local originalName = item.OriginalName.Value
	if item.Type.Value == &quot;Item&quot; and tools:FindFirstChild(originalName) and (tools:FindFirstChild(originalName):IsA(&quot;HopperBin&quot;) or tools:FindFirstChild(originalName):IsA(&quot;Tool&quot;)) then
		--Give the player their item!

		--First, add it to the list of items they already own, so they can swap between rather than having to buy it again.
		local ownedItems = player:FindFirstChild(&quot;OwnedItems&quot;)
		if not ownedItems then
			ownedItems = Instance.new(&quot;Model&quot;)
			ownedItems.Name = &quot;OwnedItems&quot;
			ownedItems.Parent = player
		end
		
		local tool = ownedItems:FindFirstChild(originalName)
		if tool then
			--This is a hack but it&apos;s easier than redoing all these checks on the part that removes your money to make it not do that.
			--So instead, we&apos;ll simply counteract the removing of money ;)
			money.Value = money.Value + price.Value
		else
			tool = tools:FindFirstChild(originalName):Clone()
			tool.Parent = ownedItems
		end

		--Remove their current item
		local currentToolData = player:FindFirstChild(&quot;CurrentTool&quot;) --This is so we can give them back their tool
		if not currentToolData then
			currentToolData = Instance.new(&quot;Model&quot;)
			currentToolData.Name = &quot;CurrentTool&quot;
			currentToolData.Parent = player
		end
		local currentTool = currentToolData:GetChildren()[1] or workspace --Workspace is a placeholder object as a hack

		local currentToolHeld = player.Backpack:FindFirstChild(currentTool.Name) or player.Character:FindFirstChild(currentTool.Name)
		if currentToolHeld then
			currentToolHeld:Remove()
		end

		if currentTool.Parent == currentToolData then
			currentTool:Remove()
		end
		local currentToolDataClone = tool:Clone()
		currentToolDataClone.Parent = currentToolData
		
		--Okay, now give them the item.
		local clone = tool:Clone()
		clone.Parent = player.Backpack

		DescriptionSet(originalName, item:FindFirstChild(&quot;Description&quot;))
		tellPlayer(
			string.format(&quot;You have equipped %s!&quot;, originalName), 
			player
		)
	else
		print(&quot;Didn&apos;t work.&quot;, originalName)
		pcall(function()
			print(tools:FindFirstChild(originalName))
		end)
		pcall(function()
			print(tools:FindFirstChild(originalName):IsA(&quot;HopperBin&quot;) or tools:FindFirstChild(originalName):IsA(&quot;Tool&quot;))
		end)
	end

	money.Value = money.Value - price.Value

	wait(1.5)

	item.Head.BrickColor = originalColor
	item.Head.Reflectance = originalReflectance
	item.Head.Material = originalMaterial
	debounce.Value = false
end

local function Description(item, player)
	if not player:FindFirstChild(&quot;leaderstats&quot;) then
		return
	end
	if not item:FindFirstChild(&quot;Head&quot;) or not item:FindFirstChild(&quot;Price&quot;) or not item:FindFirstChild(&quot;Type&quot;) or not item:FindFirstChild(&quot;Description&quot;) then
		return
	end
	HintPlayer(item.Description.Value, player)
	wait(5)
	HintPlayer(&quot;&quot;, player)
end

--Setup
for _, shopItem in pairs(shop:GetChildren()) do
	local originalName = Instance.new(&quot;StringValue&quot;)
	originalName.Name = &quot;OriginalName&quot;
	originalName.Value = shopItem.Name
	originalName.Parent = shopItem
	print(&quot;Created new originalname for shop item:&quot;, originalName, shopItem)

	if shopItem:FindFirstChild(&quot;Head&quot;) and shopItem:FindFirstChild(&quot;Price&quot;) then
		if shopItem.Price.Value &gt; 0 then
			shopItem.Name = shopItem.Name .. &quot; - &quot; .. shopItem.Price.Value
		end

		local clickDetector = Instance.new(&quot;ClickDetector&quot;)
		clickDetector.Parent = shopItem.Head

		shopItem.Head.Touched:connect(function(hitPart)
			local player = Players:GetPlayerFromCharacter(hitPart.Parent)
			if hitPart.Parent and player then
				--Description(shopItem, Players:GetPlayerFromCharacter(hitPart.Parent))
				Buy(shopItem, player)
			end
		end)

		clickDetector.MouseClick:connect(function(player)
			--Buy does not work as ClickDetector does not return the player for some reason. Is this a 2010L bug?
			--Buy(shopItem, player)
			DescriptionSet(shopItem.Name, shopItem:FindFirstChild(&quot;Description&quot;))
		end)

		--Create a preview of the item here!
		--If it has a handle, show a floating, spinning copy of the handle.
		--Otherwise, make a BillboardGui and show the hopperbin&apos;s icon.
	end
end

Players.PlayerAdded:connect(function(player)
	player.CharacterAdded:connect(function(character)
		--Give the player their set items on respawn
			local currentToolData = player:FindFirstChild(&quot;CurrentTool&quot;)
			if currentToolData and currentToolData:GetChildren()[1] then
				local clone = currentToolData:GetChildren()[1]:Clone()
				clone.Parent = player.Backpack
			end
	end)
end)</ProtectedString>
