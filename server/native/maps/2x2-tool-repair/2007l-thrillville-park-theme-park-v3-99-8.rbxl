							<Item class="Script" referent="RBX9374">
								<Properties>
									<bool name="Disabled">false</bool>
									<Content name="LinkedSource"><null></null></Content>
									<string name="Name">FlyingMachine</string>
									<string name="Source">print("RobloxPolice's AMAZING FLYING MACHINE!")

bin=script.Parent

engine=bin.Engine
prop=bin.Prop

ailer=bin.Aileron
throtle=bin.Throtle
elevator=bin.Elevator
active=bin.Active

position = engine.Position
function Fly(spd)
	direction = engine.CFrame.lookVector 
	position = position + spd*3*direction
	error = position - engine.Position
	engine.Velocity = spd*error
end

while true do
	wait(0.1)
	
	local spd=throtle.Value/10
	local trn=ailer.Value/10
	local elv=elevator.Value/10

	prop.BackParamA = -(spd/2)
	prop.BackParamB = spd/2
	engine.RotVelocity = Vector3.new(elv,-trn,0)
	Fly(spd/2)

	if (active.Value=="") then
		if (ailer.Value&lt;0) then
			ailer.Value=ailer.Value+1
		end
		if (ailer.Value&gt;0) then
			ailer.Value=ailer.Value-1
		end
	end
end
</string>
									<bool name="archivable">true</bool>
