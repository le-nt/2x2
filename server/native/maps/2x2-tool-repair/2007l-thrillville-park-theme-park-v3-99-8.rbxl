Door = script.Parent.ButtonDoor2
Button = script.Parent.Button2

--If you put this in anymore models, you have to change the directories.
--Door = game.Workspace.ModelName.Wing1.ButtonDoor

function onTouched(hit)
	
		print("Door Hit")
		Door.Transparency = 1
		Button.Transparency = 1
		Door.CanCollide = false
		Button.CanCollide = false
		wait(5)
		Door.CanCollide = true
		Button.CanCollide = true
		Door.Transparency = 0
		Button.Transparency = 0
end

connection = Button.Touched:connect(onTouched)
