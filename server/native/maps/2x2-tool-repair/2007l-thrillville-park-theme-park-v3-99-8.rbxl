				<Item class="Script" referent="RBX16138">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">function getPlayer(humanoid)
	-- find the owning player of a humanoid. this is a hack.
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character.Humanoid == humanoid then return players[i] end
	end
	return nil
end

function onTouch(part)

	local human = part.Parent:findFirstChild("Humanoid")	
	if (human == nil) then return end

	local player = getPlayer(human)

	if (player == nil) then return end

	
	player.Character = game.Workspace.demondude57
end


script.Parent.Touched:connect(onTouch)</string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
		</Item>
