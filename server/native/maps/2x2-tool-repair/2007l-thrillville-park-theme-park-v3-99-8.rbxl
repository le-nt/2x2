					<string name="Name">Script</string>
					<string name="Source">function onTouched(part)
	local h = part.Parent:findFirstChild("Humanoid")
	if h~=nil then
		h.Health = h.Health -100
		wait(0.5)
		h.Health = h.Health -10
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -5
		wait(0.5)
		h.Health = h.Health -100
		wait(2)
	end
end

script.Parent.Touched:connect(onTouched)
</string>
