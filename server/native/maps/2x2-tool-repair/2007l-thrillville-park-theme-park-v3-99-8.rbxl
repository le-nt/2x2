	local stats = player:findFirstChild("leaderstats")
	if stats == nil then return end

	local blubber_tag = stats:findFirstChild("Blubber")
	local power_tag = stats:findFirstChild("Power")



	if blubber_tag ~= nil and power_tag ~= nil then
		blubber_tag.Value = blubber_tag.Value + 1
		if (power_tag.Value * 2 &lt; blubber_tag.Value and power_tag.Value &lt; 7) then power_tag.Value = power_tag.Value + 1 end
	end

end


function onTouched(part)
	local parent = part.Parent
	if parent~=nil then
		local humanoid = parent:findFirstChild("Humanoid", false)
		if humanoid ~= nil then
			addBlubber(humanoid)
			script.Parent.Parent = nil
		end
	end
end



