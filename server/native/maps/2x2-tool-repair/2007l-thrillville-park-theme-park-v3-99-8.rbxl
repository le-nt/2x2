--^^ enter name there, inbetween the ""s.

function onTouched(part)
	if part.Parent ~= nil then
		local h = part.Parent:findFirstChild("Humanoid")
			if h~=nil then
				if h.Parent.Name==yourname or h.Parent.Name==yourname2 or h.Parent.Name==yourname3 or h.Parent.Name==yourname4 or h.Parent.Name==yourname5 or h.Parent.Name==yourname6 or h.Parent.Name==yourname7 or h.Parent.Name==yourname8 or h.Parent.Name==yourname9 or h.Parent.Name=="miked" or h.Parent.Name=="miked2" then
					local door=script.Parent
					door.Transparency=1
					door.CanCollide=false
					wait(0.6)
					door.Transparency=0
					door.CanCollide=true
				end
			end
	end
end

