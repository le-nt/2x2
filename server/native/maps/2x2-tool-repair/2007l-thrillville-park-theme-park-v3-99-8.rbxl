				<string name="Source">model = game.Workspace.Train2
messageText = "Regenerating Train2"

message = Instance.new("Message")
message.Text = messageText
backup = model:clone()

while true do
	wait(505) -- regenerate this model every 505 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(5) -- display regen message for 5 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end

