		<Item class="Script" referent="RBX9884">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">model = game.Workspace.supercart
messageText = "Regenerating the carts for *Silver bullet* and Air time :-D"

message = Instance.new("Message")
message.Text = messageText
backup = model:clone()

while true do
	wait(85) -- regenerate this model every 85 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(2) -- display regen message for 2 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end

</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
