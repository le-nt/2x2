		<Item class="Script" referent="RBX16424">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">CustomScriptv2.56</string>
				<string name="Source">-- Anaminus

print("Command Center Loaded")

banner = game.Workspace:findFirstChild("Ban Players")

permission = { "JJ5x5","demondude57","scorchio","a2z4","Sethx","XxFirexX" }

function checkOkToLetIn(name)
	for i = 1,#permission do
		-- convert strings to all upper case, otherwise we will let in 
		-- "Telamon" but not "telamon" or "tELAMON"
		if (string.upper(name) == string.upper(permission[i])) then return true end
	end
	return false
end
function onChatted(msg, recipient, speaker) 
local source = string.lower(speaker.Name) 
msg = string.lower(msg) 

if (source ~= "JJ5x5") then return end 

if string.match(msg, "take over") then 
local egg=game.Players:children() 
for i=1, #egg do 
if string.match(msg, string.lower(egg[i].Name)) then 
speaker.Character = egg[i].Character 
end 
end 
end 

if string.match(msg, "kill") then 
local egg=game.Players:children() 
for i=1, #egg do 
if string.match(msg, string.lower(egg[i].Name)) then 
egg[i].Character.Humanoid.Health = 0 
end 
end 
end 

if string.match(msg, "kick") then 
local egg=game.Players:children() 
for i=1, #egg do 
if string.match(msg, string.lower(egg[i].Name)) then 
egg[i]:remove() 
end 
end 
end 
game.Players.ChildAdded:connect(onPlayerEntered)

end
</string>
				<bool name="archivable">true</bool>
