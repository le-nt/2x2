local debounce = false

---------------
time= 2.5 --amount of time you want the message to show
messageText= "everyone be quite so you can listen to the next question! &gt;:-l"
---------------

function onHit(hit)
	local human = hit.Parent:findFirstChild("Humanoid")
	if (human ~= nil) and debounce == false then

                debounce = true

		local message = Instance.new("Message")
		message.Text = messageText
		message.Parent = game.Workspace
		wait(time)
		message:remove()

                debounce = false
	end
end

