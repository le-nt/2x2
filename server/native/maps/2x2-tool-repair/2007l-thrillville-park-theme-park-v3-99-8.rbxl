		<Item class="Script" referent="RBX9076">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">model = game.Workspace.Train1
messageText = "Regenerating Train1"

message = Instance.new("Message")
message.Text = messageText
backup = model:clone()

while true do
	wait(500) -- regenerate this model every 500 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(5) -- display regen message for 5 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end

