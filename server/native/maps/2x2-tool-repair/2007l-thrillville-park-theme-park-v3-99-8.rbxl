				<string name="Source">model = game.Workspace.Adminstuff
messageText = "Regenerating the swords and admin stuff &gt;_&gt;"

message = Instance.new("Message")
message.Text = messageText
backup = model:clone()

while true do
	wait(606) -- regenerate this model every 606 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(2) -- display regen message for 2 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
