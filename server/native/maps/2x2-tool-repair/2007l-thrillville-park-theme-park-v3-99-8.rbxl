				<Item class="LocalScript" referent="RBX11734">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><url>rbxasset://../../../shareddata/scripts/1014476.lua</url></Content>
						<string name="Name">Local Gui</string>
						<string name="Source"></string>
