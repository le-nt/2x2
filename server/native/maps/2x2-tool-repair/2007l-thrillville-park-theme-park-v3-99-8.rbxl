		<Item class="Script" referent="RBX16163">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<string name="Source">model = game.Workspace.deadlycart
messageText = "Regenerating the U.L.R and the frozen death rollercoaster"

message = Instance.new("Message")
message.Text = messageText
backup = model:clone()

while true do
	wait(195) -- regenerate this model every 195 seconds

	message.Parent = game.Workspace
	model:remove()

	wait(2) -- display regen message for 2 seconds

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end

</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
