				<Item class="Script" referent="RBX9893">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">local engine = script.Parent.Parent.Engine
local bodyforce = engine.BodyForce
local car = script.Parent.Parent



local debounce = false




function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild("Humanoid")
	if humanoid~=nil and debounce == false then
		debounce = true
		
		script.Parent.BrickColor = BrickColor.new(21)

		
			
		bodyforce.force = Vector3.new(0,0,0)
		wait(15)
		bodyforce.force = Vector3.new(-0,900000,0)
		wait(5)
		bodyforce.force = Vector3.new(-0,1000000000,0)
		wait(1)
		bodyforce.force = Vector3.new(0,0,0)

			
	

		script.Parent.BrickColor = BrickColor.new(28)

		wait(1)
	
		

		debounce = false
	end
end


script.Parent.Touched:connect(onTouched)


</string>
						<bool name="archivable">true</bool>
