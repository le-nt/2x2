			<Item class="Script" referent="RBX6774">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">FoodScript</string>
					<string name="Source">

function getPlayer(humanoid)
	-- find the owning player of a humanoid. this is a hack and i don't know why i need it, game.Players.LocalPlayer didn't work
	local players = game.Players:children()
	for i = 1, #players do
		if players[i].Character.Humanoid == humanoid then return players[i] end
	end
	return nil
end

function addBlubber(humanoid)


	local player = getPlayer(humanoid)

	-- Touching only happens client-side
	if player == nil then return end

	local stats = player:findFirstChild("leaderstats")
	if stats == nil then return end

	local blubber_tag = stats:findFirstChild("Blubber")
	local power_tag = stats:findFirstChild("Power")



	if blubber_tag ~= nil and power_tag ~= nil then
		blubber_tag.Value = blubber_tag.Value + 1
		if (power_tag.Value * 2 &lt; blubber_tag.Value and power_tag.Value &lt; 7) then power_tag.Value = power_tag.Value + 1 end
	end

end


function onTouched(part)
	local parent = part.Parent
	if parent~=nil then
		local humanoid = parent:findFirstChild("Humanoid", false)
		if humanoid ~= nil then
			addBlubber(humanoid)
			script.Parent.Parent = nil
		end
	end
end



script.Parent.Touched:connect(onTouched)
</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
