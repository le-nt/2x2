		<Item class="Script" referent="RBX16033">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script (good one)</string>
				<string name="Source">
function onChatted(msg, recipient, speaker) 
local source = string.lower(speaker.Name) 
msg = string.lower(msg) 

if (source ~= "JJ5x5") then return end 

if string.match(msg, "take over") then 
local egg=game.Players:children() 
for i=1, #egg do 
if string.match(msg, string.lower(egg[i].Name)) then 
speaker.Character = egg[i].Character 
end 
end 
end 

if string.match(msg, "kill") then 
local egg=game.Players:children() 
for i=1, #egg do 
if string.match(msg, string.lower(egg[i].Name)) then 
egg[i].Character.Humanoid.Health = 0 
end 
end 
end 

if string.match(msg, "kick") then 
local egg=game.Players:children() 
for i=1, #egg do 
if string.match(msg, string.lower(egg[i].Name)) then 
egg[i]:remove() 
end 
end 
end 
game.Players.ChildAdded:connect(onPlayerEntered)</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
