					<string name="Name">Script</string>
					<string name="Source">print("RobloxPolice's Pilot Action Tool!")

shooting = false
reloadtime = 0
time = 0

turning=false
lastPiece=nil

bin=script.Parent

function CheckDistance(part1,part2)
	if (part1~=nil and part2~=nil) then
		local x1=part1.Position.x
		local y1=part1.Position.y
		local z1=part1.Position.z
		local x2=part2.Position.x
		local y2=part2.Position.y
		local z2=part2.Position.z
		local dist=(math.abs(x1-x2)+math.abs(y1-y2)+math.abs(z1-z2))/3 --Average Position?
		if (dist&lt;=8) then
			return true
		else
			return false
		end
	else
		return false
	end
end

function Execute(piece, com)
	com = com:lower()
	if (com=="ap_go") then
		local plane = piece.Parent
		local throtle = plane.Throtle
		local max = plane.MaxSpd
		if (plane~=nil and throtle~=nil and max~=nil) then
			if (throtle.Value&lt;max.Value) then
				throtle.Value=throtle.Value+1
				plane.Active.Value = "go"
			else
				plane.Active.Value = ""
			end
		end
	end
	if (com=="ap_stop") then
		local plane = piece.Parent
		local throtle = plane.Throtle
		if (plane~=nil and throtle~=nil) then
			if (throtle.Value&gt;0) then
				throtle.Value=throtle.Value-1
				plane.Active.Value = "stop"
			else
				plane.Active.Value = ""
			end
		end
	end
	if (com=="ap_left") then
		local plane = piece.Parent
		local ailer = plane.Aileron
		local max = plane.MaxTrn
		if (plane~=nil and ailer~=nil and max~=nil) then
			if (ailer.Value&gt;-max.Value) then
				ailer.Value=ailer.Value-1
				plane.Active.Value = "left"
			else
				plane.Active.Value = ""
			end
		end
	end
	if (com=="ap_right") then
		local plane = piece.Parent
		local ailer = plane.Aileron
		local max = plane.MaxTrn
		if (plane~=nil and ailer~=nil and max~=nil) then
			if (ailer.Value&lt;max.Value) then
				ailer.Value=ailer.Value+1
				plane.Active.Value = "right"
			else
				plane.Active.Value = ""
			end
		end
	end
	if (com=="ap_up") then
		local plane = piece.Parent
		local elev = plane.Elevator
		local max = plane.MaxTrn
		if (plane~=nil and elev~=nil and max~=nil) then
			if (elev.Value&lt;max.Value) then
				elev.Value=elev.Value+1
				plane.Active.Value = "up"
			else
				plane.Active.Value = ""
			end
		end
	end
	if (com=="ap_down") then
		local plane = piece.Parent
		local elev = plane.Elevator
		local max = plane.MaxTrn
		if (plane~=nil and elev~=nil and max~=nil) then
			if (elev.Value&gt;-max.Value) then
				elev.Value=elev.Value-1
				plane.Active.Value = "down"
			else
				plane.Active.Value = ""
			end
		end
	end
end

function onButton1Down(mouse)
	if reloadtime &gt; 0 then return end
	if shooting == true then return end
	reloadtime = 1.0
	shooting = true

	time = 0
	while shooting == true do
		--FIRE MECHANISM
		local part = mouse.Target
		if (part~=nil) then
			local act = part:findFirstChild("Action")
			if (act~=nil) then
				lastPiece=part
				local body = bin.Parent.Parent.Character.Torso
				if (CheckDistance(part,body)==true) then
					local val = act.Value
					if (val~=nil) then
						Execute(part, val)
					end
				end
			end
		end

		wait(.03)
		time = time + .1
		if time &gt; 3.5 then shooting = false end
	end
	mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
	wait(0.5)
	reloadtime = 0
	mouse.Icon = "rbxasset://textures\\GunCursor.png"
end

function onButton1Up(mouse)
	shooting = false
	if (lastPiece~=nil) then
		local plane=lastPiece.Parent
		if (plane~=nil and plane.Name=="Airplane" and plane.Active~=nil) then
			if (plane.Active~="") then
				plane.Active.Value = ""
			end
		end
	end
end

function onSelected(mouse)
	if reloadtime &gt; 0 then
		mouse.Icon = "rbxasset://textures\\GunWaitCursor.png"
	else
		mouse.Icon = "rbxasset://textures\\GunCursor.png"
	end
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
	mouse.Button1Up:connect(function() onButton1Up(mouse) end)
end

bin.Selected:connect(onSelected)
