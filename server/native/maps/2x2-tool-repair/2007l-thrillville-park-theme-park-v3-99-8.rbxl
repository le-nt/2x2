				<Item class="Script" referent="RBX10002">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<string name="Source">Balloon = script.Parent.Parent.Balloon 
Balloonvelocity = Balloon.BodyVelocity 
Button = script.Parent 
debounce=false 

function onTouched(hit) 
local h = hit.Parent:findFirstChild("Humanoid") 
if h~=nil and debounce == false then 
debounce = true 
Balloonvelocity.velocity = Vector3.new(0,9,0) 
Button.BrickColor = BrickColor.new(21) 
wait(30) 
Balloonvelocity.velocity = Vector3.new(0,-5,0) 
wait(51) 
Balloonvelocity.velocity = Vector3.new(0, 0, 0)
Button.BrickColor = BrickColor.new(28) 
wait(10) 
debounce = false 
end 
end 
connection = Button.Touched:connect(onTouched) </string>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
