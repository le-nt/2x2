				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MessyAnger</string>
					<string name="Source">print("Jimmy347's Chatterbox")

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild("Humanoid")
	if (human ~= nil) and debounce == false then

                debounce = true

		local message = Instance.new("Message")
		message.Text = "welcome to the......"
		message.Parent = game.Players:playerFromCharacter(hit.Parent)
		wait(5)
		message.Text = "thrillville hotel!"
		wait(3)
		message.Text = "vist the rooms or the hotel itself!"
		wait(2)
		message.Text = "there are no rooms to book...yet :-p"
		wait(5)
		message:remove()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)</string>
