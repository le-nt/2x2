			<Item class="Script" referent="RBX16029">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">MessyAnger</string>
					<string name="Source">print("Koopa's Chatterbox")

local debounce = false


function onHit(hit)
	local human = hit.Parent:findFirstChild("Humanoid")
	if (human ~= nil) and debounce == false then

                debounce = true

		local message = Instance.new("Message")
		message.Text = "heres the rules of the park...."
		message.Parent = game.Players:playerFromCharacter(hit.Parent)
		wait(3)
		message.Text = "DON'T copy so many bricks...thats like spamming"
		wait(3)
		message.Text = "and do NOT shoot everything with the paintball guns"
		wait(3)
		message.Text = "or else you will be banned....or worse &gt;:-D"
		wait(3)
		message:remove()

                debounce = false
	end
end

script.Parent.Touched:connect(onHit)</string>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
		</Item>
