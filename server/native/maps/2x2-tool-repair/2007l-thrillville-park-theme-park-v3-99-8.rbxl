			<Item class="Script" referent="RBX9027">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">PlateScript</string>
					<string name="Source">local plate = script.Parent

local color = plate.BrickColor


function disappear()
	plate.BrickColor = BrickColor.new(26)
	wait(.5)
	for i=1,5 do
		plate.Transparency = (i / 5)
		wait(.2)
	end
	plate.CanCollide = false
	
	wait(5)

	plate.CanCollide = true
	plate.Transparency = 0
	plate.BrickColor = color
end


while true do
	if (math.random(1,10) == 5) then disappear() end
	wait(2)
end</string>
