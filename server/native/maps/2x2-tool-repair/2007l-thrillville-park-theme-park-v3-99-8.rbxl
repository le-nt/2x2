				<Item class="Script" referent="RBX2636">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">BulletConductor</string>
						<string name="Source">print("RobloxPolice's BULLET Train Started!")

part=script.Parent

eng1=part.Engine1.BodyVelocity
eng2=part.Engine2.BodyVelocity
eng3=part.Engine3.BodyVelocity
eng4=part.Engine4.BodyVelocity

start=part.StartSw
stop=part.StopSw
trans=part.TransSw
engr=part.EngnrSw
doors=part.DoorSw

spdlt=part.SpeedLt
trnlt=part.TransLt

engrDr=part.EgnrDr
Door1=part.Door1
Door2=part.Door2

spd=0
maxspd=75
func=0
direct=1

engrpos=0
doorpos=0

transfunc=0
engrfunc=0
doorfunc=0

function SetSpeed(vel)
	eng1.velocity=Vector3.new(-vel,0,0)
	eng2.velocity=Vector3.new(-vel,0,0)
	eng3.velocity=Vector3.new(-vel,0,0)
	eng4.velocity=Vector3.new(-vel,0,0)
end

function StartUp()
	while (spd&lt;maxspd) do
		wait(.1)
		spd=spd+10
		SetSpeed(spd)
	end
	SetSpeed(maxspd)
end

function StartUpRev()
	while (spd&gt;-maxspd) do
		wait(.1)
		spd=spd-10
		SetSpeed(spd)
	end
	SetSpeed(-maxspd)
end

function SlowDown()
	while (spd&gt;0) do
		wait(.1)
		spd=spd-10
		SetSpeed(spd)
	end
	SetSpeed(0)
end

function SlowDownRev()
	while (spd&lt;0) do
		wait(.1)
		spd=spd+10
		SetSpeed(spd)
	end
	SetSpeed(0)
end

function onTouchedStart(part)
	local h = part.Parent:findFirstChild("Humanoid")
	if h~=nil then
		if (func==0) then
			spdlt.Color = Color3.new(0,1,0)
			if (direct==1) then
				StartUp()
			end
			if (direct==-1) then
				StartUpRev()
			end
			func=1
		end
	end
end

function onTouchedStop(part)
	local h = part.Parent:findFirstChild("Humanoid")
	if h~=nil then
		if (func==1) then
			if (direct==1) then
				SlowDown()
			end
			if (direct==-1) then
				SlowDownRev()
			end
			spdlt.Color = Color3.new(1,0,0)
			func=0
		end
	end
end

function onTouchedTrans(part)
	local h = part.Parent:findFirstChild("Humanoid")
	if h~=nil then
		if (func==0 and transfunc==0) then
			local bypass=false
			if (direct==1) then
				direct=-1
				bypass=true
				trnlt.Color = Color3.new(0,0,0)
			end
			if (bypass==false) then
				if (direct==-1) then
					direct=1
					trnlt.Color = Color3.new(1,1,1)
				end
			end
			trans.Color=Color3.new(0,0,0)
			transfunc=1
			wait(3)
			trans.Color=Color3.new(1,1,0)
			transfunc=0
		end
	end
end

function onTouchedEngr(part)
	local h = part.Parent:findFirstChild("Humanoid")
	if (h~=nil and engrfunc==0) then
		local bypass=false
		if (engrpos==0) then
			engrpos=1
			bypass=1

			engrDr.CanCollide=true
			engrDr.Transparency=0.5
			engr.Color = Color3.new(0.5,0.5,0.5)
			engrfunc=1
			wait(2)
			engr.Color = Color3.new(1,0,1)
			engrfunc=0
		end
		if (engrpos==1 and bypass==false) then
			engrpos=0
			bypass=0

			engrDr.CanCollide=false
			engrDr.Transparency=1
			engr.Color = Color3.new(0.5,0.5,0.5)
			engrfunc=1
			wait(2)
			engr.Color = Color3.new(1,0,1)
			engrfunc=0
		end
	end
end

function onTouchedDoor(part)
	local h = part.Parent:findFirstChild("Humanoid")
	if (h~=nil and engrfunc==0) then
		local bypass=false
		if (engrpos==0) then
			engrpos=1
			bypass=1

			Door1.CanCollide=true
			Door1.Transparency=0.5
			Door2.CanCollide=true
			Door2.Transparency=0.5
			doors.Color = Color3.new(0.5,0.5,0.5)
			doorfunc=1
			wait(2)
			doors.Color = Color3.new(0,0,1)
			doorfunc=0
		end
		if (engrpos==1 and bypass==false) then
			engrpos=0
			bypass=0

			Door1.CanCollide=false
			Door1.Transparency=1
			Door2.CanCollide=false
			Door2.Transparency=1
			doors.Color = Color3.new(0.5,0.5,0.5)
			doorfunc=1
			wait(2)
			doors.Color = Color3.new(0,0,1)
			doorfunc=0
		end
	end
end

start.Touched:connect(onTouchedStart)
stop.Touched:connect(onTouchedStop)
trans.Touched:connect(onTouchedTrans)
engr.Touched:connect(onTouchedEngr)
doors.Touched:connect(onTouchedDoor)
