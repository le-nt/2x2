				<ProtectedString name="Source">x = -1
y = 0
z = 0
dx = game.Workspace.b.Position.x -game.Workspace.a.Position.x
dy = game.Workspace.b.Position.y -game.Workspace.a.Position.y
dz = game.Workspace.b.Position.z -game.Workspace.a.Position.z
print(dx,dy,dz)
print("-3,2,2.4")
m = Instance.new("Model")
m.Name = "Cable"
m.Parent = workspace

for i=1, 50 do
c = game.Workspace.a:clone()
c.Position = c.Position + Vector3.new(x,y,z)
c.Parent = m
z = z +dz
x = x +dx
y = y+dy
end
</ProtectedString>
