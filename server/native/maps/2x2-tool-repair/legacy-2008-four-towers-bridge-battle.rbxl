		<Item class="Script" referent="RBX54">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Enter</string>
				<ProtectedString name="Source">function onEnter(nPlayer)
i = Instance.new("IntValue")
i.Parent = nPlayer
i.Name = "leaderstats"

ii = Instance.new("IntValue")
ii.Parent = i
ii.Name = "Buttons Hit"
end
game.Players.ChildAdded:connect(onEnter)</ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX55">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Name-A-Team</string>
				<ProtectedString name="Source">dd = false
m = Instance.new("Message")


function onChatted(msg, recipient, speaker)

s = Instance.new("Sound")
s.SoundId = "rbxasset://sounds\\electronicpingshort.wav"

print(#msg)
n = 1

g = game.Workspace:findFirstChild("Game")
if g ~= nil then
d1 = g.d1
d2 = g.d2
end

function Action()
for i=1, #msg do
typeme()
team.Name = t
end
s:remove()
end

function typeme()
wait(0.05)
t = string.sub(msg, tt,n)
n = n+1
s.Parent = workspace
s:play()
end

if string.sub(msg, 1,2) == "n/" and dd == false then
dd = true
p = game.Players:findFirstChild(speaker.Name)
if #msg &gt;= 17 then
if p ~= nil then
m.Parent = p
m.Text = "Too long.. Make it " .. #msg -17 .. " character(s) shorter..."
wait(3)
m:remove()
dd = false
end
else
tt = 3
c = game.Teams:children()
print("dd was false. :)")
for i=1, #msg do
if p.TeamColor == c[1].TeamColor and d1.Value == false then
d1.Value = true
print("d1 was false. :)")
team = c[1]
Action()
end
end
for i=1, #msg do
if p.TeamColor == c[2].TeamColor and d2.Value == false then
print("d2 was false. :)")
team = c[2]
d2.Value = true
Action()
end
end
dd = false
end
end
end

function onEnter(player)
	player.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, player) end) 
end
game.Players.ChildAdded:connect(onEnter)
