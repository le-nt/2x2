					<Item class="Script" referent="RBX10893">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">-- Gamehero

b = script.Parent
m = b.Parent
base = m.Base
d = false
h = Instance.new("Hint")
nn = game.Workspace.Count
lastp = nil
mes = Instance.new("Message")
winner = "No one"
won = false
gm = game.Workspace.Game
dd = gm.PDebounce
loser = "nil"
an = gm.an

function announce()
if an.Value == false then
an.Value = true
mes.Parent = workspace
if loser.Name ~= "nil" then
mes.Text = "Announcing countdown for the doom of " .. loser.Name .. "!"
end
wait(3)
mes:remove()
end
end

function onTouched(hit)
t = hit.Parent:findFirstChild("Torso")
if t ~= nil and d == false and b.BrickColor ~= t.BrickColor and dd.Value == false then
c = game.Teams:GetChildren()
p = game.Players:findFirstChild(t.Parent.Name)
lead = p:findFirstChild("leaderstats")
but = lead:findFirstChild("Buttons Hit")
print(t.Parent.Name)
d = true

if b.BrickColor.Number ~= 26 and p ~= nil and lead ~= nil and but ~= nil then
for i=1, #c do
if c[i].TeamColor == t.BrickColor then
team = c[i]
team.Score = team.Score +1
but.Value = but.Value +1
print("GOGOO!!!")
else
c[i].Score = c[i].Score -1
if lastp ~= nil then
lastp.Value = lastp.Value -1
loser = c[i]
end
end
end
else
for i=1, #c do
if c[i].TeamColor == t.BrickColor then
team = c[i]
team.Score = team.Score +1
but.Value = but.Value +1
else
loser = c[i]
end
end
end

b.BrickColor = t.BrickColor
m.Brick.BrickColor = t.BrickColor
b.CanCollide = false
b.Transparency = 1

if team ~= nil and team.Score == 4 then
announce()
end

for i=1, #c do
for n=1,nn.Value do
if c[i].Score == 4 and nn.Value &gt;= 1 then
wait(1)
nn.Value = nn.Value-1
mes.Parent = workspace
mes.Text = nn.Value
winner = c[i]
print(winner)
end
end
if nn.Value &lt;= 1 then
dd.Value = true
w = gm:children()
won = true
for ii=1, #w do
if w[ii].className == "Part" then
w[ii].Anchored = false
w[ii]:BreakJoints()
end
co = w[ii]:findFirstChild("Color")
if co ~= nil and co.BrickColor ~= winner.TeamColor then
ww = co.Parent:children()
for ii=1, #ww do
ww[ii].Anchored = false
end
e = Instance.new("Explosion")
e.Parent = workspace
e.Position = co.Position
e.BlastPressure = 50000
e.BlastRadius = 60
snd = Instance.new("Sound")
snd.Parent = workspace
snd.SoundId = "rbxasset://sounds\\Rocket Shot.wav"
snd:play()
end
end
end
end
end

if winner ~= "No one" and won == true then
wait(2)
mes.Parent = workspace
mes.Text = winner.Name .. " WINS!"
wait(3)
mes:remove()
game.Workspace.Doregen.Value = true
end

wait(2)
d = false
b.Transparency = 0
b.CanCollide = true
an.Value = false
lastp = but
print(p)
end



b.Touched:connect(onTouched)</ProtectedString>
