		<Item class="Script" referent="RBX51">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">model = game.Workspace.Game
messageText = "Regenerating..."
d = false
message = Instance.new("Message")
message.Text = messageText
backup = model:clone()
dor = game.Workspace.Doregen
t = game.Teams:children()

name1 = t[1].Name
name2 = t[2].Name

while true do
wait(1)
if dor.Value == true and d == false then
d = true
	wait (5)
ch = game.Players:children()
for i=1, #ch do
if ch[i].Character ~= nil then
tt = ch[i].Character:findFirstChild("Torso")
if tt ~= nil then
tt:remove()
end
end
end

	message.Parent = game.Workspace
	model:remove()

	wait (5)

t[1].Name = name1
t[2].Name = name2

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()

mes = game.Workspace:children()

for i=1, #mes do
if mes[i].className == "Message" then
	mes[i].Parent = nil
end
end

dor.Value = false
d = false
end
end
