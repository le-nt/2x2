					<string name="Name">Score Reset</string>
					<ProtectedString name="Source">game.Workspace.Count.Value = 61
c = game.Teams:children()
p = game.Players:children()

for i=1, #c do
for ii=1, #p do
lead = p[ii]:findFirstChild("leaderstats")
b = lead:findFirstChild("Buttons Hit")
if lead ~= nil and b ~= nil then
c[i].Score = 0
b.Value = 0
end
end
end
