						<Item class="Script" referent="RBX8167">
							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<string name="Source">function onTouched(hit)&#13;&#10;&#9;local p = game.Players:GetChildren()&#13;&#10;&#9;for i = 1,#p do&#13;&#10;&#9;&#9;if p[i].Character == hit.Parent then&#13;&#10;&#9;&#9;&#9;connection:disconnect()&#13;&#10;&#9;&#9;&#9;local tag = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;&#9;&#9;tag.Parent = p[i]&#13;&#10;&#9;&#9;&#9;tag.Name = &quot;OrbTag&quot;&#13;&#10;&#9;&#9;&#9;local m = Instance.new(&quot;Message&quot;)&#13;&#10;&#9;&#9;&#9;m.Parent = p[i]&#13;&#10;&#9;&#9;&#9;m.Text = &quot;You found a secret orb!&quot;&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;m.Text = &quot;This orb has great power.&quot;&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;m.Text = &quot;Say /a to increase your health by 50 percent...&quot;&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;m.Text = &quot;Or say /b to increase your damage by 50 percent.&quot;&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#9;&#9;&#9;m.Parent = nil&#13;&#10;&#9;&#9;&#9;script.Parent.Parent = nil&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;connection = script.Parent.Touched:connect(onTouched)</string>
								<bool name="archivable">true</bool>
							</Properties>
						</Item>
					</Item>
