							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">--Weapon Giving One Way Teleporter
--by stickmasterluke
------------------------------------

------------------------------------
--above change the name to the model you want to teleport to.
function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

function onTouch(part) 

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human == nil) then return end 

local player = getPlayer(human) 

if (player == nil) then return end 
--put the weapon you want to give in the Lighting folder.
--then here change the par below that says Gun to the weapon in the Lighting folder.

player.TeamColor = BrickColor.new(21) 
human.Health = 0

--make sure you dont get to many weapons from it so we wait alitol.
wait(0.5)

end 

script.Parent.Touched:connect(onTouch)

--remember this was created by stickmasterluke!
--dont try to claim as your own!
--your lucky im letting people use this great thing i created.
--i have seen this in other games but no one made a model of it till now.</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
