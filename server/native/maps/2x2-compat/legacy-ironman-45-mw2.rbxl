			<Item class="Script" referent="RBX2421">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ProjectileScript</string>
					<ProtectedString name="Source">projectile = script.Parent
damage = 15
local hitteam = 0
local damagedone = 0

function onTouched(hit)
	local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	
	if hit:getMass() &lt; 1.2 * -200 then
		hit.BrickColor = projectile.BrickColor
	end


	if humanoid ~= nil then
		tagHumanoid(humanoid)
		local players = game.Players:GetChildren()
		for i = 1,#players do
			if players[i].Character == humanoid.Parent then
				hitteam = players[i].TeamColor.Number
			end
		end
		
		if hitteam ~= script.Parent.Team.Value and damagedone == 0 then
			damagedone = 1
			humanoid.Health = humanoid.Health - damage
		end
		wait(2)
		untagHumanoid(humanoid)
	end

	connection:disconnect()
	projectile.Parent = nil
end

function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = projectile:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
	end
end


function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

connection = projectile.Touched:connect(onTouched)

wait(10)
script.Parent:remove()</ProtectedString>
