		<Item class="Script" referent="RBX2311">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">OnDied</string>
				<ProtectedString name="Source">game.Players.PlayerAdded:connect(function(p)
p.Changed:connect(function(prop)
if prop == &quot;Character&quot; then
if p.Character ~= nil then

pcall(function()

local Character = p.Character

local h = Character:FindFirstChild(&quot;Humanoid&quot;)
if h ~= nil then

h.Died:connect(function()

local torso = Character:FindFirstChild(&quot;Torso&quot;)
if torso ~= nil and torso:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local tvel = torso.Velocity

torso.Name = &quot;NewTorso&quot;

for a,b in ipairs(torso:GetChildren()) do
if b.className == &quot;Motor&quot; then
b:remove()
end
end

local part = Character:FindFirstChild(&quot;Right Arm&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Right Shoulder&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x + part.Size.x) / 2,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) --CFrame.new((torso.Size.x / 2) + (part.Size.x / 2),part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame --* Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)  --vectorToWorldSpace(0,((part.Size.y / 2) * -1) + .2,0))   part.CFrame:toWorldSpace(CFrame.new(part.CFrame Vector3.new(0,((part.Size.y / 2) * -1) + .2,0)   ))
b.Transparency = 1
b.CFrame = part.CFrame --* w.C0
b.Parent = part

local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b

w.Parent = torso

end

local part = Character:FindFirstChild(&quot;Left Arm&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Left Shoulder&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((-torso.Size.x - part.Size.x) / 2,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi / 2,0) 
m.C1 = CFrame.new(0,part.Size.y/4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi / 2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame
b.Transparency = 1
b.Parent = part

local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b
w.Parent = torso

end

local part = Character:FindFirstChild(&quot;Right Leg&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Right Hip&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x - part.Size.x) / 2,-(part.Size.y/4) * 3,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame
b.Transparency = 1
b.Parent = part

local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b
w.Parent = torso

end

local part = Character:FindFirstChild(&quot;Left Leg&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Left Hip&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x / 2) - part.Size.x * 1.5,-(part.Size.y / 4) * 3,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

local b = Instance.new(&quot;Part&quot;)
b.formFactor = &quot;Plate&quot;
b.Size = Vector3.new(1,.4,1)
b.CanCollide = true
b.TopSurface = 0
b.BottomSurface = 0
b.CFrame = part.CFrame
b.Transparency = 1
b.Parent = part

local w = Instance.new(&quot;Weld&quot;)
w.Name = &quot;LimbEnd&quot;
w.C0 = CFrame.new(0,((part.Size.y / 2) * -1) + .2,0)
w.Part0 = part
w.Part1 = b
w.Parent = torso

end

local part = Character:FindFirstChild(&quot;Head&quot;)

if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local m = Instance.new(&quot;Weld&quot;)
m.Name = &quot;Neck&quot;

m.C0 = CFrame.new(0,(torso.Size.y / 2) + (part.Size.y / 2),0) * CFrame.fromEulerAnglesXYZ(0,0,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso

--[[pplocal bf = Instance.new(&quot;BodyThrust&quot;)
bf.force = Vector3.new(0,0,-1250)
bf.Parent = part

wait(1)

bf.Parent = nil--]]

else

--[[local part = Character:FindFirstChild(&quot;Right Leg&quot;)
if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then

local bf = Instance.new(&quot;BodyThrust&quot;)
bf.force = Vector3.new(0,500,1250)
bf.Parent = part

wait(1)

bf.Parent = nil

end--]]


end

local timesreconnected = 0

local dconnection = 0

dconnection = torso.ChildRemoved:connect(function(w)

if torso.Parent == nil then
dconnection:disconnect()
return
end

if timesreconnected &gt;= 3 then
dconnection:disconnect()
return
end

if w.className == &quot;Glue&quot; then
if w.Name == &quot;Right Shoulder&quot; then
timesreconnected = timesreconnected + 1
wait()
local part = Character:FindFirstChild(&quot;Right Arm&quot;)
if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then
local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Right Shoulder&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x + part.Size.x) / 2,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) --CFrame.new((torso.Size.x / 2) + (part.Size.x / 2),part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso
end
elseif w.Name == &quot;Left Shoulder&quot; then
local part = Character:FindFirstChild(&quot;Left Arm&quot;)
if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then
local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Left Shoulder&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((-torso.Size.x - part.Size.x) / 2,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi / 2,0) 
m.C1 = CFrame.new(0,part.Size.y/4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi / 2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso
end
elseif w.Name == &quot;Left Hip&quot; then
local part = Character:FindFirstChild(&quot;Left Leg&quot;)
if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then
local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Left Hip&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x / 2) - part.Size.x * 1.5,-(part.Size.y / 4) * 3,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso
end
elseif w.Name == &quot;Right Hip&quot; then
local part = Character:FindFirstChild(&quot;Right Leg&quot;)
if part ~= nil and part:FindFirstChild(&quot;IsDisconnected&quot;) == nil then
local m = Instance.new(&quot;Glue&quot;)
m.Name = &quot;Right Hip&quot;
--m.MaxVelocity = 0.1
m.C0 = CFrame.new((torso.Size.x - part.Size.x) / 2,-(part.Size.y/4) * 3,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.C1 = CFrame.new(0,part.Size.y / 4,0) * CFrame.fromEulerAnglesXYZ(0,math.pi/2,0) 
m.Part1 = part
m.Part0 = torso
m.Parent = torso
