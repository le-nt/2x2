							<Properties>
								<bool name="Disabled">false</bool>
								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function onTouched(hit)
	local p = game.Players:GetChildren()
	for i = 1,#p do
		if p[i].Character == hit.Parent then
			local status = p[i]:FindFirstChild(&quot;DEAGLE&quot;)
			local lock1 = p[i]:FindFirstChild(&quot;M9&quot;)
			local points = p[i].leaderstats:FindFirstChild(&quot;Points&quot;)
			print(&quot;yes&quot;)
			if points.Value &gt; 249 and status.Value == 0 and lock1.Value ~= 2 then
				status.Value = 2	
				points.Value = points.Value - 250
				local newacr = game.Lighting.DesertEagle:clone()
				newacr.Parent = p[i].Backpack
				local notif = Instance.new(&quot;Message&quot;)
				notif.Parent = p[i]
				notif.Text = &quot;You have bought and equipped the Desert Eagle.&quot;
				wait(2)
				notif:remove()
			elseif status.Value == 1 and lock1.Value ~= 2 then
				local newacr2 = game.Lighting.DesertEagle:clone()	
				newacr2.Parent = p[i].Backpack
				status.Value = 2
				local notif = Instance.new(&quot;Message&quot;)
				notif.Parent = p[i]
				notif.Text = &quot;You have equipped the Desert Eagle.&quot;
				wait(2)
				notif:remove()
			end
		end
	end
end






