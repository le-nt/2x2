				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Leaderboard</string>
				<ProtectedString name="Source">function onPlayerEntered(newPlayer)

	local stats = Instance.new(&quot;IntValue&quot;)
	stats.Name = &quot;leaderstats&quot;

	local kills = Instance.new(&quot;IntValue&quot;)
	kills.Name = &quot;Kills&quot;
	kills.Value = 0

	local deaths = Instance.new(&quot;IntValue&quot;)
	deaths.Name = &quot;Deaths&quot;
	deaths.Value = 0

	local points = Instance.new(&quot;IntValue&quot;)
	points.Name = &quot;Points&quot;
	points.Value = 0

	local spree = Instance.new(&quot;IntValue&quot;)
	spree.Name = &quot;Spree&quot;
	spree.Value = 0

	local ACRTAR21 = Instance.new(&quot;IntValue&quot;)
	ACRTAR21.Name = &quot;ACRTAR21&quot;
	ACRTAR21.Value = 0

	local ACRTAR21GL = Instance.new(&quot;IntValue&quot;)
	ACRTAR21GL.Name = &quot;ACRTAR21GL&quot;
	ACRTAR21GL.Value = 0

	local M4AKGL = Instance.new(&quot;IntValue&quot;)
	M4AKGL.Name = &quot;M4AKGL&quot;
	M4AKGL.Value = 0

	local SNIPER = Instance.new(&quot;IntValue&quot;)
	SNIPER.Name = &quot;SNIPER&quot;
	SNIPER.Value = 0
	
	local DEAGLE = Instance.new(&quot;IntValue&quot;)
	DEAGLE.Name = &quot;DEAGLE&quot;
	DEAGLE.Value = 0

	local M9 = Instance.new(&quot;IntValue&quot;)
	M9.Name = &quot;M9&quot;
	M9.Value = 1

	local M4AK = Instance.new(&quot;IntValue&quot;)
	M4AK.Name =&quot;M4AK&quot;
	M4AK.Value = 1

	kills.Parent = stats
	deaths.Parent = stats
	spree.Parent = stats
	points.Parent = stats
	

	while true do
		if newPlayer.Character ~= nil then break end
		wait(1)
	end
--------------------------------------------------------------------------------
	local humanoid = newPlayer.Character.Humanoid

	humanoid.MaxHealth=100
	humanoid.Health=100
	if humanoid.Parent:findFirstChild(&quot;Torso&quot;)~=nil then
		humanoid.Parent.Torso.Reflectance=0.3
	end
	humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )

	wait(2)
	if humanoid.Parent:findFirstChild(&quot;Torso&quot;)~=nil then
		humanoid.Parent.Torso.Reflectance=0
	end



			local sg=humanoid.Parent:findFirstChild(&quot;Shirt Graphic&quot;)
			if sg then
				if sg.Graphic==&quot;rbxasset://../../../shareddata/assets/1070319&quot; then
						humanoid.MaxHealth=130
						humanoid.Health=130
				else
	humanoid.MaxHealth=100
	humanoid.Health=100
				end
			else
				humanoid.MaxHealth=100
	humanoid.Health=100
			end
		

--------------------------------------------------------------------------------
	-- start to listen for new humanoid
	newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )
	newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
	stats.Parent = newPlayer
	ACRTAR21.Parent= newPlayer
	ACRTAR21GL.Parent= newPlayer
	M4AKGL.Parent= newPlayer
	M4AK.Parent= newPlayer
	M9.Parent= newPlayer
	SNIPER.Parent= newPlayer
	DEAGLE.Parent= newPlayer
end

function onHumanoidDied(humanoid, player)
	local stats = player:findFirstChild(&quot;leaderstats&quot;)
	local team3 = player.TeamColor.Number
	print(team3)
	if stats ~= nil then
		local deathsp = stats:findFirstChild(&quot;Deaths&quot;)
		local spreep = stats:findFirstChild(&quot;Spree&quot;)
		local ACRstatus = player:findFirstChild(&quot;ACRTAR21&quot;)
		local ACRTAR21GLstatus = player:findFirstChild(&quot;ACRTAR21GL&quot;)
		local M4AKGLstatus = player:findFirstChild(&quot;M4AKGL&quot;)
		local DEAGLEstatus = player:findFirstChild(&quot;DEAGLE&quot;)
		local SNIPERstatus = player:findFirstChild(&quot;SNIPER&quot;)
		local M9status = player:findFirstChild(&quot;M9&quot;)
		local M4AKstatus = player:findFirstChild(&quot;M4AK&quot;)
		deathsp.Value = deathsp.Value + 1
		spreep.Value = 0
		if  ACRstatus.Value == 2 then
			ACRstatus.Value = 1
		end
		if  ACRTAR21GLstatus.Value == 2 then
			ACRTAR21GLstatus.Value = 1
		end
		if  M4AKGLstatus.Value == 2 then
			M4AKGLstatus.Value = 1
		end
		if  DEAGLEstatus.Value == 2 then
			DEAGLEstatus.Value = 1
		end
		if  SNIPERstatus.Value == 2 then
			SNIPERstatus.Value = 1
		end
		if  M9status.Value == 2 then
			M9status.Value = 1
		end
		if M4AKstatus.Value == 2 then
			M4AKstatus.Value = 1
		end
		local killer = getKillerOfHumanoidIfStillInGame(humanoid)
		handleKillCount(humanoid, player)
	end
end

function onPlayerRespawn(property, player)
	if property == &quot;Character&quot; and player.Character ~= nil then
		local humanoid=player.Character.Humanoid
		humanoid.MaxHealth=100
		humanoid.Health=100
		if humanoid.Parent:findFirstChild(&quot;Torso&quot;)~=nil then
			humanoid.Parent.Torso.Reflectance=0.3
			humanoid.Parent.Torso.Anchored=true
		end
		humanoid.Died:connect(function() onHumanoidDied(humanoid, player) end )

		humanoid.Parent.Torso.Anchored=false
		
		wait(6)

		humanoid.Parent.Torso.Reflectance=0
		humanoid.MaxHealth=100
		humanoid.Health=100
	end
end

function getKillerOfHumanoidIfStillInGame(humanoid)
	local tag = humanoid:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		
		local killer = tag.Value
		if killer.Parent ~= nil then -- killer still in game
			return killer
		end
	end

	return nil
end

function handleKillCount(humanoid, player)
	local killer = getKillerOfHumanoidIfStillInGame(humanoid)
	if killer ~= nil then
		local stats = killer:findFirstChild(&quot;leaderstats&quot;)
		if stats ~= nil then
			local killser = stats:findFirstChild(&quot;Kills&quot;)
			local spreeer = stats:findFirstChild(&quot;Spree&quot;)
			local pointser = stats:findFirstChild(&quot;Points&quot;)
			if killer ~= player then
				if killer.TeamColor ~= player.TeamColor then
					killser.Value = killser.Value + 1
					spreeer.Value = spreeer.Value +1
					pointser.Value = pointser.Value + 100
					
					if killer.TeamColor.Number == 21 then
						game.Workspace.SpetznazKills.Value = game.Workspace.SpetznazKills.Value + 1
					else
						game.Workspace.TFKills.Value = game.Workspace.TFKills.Value + 1
					end
					
					if spreeer.Value == 5 or spreeer.Value == 10 then
						local Predator = game.Lighting.PredatorMissile:clone()
						Predator.Parent = killer.Backpack
					elseif spreeer.Value == 15 then
						local Nuke = game.Lighting.TacticalNuke:clone()
						Nuke.Parent = killer.Backpack
					end
				else
					killser.Value = killser.Value - 1
					spreeer.Value = spreeer.Value - 1
					if killer.TeamColor.Number == 21 then
						game.Workspace.SpetznazKills.Value = game.Workspace.SpetznazKills.Value - 1
					else
						game.Workspace.TFKills.Value = game.Workspace.TFKills.Value - 1
					end
					if player:findFirstChild(&quot;leaderstats&quot;)~=nil then
						if player.leaderstats:findFirstChild(&quot;Points&quot;)~=nil then
							player.leaderstats.Points.Value=player.leaderstats.Points.Value
						end
					end
				end
			else
				killser.Value = killser.Value - 1
				spreeer.Value = 0
				pointser.Value = pointser.Value - 50
			end
		end
	end
end


game.Players.ChildAdded:connect(onPlayerEntered)
game.Workspace.RedFlagSet.RedFlagStand.FlagCaptured:connect(onCaptureScoredRed)
game.Workspace.BlueFlagSet.BlueFlagStand.FlagCaptured:connect(onCaptureScoredBlue)
