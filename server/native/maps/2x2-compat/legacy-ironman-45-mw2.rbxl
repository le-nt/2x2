vest = Instance.new(&quot;Decal&quot;)
vest.Texture = &quot;rbxasset://../../../shareddata/MW2/textures/spvest.png&quot;
vest.Parent = player.Character.Torso

--make sure you dont get to many weapons from it so we wait alitol.
wait(0.5)

end 

