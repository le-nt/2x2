				<string name="Name">Game</string>
				<ProtectedString name="Source">local Scoreboard = Instance.new(&quot;Hint&quot;)
Scoreboard.Parent = game.Workspace
local winmsg = Instance.new(&quot;Message&quot;)

spkills = 0
tfkills = 0
time = 0
timeel = 0
gameac = 1
winner = 0
mapid = 1

function matchend()
	gameac = 0
	game.Workspace.Teleporters:remove()
	local proj = game.Workspace:GetChildren()
	for i = 1, #proj do
		if proj[i].Name == &quot;Projectile&quot; then
			proj[i]:remove()
		end
	end
	winmsg.Parent = game.Workspace
	if script.Parent.SpetznazKills.Value &gt; script.Parent.TFKills.Value then
		winmsg.Text = &quot;Spetznaz Wins!&quot;
		winner = 21
		game.Workspace.SpetznazVictory:play()
	elseif script.Parent.SpetznazKills.Value &lt; script.Parent.TFKills.Value then
		winmsg.Text = &quot;Task Force 141 Wins!&quot;
		winner = 45
		game.Workspace.TFVictory:play()
	else
		winmsg.Text = &quot;No one Wins.&quot;
		winner = &quot;none&quot;
		game.Workspace.RoundEnd:play()
	end
	game.Workspace.SpetznazKills.Value = 0
	game.Workspace.TFKills.Value = 0
	Scoreboard.Text = &quot;Intermission&quot;
	local player = game.Players:GetChildren()
	if(#player&gt;0)then
		for p = 1, #player do
				local playerteam = 0
				playerteam = player[p].TeamColor.Number
				player[p].leaderstats.Spree.Value = 0
				if playerteam == winner then
				local points = player[p].leaderstats:FindFirstChild(&quot;Points&quot;)
				points.Value = points.Value + 250
				else
				local points = player[p].leaderstats:FindFirstChild(&quot;Points&quot;)				
				points.Value = points.Value + 125
				end
				if(player[p].Character~=nil)then
				local h = player[p].Character:FindFirstChild(&quot;Humanoid&quot;)
				if(h.Health&gt;0)then
					player[p].Character.Humanoid.Health = 0
					local deaths = player[p].leaderstats:FindFirstChild(&quot;Deaths&quot;)
					deaths.Value = deaths.Value - 1
				end
				wait(0.1)
				player[p].leaderstats.Kills.Value = 0
				player[p].leaderstats.Deaths.Value = 0
			end
		end
	end
	game.Workspace.Map:remove()
	wait(2.9)
	winmsg.Parent = nil
	local newmap = game.Lighting.Rust:clone()
	newmap.Parent = game.Workspace
	newmap.Name = &quot;Map&quot;
	wait(22)
	print(&quot;done&quot;)
	local newtp = game.Lighting.RustTeleporters:clone()
	newtp.Parent = game.Workspace
	newtp.Name = &quot;Teleporters&quot;
	
	time = 420
	gameac = 1
	timeel = 0

	game.Workspace.SpetznazKills.Value = 0
	game.Workspace.TFKills.Value = 0
	
	winmsg.Parent = game.Workspace
	game.Workspace.RoundStartWav:play()
	winmsg.Text = &quot;Team Deathmatch - Eliminate the enemy team to win&quot;
	wait(2)
	winmsg.Parent = nil
end

function killpeople()
	local player = game.Players:GetChildren()
	if(#player&gt;0)then
		for p = 1, #player do
			if(player[p].Character~=nil)then
				local h = player[p].Character:FindFirstChild(&quot;Humanoid&quot;)
				if(h.Health&gt;0)then
					player[p].Character.Humanoid.Health = 0
				end
			end
		end
	end
end

while true do
	wait(1)

	spkills = script.Parent.SpetznazKills.Value
	tfkills = script.Parent.TFKills.Value
	timeel = timeel + 1
	time = 420 - timeel

	if gameac == 1 then
		Scoreboard.Text = &quot;Spetznaz Kills: &quot; .. spkills .. &quot;   Task Force 141 Kills: &quot; .. tfkills .. &quot;   Time Remaining: &quot; .. time
	else
		Scoreboard.Text = &quot;Intermission&quot;
	end

	if timeel == 420 or spkills &gt; 74 or tfkills &gt; 74 then
		matchend()
	end
end


