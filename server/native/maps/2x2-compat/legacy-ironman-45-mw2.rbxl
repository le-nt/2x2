								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function onTouched(hit)
	local p = game.Players:GetChildren()
	for i = 1,#p do
		if p[i].Character == hit.Parent then
			local status = p[i]:FindFirstChild(&quot;ACRTAR21GL&quot;)
			local lock1 = p[i]:FindFirstChild(&quot;ACRTAR21&quot;)
			local lock2 = p[i]:FindFirstChild(&quot;M4AKGL&quot;)
			local lock3 = p[i]:FindFirstChild(&quot;SNIPER&quot;)
			local lock4 = p[i]:FindFirstChild(&quot;M4AK&quot;)
			local points = p[i].leaderstats:FindFirstChild(&quot;Points&quot;)
			print(&quot;yes&quot;)
			if points.Value &gt; 749 and status.Value == 0 and lock1.Value ~= 2 and lock2.Value ~= 2 and lock3.Value ~= 2 and lock4.Value ~= 2 then
				status.Value = 2	
				points.Value = points.Value - 750
				local newacr = game.Lighting.TAR21Grenadier:clone()
				newacr.Parent = p[i].Backpack
