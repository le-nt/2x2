			<Item class="Script" referent="RBX2513">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Server Launcher</string>
					<ProtectedString name="Source">local Rocket = Instance.new(&quot;Part&quot;)
local Tool = script.Parent
local m = Instance.new(&quot;Message&quot;)
m.Text = &quot;Click a point on the map to launch a missile strike onto. WARNING: IT CAN TEAM KILL&quot;

Rocket.Locked = true
Rocket.BackSurface = 3
Rocket.BottomSurface = 3
Rocket.FrontSurface = 3
Rocket.LeftSurface = 3
Rocket.RightSurface = 3
Rocket.TopSurface = 3
Rocket.Size = Vector3.new(4,16,4)
Rocket.BrickColor = BrickColor.new(23)

Tool.RocketScript:clone().Parent = Rocket
Tool.Explosion:clone().Parent = Rocket
Tool.Swoosh:clone().Parent = Rocket


function fire(vTarget)

	local vCharacter = Tool.Parent;
	
	local vHandle = Tool:findFirstChild(&quot;Handle&quot;)
	if vHandle == nil then
		print(&quot;Handle not found&quot;)
		return 
	end

	local missile = Rocket:clone()

	
	

	local creator_tag = Instance.new(&quot;ObjectValue&quot;)

	local vPlayer = game.Players:playerFromCharacter(vCharacter)

	if vPlayer == nil then
		print(&quot;Player not found&quot;)
	else
		if (vPlayer.Neutral == false) then -- nice touch
			missile.BrickColor = vPlayer.TeamColor
		end
	end

	creator_tag.Value =vPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	
	missile.RocketScript.Disabled = false

	missile.Parent = game.Workspace
	
	wait(0.01)
	missile.Position = Vector3.new(Tool.X.Value,400,Tool.Z.Value)
	
	local indicator = game.Lighting.Indicator:clone()
	
	indicator.Parent = game.Workspace
	indicator.Position = Vector3.new(Tool.X.Value,Tool.Y.Value,Tool.Z.Value)
	wait(2.75)
	
	for i = 1,25 do
		wait(0.01)
		indicator.Transparency = indicator.Transparency + 0.02
	end

	indicator:remove()
	Tool:remove()
end

Tool.Enabled = true
function onActivated()
	if not Tool.Enabled then
		return
	end

	Tool.Enabled = false

	local character = Tool.Parent;
	local humanoid = character.Humanoid
	if humanoid == nil then
		print(&quot;Humanoid not found&quot;)
		return 
	end

	local targetPos = humanoid.TargetPoint
	fire(targetPos)

	wait(7)
	Tool:remove()
	Tool.Enabled = true
end

function onEquipped()
	local p = game.Players:GetChildren()
	for i = 1,#p do
		if p[i].Character == script.Parent.Parent then
			m.Parent = p[i]
		end
	end
end

script.Parent.Activated:connect(onActivated)

</ProtectedString>
					<bool name="archivable">true</bool>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX2514">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">RocketScript</string>
					<ProtectedString name="Source">script.Parent.Velocity = Vector3.new(0, -500 , 0)
script.Parent.Swoosh:play()

function explode()
	explosion = Instance.new(&quot;Explosion&quot;)
	explosion.Position = Vector3.new(script.Parent.Position.x,script.Parent.Position.y - 3,script.Parent.Position.z)
	explosion.BlastRadius=30
	explosion.BlastPressure=0.1
	
	local creator = script.Parent:findFirstChild(&quot;creator&quot;)
	if creator ~= nil then
		explosion.Hit:connect(function(part, distance)  onPlayerBlownUp(part, distance, creator) end)
	end
	explosion.Parent = game.Workspace
	script.Parent.Explosion:play()
	wait(.1)
	script.Parent:remove()
end

function onPlayerBlownUp(part, distance, creator)
	if part.Name == &quot;Head&quot; then
		local humanoid = part.Parent.Humanoid
		tagHumanoid(humanoid, creator)
	end
end

function tagHumanoid(humanoid, creator)
	if creator ~= nil then
		local new_tag = creator:clone()
		new_tag.Parent = humanoid
	end
end

function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			tag.Parent = nil
		end
	end
end

wait(0.11)
function onTouched(hit)
	script.Parent.Swoosh:stop()
	explode()
	script.Parent:destroy()
end

connection = script.Parent.Touched:connect(onTouched)

while true do 
	wait(0)
	script.Parent.Velocity = Vector3.new(0, -300 , 0)
	local splode = Instance.new(&quot;Explosion&quot;)
	splode.Position = Vector3.new(script.Parent.Position.x,script.Parent.Position.y +10,script.Parent.Position.z)
	splode.BlastRadius=4
	splode.BlastPressure=0
	wait(0)
	splode:remove()
	splode.Parent = game.Workspace
end

