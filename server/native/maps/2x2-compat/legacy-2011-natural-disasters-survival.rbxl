					<ProtectedString name="Source">--Made by Stickmasterluke



sp=script.Parent

sp.Touched:connect(function(hit)
&#9;if hit then
&#9;&#9;if hit.Parent~=nil then
&#9;&#9;&#9;if not hit.Anchored then
&#9;&#9;&#9;&#9;hit:BreakJoints()
&#9;&#9;&#9;&#9;hit.Velocity=sp.Velocity
&#9;&#9;&#9;end
&#9;&#9;&#9;wait(.1)
&#9;&#9;&#9;sp:remove()
&#9;&#9;end
&#9;end
end)




