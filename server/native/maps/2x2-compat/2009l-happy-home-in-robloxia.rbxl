					<Item class="Script" referent="RBX123">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Dozer</string>
							<string name="Source">function removeSeats(root)
	local c = root:GetChildren()
	for i=1,#c do
		removeSeats(c[i])
		if (c[i].className == &quot;VehicleSeat&quot;) then 
			c[i]:Remove() 
		else
			game.Debris:AddItem(c[i], 200)
		end
	end
end


function Touch(part)


	if (script.Parent.Parent.Name ~= &quot;Car&quot;) then
		script.Parent = nil -- this dozer got dozed lol
	end

	if (part.Parent.Name == &quot;Car&quot; and part.Parent.className == &quot;Model&quot;) then

		if (part.Parent ~= script.Parent.Parent) then
			part.Parent.Name = &quot;DestroyedCar&quot;
			part.Parent:BreakJoints()
			removeSeats(part.Parent)
		end
	end

end

script.Parent.Touched:connect(Touch)</string>
