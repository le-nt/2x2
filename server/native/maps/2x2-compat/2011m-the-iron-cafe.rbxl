			<Item class="Script" referent="RBX4732">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">SnowGlobeScript</string>
					<ProtectedString name="Source">local Tool = script.Parent;

Tool.Enabled = true

function onActivated()
	if not Tool.Enabled  then
		return
	end


	snowglobesound:Play()

	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = -3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = -3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = -3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = -3
	wait(.2)
	--[[Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = 3
	wait(.2)
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 0.5
	Tool.Parent.Torso[&quot;Right Shoulder&quot;].DesiredAngle = -3
	wait(.2)
	--]]

	Tool.Parent.Torso[&quot;Right Shoulder&quot;].MaxVelocity = 1

	sparkles.Enabled = false
	Tool.Enabled = true

end

function onEquipped()
	snowglobesound = Instance.new(&quot;Sound&quot;)
	snowglobesound.SoundId = &quot;rbxasset://../../../shareddata/assets/21341252&quot; 
	snowglobesound.Parent = Tool
end

function onUnequipped()
	snowglobesound:Stop()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
script.Parent.Unequipped:connect(onUnequipped)
