		<Item class="HopperBin" referent="RBX4230">
			<Properties>
				<bool name="Active">false</bool>
				<token name="BinType">0</token>
				<string name="Name">Spin/Dance</string>
				<Content name="TextureId"><url>rbxasset://../../../shareddata/assets/43832653</url></Content>
