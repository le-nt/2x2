					<ProtectedString name="Source">function dance()

local me = script.Parent.Parent.Parent.Character.Torso

local RightShoulder = me[&quot;Right Shoulder&quot;]


for i=1, 9 do 

	for i=1, 15 do

RightShoulder.MaxVelocity = 0.35


RightShoulder.DesiredAngle = 3.14
	wait(0)
end
	for i=1, 14 do

RightShoulder.MaxVelocity = 0.35

RightShoulder.DesiredAngle = 2.21

wait(0) end


RightShoulder.MaxVelocity = 0.15
end


end

function go(mouse)

mouse.Button1Down:connect(function() dance() end)

end

script.Parent.Selected:connect(go)
