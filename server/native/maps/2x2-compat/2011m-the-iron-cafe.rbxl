						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">f = script.Parent
b1 = f.Button1
b2 = f.Button2
b3 = f.Button3
b4 = f.Button4
b5 = f.Button5
nb = f.NoBody
b = {b1,b2,b3,b4,b5,nb}
h = f.Parent.Parent.Parent.Character.Humanoid
function meshmaker1()
nomesh()
button = b1
for i,v in ipairs(button:GetChildren()) do
clone = v:Clone()
clone.Parent = h.Parent
end end
function meshmaker2()
nomesh()
button = b2
for i,v in ipairs(button:GetChildren()) do
clone = v:Clone()
clone.Parent = h.Parent
end end
function meshmaker3()
nomesh()
button = b3
for i,v in ipairs(button:GetChildren()) do
clone = v:Clone()
clone.Parent = h.Parent
end end
function meshmaker4()
nomesh()
button = b4
for i,v in ipairs(button:GetChildren()) do
clone = v:Clone()
clone.Parent = h.Parent
end end
function meshmaker5()
nomesh()
button = b5
for i,v in ipairs(button:GetChildren()) do
clone = v:Clone()
clone.Parent = h.Parent
end end


function nomesh()
for i,v in ipairs(h.Parent:GetChildren()) do
if v.className == &quot;CharacterMesh&quot; then
v:Remove()
end end end

script.Parent.Button1.MouseButton1Click:connect(meshmaker1)
script.Parent.Button2.MouseButton1Click:connect(meshmaker2)
script.Parent.Button3.MouseButton1Click:connect(meshmaker3)
script.Parent.Button4.MouseButton1Click:connect(meshmaker4)
script.Parent.Button5.MouseButton1Click:connect(meshmaker5)
script.Parent.NoBody.MouseButton1Click:connect(nomesh)</ProtectedString>
