						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">button = script.Parent
p = script.Parent.Parent.Parent.Parent

on = false
--name these the name you want on the list that the players see
list = {&quot;DrumKit&quot;, &quot;Tambourine&quot;, &quot;MariachiGuitar&quot;,&quot;Saxophone&quot;,&quot;Guitar&quot;,&quot;Mic&quot;,&quot;None&quot;,&quot;None&quot;}

function over()
	button.Transparency = 0
end

function out()
	release()
	button.Transparency = 0.5
end

--if you like this try my music gui!

function function1()
game.Lighting.DrumKit:clone().Parent = p.Backpack 
end

function function2()
game.Lighting.Tambourine:clone().Parent = p.Backpack 
end

function function3()
game.Lighting.MariachiGuitar:clone().Parent = p.Backpack 
end

function function4()
game.Lighting.Saxophone:clone().Parent = p.Backpack 
end

function function5()
game.Lighting.Guitar:clone().Parent = p.Backpack 
end

function function6()
game.Lighting.Mic:clone().Parent = p.Backpack 
end

function function7()
game.Lighting.None:clone().Parent = p.Backpack 
end

function function8()
game.Lighting.None:clone().Parent = p.Backpack 
end

--dont mess with this stuff down there if you dont no what you are doing!

function sort(which)
	functions = {function1, function2, function3, function4, function5, function6, function7, function8}
	for i = 1,#functions do
		if which.Name == &quot;ListItem&quot; .. tostring(i) then
			functions[i]()
		end
	end
	if on then
		click()
	end
end

function click()
	if on then
		button.BackgroundColor = BrickColor.new(&quot;Grime&quot;)
	else button.BackgroundColor = BrickColor.new(&quot;Bright red&quot;)
	end
	on = not on
	for i = 1,#list do
		item = button.Parent:findFirstChild(&quot;ListItem&quot; .. tostring(i))
		if (item~=nil) then
			item.Visible = on
			item.Text = list[i]
		end
	end
end

function release()
end

button.MouseEnter:connect(over)
button.MouseLeave:connect(out)
button.MouseButton1Down:connect(click)
button.MouseButton1Up:connect(release)
button.Parent.ListItem1.MouseButton1Click:connect(function () sort(button.Parent.ListItem1) end)
button.Parent.ListItem2.MouseButton1Click:connect(function () sort(button.Parent.ListItem2) end)
button.Parent.ListItem3.MouseButton1Click:connect(function () sort(button.Parent.ListItem3) end)
button.Parent.ListItem4.MouseButton1Click:connect(function () sort(button.Parent.ListItem4) end)
button.Parent.ListItem5.MouseButton1Click:connect(function () sort(button.Parent.ListItem5) end)
button.Parent.ListItem6.MouseButton1Click:connect(function () sort(button.Parent.ListItem6) end)
button.Parent.ListItem7.MouseButton1Click:connect(function () sort(button.Parent.ListItem7) end)
button.Parent.ListItem8.MouseButton1Click:connect(function () sort(button.Parent.ListItem8) end)</ProtectedString>
