								<string name="Name">Script</string>
								<ProtectedString name="Source">function onClicked()
if script.Parent.Anchored == true then
script.Parent.Anchored = false
script.Parent.BrickColor = BrickColor.new(&quot;Black&quot;)
else
script.Parent.Anchored = true
script.Parent.BrickColor = BrickColor.new(&quot;Sand green&quot;)
end
end
script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
