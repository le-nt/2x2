backup_b16 = b16:Clone() 
backup_ocean = ocean:Clone()

function onChatted(msg, recipient, speaker) 

local source = string.lower(speaker.Name) 
msg = string.lower(msg) 

if (msg == &quot;regen&quot;) and cooldown ~= true then
cooldown = true
spawn.Parent = nil 
spawn = backup_spawn:clone() 
spawn.Parent = game.Workspace 
spawn:makeJoints() 
wait(1)
bricks.Parent = nil 
bricks = backup_bricks:clone() 
bricks.Parent = game.Workspace 
bricks:makeJoints() 
wait(1)
