			<Item class="LocalScript" referent="RBX2763">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">LocalScript</string>
					<ProtectedString name="Source">function AntiGrief()
if not script.Parent.Parent.Parent.Character:findFirstChild(&quot;AntiGrief&quot;) then
v = Instance.new(&quot;BoolValue&quot;)
v.Name = &quot;AntiGrief&quot;
v.Parent = script.Parent.Parent.Parent.Character
script.Parent.TextButton.TextLabel.Text = &quot;(On)&quot;
script.Parent.TextButton.TextLabel.TextColor3 = Color3.new(0,1,0)
else
script.Parent.Parent.Parent.Character.AntiGrief:Remove()
script.Parent.TextButton.TextLabel.Text = &quot;(Off)&quot;
script.Parent.TextButton.TextLabel.TextColor3 = Color3.new(1,0,0)
end
end

function OnChildAdded(child)
if (child.Part0:IsDescendantOf(script.Parent.Parent.Parent.Character) or child.Part1:IsDescendantOf(script.Parent.Parent.Parent.Character)) and script.Parent.Parent.Parent.Character:findFirstChild(&quot;AntiGrief&quot;) then
child:Remove()
end
end

function onMouseEnter()
script.Parent.TextButton.BackgroundColor3 = Color3.new(0.698039,0.698039,0.698039)
script.Parent.TextButton.BackgroundTransparency = 0
end

function onMouseLeave()
script.Parent.TextButton.BackgroundColor3 = Color3.new(0.588235,0.588235,0.588235)
script.Parent.TextButton.BackgroundTransparency = 0.4
end

script.Parent.TextButton.MouseButton1Down:connect(AntiGrief)
script.Parent.TextButton.MouseEnter:connect(onMouseEnter)
script.Parent.TextButton.MouseLeave:connect(onMouseLeave)
Game.JointsService.ChildAdded:connect(OnChildAdded)
</ProtectedString>
