				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Public Commands</string>
				<ProtectedString name="Source">wait(5)
cooldown = false
spawn = game.Workspace.Spawn
bricks = game.Workspace.Bricks
vipbricks = game.Workspace[&quot;Vip Bricks&quot;]
