				<Item class="Script" referent="RBX4259">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">HatShot</string>
						<ProtectedString name="Source">function RemoveHat(hit)
&#9;local name = hit.Parent.className
&#9;if (name == &quot;Hat&quot;) then
&#9;&#9;local human = hit.Parent.Parent:findFirstChild(&quot;Humanoid&quot;)
&#9;&#9;if (human ~= nil) then
&#9;&#9;&#9;hit.Parent:remove()
&#9;&#9;end
&#9;end
end

connection = script.Parent.Touched:connect(RemoveHat)
</ProtectedString>
