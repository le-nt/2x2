			<Item class="Script" referent="RBX4213">
				<Properties>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">ToolScript</string>
					<ProtectedString name="Source">bin = script.Parent
backpack = bin.Parent
player = backpack.Parent

tools = {}
currentTool = 0

function onButton1Down(mouse)
&#9;if #tools == 0 then
&#9;&#9;print(&quot;ERROR:  No Tools.&quot;)
&#9;&#9;return
&#9;end
&#9;if currentTool ~= #tools then
&#9;&#9;currentTool = currentTool + 1
&#9;else
&#9;&#9;currentTool = 1
&#9;end
&#9;if not tools[currentTool] then
&#9;&#9;print(&quot;ERROR:  Tool not found.&quot;)
&#9;end
&#9;previousTool = currentTool - 1
&#9;if previousTool == 0 then
&#9;&#9;previousTool = #tools
&#9;end
&#9;--[[if tools[previousTool] then
&#9;&#9;if tools[previousTool].Parent == backpack then
&#9;&#9;&#9;tools[previousTool].Parent = bin
&#9;&#9;else
&#9;&#9;&#9;print(&quot;ERROR:  Previous tool already in bin.&quot;)
&#9;&#9;end
&#9;else
&#9;&#9;print(&quot;ERROR:  Previous tool not found&quot;)
&#9;end]]
&#9;local c = backpack:GetChildren()
&#9;for i = 1, #c do
&#9;&#9;for n = 1, #tools do
&#9;&#9;&#9;if string.sub(tools[n].Name,1,4) == string.sub(c[i].Name,1,4) then
&#9;&#9;&#9;&#9;c[i].Parent = nil
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;tools[currentTool]:Clone().Parent = backpack
end

function onSelected(mouse)
&#9;local c = bin:GetChildren()
&#9;for i = 1, #c do
&#9;&#9;if c[i].className == &quot;HopperBin&quot; or c[i].className == &quot;Tool&quot; then
&#9;&#9;&#9;table.insert(tools, c[i])
&#9;&#9;end
&#9;end
&#9;mouse.Button1Down:connect(onButton1Down)
end

bin.Selected:connect(onSelected)</ProtectedString>
				</Properties>
			</Item>
			<Item class="HopperBin" referent="RBX4214">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Balefire</string>
					<Content name="TextureId"><null></null></Content>
				</Properties>
				<Item class="Script" referent="RBX4215">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">print(&quot;Balefire Spell Loaded&quot;) 

local COOLDOWN = 000.1

bin = script.Parent 


function balefire(pos) 

local player = game.Players.LocalPlayer 
if player == nil or player.Character == nil then return end 

local char = player.Character.Torso 

dir = (pos - char.CFrame.p).unit 

for i = 1, 50 do 
local ex = Instance.new(&quot;Explosion&quot;) 
ex.BlastRadius = 3 
ex.BlastPressure = 8000000 
ex.Position = char.CFrame.p + (dir * 6 * i) + (dir * 7) 
ex.Parent = game.Workspace 
end 

end 


enabled = true 
function onButton1Down(mouse) 
if not enabled then 
return 
end 

local player = game.Players.LocalPlayer 
if player == nil then return end 



enabled = false 
mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot; 

-- find the best cf 
local cf = mouse.Hit 
local v = cf.lookVector 

balefire(cf.p) 

wait(COOLDOWN) 
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
enabled = true 

end 

function onSelected(mouse) 
mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot; 
mouse.Button1Down:connect(function() onButton1Down(mouse) end) 
