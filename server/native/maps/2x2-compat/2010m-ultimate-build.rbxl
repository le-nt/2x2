						<string name="Name">ToolScript</string>
						<ProtectedString name="Source">bin = script.Parent
backpack = bin.Parent
player = backpack.Parent

tools = {}
currentTool = 0

function onButton1Down(mouse)
&#9;if #tools == 0 then
&#9;&#9;print(&quot;ERROR:  No Tools.&quot;)
&#9;&#9;return
&#9;end
&#9;if currentTool ~= #tools then
&#9;&#9;currentTool = currentTool + 1
&#9;else
&#9;&#9;currentTool = 1
&#9;end
&#9;if not tools[currentTool] then
&#9;&#9;print(&quot;ERROR:  Tool not found.&quot;)
&#9;end
&#9;previousTool = currentTool - 1
&#9;if previousTool == 0 then
&#9;&#9;previousTool = #tools
&#9;end
&#9;--[[if tools[previousTool] then
&#9;&#9;if tools[previousTool].Parent == backpack then
&#9;&#9;&#9;tools[previousTool].Parent = bin
&#9;&#9;else
&#9;&#9;&#9;print(&quot;ERROR:  Previous tool already in bin.&quot;)
&#9;&#9;end
&#9;else
&#9;&#9;print(&quot;ERROR:  Previous tool not found&quot;)
&#9;end]]
&#9;local c = backpack:GetChildren()
&#9;for i = 1, #c do
&#9;&#9;for n = 1, #tools do
&#9;&#9;&#9;if string.sub(tools[n].Name,1,4) == string.sub(c[i].Name,1,4) then
&#9;&#9;&#9;&#9;c[i].Parent = nil
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;tools[currentTool]:Clone().Parent = backpack
end

function onSelected(mouse)
&#9;local c = bin:GetChildren()
&#9;for i = 1, #c do
&#9;&#9;if c[i].className == &quot;HopperBin&quot; or c[i].className == &quot;Tool&quot; then
&#9;&#9;&#9;table.insert(tools, c[i])
&#9;&#9;end
&#9;end
&#9;mouse.Button1Down:connect(onButton1Down)
end

bin.Selected:connect(onSelected)</ProtectedString>
