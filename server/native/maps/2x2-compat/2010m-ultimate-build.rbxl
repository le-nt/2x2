							<ProtectedString name="Source">print (&quot;VIP T-Shirt Door Script Loaded&quot;)

permission = { &quot;B0BBA&quot;,&quot;Sarren&quot;,&quot;xxxxAhrimxxx&quot;,&quot;Czechtech&quot; }

texture = &quot;rbxasset://../../../shareddata/assets/6256477&quot;

function checkOkToLetIn(name) 
&#9;for i = 1,#permission do 
&#9;&#9;if (string.upper(name) == string.upper(permission[i])) then return true end 
&#9;end 
&#9;return false 
end 

function onTouched(hit) 
&#9;print(&quot;Door Hit&quot;) 
&#9;local human = hit.Parent:findFirstChild(&quot;Humanoid&quot;) 
&#9;if (human ~= nil ) then 
&#9;&#9;if human.Parent.Torso.roblox.Texture == texture then
&#9;&#9;human.Parent.Torso.CFrame = script.Parent.Parent:findFirstChild(&quot;Tele Exit&quot;).Head.CFrame + Vector3.new(0,3,0)
&#9;&#9;elseif (checkOkToLetIn(human.Parent.Name)) then
&#9;&#9;human.Parent.Torso.CFrame = script.Parent.Parent:findFirstChild(&quot;Tele Exit&quot;).Head.CFrame + Vector3.new(0,3,0)
&#9;&#9;else human.Health = 0
&#9;&#9;end 
&#9;end 
end 

script.Parent.Head.Touched:connect(onTouched)
</ProtectedString>
