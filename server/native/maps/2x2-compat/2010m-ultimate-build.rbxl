						<ProtectedString name="Source">--B0BBA, http://www.roblox.com/Item.aspx?ID=3354216

bin = script.Parent
player = game.Players.LocalPlayer

function onButton1Down(mouse)

&#9;if player == nil then return end
&#9;if player.Character.Humanoid.WalkSpeed~=250 then
&#9;player.Character.Humanoid.WalkSpeed=250
&#9;script.Parent.Name = &quot;Walk&quot;
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;else
&#9;player.Character.Humanoid.WalkSpeed=16
&#9;script.Parent.Name = &quot;Run&quot;
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;end
end

function onSelected(mouse)&#9;
&#9;if player.Character.Humanoid.WalkSpeed~=16 then
&#9;script.Parent.Name = &quot;Walk&quot;
&#9;else
&#9;script.Parent.Name = &quot;Run&quot;
&#9;end
&#9;mouse.Icon = &quot;rbxasset://textures\\ArrowCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end

function onDeS(mouse) 
script.Parent.Name = &quot;SuperSpeed&quot;
end 
script.Parent.Deselected:connect(onDeS)

bin.Selected:connect(onSelected)

