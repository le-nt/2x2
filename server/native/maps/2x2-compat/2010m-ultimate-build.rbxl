							<ProtectedString name="Source">clicked = false

local button1 = Instance.new(&quot;TextButton&quot;)
button1.Name = &quot;Yes&quot;
button1.Text = &quot;Yes&quot;
button1.Size = UDim2.new(1,0,1,0)
