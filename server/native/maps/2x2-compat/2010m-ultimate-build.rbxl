						<string name="Name">Script</string>
						<ProtectedString name="Source">-- zipperipper&apos;s script
Bin = script.Parent

mode = &quot;free&quot;


function onKeyDown(key) -- key functions

&#9;if (key~=nil) then



&#9;&#9;if (key==&quot;z&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Red&quot;

&#9;&#9;&#9;Bin.Name = &quot;Red&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;x&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Blue&quot;

&#9;&#9;&#9;Bin.Name = &quot;Blue&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;c&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Green&quot;

&#9;&#9;&#9;Bin.Name = &quot;Green&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;v&quot;) then -- mode button
&#9;&#9;&#9;mode = &quot;Yellow&quot;

&#9;&#9;&#9;Bin.Name = &quot;Yellow&quot;

&#9;&#9;end


&#9;&#9;if (key==&quot;b&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Purple&quot;

&#9;&#9;&#9;Bin.Name = &quot;Purple&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;n&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Black&quot;

&#9;&#9;&#9;Bin.Name = &quot;Black&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;m&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;White&quot;

&#9;&#9;&#9;Bin.Name = &quot;White&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;k&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Orange&quot;

&#9;&#9;&#9;Bin.Name = &quot;Orange&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;l&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Grey&quot;

&#9;&#9;&#9;Bin.Name = &quot;Grey&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;j&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Brown&quot;

&#9;&#9;&#9;Bin.Name = &quot;Brown&quot;

&#9;&#9;end



&#9;&#9;if (key==&quot;h&quot;) then -- mode button

&#9;&#9;&#9;mode = &quot;Pink&quot;

&#9;&#9;&#9;Bin.Name = &quot;Pink&quot;

&#9;&#9;end





&#9;end

end







function onButton1Down(mouse)

&#9;mt = mouse.Target

&#9;mts = mt.Size&#9;if mt.Locked == false then

&#9;&#9;if mode == &quot;Red&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(21)

&#9;&#9;end



&#9;&#9;if mode == &quot;Blue&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(23)

&#9;&#9;end



&#9;&#9;if mode == &quot;Green&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(37)

&#9;&#9;end



&#9;&#9;if mode == &quot;Yellow&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(24)

&#9;&#9;end



&#9;&#9;if mode == &quot;Purple&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(104)

&#9;&#9;end



&#9;&#9;if mode == &quot;Black&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(26)

&#9;&#9;end



&#9;&#9;if mode == &quot;White&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(1)

&#9;&#9;end



&#9;&#9;if mode == &quot;Orange&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(105)

&#9;&#9;end



&#9;&#9;if mode == &quot;Grey&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(194)

&#9;&#9;end

&#9;&#9;if mode == &quot;Brown&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(38)

&#9;&#9;end


&#9;&#9;if mode == &quot;Pink&quot; then

&#9;&#9;&#9;mt.BrickColor = BrickColor.new(9)

&#9;&#9;end

&#9;end

end




function onSelected(mouse)
&#9; --b = Instance.new(&quot;Message&quot;)
             --  b.Parent = script.Parent.Parent.Parent
             --  b.Text = &quot;Color tool&quot;
     
        h = Instance.new(&quot;Hint&quot;)
               h.Parent = script.Parent.Parent.Parent
               h.Text = &quot;press z, x, c, v, b, n, m, h, j, k or l to change color mode&quot; 
               h.Name = &quot;Hint&quot;
&#9;if mode~=&quot;free&quot; then
&#9;script.Parent.Name = mode
&#9;end

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)

end

function onDeS(mouse) 
script.Parent.Parent.Parent.Hint:remove()
script.Parent.Name = &quot;ColorTool&quot;
--script.Parent.Parent.Parent.Message:remove() 
end 
script.Parent.Deselected:connect(onDeS)
Bin.Selected:connect(onSelected)



</ProtectedString>
