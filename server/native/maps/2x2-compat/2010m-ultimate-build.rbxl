function Kick()
t = script.Parent.Parent.Value.Value:findFirstChild(&quot;Torso&quot;)
if t ~= nil then
t.CFrame = CFrame.new(0,10,0)
wait(0.1)
t.Anchored = true
end
wait(1)
script.Parent.Parent.Value.Value:Remove()
script.Parent.Parent:Remove()
end
