								<string name="Name">Script</string>
								<ProtectedString name="Source">Bin = script.Parent
Power = script.Parent.Power

while true do
if script.Parent.Velocity ~= script.Parent.CFrame.lookVector *(Power.Value) then
script.Parent.Velocity = script.Parent.CFrame.lookVector *(Power.Value)
end
wait(0.1)
end
</ProtectedString>
