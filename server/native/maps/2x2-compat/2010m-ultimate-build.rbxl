		<Item class="Script" referent="RBX4545">
			<Properties>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">tool = Instance.new(&quot;HopperBin&quot;)
tool.Name = &quot;Fighter&quot;
clone = script.Script:Clone()
clone.Disabled = false
clone.Parent = tool
tooltip = script.WarshipTooltip

function OnChildAdded(child)
script.Parent.Parent = game.Players:getPlayerFromCharacter(child.Part1.Parent).Character
tool:Clone().Parent = game.Players:getPlayerFromCharacter(child.Part1.Parent).Backpack
tooltip:Clone().Parent = game.Players:getPlayerFromCharacter(child.Part1.Parent).PlayerGui
end
script.Parent.Cockpit.Seat.ChildAdded:connect(OnChildAdded)

function OnChildRemoved(child)
script.Parent.Parent = Workspace
game.Players:getPlayerFromCharacter(child.Part1.Parent).Backpack.Fighter:Remove()
game.Players:getPlayerFromCharacter(child.Part1.Parent).playerGui.WarshipTooltip:Remove()
script.Parent.Cockpit.Engine.BodyPosition.maxForce = Vector3.new(0,0,0)
end
script.Parent.Cockpit.Seat.ChildRemoved:connect(OnChildRemoved)</ProtectedString>
