			<Item class="HopperBin" referent="RBX2716">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Anchor</string>
					<Content name="TextureId"><null></null></Content>
				</Properties>
				<Item class="Script" referent="RBX2717">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onMove(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.Locked==true then script.Parent.Parent.Parent.Message.Text = &quot;Brick Is Locked!&quot; return end
if targ.Anchored == true then
script.Parent.Parent.Parent.Message.Text = &quot;Brick Is Anchored&quot;
else
script.Parent.Parent.Parent.Message.Text = &quot;Brick Isn&apos;t Anchored&quot;
end
end

function onButton1Down(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.Locked == true then return end
if targ.Anchored == true then
targ.Velocity = Vector3.new(0,0,0)
targ.RotVelocity = Vector3.new(0,0,0)
targ.Anchored = false
local v = targ.Transparency
targ.Transparency = 1
wait(0.1)
targ.Transparency = v
else
targ.Velocity = Vector3.new(0,0,0)
targ.RotVelocity = Vector3.new(0,0,0)
targ.Anchored = true
local v = targ.Transparency
targ.Transparency = 1
wait(0.1)
targ.Transparency = v
end
end

function onS(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
Instance.new(&quot;Hint&quot;).Parent = script.Parent.Parent.Parent
mouse.Move:connect(function() onMove(mouse) end)
end
script.Parent.Selected:connect(onS)

function onUnS(mouse)
script.Parent.Parent.Parent.Message:Remove()
end
script.Parent.Deselected:connect(onUnS)</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="HopperBin" referent="RBX2718">
				<Properties>
					<bool name="Active">false</bool>
					<token name="BinType">0</token>
					<string name="Name">Program</string>
					<Content name="TextureId"><null></null></Content>
				</Properties>
				<Item class="Script" referent="RBX2719">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Tool Script</string>
						<ProtectedString name="Source">m = Instance.new(&quot;Message&quot;)
mode = 0
speed = 20
torque = 10
function Selected(mouse)
funny = 1
m.Parent = script.Parent.Parent.Parent
message()
Bin = script.Parent
Player = Bin.Parent.Parent.Character
print(&quot;Selected&quot;)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function message()
if mode == 0 then
m.Text = &quot;Press Q or E to change modes&quot;
end
if mode == 1 then
m.Text = &quot;Use Z or X to change MaxSpeed&quot;
end
if mode == 2 then
m.Text = &quot;Use Z or X to change Torque&quot;
end
end

function onKeyDown(key)
if (key~=nil) then
if ((key == &quot;q&quot;)) then
if mode == 0 then mode = 2 message() return end
if mode == 2 then mode = 1 message() return end
if mode == 1 then mode = 2 message() return end
end
if ((key == &quot;e&quot;)) then
if mode == 2 then mode = 1 message() return end
if mode == 1 then mode = 2 message() return end
if mode == 0 then mode = 2 message() return end
end
if ((key == &quot;x&quot;)) then
if mode == 1 then
speed = speed - 5
m.Text = &quot;Max Speed:&quot;..speed
end
if mode == 2 then
torque = torque - 5
m.Text = &quot;Max Torque:&quot;..torque
end
end
if ((key == &quot;z&quot;)) then
if mode == 1 then
speed = speed + 5
m.Text = &quot;Max Speed:&quot;..speed
end
if mode == 2 then
torque = torque + 5
m.Text = &quot;Max Torque:&quot;..torque
end
end
end
end

function onButton1Down(mouse)
if mouse.Target.className == &quot;VehicleSeat&quot; then
mouse.Target.MaxSpeed = speed
mouse.Target.Torque = torque
m.Text = &quot;VehicleSeat Changed&quot;
end
end

function onButton1Up(mouse)
end

function Deselected()
m.Parent = nil
print(&quot;Deselected&quot;)
end


script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
