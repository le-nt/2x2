						<string name="Name">Script</string>
						<ProtectedString name="Source">Bin = script.Parent
function onKeyDown(key)
&#9;if (key~=nil) then
&#9;&#9;if (key==&quot;q&quot;) then
&#9;&#9;&#9;if Bin.Value2.Value &gt;= 10 then return end
&#9;&#9;Bin.Value.Value = Bin.Value.Value + 0.1
&#9;&#9;Bin.Value2.Value = Bin.Value2.Value + 1
&#9;&#9;Bin.Parent.Parent.Message2.Text = Bin.Value.Value
&#9;&#9;end
&#9;&#9;if (key==&quot;e&quot;) then
&#9;&#9;&#9;if Bin.Value2.Value &lt;= -0 then return end
&#9;&#9;Bin.Value.Value = Bin.Value.Value - 0.1
&#9;&#9;Bin.Value2.Value = Bin.Value2.Value - 1
&#9;&#9;Bin.Parent.Parent.Message2.Text = Bin.Value.Value
&#9;&#9;end
&#9;end
end

function onMove(mouse)
targ = mouse.Target
if targ==nil then return end
script.Parent.Parent.Parent.Message.Text = &quot;Click To change Transparency&quot;
end

function onButton1Down(mouse)
targ = mouse.Target
if targ==nil then return end
if targ.Name ~= (&quot;Smooth Block Model&quot;) then
script.Parent.Parent.Parent.Message.Text = &quot;Your not supposed to change that!&quot;
return end
if targ.Locked == true then
script.Parent.Parent.Parent.Message.Text = &quot;That Brick is locked!&quot;
return end
if targ.Locked ~= true then targ.Transparency = Bin.Value.Value
end
end

function onS(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
Instance.new(&quot;Hint&quot;).Parent = script.Parent.Parent.Parent
mouse.Move:connect(function() onMove(mouse) end)
end
script.Parent.Selected:connect(onS)

function onSelected(mouse)

&#9;b = Instance.new(&quot;Message&quot;)
&#9;b.Parent = script.Parent.Parent.Parent
&#9;b.Text = Bin.Value.Value
&#9;b.Name = &quot;Message2&quot;

        h = Instance.new(&quot;Hint&quot;)
               h.Parent = script.Parent.Parent.Parent
               h.Text = &quot;press q or e to change the transparency value&quot; 
               h.Name = &quot;Hint&quot;
&#9;wait (2)
&#9;h:Remove()

&#9;mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
&#9;mouse.KeyDown:connect(onKeyDown)

end

function onUnS(mouse)
script.Parent.Parent.Parent.Message:Remove()
script.Parent.Parent.Parent.Message2:Remove()
end
script.Parent.Deselected:connect(onUnS)
Bin.Selected:connect(onSelected)



