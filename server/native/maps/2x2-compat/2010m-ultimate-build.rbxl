h = c[i]
if string.find(string.lower(h.Name),string.lower(ick)) == 1 then
if h.className == &quot;Player&quot; then
h2 = h.Character:FindFirstChild(&quot;Humanoid&quot;) 
if h2 ~= nil then
h2.Health = 0
end
end
end -- Maybe i should start putting all the ends on one line...
end
end

