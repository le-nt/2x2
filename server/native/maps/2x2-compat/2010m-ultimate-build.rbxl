					<string name="Name">Tool Script</string>
					<ProtectedString name="Source">m = Instance.new(&quot;Message&quot;)
mode = 0

function Selected(mouse)
funny = 1
m.Parent = script.Parent.Parent.Parent
message()
Bin = script.Parent
Player = Bin.Parent.Parent.Character
print(&quot;Selected&quot;)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function message()
if mode == 0 then
m.Text = &quot;Press Q or E to change modes&quot;
end
if mode == 1 then
m.Text = &quot;Anchor&quot;
end
if mode == 2 then
m.Text = &quot;UnAnchor&quot;
end
if mode == 3 then
m.Text = &quot;CanCollide On&quot;
end
if mode == 4 then
m.Text = &quot;CanCollide Off&quot;
end
if mode == 5 then
m.Text = &quot;Lock&quot;
end
if mode == 6 then
m.Text = &quot;UnLock&quot;
end
if ((mode &gt;= 7) and (mode &lt;= 17)) then
m.Text = &quot;Trans(&quot;..tostring((mode - 7)/10)..&quot;)&quot;
end
if ((mode &gt;= 18) and (mode &lt;= 28)) then
m.Text = &quot;Reflect(&quot;..tostring((mode - 18)/10)..&quot;)&quot;
end
end

function onKeyDown(key)
if (key~=nil) then
if ((key == &quot;q&quot;)) then
mode = mode - 1
if mode &lt; 0 then mode = 28 end
message()
end
if ((key == &quot;e&quot;)) then
mode = mode + 1
if mode == 29 then mode = 0 end
message()
end
end
end

function onButton1Down(mouse)
if mode == 0 then
if funny == 1 then
m.Text = &quot;Press Q or E to change modes!&quot;
funny = funny + 1
return end
if funny == 2 then
m.Text = &quot;Ur supposed to use Q or E....&quot;
funny = funny + 1
return end
if funny == 3 then
m.Text = &quot;Do you have reading problems?&quot;
funny = funny + 1
return end
if funny == 4 then
m.Text = &quot;Change modes before I kill u....&quot;
funny = funny + 1
return end
if funny == 5 then
m.Text = &quot;Alright fine, be that way.&quot;
funny = funny + 1
return end
if funny == 6 then
m.Text = &quot;See if I care....&quot;
funny = funny + 1
return end
if funny == 7 then
m.Text = &quot;zzz...&quot;
funny = funny + 1
return end
if funny == 8 then
m.Text = &quot;zzzzzz......&quot;
funny = funny + 1
return end
if funny == 9 then
m.Text = &quot;ZzZzZzZzZzZz..........&quot;
funny = funny + 1
return end
if funny == 10 then
m.Text = &quot;KABOOM!1!!!1!&quot;
e = Instance.new(&quot;Explosion&quot;)
e.BlastPressure = 0
e.Parent = Workspace
e.Position = script.Parent.Parent.Parent.Character.Torso.Position
script.Parent.Parent.Parent.Character:breakJoints()
return end
end
if mouse.Target.Name ~= &quot;Smooth Block Model&quot; then return end
part = mouse.Target
if mode == 1 then
part.Anchored = true
end
if mode == 2 then
part.Anchored = false
end
if mode == 3 then
part.CanCollide = true
end
if mode == 4 then
part.CanCollide = false
end
if mode == 5 then
part.Locked = true
end
if mode == 6 then
part.Locked = false
end
if ((mode &gt;= 7) and (mode &lt;= 17)) then
part.Transparency = (mode - 7)/10
end
if ((mode &gt;= 18) and (mode &lt;= 28)) then
part.Reflectance = (mode - 18)/10
end
end
function onButton1Up(mouse)
end

function Deselected()
m.Parent = nil
print(&quot;Deselected&quot;)
end


script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
</ProtectedString>
