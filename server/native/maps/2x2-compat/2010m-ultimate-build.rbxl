&#9;local stats = Instance.new(&quot;IntValue&quot;)
&#9;stats.Name = &quot;leaderstats&quot;
&#9;
&#9;local deletes = Instance.new(&quot;IntValue&quot;)
&#9;deletes.Name = &quot;Deletes&quot;
&#9;deletes.Value = 0
&#9;deletes.Parent = stats

&#9;stats.Parent = newPlayer

end



