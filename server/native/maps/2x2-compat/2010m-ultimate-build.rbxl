							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouched(part)
        p = game.Players:playerFromCharacter(part.Parent)
        if p == nil then return end
&#9;if part.Parent.Name == &quot;B0BBA&quot; then
&#9;tool = game.Lighting.VVIP:Clone()
&#9;if p.Backpack:findFirstChild(tool.Name) ~= nil then return end
&#9;tool.Parent = p.Backpack
&#9;else
&#9;gun = game.Lighting.VIP:clone()
        if p.Backpack:findFirstChild(gun.Name) ~= nil then return end
        gun.Parent = p.Backpack
&#9;end
end

script.Parent.Touched:connect(onTouched)
</ProtectedString>
