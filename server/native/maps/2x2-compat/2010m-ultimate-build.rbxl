			<Item class="Script" referent="RBX4555">
				<Properties>
					<bool name="Disabled">true</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">fly = false
hyperdrive = false

function getPlane()
player = script.Parent.Parent.Parent.Character
&#9;if player:findFirstChild(&quot;Warship&quot;) ~= nil then
&#9;&#9;if player[&quot;Warship&quot;]:FindFirstChild(&quot;Cockpit&quot;) ~= nil then
&#9;&#9;&#9;if player[&quot;Warship&quot;].Cockpit:findFirstChild(&quot;Engine&quot;) ~= nil then
&#9;&#9;&#9;&#9;if player[&quot;Warship&quot;].Cockpit.Engine:findFirstChild(&quot;BodyPosition&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;if player[&quot;Warship&quot;].Cockpit.Engine:findFirstChild(&quot;BodyGyro&quot;) ~= nil then
&#9;&#9;&#9;&#9;&#9;&#9;return true
&#9;&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;&#9;end
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function ignite()
&#9;for i = 1,4 do
&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Enabled = true
&#9;end
end

function extinguish()
&#9;for i = 1,4 do
&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Enabled = false
&#9;end
end


function Selected(mouse)
mouse.Button1Down:connect(function() onButton1Down(mouse) end)
mouse.Button1Up:connect(function() onButton1Up(mouse) end)
mouse.KeyDown:connect(onKeyDown)
end

function onKeyDown(key)
&#9;if key == &quot;y&quot; then
&#9;&#9;if getPlane() then
&#9;&#9;ignite()
&#9;&#9;bp = player[&quot;Warship&quot;].Cockpit.Engine.BodyPosition
&#9;&#9;bp.maxForce = Vector3.new(1,1,1) * 10000000
&#9;&#9;bg = player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro
&#9;&#9;bg.maxTorque = Vector3.new(1,1,1) * math.huge
&#9;&#9;player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro.cframe = CFrame.new(player[&quot;Warship&quot;].Cockpit.Engine.Position,player[&quot;Warship&quot;].Cockpit.Engine.Position + player[&quot;Warship&quot;].Cockpit.Engine.CFrame.lookVector)
&#9;&#9;end
&#9;end

&#9;if key == &quot;x&quot; then
&#9;&#9;if getPlane() then
&#9;&#9;extinguish()
&#9;&#9;bp = player[&quot;Warship&quot;].Cockpit.Engine.BodyPosition
&#9;&#9;bp.maxForce = Vector3.new(0,0,0)
&#9;&#9;bg = player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro
&#9;&#9;bg.maxTorque = Vector3.new(0,0,0)
&#9;&#9;end
&#9;end

&#9;if key == &quot;f&quot; then
&#9;&#9;if getPlane() then
&#9;&#9;&#9;for i = 1,2 do
&#9;&#9;&#9;if i == 1 then gun = player[&quot;Warship&quot;][&quot;Right Wing&quot;][&quot;Missile0&quot;] else gun = player[&quot;Warship&quot;][&quot;Left Wing&quot;][&quot;Missile0&quot;] end
&#9;&#9;&#9;missle = Instance.new(&quot;Part&quot;)
&#9;&#9;&#9;missle.size = Vector3.new(1,2,10)
&#9;&#9;&#9;missle.CFrame = gun.CFrame
&#9;&#9;&#9;missle.Velocity = missle.CFrame.lookVector * 1000
&#9;&#9;&#9;missle.CanCollide = false
&#9;&#9;&#9;v = Instance.new(&quot;BodyVelocity&quot;)
&#9;&#9;&#9;v.velocity = missle.Velocity
&#9;&#9;&#9;v.Parent = missle
&#9;&#9;&#9;script.MissleMesh:Clone().Parent = missle
&#9;&#9;&#9;missle.Parent = player[&quot;Warship&quot;]
&#9;&#9;&#9;clone = script.Explosion:Clone()
&#9;&#9;&#9;clone.Disabled = false
&#9;&#9;&#9;v = Instance.new(&quot;ObjectValue&quot;)
&#9;&#9;&#9;v.Value = script.Parent.Parent.Parent.Character
&#9;&#9;&#9;v.Parent = clone
&#9;&#9;&#9;clone.Parent = missle
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end

&#9;if key == &quot;h&quot; then
&#9;&#9;if hyperdrive == false then
&#9;&#9;&#9;hyperdrive = true
&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Engine&quot;][&quot;Speed&quot;].Value = 1000
&#9;&#9;&#9;for i = 1,4 do
&#9;&#9;&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Color = Color3.new(255, 128, 0)
&#9;&#9;&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.SecondaryColor = Color3.new(255, 0, 0)
&#9;&#9;&#9;end
&#9;&#9;else
&#9;&#9;&#9;hyperdrive = false
&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Engine&quot;][&quot;Speed&quot;].Value = 20
&#9;&#9;&#9;for i = 1,4 do
&#9;&#9;&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.Color = Color3.new(0, 0, 255)
&#9;&#9;&#9;&#9;player[&quot;Warship&quot;][&quot;Cockpit&quot;][&quot;Fire&quot;..i].Fire.SecondaryColor = Color3.new(0, 255, 0)
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
end

function onButton1Down(mouse)
if getPlane() ~= true then return end
click = true
repeat
wait()
player[&quot;Warship&quot;].Cockpit.Engine.BodyGyro.cframe = CFrame.new(player[&quot;Warship&quot;].Cockpit.Engine.Position,mouse.hit.p)
until click == false
end

function onButton1Up(mouse)
click = false
end

function Deselected()
click = false
end


script.Parent.Selected:connect(Selected)
script.Parent.Deselected:connect(Deselected)
