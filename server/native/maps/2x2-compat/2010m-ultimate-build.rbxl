				<Item class="Script" referent="RBX4261">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">OnEquiped</string>
						<ProtectedString name="Source">Tool = script.Parent
print(&quot;Welding...&quot;)

function Weldnow()
&#9;local w1 = Instance.new(&quot;Weld&quot;)
&#9;w1.Parent = Tool.Handle
&#9;w1.Part0 = w1.Parent
&#9;w1.Part1 = Tool.SPos
&#9;w1.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(-1, 0.5, 0)
&#9;Tool.SPos.CanCollide = false
end

Tool.Equipped:connect(Weldnow)
Tool.Unequipped:connect(Weldnow)
</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4262">
					<Properties>
						<bool name="Disabled">true</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Paintball</string>
						<ProtectedString name="Source">ball = script.Parent
headdamage = 1000
torsodamage = math.random(50)
armdamage = math.random(25)
legdamage = math.random(30)



function onTouched(hit)
&#9;local humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;) or hit.Parent:findFirstChild(&quot;Zombie&quot;) or hit.Parent:findFirstChild(&quot;Alien&quot;)
&#9;

&#9;if hit.Name==&quot;Left Leg&quot; then 
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(legdamage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;end


&#9;if hit.Name==&quot;Leg Arm&quot; then 
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(legdamage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;end


&#9;if hit.Name==&quot;Left Arm&quot; then 
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(armdamage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;end


&#9;if hit.Name==&quot;Right Arm&quot; then 
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(armdamage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;end


&#9;if hit.Name==&quot;Torso&quot; then 
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(torsodamage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;end


&#9;if hit.Name==&quot;Head&quot; then 
&#9;&#9;tagHumanoid(humanoid)
&#9;&#9;humanoid:TakeDamage(headdamage)
&#9;&#9;wait(2)
&#9;&#9;untagHumanoid(humanoid)
&#9;end


&#9;connection:disconnect()
&#9;ball.Parent = nil
end

function tagHumanoid(humanoid)
&#9;-- todo: make tag expire
&#9;local tag = ball:findFirstChild(&quot;creator&quot;)
&#9;if tag ~= nil then
&#9;&#9;local new_tag = tag:clone()
&#9;&#9;new_tag.Parent = humanoid
&#9;end
end


function untagHumanoid(humanoid)
&#9;if humanoid ~= nil then
&#9;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)
&#9;&#9;if tag ~= nil then
&#9;&#9;&#9;tag.Parent = nil
&#9;&#9;end
&#9;end
end

connection = ball.Touched:connect(onTouched)

wait(4)
ball.Parent = nil</ProtectedString>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX4263">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PaintballShooter</string>
						<ProtectedString name="Source">Tool = script.Parent

colors = {26}

function fire(v)



&#9;Tool.Handle.Fire:play()
        Tool.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).CurrentAngle = 1.5

&#9;local vCharacter = Tool.Parent
&#9;local vPlayer = game.Players:playerFromCharacter(vCharacter)

&#9;local missile = Instance.new(&quot;Part&quot;)
&#9;local p = script.Parent.SPos:clone()

        

&#9;local spawnPos = vCharacter.PrimaryPart.Position
&#9;


&#9;spawnPos  = spawnPos + (v * 8)

&#9;missile.Position = spawnPos
&#9;missile.Size = Vector3.new(1,1,1)
&#9;missile.Velocity = v * 600
&#9;missile.BrickColor = BrickColor.new(colors[math.random(1, #colors)])
&#9;missile.Shape = 0
&#9;missile.BottomSurface = 0
&#9;missile.TopSurface = 0
&#9;missile.Name = &quot;Paintball&quot;
&#9;missile.Elasticity = 0
&#9;missile.Reflectance = 0
&#9;missile.Friction = .3

&#9;local force = Instance.new(&quot;BodyForce&quot;)
&#9;force.force = Vector3.new(math.random(-10, 10),math.random(90, 110),math.random(-10, 10))
&#9;force.Parent = missile
&#9;
&#9;Tool.BrickCleanup:clone().Parent = missile

