					<Item class="Script" referent="RBX2647">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ShieldPackGiver</string>
							<ProtectedString name="Source">function OnTouched(hit)
if hit.Parent:findFirstChild(&quot;Torso&quot;) ~= nil then
if hit.Parent:findFirstChild(&quot;ShieldPack&quot;) == nil then
p = Instance.new(&quot;Part&quot;)
--Apperance
p.BrickColor = BrickColor.new(&quot;Black&quot;)
p.Reflectance = 0
p.Transparency = 0
--Data
p.Name = &quot;ShieldPack&quot;
p.Parent = Workspace
--Behavior
p.Anchored = false
p.CanCollide = false
p.Locked = true
p.archivable = true
--Surface
p.BackSurface = &quot;Smooth&quot;
p.BottomSurface = &quot;Smooth&quot;
p.FrontSurface = &quot;Smooth&quot;
p.LeftSurface = &quot;Smooth&quot;
p.RightSurface = &quot;Smooth&quot;
p.TopSurface = &quot;Smooth&quot;
--Part
p.Elasticity = 0
p.Friction = 0
p.Shape = &quot;Block&quot;
p.Size = Vector3.new(2,2,1)
p.formFactor = &quot;Symmetric&quot;

c = Instance.new(&quot;ClickDetector&quot;)
c.Parent = p

o = Instance.new(&quot;ObjectValue&quot;)
o.Name = &quot;Player&quot;
o.Value = hit.Parent
o.Parent = p

s = script.Parent.Shield:Clone()
s.Disabled = false
s.Parent = p

local w = Instance.new(&quot;Weld&quot;) 
w.Parent = hit.Parent.Torso
w.Part0 = hit.Parent.Torso
w.Part1 = p
w.C0 = CFrame.new(0, 0.6, 1)*CFrame.new(0, -math.pi/5, 0) 

x = Instance.new(&quot;ObjectValue&quot;)
x.Name = &quot;ShieldPack&quot;
x.Parent = hit.Parent

end
end
end
script.Parent.Touched:connect(OnTouched)</ProtectedString>
