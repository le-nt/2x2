					<ProtectedString name="Source">local Tool = script.Parent

--game:GetService(&quot;InsertService&quot;):SetCollectionUrl(&quot;rbxasset://../../../shareddata/assets/&quot;)
--game:GetService(&quot;InsertService&quot;):SetBaseCategoryUrl(&quot;rbxasset://../../../shareddata/assets/&quot;)
