								<R12>0</R12>
								<R20>0</R20>
								<R21>0</R21>
								<R22>1</R22>
							</CoordinateFrame>
							<string name="Name">Plane</string>
							<Ref name="PrimaryPart">null</Ref>
						</Properties>
						<Item class="IntValue" referent="RBX728">
							<Properties>
								<string name="Name">PlaneCheck</string>
