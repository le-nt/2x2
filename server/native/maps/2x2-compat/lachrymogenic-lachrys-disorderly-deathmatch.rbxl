					<Item class="Script" referent="RBX1130">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">local weapon = &quot;Minigun&quot;
use = false
function onTouched(part)
	if use ~=true then
	if part.Parent == nil then return end
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if not h.Parent:findFirstChild(weapon) then
		if not game.Players:findFirstChild(h.Parent.Name).Backpack:findFirstChild(weapon) then
		local tool = game.Lighting.Tools.Minigun:Clone()
		tool.Parent = game.Players:findFirstChild(h.Parent.Name).Backpack
		script.Parent.Transparency = 1
		use = true
		wait(1)
		script.Parent.Transparency = 0
		use = false
	end
	end
	end
	end
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
