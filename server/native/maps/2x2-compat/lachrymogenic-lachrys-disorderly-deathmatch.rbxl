						<string name="Name">Script</string>
						<ProtectedString name="Source">local thrust2 = Instance.new(&quot;BodyVelocity&quot;)
local velocity = 300

function onTouched(part)
    h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	 if h then
	 script.Parent.Sound:Play()
	 wait(0.1)
    onStart()
    wait(1)
    onEnd()
end
end

function onStart()
	 thrust2.Name = &quot;JumpThrust&quot;
    thrust2.Parent = h.Parent.PrimaryPart
    thrust2.velocity = Vector3.new(0,velocity,0)
    thrust2.maxForce = Vector3.new(0,4e+003,0) 
end

function onEnd()
    thrust2.Parent = nil
end

