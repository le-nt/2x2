				<Item class="Script" referent="RBX2008">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local thrust = Instance.new(&quot;BodyVelocity&quot;)
local velocity = 200
use = false

function onTouched(part)
	 if use ~= true then
    h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	 if h then
	 use = true
	 script.Parent.Sound:Play()
	 wait(0.1)
    onStart()
    wait(1)
    onEnd()
	 use = false
end
end
end

function onStart()
    thrust.Parent = h.Parent.PrimaryPart
    thrust.velocity = Vector3.new(0,h.Parent.PrimaryPart.CFrame.LookVector * 50,0)
    thrust.maxForce = Vector3.new(0,4e+003,0) 
end

function onEnd()
		h.WalkSpeed = h.WalkSpeed / 2 --CustomWalkSpeed
end

script.Parent.Touched:connect(onTouched)</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
			</Item>
