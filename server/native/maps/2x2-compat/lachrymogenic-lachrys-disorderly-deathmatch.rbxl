				<ProtectedString name="Source">permission = {&quot;Lachrymogenic&quot;} --Place the admin&apos;s names here
Hub = game.Workspace.Hub
Message = Instance.new(&quot;Hint&quot;)
Message.Text = &quot;2 players are required for this game&quot;
Message.Parent = game.Workspace
starting = false
reqplayers = 2

function gameloop()

while true do
	if starting == false then
		if game.Players.NumPlayers &gt;= reqplayers then
			time = 20
			starting = true
			while time &gt; 0 do
				if game.Players.NumPlayers &lt; reqplayers then
					Message.Text = &quot;2 players are required for this game&quot;
					starting = false
					break
				end
				Message.Text = &quot;Starting in &quot; .. tostring(time) .. &quot; seconds...&quot;
				time = time - 1
				wait(1)
			end
			if starting == true then
				Message.Text = &quot;First one to 25 kills wins!&quot;
				startgame()
			end
	end
	
	end

	for i, v in pairs (game:GetService(&quot;Players&quot;):GetPlayers()) do
		if starting then
			if v.leaderstats.KOs.Value &gt;= 15 then
					endgame()
					Message.Text = v.Name .. &quot; wins! Game over!&quot;
					wait(5)
					starting = false
			end
		end
	end
	print(game.Players.NumPlayers)
	print(&quot;Testing&quot;)
	wait(1)
end

end

function startgame()

Maps = game.Lighting.Maps:GetChildren()
CurrentMap = Maps[math.random(1, #Maps)]
CurrentMap.Parent = game.Workspace
game.Workspace.Hub.SpawnLocation.Neutral = false
for i, v in pairs(CurrentMap.Spawnpoints:GetChildren()) do
	v.Neutral = true
end

Hub.Parent = game.Lighting.Lobby--game.Workspace.Hub.Parent = game.Lighting.Lobby

for i, v in pairs(game:GetService(&quot;Players&quot;):GetPlayers()) do
local pistol = game.Lighting.Tools.Pistol:Clone()
pistol.Parent = v.Backpack
end

local pistol = game.Lighting.Tools.Pistol:Clone()
pistol.Parent = game.StarterPack

CurrentMap.Sound:Play()

end

function endgame()
	print(&quot;ended&quot;)
	CurrentMap.Sound:Stop()
	CurrentMap.Parent = game.Lighting.Maps
	Hub.Parent = game.Workspace
	Hub.SpawnLocation.Neutral = true

	for i, v in pairs(CurrentMap.Spawnpoints:GetChildren()) do
		v.Neutral = false
	end

	for i, v in pairs(game.StarterPack:GetChildren()) do
		if v.Name ~= &quot;Leap&quot; then
			v.Parent = nil
		end
	end

	for i, v in pairs(game:GetService(&quot;Players&quot;):GetPlayers()) do
		v.leaderstats.KOs.Value = 0
		v.leaderstats.Deaths.Value = 0
		v.Character:FindFirstChild(&quot;Humanoid&quot;).Health = 0
	end
end

function checkIfAdmin(name)
	for i = 1,#permission do
		if (string.upper(name) == string.upper(permission[i])) then return true end
	end
	return false
end


function onChatted(msg, recipient, speaker) 
print(&quot;Chatted&quot;)

source = speaker.Name

	if (checkIfAdmin(source)) then
			if msg == &quot;!start&quot; then
				startgame()
			end
			if msg == &quot;!end&quot; then
				endgame()
			end
	end
end

function onPlayerEntered(newPlayer)
	newPlayer.Chatted:connect(function(msg, recipient) onChatted(msg, recipient, newPlayer) end) 
end

