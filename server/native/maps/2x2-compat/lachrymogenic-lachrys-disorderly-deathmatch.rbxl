enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end
	enabled = true
	script.Parent.Handle.Fire:Play()
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;

	--wait(.5)
