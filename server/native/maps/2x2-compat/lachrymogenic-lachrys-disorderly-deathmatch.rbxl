					<Item class="Script" referent="RBX1120">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Rotation</string>
							<ProtectedString name="Source">local part = script.Parent
     
    local incr = 360/50
     
    -- Rotate the part continually
    while true do
    	for deg = 0, 360, incr do
    		-- Set only the Y axis rotation
    		-- A better way to do this would be setting CFrame
    		part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, math.rad(deg), 0)
    		wait()
    	end
    end
</ProtectedString>
							<bool name="archivable">true</bool>
						</Properties>
					</Item>
