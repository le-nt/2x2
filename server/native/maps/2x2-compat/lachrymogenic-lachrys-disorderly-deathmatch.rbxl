				<Item class="Script" referent="RBX2066">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Rotation</string>
						<ProtectedString name="Source">local part = script.Parent
local part2 = script.Parent.Part
     
    local incr = 360/50
     
    -- Rotate the part continually
    while true do
    	for deg = 0, 360, incr do
    		-- Set only the Y axis rotation
    		-- A better way to do this would be setting CFrame
    		part.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, math.rad(deg), 0)
			part2.CFrame = CFrame.new(part.Position) * CFrame.Angles(0, math.rad(deg), 0)
    		wait()
    	end
    end
</ProtectedString>
						<bool name="archivable">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX2067">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local weapon = &quot;Shotgun&quot;
use = false
function onTouched(part)
	if use ~=true then
	if part.Parent == nil then return end
	h = part.Parent:findFirstChild(&quot;Humanoid&quot;)
	if h~=nil then
		if not h.Parent:findFirstChild(weapon) then
		if not game.Players:findFirstChild(h.Parent.Name).Backpack:findFirstChild(weapon) then
		local tool = game.Lighting.Tools.Shotgun:Clone()
		tool.Parent = game.Players:findFirstChild(h.Parent.Name).Backpack
		script.Parent.Part.Transparency = 1
		use = true
		wait(1)
		script.Parent.Part.Transparency = 0
		use = false
	end
	end
	end
	end
end

