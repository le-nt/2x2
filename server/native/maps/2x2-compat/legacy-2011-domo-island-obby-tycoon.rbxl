&#9;p.TopSurface = 0
&#9;p.Name = &quot;TycoonBrick&quot; --If you change this, make sure you change the name in the get script too (in the collect profits model)
&#9;p.Parent = script.Parent
end 


while true do
&#9;wait(2) --Alter Rate Of Drop
&#9;fire()
end
