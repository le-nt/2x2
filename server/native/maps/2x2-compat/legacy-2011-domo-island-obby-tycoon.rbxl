for i, v in ipairs(game.Players:GetChildren()) do
if v.Name:lower() == person:lower() then
for _, badge in ipairs (game.Players:GetChildren()) do
game:GetService(&quot;BadgeService&quot;):AwardBadge(badge.userId, badgeid)
end
end
