											<string name="Name">EngineScript</string>
											<ProtectedString name="Source">function OnF()
&#9;script.Parent.Engine.Pitch = (script.Parent.Parent.VehicleSeat.MaxSpeed / 10) + 2.5
&#9;script.Parent.Engine:play()
end

function OnB()
&#9;script.Parent.Engine.Pitch = -(script.Parent.Parent.VehicleSeat.MaxSpeed / 10) + 2.5
&#9;script.Parent.Engine:play()
end

function Off()
&#9;script.Parent.Engine:stop()
end

function Check()
&#9;if script.Parent.Parent.VehicleSeat.MaxSpeed &gt; 0 then
&#9;&#9;OnF()
&#9;elseif script.Parent.Parent.VehicleSeat.MaxSpeed &lt; 0 then
&#9;&#9;OnB()
&#9;elseif script.Parent.Parent.VehicleSeat.MaxSpeed == 0 then
&#9;&#9;Off()
&#9;end
end

script.Parent.Parent.VehicleSeat.Changed:connect(Check)
