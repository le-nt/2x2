			<Item class="Script" referent="RBX2210">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">extended = script.Parent.extended
function onclicked()
	if script.Parent.active.Value == true then
		if extended.Value == false then
			extended.Value = true
			return
		end
		if extended.Value == true then 
			extended.Value = false
			return
		end
	end
end
function onchanged()
	if extended.Value == false then 	
		script.Parent.mover.BodyPosition.position = Vector3.new(script.Parent.retract.Position.X,49.4,script.Parent.retract.Position.Z)
	else
		script.Parent.mover.BodyPosition.position = Vector3.new(script.Parent.out.Position.X,49.4,script.Parent.out.Position.Z)
	end
end
script.Parent.walkway.ClickDetector.MouseClick:connect(onclicked)
script.Parent.extended.Changed:connect(onchanged)
</ProtectedString>
