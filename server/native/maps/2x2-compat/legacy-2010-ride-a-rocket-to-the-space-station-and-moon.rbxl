				<Item class="Script" referent="RBX2189">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">motorscript</string>
						<ProtectedString name="Source">function doi()
while true do
	wait(10)
	parts = script.Parent.Parent:GetChildren() 
	for i =1,#parts do
		if parts[i].Name ~= &quot;motor&quot; and parts[i].Name ~= &quot;monorailbase&quot; and parts[i].Name ~= &quot;monoraillpad&quot; and (parts[i].Position - script.Parent.Position).Magnitude &gt; 30 then
			print(parts[i].Name)
			new = game.Lighting.monorail:Clone()
			script.Parent = workspace
			msg = Instance.new(&quot;Message&quot;)
			msg.Text = &quot;Monorail damaged - regenerating&quot;
			msg.Parent = workspace
			workspace.monorail:Remove()
			new.Parent = workspace
			new:MakeJoints()
			wait(3)
			msg:remove()
			workspace.motorscript:remove()			
			return
		end
	end
end
end

doi()			</ProtectedString>
					</Properties>
				</Item>
			</Item>
