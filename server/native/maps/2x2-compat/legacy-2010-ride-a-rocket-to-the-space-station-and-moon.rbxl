					</Properties>
				</Item>
				<Item class="StringValue" referent="RBX16351">
					<Properties>
						<bool name="Archivable">true</bool>
						<string name="Name">victim</string>
						<string name="Value"></string>
					</Properties>
				</Item>
				<Item class="BoolValue" referent="RBX16352">
					<Properties>
						<bool name="Archivable">true</bool>
						<string name="Name">buisy</string>
						<bool name="Value">false</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX16353">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function testageness()
	if script.Parent.refplayer.Value ~= &quot;Aerideyn&quot; then
		if script.Parent.victim.Value == &quot;Alec12317&quot; or script.Parent.victim.Value == &quot;Aerideyn&quot; then
			msg = Instance.new(&quot;Message&quot;)
			msg.Text = (&quot;This Players Admin cannot be removed&quot;)
			msg.Parent = script.Parent.refplayer.Value
			wait(2)
			msg:remove()
			return
		end
	end
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	wait(2)
	name = script.Parent.victim.Value
	if workspace.admins:FindFirstChild(name) ~= nil then
		name = script.Parent.victim.Value
		workspace.admins[name]:remove()
		msg = Instance.new (&quot;Message&quot;)
		msg.Text = (&quot;Your Admin Privliges have been removed by &quot; .. script.Parent.refplayer.Value)
		msg.Parent = game.Players[name]
		player = script.Parent.victim.Value
		p = game.Players:GetChildren()
		for i = 1,#p do
			name = p[i].Name
			if game.Players[player].PlayerGui.ScreenGui:FindFirstChild(name) ~= nil then
				game.Players[player].PlayerGui.ScreenGui[name]:remove()
			end
		end
		guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
		guis = game.Lighting.players:GetChildren()
		for i = 1,#guit do
			name = guit[i].Name
			for j =1,#guis do
				namer = guis[j].Name
				if name == namer then
				guit[i]:remove()
				end
			end
		end
		guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
		guis = game.Lighting.rocketguis:GetChildren()
		for i = 1,#guit do
			name = guit[i].Name
			for j =1,#guis do
				namer = guis[j].Name
				if name == namer then
				guit[i]:remove()
				end
			end
		end
		wait(1)
		msg:remove()
		if script.Parent ~= nil then
		script.Parent.buisy.Value = false
		end
	else
		name = script.Parent.victim.Value
		admin = Instance.new(&quot;StringValue&quot;)
		admin.Name = name
		admin.Value = name
		admin.Parent = workspace.admins
		msg = Instance.new (&quot;Message&quot;)
		msg.Text = (&quot;Your have been made an Admin by &quot; .. script.Parent.refplayer.Value)
		msg.Parent = game.Players[name]
		msg.Name = &quot;guimessage&quot;
		local button =  game.Lighting.players.Players:Clone()
		button.Parent = game.Players[name].PlayerGui.ScreenGui
		button.playername.Value = name
		local button =  game.Lighting.rocketguis.Rocketcontrols:Clone()
		button.Parent = game.Players[name].PlayerGui.ScreenGui
		button.playername.Value = name
		if workspace.vips:FindFirstChild(name) ~= nil then
			workspace.vips[name]:remove()
		end
		wait(1)
		msg:remove()
		script.Parent.buisy.Value = false
	end
	
end
