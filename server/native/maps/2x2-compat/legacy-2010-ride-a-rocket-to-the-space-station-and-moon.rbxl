							<X>2.5570001e-019</X>
							<Y>-0.156959996</Y>
							<Z>-1.85326869e-019</Z>
						</Vector3>
						<token name="shape">1</token>
						<Vector3 name="size">
							<X>1</X>
							<Y>1.20000005</Y>
							<Z>1</Z>
						</Vector3>
					</Properties>
				</Item>
			</Item>
			<Item class="StringValue" referent="RBX16515">
				<Properties>
					<bool name="Archivable">true</bool>
					<string name="Name">status</string>
					<string name="Value">spawned</string>
				</Properties>
			</Item>
			<Item class="Script" referent="RBX16516">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">list = {&quot;Titan&quot;,&quot;Enceladus&quot;,&quot;Tethys&quot;,&quot;Hyperion&quot;,&quot;Dione&quot;,&quot;Rhea&quot;,&quot;Mimas&quot;,&quot;Iapetus&quot;,&quot;Ijiraq&quot;,&quot;Kiviuq&quot;,&quot;Paaliaq&quot;,&quot;Siarnaq&quot;,&quot;Tarqeq&quot;,&quot;Albiorix&quot;,&quot;Bebhionn&quot;,&quot;Erriapus&quot;,&quot;Aegir&quot;,&quot;Bergelmir&quot;,&quot;Bestla&quot;,&quot;Farbauti&quot;,&quot;Fenrir&quot;,&quot;Fornjot&quot;,&quot;Greip&quot;,&quot;Hati&quot;,&quot;Hyrrokkin&quot;,&quot;Jarnsaxa&quot;,&quot;Kari&quot;,&quot;Loge&quot;,&quot;Mundilfari&quot;,&quot;Narvi&quot;,&quot;Phoebe&quot;,&quot;Skathi&quot;,&quot;Skoll&quot;,&quot;Surtur&quot;,&quot;Suttungr&quot;,&quot;Thrymr&quot;,&quot;Ymir&quot;}

for i = 1,#list do
	name = list[math.random(1,#list)]
	if workspace.rockets:FindFirstChild(name) == nil then
		script.Parent.Name = name
		break
	end
end


p = game.Players:GetPlayers()
for i,v in pairs(p) do
	if v.PlayerGui.ScreenGui.launchterminal.Visible == true then
		v.PlayerGui.ScreenGui.launchterminal.update.Value = true
	end
end

function updatestatus()	
	p = game.Players:GetPlayers()	
	for i,v in pairs(p) do
		if v.PlayerGui.ScreenGui.launchterminal.Visible == true then
			if v.PlayerGui.ScreenGui.launchterminal.listening.Value == script.Parent then
				v.PlayerGui.ScreenGui.launchterminal.vstatus.Value = script.Parent.status.Value
			end
		end
	end
	if script.Parent.status.Value == &quot;launched&quot; then
		if Game:GetService(&quot;BadgeService&quot;):UserHasBadge( script.Parent.launcher.Value.userId,31866202) == false then
			game:GetService(&quot;BadgeService&quot;):AwardBadge(script.Parent.launcher.Value.userId,31866202)
		end
		launch()
	end
end

function launch()	
	thruster = script.Parent.stage1.Thruster
	p = game.Players:GetPlayers()	
	for i,v in pairs (p) do
		v.PlayerGui.ScreenGui.countdown.Visible = true
	end	
	for i = 10,0,-1 do
		p = game.Players:GetPlayers()
		for j,v in pairs (p) do
			v.PlayerGui.ScreenGui.countdown.Text = (&quot;T- &quot; .. i .. &quot; Seconds until launch of &quot; .. script.Parent.Name)
		end		
		if i == 2 then
			script.Parent.status.Value = &quot;ignition&quot;
			workspace.walkway.walkway.BrickColor = BrickColor.new(&quot;Bright red&quot;)
			workspace.walkway.active.Value = false
			workspace.walkway.extended.Value = false
			thruster.Fire.Enabled = true
			thruster.Fire2.Enabled = true			
			thruster.Smoke1.Enabled = true
			thruster.Smoke2.Enabled = true
			thruster.Smoke3.Enabled = true
			p = game.Players:GetPlayers()
			for i,v in pairs (p) do
				if v.PlayerGui.ScreenGui.launchterminal.Visible == false then
					v.PlayerGui.ScreenGui.ignit.Visible = true					
				end			
			end
		end
		wait(1)
	end
	for i,v in pairs (p) do
		v.PlayerGui.ScreenGui.countdown.Visible = false
	end	
	script.Parent.maned.launched.Value = true
	thruster.BodyThrust.force = Vector3.new(0, -1.2e+006, 0)
	wait(3)
	p = game.Players:GetPlayers()
	for i,v in pairs (p) do
		v.PlayerGui.ScreenGui.ignit.Visible = false
	end		
	wait(5)
	if thruster.Velocity.Magnitude &lt; 33 then
		thruster.BodyThrust.force = Vector3.new(0, -1.21e+006, 0)	
		p = game.Players:GetPlayers()
		script.Parent.status.Value = &quot;throttleup&quot;
		for i,v in pairs (p) do
			v.PlayerGui.ScreenGui.throttleup.Visible = true
		end			
		wait(3)
		for i,v in pairs (p) do
			v.PlayerGui.ScreenGui.throttleup.Visible = false
		end
	end		
	wait(25)
	new = game.Lighting.rocket:clone()
	new.Parent = workspace.rockets
	new:MakeJoints()
	workspace.walkway.walkway.BrickColor = BrickColor.new(&quot;Bright green&quot;)
	workspace.walkway.active.Value = true	
	script.Parent.status.Value = &quot;seperating&quot;
	wait(3)
	script.Parent.maned.stage2.BodyThrust.force = Vector3.new(0,-5e+005,0)
	thruster.BodyThrust.force = Vector3.new(0,0,0)
	wait(0.2)
	bits = script.Parent.stage1:GetChildren()
	if script.Parent.stage1.Thruster.Position.Y &gt;1300 then
		for i,v in pairs(bits) do
			if v:IsA(&quot;Part&quot;) then
				v.CanCollide = false
			end
		end
	end
	script.Parent.stage1:BreakJoints()
	p = game.Players:GetPlayers()
	for i,v in pairs (p) do
		v.PlayerGui.ScreenGui.seperation.Visible = true
	end			
	wait(3)
	for i,v in pairs (p) do
		v.PlayerGui.ScreenGui.seperation.Visible = false
	end		
	wait(2)
	blast = Instance.new(&quot;Explosion&quot;)
	blast. BlastPressure = 1000
	blast.BlastRadius = 50
	blast.Position = script.Parent.stage1.tube.Position
	blast.Parent = game.Workspace
	thruster.Smoke1:remove()
	thruster.Smoke2:remove()
	thruster.Smoke3:remove()	
	script.Parent.stage1:remove()
	wait(1)
	script.Parent.maned.stage2.BodyThrust.force = Vector3.new(0, 0,0)
	bp = Instance.new(&quot;BodyPosition&quot;)
	bp.position = workspace.target1.Position
	bp.Parent = script.Parent.maned.stage2
	bp.maxForce = Vector3.new(4e+005,1e+006, 4e+005)
	bp.D = 2e+004
	
	p = script.Parent.maned.Seat:FindFirstChild(&quot;SeatWeld&quot;)
	print(p)
	if p~= nil then
		print(p.Part1)
		if p.Part1.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
			game.Players:GetPlayerFromCharacter(p.Part1.Parent)
			game.Players:GetPlayerFromCharacter(p.Part1.Parent).Backpack.LocalScript.gravity.Value = 0			
		end
	end
	p = script.Parent.maned.Seat1:FindFirstChild(&quot;SeatWeld&quot;)
	print(p)
	if p~= nil then
		print(p.Part1)
		if p.Part1.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
			print(game.Players:GetPlayerFromCharacter(p.Part1.Parent))
			game.Players:GetPlayerFromCharacter(p.Part1.Parent).Backpack.LocalScript.gravity.Value = 0			
		end
	end	
	bv = Instance.new(&quot;BodyVelocity&quot;)
	bv.Parent = script.Parent.maned.stage2
	bv.maxForce = Vector3.new(0,0,0)

	while (script.Parent.maned.stage2.Position - workspace.target1.Position).Magnitude &gt; 5 do
		wait(1)
	end
	script.Parent.status.Value = &quot;docking&quot;
	bp:Remove()
	bv.maxForce = Vector3.new(4e+009,4e+009,4e+009)
	while (script.Parent.maned.stage2.Position - workspace.target2.Position).Magnitude &gt; 1 do
		ratio  = (script.Parent.maned.stage2.Position - workspace.target2.Position).Unit
		bv.velocity  = -ratio*5
		wait()
	end	
	workspace.stationdoor.CanCollide = false
	workspace.stationdoor.Transparency = 1
	while (script.Parent.maned.stage2.Position - workspace.target3.Position).Magnitude &gt; 1 do
		ratio  = (script.Parent.maned.stage2.Position - workspace.target3.Position).Unit
		bv.velocity  = -ratio*5		
		wait()
	end	
	bv.velocity = Vector3.new(0,-1,0)
	wait(5)
	bv.maxForce = Vector3.new(0,0,0)
	workspace.stationdoor.CanCollide = true
	workspace.stationdoor.Transparency = 0	
	
	script.Parent.Parent = workspace
	for i,v in pairs(Game.Players:GetChildren()) do
		if v.PlayerGui.ScreenGui.launchterminal.Visible == true then
			v.PlayerGui.ScreenGui.launchterminal.update.Value = true
		end
	end	
	script.Parent:Remove()
end
script.Parent.status.Changed:connect(updatestatus)
wait(3)
script.Parent.status.Value = &quot;ready&quot;




