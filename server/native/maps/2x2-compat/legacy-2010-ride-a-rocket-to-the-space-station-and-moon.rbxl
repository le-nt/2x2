script.Parent.launch.MouseButton1Down:connect(launch)
script.Parent.vstatus.Changed:connect(status)
script.Parent.listening.Changed:connect(listen)
script.Parent.Changed:connect(initialize)
script.Parent.close.MouseButton1Down:connect(close)</ProtectedString>
