		<Item class="Script" referent="RBX2072">
			<Properties>
				<bool name="Archivable">true</bool>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">Script</string>
				<ProtectedString name="Source">function respawn(character) 
	name = character.Name
	wait(2)
	players = workspace.admins:GetChildren()
	print(&quot;test&quot;)
	for i = 1,#players do
		if name == players[i].Name then
			wait(2)
			local button =  game.Lighting.players.Players:Clone()
			button.Parent = game.Players[name].PlayerGui.ScreenGui
			button.playername.Value = name
			local button =  game.Lighting.rocketguis.Rocketcontrols:Clone()
			button.Parent = game.Players[name].PlayerGui.ScreenGui
			button.playername.Value = name
		end
	end	
	if workspace.admins:findFirstChild(name) == nil then
		if workspace[name]:FindFirstChild (&quot;Humanoid&quot;) ~= nil then
			if workspace[name]:FindFirstChild (&quot;Torso&quot;) ~= nil then
				if workspace[name].Torso.roblox.Texture == &quot;http://www.roblox.com/asset/?id=28781898&quot; then
					msg = Instance.new (&quot;Message&quot;)
					msg.Text = &quot;raceway Shirts no longer give admin here&quot;
					msg.Parent = game.Players[name]
					wait(2)
					msg:remove()
				end
			end
		end
	end
end 

function enter(player) 
player.CharacterAdded:connect(function(c) respawn(c) end) 
end 


game.Players.PlayerAdded:connect(enter)</ProtectedString>
