					<string name="Name">Script1</string>
					<ProtectedString name="Source">door = script.Parent.door
gyro = script.Parent.gyro.BodyGyro
velo = script.Parent.motor.BodyVelocity
gear = script.Parent.landinggear:GetChildren()

w = Instance.new(&quot;Weld&quot;)
w.Part0 = script.Parent.wall
w.Part1 = script.Parent.cockpitdoor
w.C0 = CFrame.new(0,0,4)
w.Parent = script.Parent
db1 = false
a = 4

function grav(g)
	for _,v in pairs(game.Players:GetPlayers()) do	
		if v.Character ~= nil then
			if v.Character:FindFirstChild(&quot;Torso&quot;) ~= nil then
				if (v.Character.Torso.Position - gyro.Parent.Position).Magnitude &lt; 50 then
					v.Backpack.LocalScript.gravity.Value = g
				end
			end
		end
	end
end

function cancelvelo()
	for i,v in pairs(script.Parent:GetChildren()) do
		if v:IsA(&quot;BasePart&quot;) then
			v.Velocity = Vector3.new(0,0,0)
		end
	end
end

script.Parent.cockpitdoor.Touched:connect(function()
	if db1 == true then return end
	db1 = true
	for i = 8,0,-1 do
		wait()
		if i == a then
			w.Parent = script.Parent
			w.C0 = CFrame.new(0,0,i/2)
			a = a -1
		end
	end
	wait(0.5)
	db1 = false
	for i = 0,8 do
		if db1 == false then
			wait()
			w.Parent = script.Parent
			w.C0 = CFrame.new(0,0,i/2)
			a = a +1
		end
	end
end)

function lowergear()
	for i,v in pairs(gear) do
		v.Transparency = 0
		v.CanCollide = true
	end
end

function raisegear()
	for i,v in pairs(gear) do
		v.Transparency = 1
		v.CanCollide = false
	end
end

function initiate()
	script.Parent.thruster1.Fire.Enabled = true
	script.Parent.thruster2.Fire.Enabled = true
	script.Parent.thruster3.Fire.Enabled = true
	script.Parent.thruster4.Fire.Enabled = true	
	script.Parent.door.Transparency = 0
	script.Parent.door.CanCollide = true
	gyro.cframe = CFrame.new(gyro.Parent.Position,workspace.stationtarget1.Position)
	while (gyro.Parent.Position - workspace.stationtarget1.Position).Magnitude &gt; 25 do
		wait(1)		
		ratio = (gyro.Parent.Position - workspace.stationtarget1.Position).unit
		velo.velocity = Vector3.new(-ratio.X*10,-10*ratio.Y,-ratio.Z*10)
	end
	gyro.cframe = workspace.stationtarget1.CFrame
	ratio = (gyro.Parent.Position - workspace.stationtarget2.Position).unit
	velo.velocity = Vector3.new(-ratio.X*5,-5*ratio.Y,-ratio.Z*5)
	wait(5)
	script.Parent.thruster1.Fire.Enabled = false
	script.Parent.thruster2.Fire.Enabled = false
	script.Parent.thruster3.Fire.Enabled = false
	script.Parent.thruster4.Fire.Enabled = false	
	script.Parent.hover1.Fire.Enabled = true
	script.Parent.hover2.Fire.Enabled = true
	script.Parent.hover3.Fire.Enabled = true
	script.Parent.hover4.Fire.Enabled = true	
	while (door.Position - workspace.stationtarget2.Position).Magnitude &gt; 1 do
		wait()
		ratio = (door.Position - workspace.stationtarget2.Position).unit
		velo.velocity = Vector3.new(-ratio.X*5,-5*ratio.Y,-ratio.Z*5)
	end
	script.Parent.hover1.Fire.Enabled = false
	script.Parent.hover2.Fire.Enabled = false
	script.Parent.hover3.Fire.Enabled = false
	script.Parent.hover4.Fire.Enabled = false	
	velo.velocity = Vector3.new(0,0,0)
	door.Anchored = true
	cancelvelo()
	workspace.ModelT.door.CanCollide = false
	workspace.ModelT.door.Transparency = 1
	script.Parent.door.Transparency = 1
	script.Parent.door.CanCollide = false
	script.Parent.mode.Value = 0
end

function gotostation()
	script.Parent.door.Transparency = 0
	script.Parent.door.CanCollide = true	
	script.Parent.hover1.Fire.Enabled = true
	script.Parent.hover2.Fire.Enabled = true
	script.Parent.hover3.Fire.Enabled = true
	script.Parent.hover4.Fire.Enabled = true
	script.Parent.thruster1.Fire.Enabled = true
	script.Parent.thruster2.Fire.Enabled = true
	script.Parent.thruster3.Fire.Enabled = true
	script.Parent.thruster4.Fire.Enabled = true
	velo.velocity = Vector3.new(0,2.5,5)
	wait(2)
	raisegear()
	while (gyro.Parent.Position - workspace.moontarget3.Position).Magnitude &gt; 10 do
		wait()
		ratio = (gyro.Parent.Position - workspace.moontarget3.Position).unit
		velo.velocity = Vector3.new(-ratio.X*25,-25*ratio.Y,-ratio.Z*25)
	end
	script.Parent.hover1.Fire.Enabled = false
	script.Parent.hover2.Fire.Enabled = false
	script.Parent.hover3.Fire.Enabled = false
	script.Parent.hover4.Fire.Enabled = false	
	grav(0)
	gyro.cframe = CFrame.new(gyro.Parent.Position,workspace.stationtarget1.Position)
	while (gyro.Parent.Position - workspace.stationtarget1.Position).Magnitude &gt; 25 do
		wait(1)
		ratio = (gyro.Parent.Position - workspace.stationtarget1.Position).unit
		velo.velocity = Vector3.new(-ratio.X*25,-25*ratio.Y,-ratio.Z*25)
	end
	gyro.cframe = workspace.stationtarget1.CFrame
	ratio = (gyro.Parent.Position - workspace.stationtarget1.Position).unit
	velo.velocity = Vector3.new(-ratio.X*5,-5*ratio.Y,-ratio.Z*5)
	wait(5)
	script.Parent.thruster1.Fire.Enabled = false
	script.Parent.thruster2.Fire.Enabled = false
	script.Parent.thruster3.Fire.Enabled = false
	script.Parent.thruster4.Fire.Enabled = false	
	script.Parent.hover1.Fire.Enabled = true
	script.Parent.hover2.Fire.Enabled = true
	script.Parent.hover3.Fire.Enabled = true
	script.Parent.hover4.Fire.Enabled = true	
	while (door.Position - workspace.stationtarget2.Position).Magnitude &gt; 1 do
		wait()
		ratio = (door.Position - workspace.stationtarget2.Position).unit
		velo.velocity = Vector3.new(-ratio.X*5,-5*ratio.Y,-ratio.Z*5)
	end
	script.Parent.hover1.Fire.Enabled = false
	script.Parent.hover2.Fire.Enabled = false
	script.Parent.hover3.Fire.Enabled = false
	script.Parent.hover4.Fire.Enabled = false	
	velo.velocity = Vector3.new(0,0,0)
	cancelvelo()
	door.Anchored = true
	workspace.ModelT.door.CanCollide = false
	workspace.ModelT.door.Transparency = 1
	script.Parent.door.Transparency = 1
	script.Parent.door.CanCollide = false	
	script.Parent.mode.Value = 0
end

function gotomoon()
	script.Parent.hover1.Fire.Enabled = true
	script.Parent.hover2.Fire.Enabled = true
	script.Parent.hover3.Fire.Enabled = true
	script.Parent.hover4.Fire.Enabled = true	
	script.Parent.door.Transparency = 0
	door.Anchored = false
	workspace.ModelT.door.CanCollide = true
	workspace.ModelT.door.Transparency = 0
	script.Parent.door.CanCollide = true	
	velo.velocity = Vector3.new(0,10,-5)
	while gyro.Parent.Position.Y &lt; 14390 do
		wait(1)
	end
	script.Parent.thruster1.Fire.Enabled = true
	script.Parent.thruster2.Fire.Enabled = true
	script.Parent.thruster3.Fire.Enabled = true
	script.Parent.thruster4.Fire.Enabled = true	
	script.Parent.hover1.Fire.Enabled = false
	script.Parent.hover2.Fire.Enabled = false
	script.Parent.hover3.Fire.Enabled = false
	script.Parent.hover4.Fire.Enabled = false	
	gyro.cframe = CFrame.new(gyro.Parent.Position,workspace.moontarget1.Position)
	while (gyro.Parent.Position - workspace.moontarget1.Position).Magnitude &gt; 25 do
		wait(1)
		ratio = (gyro.Parent.Position - workspace.moontarget1.Position).unit
		velo.velocity = Vector3.new(-ratio.X*25,-25*ratio.Y,-ratio.Z*25)
	end	
	script.Parent.hover1.Fire.Enabled = true
	script.Parent.hover2.Fire.Enabled = true
	script.Parent.hover3.Fire.Enabled = true
	script.Parent.hover4.Fire.Enabled = true
	lowergear()
	script.Parent.thruster1.Fire.Enabled = false
	script.Parent.thruster2.Fire.Enabled = false
	script.Parent.thruster3.Fire.Enabled = false
	script.Parent.thruster4.Fire.Enabled = false
	gyro.cframe = workspace.moontarget2.CFrame
	while (gyro.Parent.Position - workspace.moontarget2.Position).Magnitude &gt; 5 do
		wait()
		ratio = (gyro.Parent.Position - workspace.moontarget2.Position).unit
		velo.velocity = Vector3.new(-ratio.X*5,-5*ratio.Y,-ratio.Z*5)
	end	
	velo.velocity = Vector3.new(0,-1,0)
	for i = 0,0.16,0.01 do
		wait(0.2)
		grav(i)	
	end
	wait(5)
	velo.velocity = Vector3.new(0,0,0)
	script.Parent.hover1.Fire.Enabled = false
	script.Parent.hover2.Fire.Enabled = false
	script.Parent.hover3.Fire.Enabled = false
	script.Parent.hover4.Fire.Enabled = false	
	script.Parent.mode.Value = 0
	script.Parent.door.Transparency = 1
	script.Parent.door.CanCollide = false
end

function mode()
	if script.Parent.mode.Value == 0 then return end
	if script.Parent.mode.Value == -1 then
		gotomoon()
	elseif script.Parent.mode.Value == 1 then
		gotostation()
	end
end
		

initiate()

script.Parent.mode.Changed:connect(mode)</ProtectedString>
