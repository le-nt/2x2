			<Item class="Script" referent="RBX8354">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onclicked()
	if script.Parent.Part.Transparency &gt; 0 then
		for i = 1,10 do
			if script.Parent.Part.Transparency == 0 then
				break 
			else
				script.Parent.Part.Transparency = script.Parent.Part.Transparency - 0.1
			end
		wait(0.1)
		end
	else
		for i = 1,6 do
			if script.Parent.Part.Transparency == 1 then
				break 
			else
				script.Parent.Part.Transparency = script.Parent.Part.Transparency + 0.1
			end
		wait(0.1)
		end		
	end
end

script.Parent.Head.ClickDetector.MouseClick:connect(onclicked)</ProtectedString>
				</Properties>
			</Item>
