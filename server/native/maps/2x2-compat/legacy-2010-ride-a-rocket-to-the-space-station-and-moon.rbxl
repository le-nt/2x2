				<Content name="LinkedSource"><null></null></Content>
				<string name="Name">LocalScript</string>
				<ProtectedString name="Source">repeat wait() until game.Players.LocalPlayer.Character
repeat wait() until game.Players.LocalPlayer.Character:FindFirstChild(&quot;Torso&quot;)

bfs = {}

function grav()
	for i,v in pairs(bfs) do
		v:Remove()
	end
	for _,v in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
		if v:FindFirstChild(&quot;BodyForce&quot;) then
			v:remove()
		end
		if v:IsA(&quot;BasePart&quot;) then
			local antigrav = Instance.new(&quot;BodyForce&quot;)
			antigrav.force = Vector3.new(0,((v:GetMass()*196.23145)*(1-script.gravity.Value)),0)
			antigrav.Parent = v
			table.insert(bfs,antigrav)
		elseif v:IsA(&quot;Hat&quot;) then
			for _,j in pairs(v:GetChildren()) do
				if j:IsA(&quot;BasePart&quot;) then
					local antigrav = Instance.new(&quot;BodyForce&quot;)
					antigrav.force = Vector3.new(0,((j:GetMass()*196.23145)*(1-script.gravity.Value)),0)
					antigrav.Parent = j
					table.insert(bfs,antigrav)
				end
			end
		elseif v:IsA(&quot;Tool&quot;) then
			for _,j in pairs(v:GetChildren()) do
				if j:IsA(&quot;BasePart&quot;) then
					local antigrav = Instance.new(&quot;BodyForce&quot;)
					antigrav.force = Vector3.new(0,((j:GetMass()*196.23145)*(1-script.gravity.Value)),0)
					antigrav.Parent = j
					table.insert(bfs,antigrav)
				end
			end
		end
	end
end

function itemremoved(c)
	for i,v in pairs(bfs) do
		if v.Parent == c then
			print(&quot;removing&quot;,v.Parent)
			table.remove(bfs,i)
		end
	end
end

if tostring(game.Players.LocalPlayer.TeamColor) == (&quot;Bright yellow&quot;) then
	script.gravity.Value = 0.16
elseif tostring(game.Players.LocalPlayer.TeamColor) == (&quot;Bright green&quot;) then
	script.gravity.Value = 0
else
	script.gravity.Value = 1
end

grav()


script.gravity.Changed:connect(grav)
game.Players.LocalPlayer.Character.ChildAdded:connect(grav)
game.Players.LocalPlayer.Character.ChildRemoved:connect(itemremoved)</ProtectedString>
