								<string name="Name">DoorScript</string>
								<ProtectedString name="Source">bin = script.Parent.Parent.DoorClosed
bin2 = script.Parent.Parent.DoorOpen

function onClicked(mouse)

	if (bin.CanCollide == true) then
		bin.Transparency = 1
		bin.CanCollide = false
		bin2.Transparency = 1
		bin2.CanCollide = false
		return
	end

	if (bin.CanCollide == false) then
		bin.Transparency = 0.2
		bin.CanCollide = true
		bin2.Transparency = 1
		bin2.CanCollide = false
		return
	end

end

script.Parent.ClickDetector.MouseClick:connect(onClicked)
</ProtectedString>
