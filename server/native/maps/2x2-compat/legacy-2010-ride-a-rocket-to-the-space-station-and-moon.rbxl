						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function testageness()
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	name = script.Parent.victim.Value
	if workspace[name].Head.Anchored == false then
		workspace[name].Head.Anchored = true
		msg = Instance.new (&quot;Message&quot;)
		msg.Text = (&quot;You have been Frozen by &quot; .. script.Parent.refplayer.Value)
		msg.Parent = game.Players[name]
		msg.Name = &quot;guimessage&quot;
		wait(2)
		msg:remove()
		script.Parent.Text = &quot;Unanchor Player&quot;
	else
		workspace[name].Head.Anchored = false
		script.Parent.Text = &quot;Anchor Player&quot;
		msg = Instance.new (&quot;Message&quot;)
		msg.Text = (&quot;You have been unfrozen by &quot; .. script.Parent.refplayer.Value)
		msg.Parent = game.Players[name]
		msg.Name = &quot;guimessage&quot;
		wait(2)
		msg:remove()
		script.Parent.Text = &quot;Anchor Player&quot;	
	end
script.Parent.buisy.Value = false
end
