				<Item class="Script" referent="RBX15595">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">local Tool = script.Parent;

enabled = true




function onActivated()
	if not enabled  then
		return
	end

	enabled = false
	Tool.GripForward = Vector3.new(-0.707,-0,-0.707)
	Tool.GripPos = Vector3.new(-0.75,-1.5,0)
	Tool.GripRight = Vector3.new(0,-1,0)
	Tool.GripUp = Vector3.new(0.707,0,-0.707)


	Tool.Handle.DrinkSound:Play()

	wait(3)
	
	local h = Tool.Parent:FindFirstChild(&quot;Humanoid&quot;)
	if (h ~= nil) then
		if (h.MaxHealth &gt; h.Health + 5) then
			h.Health = h.Health + 5
		else	
			h.Health = h.MaxHealth
		end
	end

	Tool.GripForward = Vector3.new(0,-0,-1)
	Tool.GripPos = Vector3.new(0,0,0.2)
	Tool.GripRight = Vector3.new(0,-1,0)
	Tool.GripUp = Vector3.new(1,0,0)

	enabled = true

end

function onEquipped()
	Tool.Handle.OpenSound:play()
end

script.Parent.Activated:connect(onActivated)
script.Parent.Equipped:connect(onEquipped)
</ProtectedString>
