				<Item class="Script" referent="RBX16325">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function testageness()
	player = script.Parent.playername.Value
	nogo = false
	if script.Parent.open.Value == false then
		guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
		for i = 1,#guit do
			if guit[i]:FindFirstChild(&quot;buisy&quot;) ~= nil then
				if guit[i].buisy.Value == true then
					nogo = true
				end
			end
		end
		if nogo ~= true then
			script.Parent.open.Value = true
			guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
			p = game.Players:GetChildren()
			for i = 1,#guit do
				name = guit[i]
				for j = 1,#p do
					namer = p[j]
					if name.Name == namer.Name and name.Name ~= script.Parent.Name then 
						if guit[i]:FindFirstChild(&quot;open&quot;) ~= nil then
							if name.open.Value == true then
								name.open.Value = false
							end
						end
					end
				end
			end
		end
		else
		guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
		for i = 1,#guit do
			if guit[i]:FindFirstChild(&quot;buisy&quot;) ~= nil then
				if guit[i].buisy.Value == true then
				nogo = true
				end
			end
		end
		if nogo ~= true then
			script.Parent.open.Value = false
		end
	end
end

function anotherlol()
	if script.Parent.open.Value == true then
		open()
	else
		close()
	end
end


function close()
	guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
	guis = game.Lighting.players:GetChildren()
	script.Parent.BackgroundColor3 = Color3.new(0/255,174/255,255/255)
	for i = 1,#guit do
		name = guit[i].Name
		for j =1,#guis do
			namer = guis[j].Name
			if name == namer and name ~= script.Parent.Name and name ~=&quot;Players&quot; then
				if guit[i].victim.Value == script.Parent.Name then
					guit[i]:remove()
				end
			end
		end
	end
end


function open()
	player = script.Parent.playername.Value
	script.Parent.BackgroundColor3 = Color3.new (255/255,51/255,0/255)
	wait(0.1)
	local udimx = 0.66 + 0.11
	local udimy = 0.05
	guis = game.Lighting.players:GetChildren()
	for i =1,#guis do
		if guis[i].Name ~= script.Parent.Name and guis[i].Name ~= &quot;PlayerButton&quot; and guis[i].Name ~= &quot;Players&quot; and guis[i].Name ~= &quot;editwspd&quot; and guis[i].Name ~= &quot;editcash&quot; then
		udimy = udimy + 0.06
		button =  guis[i]:Clone()
		button.Parent = game.Players[player].PlayerGui.ScreenGui
		button.Position = UDim2.new(udimx,0,udimy,0)
		button.BackgroundColor3 = Color3.new (255/255,51/255,0/255)
		button.refplayer.Value = player
		button.victim.Value = script.Parent.Name
		end
	end
end

script.Parent.open.Changed:connect(anotherlol)
script.Parent.MouseButton1Down:connect(testageness)</ProtectedString>
