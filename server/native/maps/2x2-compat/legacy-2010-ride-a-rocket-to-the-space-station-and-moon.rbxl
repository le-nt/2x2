						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">metrics</string>
						<ProtectedString name="Source">function round(num, decimals) 
return ( math.floor( num * 10^decimals ) / 10^decimals ) 
end 

rocket = script.Parent.listening.Value
script.Parent.altitude.Text = &quot;Loading...&quot;
script.Parent.velocity.Text = &quot;Loading...&quot;
script.Parent.acceleration.Text = &quot;Loading...&quot;
while true do
	prevel = rocket.maned.door.Velocity.Magnitude
	wait(0.5)
	script.Parent.altitude.Text = &quot;Altitude: &quot; .. (round(rocket.maned.door.Position.Y,0) .. &quot; studs&quot;)
	script.Parent.velocity.Text = &quot;Velocity: &quot; .. (round(rocket.maned.door.Velocity.Magnitude,0) .. &quot; studs per second&quot;)
	script.Parent.acceleration.Text = &quot;Acceleration: &quot; .. (round(rocket.maned.door.Velocity.Magnitude - prevel,0)*2 .. &quot; studs/second^2&quot;)
	if script.Parent.vstatus.Value == &quot;ignition&quot; or script.Parent.vstatus.Value == &quot;throttleup&quot; then
		if round((rocket.maned.door.Velocity.Magnitude - prevel)*2,0) &lt; 3 then
			script.Parent.acceleration.TextColor3 = Color3.new(1,0,0)
		else
			script.Parent.acceleration.TextColor3 = Color3.new(0,140/255,0)
		end
	end
end
</ProtectedString>
