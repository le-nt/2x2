				<Item class="Script" referent="RBX2064">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function ontouched(p)
	if p:IsA(&quot;Weld&quot;) then
		if p.Part1.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
			game.Players:GetPlayerFromCharacter(p.Part1.Parent).PlayerGui.ScreenGui.launchterminal.Visible = true				
		end
	end
end

script.Parent.ChildAdded:connect(ontouched)</ProtectedString>
					</Properties>
