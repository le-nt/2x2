					<Item class="BoolValue" referent="RBX586">
						<Properties>
							<bool name="Archivable">true</bool>
							<string name="Name">launched</string>
							<bool name="Value">false</bool>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX587">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">debounce = false
function launched()
	if script.Parent.launched.Value == true and debounce == false then
		debounce = true
		wait(110)
		p = game.Players:GetPlayers()
		for i = 1,#p do
			p[i].PlayerGui.ScreenGui.disembark.Visible = true
		end
		wait(5)	
		for i = 1,#p do
			p[i].PlayerGui.ScreenGui.disembark.Visible = false
		end	
		debounce = false
		script.Parent.Parent.Parent = workspace
		for i = 1,#p do
			if p[i].PlayerGui.ScreenGui.launchterminal.Visible == true then
				p[i].PlayerGui.ScreenGui.launchterminal.update.Value = true
			end
		end	
		script.Parent.Parent:remove()
	end
end
script.Parent.launched.Changed:connect(launched)
</ProtectedString>
						</Properties>
