				<Item class="Script" referent="RBX876">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">shut = script.Parent.mover.Position
open = Vector3.new(shut.X - 8,shut.Y,shut.Z)
script.Parent.mover.BodyPosition.position = shut
script.Parent.mover.BodyPosition.maxForce = Vector3.new(4e+006, 4e+006, 4e+006)
script.Parent.mover.Anchored = false
extended = script.Parent.extended
function onclicked()
	if script.Parent.active.Value == true then
		if extended.Value == false then
			extended.Value = true
			return
		end
		if extended.Value == true then 
			extended.Value = false
			return
		end
	end
end
function onchanged()
	if extended.Value == false then 	
		script.Parent.mover.BodyPosition.position = shut
	else
		script.Parent.mover.BodyPosition.position = open
	end
end
script.Parent.walkway.ClickDetector.MouseClick:connect(onclicked)
script.Parent.extended.Changed:connect(onchanged)
</ProtectedString>
					</Properties>
				</Item>
