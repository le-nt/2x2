					<Item class="LocalScript" referent="RBX16231">
						<Properties>
							<bool name="Archivable">true</bool>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">LocalScript</string>
							<ProtectedString name="Source">function changed(property)
	if property == &quot;Visible&quot; and script.Parent.Parent.Visible == true then
		for i = 10,0,-1 do
			if script.Parent.Parent.Visible == false then 
				break
			end
			script.Parent.Text = (&quot;Time: &quot;.. i)
			wait(1)
		end
	script.Parent.Parent.Visible = false
	end
end

script.Parent.Parent.Changed:connect(changed)</ProtectedString>
						</Properties>
