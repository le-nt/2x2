			<Item class="Script" referent="RBX547">
				<Properties>
					<bool name="Archivable">true</bool>
					<bool name="Disabled">false</bool>
					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">function onclicked()
	if script.Parent.location.Value == true then
		workspace.monorail.motor.BodyPosition.position = Vector3.new(-768, 25, -26)
		script.Parent.location.Value = false	
	else
		workspace.monorail.motor.BodyPosition.position = Vector3.new(4.5, 25, -26)
		script.Parent.location.Value = true	
	end
end

script.Parent.ClickDetector.MouseClick:connect(onclicked)</ProtectedString>
				</Properties>
