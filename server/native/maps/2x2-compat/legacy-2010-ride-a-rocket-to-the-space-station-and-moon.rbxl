							<ProtectedString name="Source">function testageness()
	msg1exist = false
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	name = script.Parent.victim.Value
	text = script.Parent.Parent.Text
	name = script.Parent.victim.Value
	if workspace[name]:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
		workspace[name].Humanoid.WalkSpeed = text
	end
	spd = workspace[name].Humanoid.WalkSpeed
	msg = Instance.new(&quot;Message&quot;)
	msg.Text = (&quot;walkspeed of: &quot; .. script.Parent.victim.Value .. &quot; set to: &quot; .. spd )
	msg.Parent = game.Players[script.Parent.refplayer.Value]
	if script.Parent.refplayer.Value ~= script.Parent.victim.Value then
		msg1 = Instance.new(&quot;Message&quot;)
		msg1.Text = (script.Parent.refplayer.Value .. &quot;has set your walk speed to: &quot; .. tostring(spd) )
		msg1.Parent = game.Players[script.Parent.victim.Value]
		msg1exist = true
	end
	wait(1)
	msg:remove()
	if msg1exist == true then
		msg1:remove()
	end
	script.Parent.Parent.Parent.changewalkspeed.done.Value = true
	script.Parent.buisy.Value = false
	script.Parent.Parent:remove()
end
