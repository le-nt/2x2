						<string name="Value">blah</string>
					</Properties>
				</Item>
				<Item class="BoolValue" referent="RBX16202">
					<Properties>
						<bool name="Archivable">true</bool>
						<string name="Name">update</string>
						<bool name="Value">false</bool>
					</Properties>
				</Item>
				<Item class="BoolValue" referent="RBX16203">
					<Properties>
						<bool name="Archivable">true</bool>
						<string name="Name">vcamera</string>
						<bool name="Value">true</bool>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX16204">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function initialize(property)
	print(property)
	if property == &quot;Visible&quot; and script.Parent.Visible == false then 
		script.Parent.launch.Visible = false
		script.Parent.clickrocket.Visible = false
		script.Parent.data1.Visible = false
		script.Parent.data2.Visible = false
		script.Parent.data3.Visible = false
		script.Parent.data4.Visible = false
		script.Parent.data5.Visible = false	
		script.Parent.camera.Visible = false
		script.Parent.velocity.Visible = false
		script.Parent.altitude.Visible = false
		script.Parent.acceleration.Visible = false		
		script.Parent.status.Visible = false
		script.Parent.clickrocket.Visible = true
	end
	if property == &quot;Visible&quot; and script.Parent.Visible == true then
		script.Parent.vstatus.Value = &quot;blah&quot;
		guis = script.Parent:GetChildren()
		for i,v in pairs(guis) do
			if v.Name == &quot;rocket1&quot; then
				v:remove()
			end
		end
		rockets = workspace.rockets:GetChildren()
		local udimx = 0.95
		local udimy = 0.25		
		for i,v in pairs(rockets) do
			gui = game.Lighting.launchguis.rocket1:clone()
			gui.Parent = script.Parent
			gui.rocket.Value = v
			gui.Text = v.Name
			gui.Position = UDim2.new(udimx,0,udimy,0)		
			udimy = udimy + 0.06	
		end
		if script.Parent.listening.Value ~= nil then
			script.Parent.vstatus.Value = script.Parent.listening.Value.status.Value
		end
	end
end

function update()
	wait(1)
	if script.Parent.update.Value == true then
		guis = script.Parent:GetChildren()
		for i,v in pairs(guis) do
			if v.Name == &quot;rocket1&quot; then
				v:remove()
			end
		end
		rockets = workspace.rockets:GetChildren()
		local udimx = 0.95
		local udimy = 0.25		
		for i,v in pairs(rockets) do
			if v.status.Value ~= &quot;docking&quot; then
				gui = game.Lighting.launchguis.rocket1:clone()
				gui.Parent = script.Parent
				gui.rocket.Value = v
				gui.Text = v.Name
				gui.Position = UDim2.new(udimx,0,udimy,0)		
				udimy = udimy + 0.06	
			end
		end	
		script.Parent.update.Value = false
	end
end
function close()
	--[[workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.Parent.Character.Humanoid
	workspace.CurrentCamera.CameraType = 5
	script.Parent.vcamera.Value = true	]]
	script.Parent.Visible = false
end

function launch()
	if script.Parent.listening.Value.status.Value == &quot;ready&quot; then
		script.Parent.listening.Value.launcher.Value = script.Parent.Parent.Parent.Parent
		script.Parent.listening.Value.status.Value = &quot;launched&quot;
	end
end

function regen()

end

function camera()
	if script.Parent.vcamera.Value == true then
		if script.Parent.listening.Value:FindFirstChild(&quot;stage1&quot;) ~= nil then
			workspace.CurrentCamera.CameraSubject = script.Parent.listening.Value.stage1.camera
			workspace.CurrentCamera.CameraType = 1
			wait(1)
			workspace.CurrentCamera.CoordinateFrame = CFrame.new(script.Parent.listening.Value.stage1.camera.Position.X,(script.Parent.listening.Value.stage1.camera.Position.Y - 3),script.Parent.listening.Value.stage1.camera.Position.Z, -0.00917185005, 0.987646937, -0.15642707, -0, 0.156433657, 0.987688422, 0.999957979, 0.00905892998, -0.00143478601)			
			script.Parent.vcamera.Value = false
		end
	else
		workspace.CurrentCamera.CameraSubject = script.Parent.Parent.Parent.Parent.Character.Humanoid
		workspace.CurrentCamera.CameraType = 5
		script.Parent.vcamera.Value = true
	end
end
function listen()
	script.Parent.metrics.Disabled = true
	script.Parent.vstatus.Value = script.Parent.listening.Value.status.Value
end

function status()
	script.Parent.launch.Visible = false
	script.Parent.clickrocket.Visible = false
	script.Parent.data1.Visible = false
	script.Parent.data2.Visible = false
	script.Parent.data3.Visible = false
	script.Parent.data4.Visible = false
	script.Parent.data5.Visible = false	
	script.Parent.camera.Visible = false
	script.Parent.velocity.Visible = false
	script.Parent.altitude.Visible = false
	script.Parent.acceleration.Visible = false		
	script.Parent.status.Visible = false
	
	vstatus = script.Parent.vstatus
	print(vstatus.Value)
	if vstatus.Value == &quot;spawned&quot; then
		script.Parent.status.Visible = true
		script.Parent.data1.Visible = true
		script.Parent.data2.Visible = true
		script.Parent.data3.Visible = true
		script.Parent.data4.Visible = true

		script.Parent.data1.Text = &quot;Turbopump: spooling up - standby&quot;		--2 seconds
		script.Parent.data1.TextColor3 = Color3.new(1,51/255,0)	
		script.Parent.data2.Text = &quot;Fueling: external fueling valves closing - standby&quot; -- 1 second
		script.Parent.data2.TextColor3 = Color3.new(1,51/255,0)
		script.Parent.data3.Text = &quot;Seperation Charges: not armed - standby&quot; -- 1.5 seconds
		script.Parent.data3.TextColor3 = Color3.new(1,51/255,0)
		script.Parent.data4.Text = &quot;Guidance: booting up - standby&quot; -- 2.5 seconds
		script.Parent.data4.TextColor3 = Color3.new(1,51/255,0)
		if workspace.walkway.extended.Value == true then extended = &quot;extended&quot; else extended = &quot;retracted&quot; end
		if workspace.walkway.active.Value == true then locked = &quot;locked&quot; else locked = &quot;unlocked&quot; end
		script.Parent.data5.Text = (&quot;walkway &quot; .. extended .. &quot; and &quot; .. locked)
		script.Parent.data5.TextColor3 = Color3.new(0,0,0)
		script.Parent.status.Text = &quot;status: preparing for launch&quot;
		local timer = 0
		while script.Parent.vstatus.Value == &quot;spawned&quot; and timer &lt; 2.5 do
			wait(0.5)
			timer = timer + 0.5
			if timer == 1 then
				script.Parent.data2.TextColor3 = Color3.new(0,140/255,0)
				script.Parent.data2.Text = &quot;Fueling: complete.&quot;		
			end
			if timer == 1.5 then
				script.Parent.data3.TextColor3 = Color3.new(0,140/255,0)		
				script.Parent.data3.Text = &quot;Seperation Charges: Set and armed.&quot;
			end
			if timer == 2 then
				script.Parent.data1.TextColor3 = Color3.new(0,140/255,0)		
				script.Parent.data1.Text = &quot;Turbopumps: Nominal.&quot;
			end
			if timer == 2.5 then
				script.Parent.data4.TextColor3 = Color3.new(0,140/255,0)		
				script.Parent.data4.Text = &quot;Guidance: online and operating.&quot;		
			end		
		end
		script.Parent.status.Text = &quot;status: waiting for clearance.&quot;	
	end
	if vstatus.Value == &quot;ready&quot; then
		script.Parent.status.Visible = true
		script.Parent.data1.Visible = true
		script.Parent.data2.Visible = true
		script.Parent.data3.Visible = true
		script.Parent.data4.Visible = true
		script.Parent.launch.Visible = true
	--	script.Parent.camera.Visible = true
		script.Parent.data1.TextColor3 = Color3.new(0,140/255,0)		
		script.Parent.data1.Text = &quot;Turbopumps: Nominal.&quot;
		script.Parent.data2.TextColor3 = Color3.new(0,140/255,0)
		script.Parent.data2.Text = &quot;Fueling: complete.&quot;		
		script.Parent.data3.TextColor3 = Color3.new(0,140/255,0)		
		script.Parent.data3.Text = &quot;Seperation Charges: Set and armed.&quot;		
		script.Parent.data4.TextColor3 = Color3.new(0,140/255,0)		
		script.Parent.data4.Text = &quot;Guidance: online and operating.&quot;		
		script.Parent.status.Text = &quot;Status: Ready for launch.&quot;
	end
	if vstatus.Value == &quot;launched&quot; then
	--	script.Parent.camera.Visible = true	
		script.Parent.status.Visible = true
		script.Parent.status.Text = &quot;Status: Launched&quot;
		script.Parent.data1.Visible = true
		script.Parent.data1.Text = &quot;Loading metrics and telemetry&quot;
		script.Parent.data1.TextColor3 = Color3.new(0,0,0)
		wait(1)
		script.Parent.data2.Visible = true
		script.Parent.altitude.Visible = true
		script.Parent.velocity.Visible = true
		script.Parent.acceleration.Visible = true
		script.Parent.data2.Text = &quot;Metrics loaded&quot;
		script.Parent.data2.TextColor3 = Color3.new(0,0,0)		
		wait(0.5)
		script.Parent.data3.Visible = true
		script.Parent.data3.Text = &quot;Connecting to data stream...&quot;
		script.Parent.data3.TextColor3 = Color3.new(0,0,0)		
		wait(1)
		script.Parent.metrics.Disabled = false
		script.Parent.data4.Visible = true
		script.Parent.data4.Text = &quot;Connected and receiving.&quot;
		script.Parent.data4.TextColor3 = Color3.new(0,0,0)		
		wait(1)
		script.Parent.data5.Text = &quot;All systems nominal.&quot;
		script.Parent.data5.TextColor3 = Color3.new(0,0,0)	
	end
	if vstatus.Value == &quot;ignition&quot; then
		script.Parent.metrics.Disabled = false
		script.Parent.altitude.Visible = true
		script.Parent.velocity.Visible = true
		script.Parent.acceleration.Visible = true
		--script.Parent.camera.Visible = true	
		script.Parent.status.Visible = true
		script.Parent.data1.Visible = true
		script.Parent.data1.Text = &quot;Umbilicals Released&quot;
		script.Parent.data1.TextColor3 = Color3.new(0,0,0)		
		wait(0.5)
		script.Parent.data2.Visible = true
		script.Parent.data2.Text = &quot;Using onboard O2&quot;
		script.Parent.data2.TextColor3 = Color3.new(0,0,0)		
		wait(0.5)
		script.Parent.data3.Visible = true
		script.Parent.data3.Text = &quot;Switching to internal power unit.&quot;
		script.Parent.data3.TextColor3 = Color3.new(0,0,0)		
		wait(1)
		script.Parent.data4.Visible = true
		script.Parent.data4.Text = &quot;Tie downs released&quot;
		script.Parent.data4.TextColor3 = Color3.new(0,0,0)	
		wait(2)
		if script.Parent.listening.Value.maned.door.Position.Y &gt; 56.9 then
			script.Parent.data4.Visible = true
			script.Parent.data4.Text = &quot;Lift off comfirmed&quot;
			script.Parent.data4.TextColor3 = Color3.new(0,0,0)
		end
	end
	if vstatus.Value == &quot;throttleup&quot; then
		script.Parent.metrics.Disabled = false
		script.Parent.altitude.Visible = true
		script.Parent.velocity.Visible = true
		script.Parent.acceleration.Visible = true
	--	script.Parent.camera.Visible = true	
		script.Parent.status.Visible = true
		script.Parent.data1.Visible = true
		script.Parent.data1.Text = &quot;turbopumps engaged&quot;
		script.Parent.data1.TextColor3 = Color3.new(204/255,153/255,0)		
		wait(0.5)
		script.Parent.data2.Visible = true
		script.Parent.data2.Text = &quot;increasing fuel flow&quot;
		script.Parent.data2.TextColor3 = Color3.new(204/255,153/255,0)		
		wait(0.5)
		script.Parent.data3.Visible = true
		script.Parent.data3.Text = &quot;new guidance data uploaded.&quot;
		script.Parent.data3.TextColor3 = Color3.new(204/255,153/255,0)		
		wait(1)
		script.Parent.data4.Visible = true
		script.Parent.data4.Text = &quot;Throttle up complete&quot;
		script.Parent.data1.TextColor3 = Color3.new(0,140/255,0)
	end
	if vstatus.Value == &quot;seperating&quot; then
		script.Parent.metrics.Disabled = false
		script.Parent.altitude.Visible = true
		script.Parent.velocity.Visible = true
		script.Parent.acceleration.Visible = true
	--	script.Parent.camera.Visible = true	
		script.Parent.status.Visible = true
		script.Parent.data1.Visible = true
		script.Parent.data1.Text = &quot;seperation bolts detonated&quot;
		script.Parent.data1.TextColor3 = Color3.new(0,1,0)		
		wait(0.5)
		script.Parent.data2.Visible = true
		script.Parent.data2.Text = &quot;igniting second stage&quot;
		script.Parent.data2.TextColor3 = Color3.new(204/255,153/255,0)	
		wait(0.5)
		script.Parent.data3.Visible = true
		script.Parent.data3.Text = &quot;guidance data uploaded.&quot;
		script.Parent.data3.TextColor3 = Color3.new(204/255,153/255,0)		
		wait(1)
		script.Parent.data4.Visible = true
		script.Parent.data4.Text = &quot;Seperation complete&quot;
		script.Parent.data1.TextColor3 = Color3.new(204/255,153/255,0)
	end
	if vstatus.Value == &quot;docking&quot; then
		script.Parent.metrics.Disabled = false
		script.Parent.altitude.Visible = true
		script.Parent.velocity.Visible = true
		script.Parent.acceleration.Visible = true
		--script.Parent.camera.Visible = true	
		script.Parent.status.Visible = true
		script.Parent.data1.Visible = true
		script.Parent.data1.Text = &quot;approaching station&quot;
		script.Parent.data1.TextColor3 = Color3.new(0,0,0)		
		wait(0.5)
		script.Parent.data2.Visible = true
		script.Parent.data2.Text = &quot;docking radar activated&quot;
		script.Parent.data2.TextColor3 = Color3.new(0,0,0)		
		wait(0.5)
		script.Parent.data3.Visible = true
		script.Parent.data3.Text = &quot;manuvering to dock.&quot;
		script.Parent.data3.TextColor3 = Color3.new(0,0/0)		
		while (script.Parent.listening.Value.maned.stage2.Position - workspace.target3.Position).Magnitude &gt; 5 do
			wait(1)
		end
		script.Parent.data4.Visible = true
		script.Parent.data4.Text = &quot;Docking complete, launch complete.&quot;
		script.Parent.data1.TextColor3 = Color3.new(0,0,0)
		script.Parent.metrics.Disabled = true
	end
end

function regen()
	if script.Parent.Parent.votewarning.Visible == false and script.Parent.Parent.voteregen.Visible == false then
		script.Parent.Parent.votewarning.Visible = true
	end
end

script.Parent.regen.MouseButton1Down:connect(regen)
--script.Parent.camera.MouseButton1Down:connect(camera)
