				<Item class="Script" referent="RBX275">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">script.Parent.Parent.mode.Changed:connect(function()
	if script.Parent.Parent.mode.Value == 0 then
		if (script.Parent.Parent.gyro.Position - workspace.stationtarget2.Position).Magnitude &lt; 100 then
			script.Parent.Name = &quot;Synchronising with the Renegade, standby.&quot;
			while workspace.Renegade.mode.Value ~= 0 do
				wait(1)
			end
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the moon in approximately 2 minutes&quot;
			wait(60)
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the moon in approximately 1 minute&quot;
			wait(30)
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the moon in approximately 30 seconds&quot;
			wait(20)
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the moon in approximately 10 seconds&quot;
			wait(10)
			script.Parent.Name = &quot;Welcome to the Orichalcum! - Please be seated.&quot;
			script.Parent.Parent.mode.Value = -1
		else
			script.Parent.Name = &quot;Synchronising with the Renegade, standby.&quot;
			while workspace.Renegade.mode.Value ~= 0 do
				wait(1)
			end			
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the station in approximately 2 minutes&quot;
			wait(60)
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the station in approximately 1 minute&quot;
			wait(30)
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the station in approximately 30 seconds&quot;
			wait(20)
			script.Parent.Name = &quot;Welcome to the Orichalcum! we will be leaving for the station in approximately 10 seconds&quot;
			wait(10)
			script.Parent.Name = &quot;Welcome to the Orichalcum! - Please be seated.&quot;
			script.Parent.Parent.mode.Value = 1			
		end
	end
end)
</ProtectedString>
					</Properties>
				</Item>
