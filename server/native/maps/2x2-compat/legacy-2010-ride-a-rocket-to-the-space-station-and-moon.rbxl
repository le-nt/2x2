				</Item>
				<Item class="Script" referent="RBX16232">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function initialize(property)
	if property == &quot;Visible&quot; and script.Parent.Visible == true then
		script.Parent.warning.Text = (&quot;Vote to regenerate rocket. Initiated by: &quot;.. script.Parent.refplayer.Value.Name)
		script.Parent.line4.Text = (&quot;and the rocket has not regenerated. - vote NO if you beleive &quot; ..script.Parent.refplayer.Value.Name.. &quot; was mistaken and the regen is not broken.&quot;)
		script.Parent.line5.Text = (&quot;vote Kick &quot;.. script.Parent.refplayer.Value.Name ..  &quot; if you beleive &quot;..script.Parent.refplayer.Value.Name..&quot; is deliberately starting votes to harrass other players.&quot;)
		script.Parent.kick.Text = &quot;Kick &quot; .. script.Parent.refplayer.Value.Name
	end	
end

function yes()
	script.Parent.Visible = false
	script.Parent.refplayer.Value.PlayerGui.ScreenGui.votewarning.yes.Value = script.Parent.refplayer.Value.PlayerGui.ScreenGui.votewarning.yes.Value + 1
end
function no()
	script.Parent.Visible = false
	script.Parent.refplayer.Value.PlayerGui.ScreenGui.votewarning.no.Value = script.Parent.refplayer.Value.PlayerGui.ScreenGui.votewarning.no.Value + 1
end
function kick()
	script.Parent.Visible = false
	script.Parent.refplayer.Value.PlayerGui.ScreenGui.votewarning.kick.Value = script.Parent.refplayer.Value.PlayerGui.ScreenGui.votewarning.kick.Value + 1
end

script.Parent.Changed:connect(initialize)	
script.Parent.yes.MouseButton1Down:connect(yes)
script.Parent.no.MouseButton1Down:connect(no)
script.Parent.kick.MouseButton1Down:connect(kick)</ProtectedString>
