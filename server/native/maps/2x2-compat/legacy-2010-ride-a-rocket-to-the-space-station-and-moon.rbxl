							<string name="Name">Script</string>
							<ProtectedString name="Source">function onClicked()

	script.Parent.Parent.A.Transparency=1
	script.Parent.Parent.A.CanCollide=false
	script.Parent.Parent.B.Transparency=1
	script.Parent.Parent.B.CanCollide=false
	wait(0.1)
	script.Parent.Parent.C.Transparency=1
	script.Parent.Parent.C.CanCollide=false
	script.Parent.Parent.D.Transparency=1
	script.Parent.Parent.D.CanCollide=false
	wait(0.1)
	script.Parent.Parent.E.Transparency=1
	script.Parent.Parent.E.CanCollide=false
	script.Parent.Parent.F.Transparency=1
	script.Parent.Parent.F.CanCollide=false
	wait(0.1)
	script.Parent.Parent.G.Transparency=1
	script.Parent.Parent.G.CanCollide=false
	script.Parent.Parent.H.Transparency=1
	script.Parent.Parent.H.CanCollide=false
	
	wait(0.1)
	
	script.Parent.Parent.P.Transparency=1
	script.Parent.Parent.P.CanCollide=false
	script.Parent.Parent.O.Transparency=1
	script.Parent.Parent.O.CanCollide=false
	wait(0.1)
	script.Parent.Parent.N.Transparency=1
	script.Parent.Parent.N.CanCollide=false
	script.Parent.Parent.M.Transparency=1
	script.Parent.Parent.M.CanCollide=false
	wait(0.1)
	script.Parent.Parent.L.Transparency=1
	script.Parent.Parent.L.CanCollide=false
	script.Parent.Parent.K.Transparency=1
	script.Parent.Parent.K.CanCollide=false
	wait(0.1)
	script.Parent.Parent.J.Transparency=1
	script.Parent.Parent.J.CanCollide=false
	script.Parent.Parent.I.Transparency=1
	script.Parent.Parent.I.CanCollide=false
	
	wait(0.1)
	
	script.Parent.Parent.Q.Transparency=1
	script.Parent.Parent.Q.CanCollide=false
	wait(0.1)
	script.Parent.Parent.R.Transparency=1
	script.Parent.Parent.R.CanCollide=false
	script.Parent.Parent.S.Transparency=1
	script.Parent.Parent.S.CanCollide=false
	wait(0.1)
	script.Parent.Parent.T.Transparency=1
	script.Parent.Parent.T.CanCollide=false
	script.Parent.Parent.U.Transparency=1
	script.Parent.Parent.U.CanCollide=false
end

script.Parent.ClickDetector.MouseClick:connect(onClicked)</ProtectedString>
