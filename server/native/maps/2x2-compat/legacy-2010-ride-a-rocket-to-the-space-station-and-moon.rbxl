				<Item class="StringValue" referent="RBX16393">
					<Properties>
						<bool name="Archivable">true</bool>
						<string name="Name">playername</string>
						<string name="Value"></string>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX16394">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">listopen = false

function testageness()
	nogo = false
	player = script.Parent.playername.Value
	if listopen == false then
		open()
		listopen = true
	else
		guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
		guis = game.Lighting.rocketguis:GetChildren()
		for i = 1,#guit do
			name = guit[i].Name
			for j =1,#guis do
				namer = guis[j].Name
				if name == namer then
					if guit[i]:FindFirstChild(&quot;buisy&quot;) ~= nil then
						if guit[i].buisy.Value == true then
						nogo = true
						end
					end
				end
			end
		end
		if nogo ~= true then
		close()
		listopen = false
		end
	end
end


	
function close()
	guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
	guis = game.Lighting.rocketguis:GetChildren()
	for i = 1,#guit do
		name = guit[i].Name
		for j =1,#guis do
			namer = guis[j].Name
			if name == namer and name ~=&quot;Rocketcontrols&quot; then
			guit[i]:remove()
			end
		end
	end
end	
	
function open()
	wait(0.1)
	local udimx = 0.55
	local udimy = 0.05
	guis = game.Lighting.rocketguis:GetChildren()
	for i =1,#guis do
		if guis[i].Name ~= &quot;Rocketcontrols&quot; then
		udimy = udimy + 0.06
		button =  guis[i]:Clone()
		button.Parent = game.Players[player].PlayerGui.ScreenGui
		button.Position = UDim2.new(udimx,0,udimy,0)
		button.refplayer.Value = player
		end
	end
end
script.Parent.MouseButton1Down:connect(testageness)</ProtectedString>
