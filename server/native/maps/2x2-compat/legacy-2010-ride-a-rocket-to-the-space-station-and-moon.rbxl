				<Item class="Script" referent="RBX1276">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">inner1 = script.Parent.innerairlock1
inner2 = script.Parent.innerairlock2
outer1 = script.Parent.outerdoor1
outer2 = script.Parent.outerdoor2

inner1.Name = &quot;Airlock atmosphere 100% - Door safe to open&quot;
inner2.Name = &quot;Airlock atmosphere 100% - Door safe to open&quot;
outer1.Name = &quot;Airlock atmosphere 100% - click to depressurise&quot;
outer2.Name = &quot;Airlock atmosphere 100% - click to depressurise&quot;

function innerlock()
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	if script.Parent.pressureised.Value == true then
		script.Parent.outer1.CanCollide = true
		script.Parent.outer1.Transparency = 0
		script.Parent.outer2.CanCollide = true
		script.Parent.outer2.Transparency = 0
		wait(1)
		script.Parent.innerdoor1.CanCollide = false
		script.Parent.innerdoor1.Transparency = 1
		script.Parent.innerdoor2.CanCollide = false
		script.Parent.innerdoor2.Transparency = 1
	elseif script.Parent.pressureised.Value == false then
		script.Parent.outer1.CanCollide = true
		script.Parent.outer1.Transparency = 0
		script.Parent.outer2.CanCollide = true
		script.Parent.outer2.Transparency = 0		
		wait(0.5)
		inner1.Name = &quot;Pressureising - standby&quot;
		inner2.Name = &quot;Pressureising - standby&quot;
		workspace.moon.emitters.Part1.Smoke.Enabled = true
		workspace.moon.emitters.Part2.Smoke.Enabled = true
		workspace.moon.emitters.Part3.Smoke.Enabled = true
		workspace.moon.emitters.Part4.Smoke.Enabled = true
		for i = 1,100 do
			inner1.Name = &quot;Pressureising - standby, atmosphere: &quot; .. i .. &quot;%&quot;
			inner2.Name = &quot;Pressureising - standby, atmosphere: &quot; .. i .. &quot;%&quot;
			outer1.Name = &quot;Pressureising - outer doors locked, atmosphere: &quot; .. i .. &quot;%&quot;
			outer2.Name = &quot;Pressureising - outer doors locked, atmosphere: &quot; .. i .. &quot;%&quot;
			wait(0.1)
		end
		script.Parent.pressureised.Value = true
		workspace.moon.emitters.Part1.Smoke.Enabled = false
		workspace.moon.emitters.Part2.Smoke.Enabled = false
		workspace.moon.emitters.Part3.Smoke.Enabled = false
		workspace.moon.emitters.Part4.Smoke.Enabled = false		
		inner1.Name = &quot;Airlock atmosphere 100% - Door safe to open&quot;
		inner2.Name = &quot;Airlock atmosphere 100% - Door safe to open&quot;
		outer1.Name = &quot;Airlock atmosphere 100% - click to depressurise&quot;
		outer2.Name = &quot;Airlock atmosphere 100% - click to depressurise&quot;		
	end
	script.Parent.buisy.Value = false
end

function outerlock()
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	if script.Parent.pressureised.Value == false then
		script.Parent.innerdoor1.CanCollide = true
		script.Parent.innerdoor1.Transparency = 0
		script.Parent.innerdoor2.CanCollide = true
		script.Parent.innerdoor2.Transparency = 0
		wait(1)
		script.Parent.outer1.CanCollide = false
		script.Parent.outer1.Transparency = 1
		script.Parent.outer2.CanCollide = false
		script.Parent.outer2.Transparency = 1	
	elseif script.Parent.pressureised.Value == true then
		script.Parent.innerdoor1.CanCollide = true
		script.Parent.innerdoor1.Transparency = 0
		script.Parent.innerdoor2.CanCollide = true
		script.Parent.innerdoor2.Transparency = 0	
		wait(0.5)
		inner1.Name = &quot;De-pressureising - standby&quot;
		inner2.Name = &quot;De-pressureising - standby&quot;
		for i = 100,1,-1 do
			inner1.Name = &quot;De-pressureising - inner doors locked, atmosphere: &quot; .. i .. &quot;%&quot;
			inner2.Name = &quot;De-Pressureising - inner doors locked, atmosphere: &quot; .. i .. &quot;%&quot;
			outer1.Name = &quot;De-Pressureising - standby, atmosphere: &quot; .. i .. &quot;%&quot;
			outer2.Name = &quot;De-Pressureising - standby, atmosphere: &quot; .. i .. &quot;%&quot;
			wait(0.1)
		end
		script.Parent.pressureised.Value = false
		inner1.Name = &quot;Airlock atmosphere 0% - click to pressurise&quot;
		inner2.Name = &quot;Airlock atmosphere 0% - click to pressurise&quot;
		outer1.Name = &quot;Airlock atmosphere 0% - Door safe to open&quot;
		outer2.Name = &quot;Airlock atmosphere 0% - Door safe to open&quot;		
	end
	script.Parent.buisy.Value = false	
end

outer1.Head.ClickDetector.MouseClick:connect(outerlock)
outer2.Head.ClickDetector.MouseClick:connect(outerlock)
inner1.Head.ClickDetector.MouseClick:connect(innerlock)
inner2.Head.ClickDetector.MouseClick:connect(innerlock)</ProtectedString>
