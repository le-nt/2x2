						<string name="Name">Script</string>
						<ProtectedString name="Source">function testageness()
	if script.Parent.refplayer.Value ~= &quot;Aerideyn&quot; then
		if script.Parent.victim.Value == &quot;Alec12317&quot; or script.Parent.victim.Value == &quot;Aerideyn&quot; then
			msg = Instance.new(&quot;Message&quot;)
			msg.Text = (&quot;This Player cannot be kicked.&quot;)
			msg.Parent = script.Parent.refplayer.Value
			wait(2)
			msg:remove()
			return
		end
	end	
	name = script.Parent.victim.Value
	msg = Instance.new (&quot;Message&quot;)
	msg.Text = (&quot;You have been kicked by &quot; .. script.Parent.refplayer.Value)
	msg.Parent = game.Players[name]
	p = game.Players:GetChildren()
	for i = 1,#p do
		if p[i].PlayerGui.ScreenGui:FindFirstChild(&quot;Players&quot;) ~= nil then
			p[i].PlayerGui.ScreenGui.Players.refresh.Value = script.Parent.victim.Value
		end
	end
	game.Players[name]:remove()
end
