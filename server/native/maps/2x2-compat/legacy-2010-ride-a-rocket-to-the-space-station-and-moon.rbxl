				<Item class="ClickDetector" referent="RBX16433">
					<Properties>
						<bool name="Archivable">true</bool>
						<float name="MaxActivationDistance">32</float>
						<string name="Name">ClickDetector</string>
					</Properties>
				</Item>
				<Item class="Script" referent="RBX16434">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function onclicked()
	script.Parent.ClickDetector:remove()
	script.Parent.Head:remove()
	new = game.Lighting.reentrycapsule1:Clone()
	script.Parent.Parent.door.Transparency = 0.5
	script.Parent.Parent.motor.Anchored = false
	script.Parent.Parent.Part.Fire.Enabled = true
	wait(5)
	new.Parent = workspace
	new:MakeJoints()
	script.Parent.Parent.motor.BodyPosition.maxForce = Vector3.new(5000000,5000000,5000000)
	a=0
	if script.Parent.Parent.Seat:FindFirstChild(&quot;SeatWeld&quot;) then
		if script.Parent.Parent.Seat.SeatWeld.Part1.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
			game.Players:GetPlayerFromCharacter(script.Parent.Parent.Seat.SeatWeld.Part1.Parent).Backpack.LocalScript.gravity.Value = 1
		end
	end
	while script.Parent.Parent.motor.Position.Y &gt; 3 do
		a = (a + 0.5)
		wait(0.5)
		if a == 200 then
			break
		end
	end
	script.Parent.Parent:remove()
end

script.Parent.ClickDetector.MouseClick:connect(onclicked)</ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Part" referent="RBX16435">
