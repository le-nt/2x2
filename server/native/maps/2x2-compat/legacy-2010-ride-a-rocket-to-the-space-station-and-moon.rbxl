						<string name="Name">Script</string>
						<ProtectedString name="Source">function testageness()
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	script.Parent.done.Value = false
	name = script.Parent.victim.Value
	wspd = game.Lighting.players.editwspd:clone()
	wspd.Parent = game.Players[script.Parent.refplayer.Value].PlayerGui.ScreenGui
	wspd.ok.refplayer.Value = script.Parent.refplayer.Value
	wspd.ok.victim.Value = name
end


function ibedone()
	if script.Parent.done.Value == false then return 
	else
		script.Parent.buisy.Value = false 
		script.Parent.done.Value = false
	end
end

