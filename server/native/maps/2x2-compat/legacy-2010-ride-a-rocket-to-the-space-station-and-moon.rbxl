						<ProtectedString name="Source">function testageness()
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true	
	name = script.Parent.victim.Value
	workspace[name]:MoveTo(Vector3.new(-739, 1.8, -39))
	msg = Instance.new (&quot;Message&quot;)
	msg.Text = (&quot;You have been teleported to the start by &quot; .. script.Parent.refplayer.Value)
	msg.Parent = game.Players[name]
	msg.Name = &quot;guimessage&quot;
	wait(2)
	msg:remove()
	script.Parent.buisy.Value = false
end
