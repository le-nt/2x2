function vote()
	script.Parent.Parent.launchterminal.Visible = false
	script.Parent.Parent.votewarning.Visible = false
	script.Parent.yes.Value = 0
	script.Parent.no.Value = 0
	script.Parent.kick.Value = 0
	p = game.Players:GetPlayers()
	for i,v in pairs(p) do
		v.PlayerGui.ScreenGui.voteregen.refplayer.Value = script.Parent.Parent.Parent.Parent
		v.PlayerGui.ScreenGui.voteregen.Visible = true
	end
	wait(10)
	if script.Parent.yes.Value &gt; script.Parent.no.Value and script.Parent.yes.Value &gt; script.Parent.kick.Value then
		msg = Instance.new(&quot;Message&quot;)		
		msg.Text = &quot;(Yes: &quot; .. script.Parent.yes.Value .. &quot;) (No: &quot; .. script.Parent.no.Value .. &quot;) (Kick: &quot; .. script.Parent.kick.Value .. &quot;) Result: Yes&quot;
		msg.Parent = workspace
		wait(3)
		msg:remove()
		rocks = workspace.rockets:GetChildren()
		for i,v in pairs(rocks) do
			v:remove()
		end
		wait(0.5)
		new = game.Lighting.rocket:Clone()
		new.Parent = workspace.rockets
		new:MakeJoints()	
	elseif script.Parent.no.Value &gt; script.Parent.yes.Value and script.Parent.no.Value &gt; script.Parent.kick.Value then
		msg = Instance.new(&quot;Message&quot;)		
		msg.Text = &quot;(Yes: &quot; .. script.Parent.yes.Value .. &quot;) (No: &quot; .. script.Parent.no.Value .. &quot;) (Kick: &quot; .. script.Parent.kick.Value .. &quot;) Result: No&quot;
		msg.Parent = workspace
		wait(3)
		msg:remove()	
	elseif script.Parent.kick.Value &gt; script.Parent.no.Value and script.Parent.kick.Value &gt; script.Parent.yes.Value then
		msg = Instance.new(&quot;Message&quot;)
		msg.Text = &quot;(Yes: &quot; .. script.Parent.yes.Value .. &quot;) (No: &quot; .. script.Parent.no.Value .. &quot;) (Kick: &quot; .. script.Parent.kick.Value .. &quot;) Result: Kick &quot;.. script.Parent.Parent.Parent.Parent.Name
		msg.Parent = workspace
		wait(3)
		msg:remove()
		script.Parent.Parent.Parent.Parent:remove()
	end
	p = game.Players:GetPlayers()
	for i,v in pairs(p) do
		v.PlayerGui.ScreenGui.voteregen.Visible = false
		v.PlayerGui.ScreenGui.votewarning.Visible = false
	end	
end	
script.Parent.close.MouseButton1Down:connect(close)
script.Parent.vote.MouseButton1Down:connect(vote)</ProtectedString>
