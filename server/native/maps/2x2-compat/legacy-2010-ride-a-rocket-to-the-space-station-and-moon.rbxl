						<ProtectedString name="Source">function testageness()
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	if workspace:FindFirstChild(&quot;monorail&quot;) ~= nil then
		workspace.monorail:remove()
		new = game.Lighting.monorail:clone()
		new.Parent = workspace
		new:MakeJoints()
		msg = Instance.new(&quot;Message&quot;)
		msg.Text = (script.Parent.refplayer.Value .. &quot; Has reset the monorail&quot;)
		msg.Parent = workspace
		wait(2)
		msg:remove()
		script.Parent.buisy.Value = false 
	end
end
