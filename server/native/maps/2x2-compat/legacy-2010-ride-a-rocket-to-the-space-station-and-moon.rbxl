						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">listopen = false

function testageness()
	nogo = false
	player = script.Parent.playername.Value
	if listopen == false then
		open()
		listopen = true
	else
		guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
		guis = game.Lighting.players:GetChildren()
		for i = 1,#guit do
			name = guit[i].Name
			for j =1,#guis do
				namer = guis[j].Name
				if name == namer then
					if guit[i]:FindFirstChild(&quot;buisy&quot;) ~= nil then
						if guit[i].buisy.Value == true then
						nogo = true
						end
					end
				end
			end
		end
		if nogo ~= true then
		shut()
		listopen = false
		end
	end
end
	
function shut()
	p = game.Players:GetChildren()
	for i = 1,#p do
		name = p[i].Name
		if game.Players[player].PlayerGui.ScreenGui:FindFirstChild(name) ~= nil then
			game.Players[player].PlayerGui.ScreenGui[name]:remove()
		end
	end
	guit = game.Players[player].PlayerGui.ScreenGui:GetChildren()
	guis = game.Lighting.players:GetChildren()
	script.Parent.BackgroundColor3 = Color3.new(0/255,174/255,255/255)
	for i = 1,#guit do
		name = guit[i].Name
		for j =1,#guis do
			namer = guis[j].Name
			if name == namer and name ~= script.Parent.Name and name ~=&quot;Players&quot; then
			guit[i]:remove()
			end
		end
	end
end	

function open()
	player = script.Parent.playername.Value
	p = game.Players:GetChildren()
	wait(0.1)
	local udimx = 0.66
	local udimy = 0.05
	for i =1,#p do
		udimy = udimy + 0.06
		name = p[i].Name
		local button =  game.Lighting.players.PlayerButton:Clone()
		button.Name = name
		button.Text = name
		button.playername.Value = player
		button.Parent = game.Players[player].PlayerGui.ScreenGui
		button.Position = UDim2.new(udimx,0,udimy,0)
	end
end

function refresh()
	player = script.Parent.playername.Value
	if script.Parent.refresh.Value ~= &quot;nil&quot; then
		if game.Players[player].PlayerGui.ScreenGui:FindFirstChild(script.Parent.refresh.Value) ~= nil then
			game.Players[player].PlayerGui.ScreenGui[script.Parent.refresh.Value].open.Value = false
			wait(0.2)
			game.Players[player].PlayerGui.ScreenGui[script.Parent.refresh.Value]:remove()
		end
	end
	script.Parent.refresh.Value = &quot;nil&quot;
end
		

script.Parent.refresh.Changed:connect(refresh)
