						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">function testageness()
	if script.Parent.buisy.Value == true then return end
	script.Parent.buisy.Value = true
	models = workspace:GetChildren()
	msg = Instance.new(&quot;Message&quot;)
	msg.Text = (script.Parent.refplayer.Value .. &quot; Has reset the rocket&quot;)
	msg.Parent = workspace	
	for i = 1,#models do
		if models[i].Name == &quot;rocket&quot; or models[i].Name == &quot;maned&quot; then
			models[i]:remove()
		end
	end
	wait(3)
	newrocket = game.Lighting.rocket:clone()
	newrocket.Parent = workspace
	newrocket:MakeJoints()
	newrocket:MoveTo(Vector3.new(0, 52, -2))
	newrocket.Name = &quot;rocket&quot;
	workspace.rocket[&quot;Click to Launch Rocket&quot;].Head.Position = Vector3.new(-785, 37.8, -12)
	workspace.rocket[&quot;Rocket Information (click to cycle)&quot;]:MoveTo(Vector3.new(-785, 37, -20))
	msg:remove()	
	wait(2)
	workspace.walkway.active.Value = true
	workspace.walkway.walkway.BrickColor = BrickColor.new(&quot;Bright green&quot;)
	script.Parent.buisy.Value = false 
end
script.Parent.MouseButton1Down:connect(testageness)</ProtectedString>
