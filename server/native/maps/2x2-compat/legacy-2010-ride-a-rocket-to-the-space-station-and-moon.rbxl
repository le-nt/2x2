				<Item class="Script" referent="RBX1970">
					<Properties>
						<bool name="Archivable">true</bool>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">Script</string>
						<ProtectedString name="Source">morphs = game.Lighting.sm:GetChildren()
function astroontouched(part)
	if part.Parent:FindFirstChild(&quot;Humanoid&quot;) ~= nil then
		parts = part.Parent:GetChildren()
		for i,v in pairs(parts) do
			if v.className == &quot;CharacterMesh&quot; then
				v:remove()
			end
		end
		for i = 1,#morphs do
			temp = morphs[i]:Clone()
			temp.Parent = part.Parent
		end
		if part.Parent:FindFirstChild(&quot;Space Hat&quot;) == nil then
			hat = Instance.new(&quot;Hat&quot;)
			helm = workspace.helmet:Clone()
			helm.Name = &quot;Handle&quot;
			hat.Name = &quot;Space Hat&quot;
			hat.Parent = part.Parent
			helm.Parent = hat
		end
	end
end

script.Parent.Head.Touched:connect(astroontouched)</ProtectedString>
