								<Content name="LinkedSource"><null></null></Content>
								<string name="Name">Script</string>
								<ProtectedString name="Source">function onchanged()
	while script.Parent.Position.Y &lt;65 do
		wait(1)
	end
	p = game.Players:GetPlayers()
	for i,v in pairs (p) do
		v.PlayerGui.ScreenGui.tower.Visible = true
	end
	wait(3)
	for i,v in pairs (p) do
		v.PlayerGui.ScreenGui.tower.Visible = false
	end	
end	

script.Parent.Parent.Parent.maned.launched.Changed:connect(onchanged)</ProtectedString>
