{
  "name": "roblox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sherlock:build": "cd sherlock && wasm-pack build --target web --out-dir ../src/lib/client/sherlock --release",
    "dev": "bun run sherlock:build && bun --bun vite dev",
    "build": "bun run sherlock:build && bun --bun vite build",
    "preview": "bun --bun vite preview --port 5173",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "migrate:deploy": "prisma migrate deploy",
    "secrets:generate": "bun run scripts/generate_secrets.ts",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@unocss/extractor-svelte": "^66.5.9",
    "@unocss/preset-mini": "^66.5.9",
    "@unocss/preset-wind3": "^66.5.9",
    "bun-types": "^1.3.3",
    "globals": "^15.14.0",
    "prisma": "^7.1.0",
    "svelte": "^5.43.14",
    "svelte-check": "^4.3.4",
    "svelte-turnstile": "^0.11.0",
    "typescript": "^5.9.3",
    "unocss": "^66.5.9",
    "vite": "^6.4.1",
    "wasm-pack": "^0.13.1"
  },
  "dependencies": {
    "@47ng/cloak": "^1.2.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/eden": "^1.4.5",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/swagger": "^1.3.1",
    "@gera2ld/tarjs": "^0.3.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@prisma/client": "^7.1.0",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltestrap/sveltestrap": "^7.1.0",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.13.2",
    "bits-ui": "^2.14.4",
    "elysia": "^1.4.16",
    "elysia-rate-limit": "^4.4.2",
    "file-type": "^21.1.1",
    "haversine-distance": "^1.2.4",
    "idb": "^8.0.3",
    "ioredis": "^5.8.2",
    "lucide-svelte": "^0.525.0",
    "otplib": "^12.0.1",
    "prisma-field-encryption": "^1.6.0",
    "qrcode": "^1.5.4",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-forms": "^2.3.1",
    "svelte-sonner": "^1.0.7",
    "tailwind-merge": "^3.4.0",
    "tslog": "^4.10.2",
    "uuid": "^11.1.0",
